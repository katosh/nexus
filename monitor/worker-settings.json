{
  "skipDangerousModePermissionPrompt": true,
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$NEXUS_ROOT/monitor/hooks/pending-tool-record.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "$NEXUS_ROOT/monitor/hooks/gh-write-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "$NEXUS_ROOT/monitor/hooks/bash-footgun-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$NEXUS_ROOT/monitor/worker-heartbeat.sh busy"
          },
          {
            "type": "command",
            "command": "$NEXUS_ROOT/monitor/hooks/pending-tool-record.sh --clear"
          }
        ]
      },
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "$NEXUS_ROOT/monitor/hooks/async-launch-detect.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$NEXUS_ROOT/monitor/worker-heartbeat.sh notify"
          },
          {
            "type": "command",
            "command": "$NEXUS_ROOT/monitor/hooks/notification-record.sh"
          },
          {
            "type": "command",
            "command": "$NEXUS_ROOT/monitor/hooks/decision-emit.sh"
          },
          {
            "type": "command",
            "command": "$NEXUS_ROOT/monitor/hooks/notify-permission.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$NEXUS_ROOT/monitor/worker-heartbeat.sh user_prompt"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$NEXUS_ROOT/monitor/worker-heartbeat.sh permission_prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$NEXUS_ROOT/monitor/hooks/decision-mark-unresolved.sh"
          },
          {
            "type": "command",
            "command": "$NEXUS_ROOT/monitor/worker-heartbeat.sh turn_end"
          },
          {
            "type": "command",
            "command": "$NEXUS_ROOT/monitor/hooks/stamp-clear.sh over-limit"
          },
          {
            "type": "command",
            "command": "$NEXUS_ROOT/monitor/hooks/stamp-clear.sh turn-failure"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$NEXUS_ROOT/monitor/hooks/over-limit-emit.sh"
          },
          {
            "type": "command",
            "command": "$NEXUS_ROOT/monitor/hooks/turn-failure-emit.sh"
          }
        ]
      }
    ]
  }
}
