# Print the leading comment block (line 2 → first blank line). Replaces
# the previous hardcoded `sed -n '2,Np'` whose N drifted out of sync
# every time the header was edited.
_print_help() { awk '/^$/{exit} NR>1' "$0"; }

# ── Usage tap (verb-dispatch instrumentation) ───────────────────────────────
# Append ONE json line per verb invocation to $STATE_DIR/ng-usage.jsonl so the
# `ng usage` analyzer can measure which verbs are actually invoked and how
# often — the single usage signal nothing else in the nexus captures. `ng`
# verbs dispatch by STRING (the case below), so a static call-graph cannot see
# them, and action-log.jsonl only records the ~8 verbs whose cmd_* bodies call
# cmd_log_action. Everything else (react/upload/show/report-init/pane-state/…)
# is invisible until this tap runs. See your-org/nexus-code usage-observatory.
#
# This runs on the hottest script in the nexus, so it is built to disappear:
#   * FAIL-OPEN   — every path is guarded/`|| true`; the tap can never break or
#                   fail a verb (it logs BEFORE dispatch, never touching $?).
#   * LOCKLESS    — one <4 KiB line via a single `printf >>` is atomic on POSIX
#                   (PIPE_BUF), so concurrent `ng` processes never interleave.
#   * FORK-LIGHT  — no `date`/`stat` fork on the hot path (bash `printf %(...)T`
#                   for the timestamp); a size check runs on ~1/64 of calls only.
#   * PII-SAFE    — logs the verb, and the sub-verb ONLY for an allowlisted set
#                   of sub-dispatch parents and only when it is a clean token
#                   (^[a-z][a-z0-9-]+$) — never issue numbers, paths, or bodies.
#   * OPT-OUT     — NG_USAGE_LOG=0 disables it entirely.
# Rollup + interpretation live in monitor/usage-report.py (`ng usage`).
_USAGE_SUBVERB_OK=" issue pr dashboard skeptic request remote lit "
_usage_tap() {
    [[ "${NG_USAGE_LOG:-1}" == "0" ]] && return 0
    local verb="${1:-}" sub="${2:-}" f="$STATE_DIR/ng-usage.jsonl"
    [[ -n "$verb" && -d "$STATE_DIR" ]] || return 0
    # sub-verb only for allowlisted parents, only a clean token
    if [[ " $_USAGE_SUBVERB_OK " == *" $verb "* && "$sub" =~ ^[a-z][a-z0-9-]+$ ]]; then :; else sub=""; fi
    local origin="agent" win="${NEXUS_WORKER_WINDOW:-${NEXUS_ORCHESTRATOR_WINDOW:-${WATCHER_WINDOW:-}}}"
    [[ -n "${NEXUS_ORCHESTRATOR_WINDOW:-}" ]] && origin="orchestrator"
    [[ -n "${WATCHER_WINDOW:-}" ]] && origin="watcher"
    win="${win//[^A-Za-z0-9:_-]/}"          # keep JSON well-formed, no escaping needed
    # SELF-ATTRIBUTION UNDER TEST (your-org/nexus-code#720). On a CI runner
    # there is no tmux window, so `win` is empty on every row — and when a
    # suite leaks `ng-usage.jsonl` into the inherited root, an empty `win` plus
    # a one-second `ts` under `--jobs 4` narrows the producer to a HANDFUL of
    # concurrent suites and no further. That is exactly where #720 stalled at
    # `d1cc62b`: 23 rows, a verb histogram pointing within four suites, and an
    # inference nobody was willing to publish as a measurement.
    #
    # `NEXUS_TEST_SUITE` is set per child by watcher/run-tests.sh, so the row
    # names its own producer and the ambiguity is removed AT THE SOURCE rather
    # than by serialising the band. Empty outside a test run, which is the
    # honest value there: production `ng` calls have a window instead.
    #
    # A SEPARATE FIELD, never a fallback INTO `win`. Overloading `win` would
    # make a suite name indistinguishable from a window name to `ng usage`,
    # which groups by it — an attribution fix that corrupts the signal it was
    # added to read.
    local src="${NEXUS_TEST_SUITE:-}"
    src="${src//[^A-Za-z0-9:\/._-]/}"       # same JSON-safety rule as `win`
    local ts; printf -v ts '%(%Y-%m-%dT%H:%M:%S%z)T' -1
    # soft-cap rotation: ~1/64 of calls do one size check; rotate once past 4 MiB
    if (( RANDOM % 64 == 0 )); then
        local sz; sz=$(wc -c <"$f" 2>/dev/null || echo 0)
        # $$ suffix so two rotations in the same epoch-second cannot clobber
        if (( sz > 4194304 )); then local ep; printf -v ep '%(%s)T' -1; mv -f "$f" "$f.$ep.$$" 2>/dev/null || true; fi
    fi
    { printf '{"ts":"%s","verb":"%s","sub":"%s","origin":"%s","win":"%s","src":"%s","pid":%d}\n' \
             "$ts" "$verb" "$sub" "$origin" "$win" "$src" "$$" >>"$f"; } 2>/dev/null || true
    return 0
}

main() {
    local sub="${1:-}"; shift || true
    _usage_tap "$sub" "${1:-}"
    case "$sub" in
        usage)          cmd_usage         "$@" ;;
