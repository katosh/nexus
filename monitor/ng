}

# `ng comment-edit <comment-id>` — compare-and-swap edit of an existing
# issue/PR comment (#524 defect 1). The safe read-modify-write loop:
#
#   ng show <cid> --meta          # 1. read: body + updated_at snapshot
#   <edit the body locally>       # 2. modify
#   ng comment-edit <cid> --body-file new.md \
#       --expect-updated-at <ts>  # 3. write: refused (rc 4) if the
#                                 #    comment moved since your read
#
# --expect-updated-at is REQUIRED: without it the verb cannot tell a
# clean write from a clobber, and last-writer-wins on a shared bot
# identity is exactly the silent-lost-update incident this verb exists
# to prevent. `--force` is the loud, deliberate opt-out (plain PATCH,
# no precondition) for comments you provably own alone.
#
# Prefer APPENDING (`ng reply`) over mutating a long-lived shared
# comment — an append can't lose anyone's edit. Reach for comment-edit
# only when the comment must be corrected in place.
cmd_comment_edit() {
    _help_check "$@"
    local cid=""
    local body_file="" repo_arg="" expect="" force=0
    _argloop_prev_6=-1; while (( $# > 0 )); do (( $# != _argloop_prev_6 )) || _argloop_stuck "$1"; _argloop_prev_6=$#
        case "$1" in
            --body-file)         _need_val --body-file "$#" "${2:-}"; body_file="$2"; shift 2 ;;
            --repo)              _need_val --repo "$#" "${2:-}"; repo_arg="$2";  shift 2 ;;
            --expect-updated-at) _need_val --expect-updated-at "$#" "${2:-}"; expect="$2";    shift 2 ;;
            --force)             force=1;            shift   ;;
            --*) die "unknown flag: $(_arg_excerpt "$1")" ;;
            *)  if [[ -z "$cid" ]]; then cid="$1"
                else die "unexpected POSITIONAL argument $(_arg_excerpt "$1"). Flags must start with --; positionals are matched in order."; fi
                shift ;;
        esac
    done
    [[ -n "$cid" ]] || die "usage: ng comment-edit <comment-id> (--expect-updated-at <ts> | --force) [--repo <owner/name>] [--body-file <path>]"
    if [[ -n "$expect" ]] && (( force == 1 )); then
        die "comment-edit: --expect-updated-at and --force are mutually exclusive"
    fi
    local target body
    target=$(_resolve_repo write "$repo_arg") || exit $?
    body=$(_read_body "$body_file") || exit $?   # #1136: a die in $( ) cannot abort us
    [[ -n "$body" ]] || die "empty body"
    if (( force == 1 )); then
        {
            printf 'ng comment-edit: --force — writing WITHOUT a concurrency precondition\n'
            printf '(last-writer-wins; a concurrent edit of comment %s would be clobbered).\n' "$cid"
        } >&2
        local resp url
        resp=$(jq -n --arg b "$body" '{body: $b}' \
               | api -X PATCH "/repos/$target/issues/comments/$cid" --input -) \
            || die "comment-edit: PATCH failed (id=$cid)"
        url=$(jq -r '.html_url // empty' <<<"$resp")
        [[ -n "$url" ]] || die "comment-edit: PATCH returned no html_url (id=$cid)"
        printf '%s\n' "$url"
        return 0
    fi
    if [[ -z "$expect" ]]; then
        die "comment-edit is compare-and-swap by design: pass --expect-updated-at <ts> (from \`ng show $cid --meta\`), or --force to deliberately clobber. Prefer \`ng reply\` (append) on contended threads."
    fi
    local url rc=0
    url=$(_comment_patch_cas "$target" "$cid" "$body" "$expect") || rc=$?
    (( rc == 0 )) || exit "$rc"
    printf '%s\n' "$url"
}

cmd_close() {
    _help_check "$@"
    local issue=""
    local comment="" repo_arg=""
    _argloop_prev_7=-1; while (( $# > 0 )); do (( $# != _argloop_prev_7 )) || _argloop_stuck "$1"; _argloop_prev_7=$#
        case "$1" in
            --comment) _need_val --comment "$#" "${2:-}"; comment="$2"; shift 2 ;;
            --repo)    _need_val --repo "$#" "${2:-}"; repo_arg="$2"; shift 2 ;;
            --*) die "unknown flag: $(_arg_excerpt "$1")" ;;
            *)  if [[ -z "$issue" ]]; then issue="$1"
                else die "unexpected POSITIONAL argument $(_arg_excerpt "$1"). Flags must start with --; positionals are matched in order."; fi
                shift ;;
        esac
    done
    [[ -n "$issue" ]] || die "usage: ng close <issue> [--comment <text>] [--repo <owner/name>]"
    # your-org/nexus-code#568 A4. `close` was the ONE write verb that neither
    # accepted `--repo` (its single-arm parser made it a hard error) nor passed
    # through `_resolve_repo` — so it hardcoded $REPO and, uniquely among the
    # write verbs, never emitted the issue-#108 cwd-mismatch refusal. Closing an
    # issue on another repo was impossible, and closing from inside a foreign
    # checkout silently targeted the nexus repo instead of refusing.
    local target
    target=$(_resolve_repo write "$repo_arg") || exit 1
    if [[ -n "$comment" ]]; then
        jq -n --arg b "$comment" '{body: $b}' \
            | api -X POST "/repos/$target/issues/$issue/comments" --input - >/dev/null \
            || die "pre-close comment failed"
    fi
    local state
    state=$(api -X PATCH "/repos/$target/issues/$issue" -f state=closed \
            | jq -r '.state // empty')
    [[ "$state" == "closed" ]] || die "close PATCH failed (state=$state)"
    printf 'CLOSED\n'
}

# ---------------------------------------------------------------------------
# ng close-set — bulk close with PER-ISSUE verification (your-org/nexus-code#1444)
#
#   ng close-set --bodies <dir> [--pr <N>] [--merge <sha>] [--repo <owner/name>]
#                [--dry-run] <issue>...
#
# Every bundle close on this board was a throwaway script, and the last one
# lied three ways in one run: a placeholder guard `grep -q '__'` that also
# matched `a__b` in an evidence table and silently SKIPPED an issue; `comm`
# over numerically-sorted lists (rc 1, empty diff, read as "nothing
# outstanding"); and `gh issue list --limit 300` used as the closed SET when
# it is a CREATION-DATE WINDOW that omitted #835 and #914. This verb encodes
# what those got wrong, per issue:
#   1. body from <dir>/<N>.md with __PR__ / __MERGE__ substituted; ANY remaining
#      `__[A-Z][A-Z_]*__` token refuses THAT issue (an exact placeholder token,
#      not a two-underscore substring);
#   2. post the comment as the bot, assert the author with assert-bot-author.sh
#      (absent verifier = NOT VERIFIED = that issue is not counted closed);
#   3. close with reason completed;
#   4. VERIFY by a direct per-issue read (`GET /repos/…/issues/N`), never a list;
#   5. print the CLOSED set and the NOT-CLOSED set explicitly — never a count
#      alone — and exit 1 when the NOT-CLOSED set is non-empty.
# Repair a named member; never re-run the posting loop (that duplicates
# comments): `--only-verify` re-reads state without posting anything.
cmd_close_set() {
    _help_check "$@"
    local bodies="" pr="" merge="" repo_arg="" dry=0 only_verify=0
    local -a issues=()
    _argloop_prev_cs=-1; while (( $# > 0 )); do (( $# != _argloop_prev_cs )) || _argloop_stuck "$1"; _argloop_prev_cs=$#
        case "$1" in
            --bodies) _need_val --bodies "$#" "${2:-}"; bodies="$2"; shift 2 ;;
            --pr)     _need_val --pr "$#" "${2:-}"; pr="$2"; shift 2 ;;
            --merge)  _need_val --merge "$#" "${2:-}"; merge="$2"; shift 2 ;;
            --repo)   _need_val --repo "$#" "${2:-}"; repo_arg="$2"; shift 2 ;;
            --dry-run) dry=1; shift ;;
            --only-verify) only_verify=1; shift ;;
            --*) die "unknown flag: $(_arg_excerpt "$1")" ;;
            *)  [[ "$1" =~ ^[0-9]+$ ]] || die "close-set: issue numbers only, got $(_arg_excerpt "$1")"
                issues+=("$1"); shift ;;
        esac
    done
    (( ${#issues[@]} > 0 )) || die "usage: ng close-set --bodies <dir> [--pr N] [--merge sha] [--repo o/r] [--dry-run|--only-verify] <issue>..."
    if (( only_verify == 0 )); then
        [[ -n "$bodies" && -d "$bodies" ]] || die "close-set: --bodies <dir> must be a directory holding <N>.md per issue"
    fi
    local target
    target=$(_resolve_repo write "$repo_arg") || exit 1
    local verifier="$_script_dir/assert-bot-author.sh"
    local -a closed=() notclosed=()
    local n body url author_ok state reason why
    for n in "${issues[@]}"; do
        why=""
        if (( only_verify == 0 )); then
            if [[ ! -r "$bodies/$n.md" ]]; then
                notclosed+=("$n"); printf 'ISSUE %s: NOT-CLOSED — no body file %s/%s.md\n' "$n" "$bodies" "$n"; continue
            fi
            body=$(sed -e "s/__PR__/${pr:-__PR__}/g" -e "s/__MERGE__/${merge:-__MERGE__}/g" "$bodies/$n.md")
            if grep -qE '__[A-Z][A-Z_]*__' <<<"$body"; then
                notclosed+=("$n"); printf 'ISSUE %s: NOT-CLOSED — unfilled placeholder token %s in the body (pass --pr/--merge)\n' "$n" "$(grep -oE '__[A-Z][A-Z_]*__' <<<"$body" | sort -u | tr '\n' ' ')"; continue
            fi
            if (( dry )); then
                printf 'ISSUE %s: DRY-RUN — would post %s bytes and close\n' "$n" "${#body}"; continue
            fi
            url=$(jq -n --arg b "$body" '{body: $b}' \
                  | api -X POST "/repos/$target/issues/$n/comments" --input - 2>/dev/null \
                  | jq -r '.html_url // empty') || url=""
            if [[ -z "$url" ]]; then
                notclosed+=("$n"); printf 'ISSUE %s: NOT-CLOSED — the comment POST returned no html_url\n' "$n"; continue
            fi
            if [[ -x "$verifier" ]]; then
                if ! "$verifier" "$url" >/dev/null 2>&1; then
                    notclosed+=("$n"); printf 'ISSUE %s: NOT-CLOSED — comment posted at %s but assert-bot-author.sh did NOT vouch for its author (an operator-authored write mutes the operator; repair by hand, do not re-post)\n' "$n" "$url"; continue
                fi
            else
                notclosed+=("$n"); printf 'ISSUE %s: NOT-CLOSED — comment posted at %s but %s is absent, so the author is NOT VERIFIED\n' "$n" "$url" "$verifier"; continue
            fi
            api -X PATCH "/repos/$target/issues/$n" -f state=closed -f state_reason=completed >/dev/null 2>&1 || true
        fi
        # VERIFY by a direct per-issue read — the only key that is the property.
        state=$(api "/repos/$target/issues/$n" 2>/dev/null | jq -r '.state // empty') || state=""
        if [[ "$state" == "closed" ]]; then
            closed+=("$n"); printf 'ISSUE %s: CLOSED (verified by direct read)\n' "$n"
        else
            notclosed+=("$n"); printf 'ISSUE %s: NOT-CLOSED — direct read says state=%s\n' "$n" "${state:-unreadable}"
        fi
    done
    printf 'CLOSED SET (%d): %s\n' "${#closed[@]}" "${closed[*]:-}"
    printf 'NOT-CLOSED SET (%d): %s\n' "${#notclosed[@]}" "${notclosed[*]:-}"
    if (( dry )); then printf 'DRY-RUN: nothing was posted or closed\n'; return 0; fi
    (( ${#notclosed[@]} == 0 ))
}

# ---------------------------------------------------------------------------
# ng stranded-branches — validated work that never got a PR (your-org/nexus-code#1399)
#
#   ng stranded-branches [--since <date>] [--base <ref>] [--with-prs] [--remote origin]
#
# 79 unmerged remote branches, 7 with a PR, and the skeptic-reviewed fix for
# #1320 among the other 72: no surface an orchestrator reads — open issues,
# live windows, open PRs, cross-reference events — can see a branch that was
# pushed and never PR'd. This enumerates them directly, cheap and with no
# false negatives: every `refs/remotes/<remote>/*` that is NOT an ancestor of
# the integration branch, with its last-commit date, commit count ahead and
# subject. `--with-prs` also asks GitHub (a READ) which of them have an open
# PR, so the un-PR'd residue is explicit. Always FETCH first — a negative
# claim about a repository is only as old as its last fetch.
cmd_stranded_branches() {
    _help_check "$@"
    local since="" base="" remote="origin" with_prs=0 repo_arg=""
    _argloop_prev_sb=-1; while (( $# > 0 )); do (( $# != _argloop_prev_sb )) || _argloop_stuck "$1"; _argloop_prev_sb=$#
        case "$1" in
            --since)  _need_val --since "$#" "${2:-}"; since="$2"; shift 2 ;;
            --base)   _need_val --base "$#" "${2:-}"; base="$2"; shift 2 ;;
            --remote) _need_val --remote "$#" "${2:-}"; remote="$2"; shift 2 ;;
            --repo)   _need_val --repo "$#" "${2:-}"; repo_arg="$2"; shift 2 ;;
            --with-prs) with_prs=1; shift ;;
            --*) die "unknown flag: $(_arg_excerpt "$1")" ;;
            *) die "unexpected argument $(_arg_excerpt "$1")" ;;
        esac
    done
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "stranded-branches: run inside a git checkout"
    git fetch -q "$remote" 2>/dev/null || printf 'WARNING: git fetch %s failed — the list below is only as fresh as the last successful fetch\n' "$remote" >&2
    if [[ -z "$base" ]]; then
        # `sed -n 1p`, not `| head -1`: a `head` can close the pipe early and,
        # under pipefail, invert the writer's status (early-exit-readers.sh).
        base=$(NEXUS_ROOT="${NEXUS_ROOT:-$_repo_root}" bash "$_script_dir/_integration_branch.sh" 2>/dev/null | sed -n 1p) || base=""
        [[ -n "$base" ]] || base=dev
    fi
    local base_ref="$remote/$base"
    git rev-parse --verify -q "$base_ref" >/dev/null || die "stranded-branches: no such ref $base_ref (pass --base)"
    local since_epoch=0
    if [[ -n "$since" ]]; then since_epoch=$(date -d "$since" +%s 2>/dev/null) || die "stranded-branches: --since must be a date"; fi
    local pr_heads="" pr_unknown=0
    if (( with_prs )); then
        local target; target=$(_resolve_repo read "$repo_arg") || exit 1
        # A failed read is NOT "no PRs": an empty list would mark every branch
        # pr=NONE, the silent-zero direction. Fail LOUD and print `pr=?`.
        if ! pr_heads=$(api "/repos/$target/pulls?state=open&per_page=100" --paginate 2>/dev/null | jq -r '.[].head.ref' 2>/dev/null); then
            pr_unknown=1; pr_heads=""
            printf 'WARNING: could not list open PRs on %s — the pr column reads ? (unknown), not NONE\n' "$target" >&2
        fi
    fi
    printf 'base: %s @ %s\n' "$base_ref" "$(git rev-parse --short "$base_ref")"
    local b n_ahead ts subj short pr_col total=0 unprd=0
    while IFS= read -r b; do
        [[ -n "$b" ]] || continue
        [[ "$b" == "$base_ref" || "$b" == "$remote/HEAD" ]] && continue
        git merge-base --is-ancestor "$b" "$base_ref" 2>/dev/null && continue
        ts=$(git log -1 --format=%ct "$b" 2>/dev/null) || ts=0
        (( ts >= since_epoch )) || continue
        n_ahead=$(git rev-list --count "$base_ref".."$b" 2>/dev/null) || n_ahead='?'
        subj=$(git log -1 --format=%s "$b" 2>/dev/null)
        short="${b#"$remote"/}"
        pr_col=""
        if (( with_prs )); then
            if (( pr_unknown )); then pr_col="pr=?"
            elif grep -qxF -- "$short" <<<"$pr_heads"; then pr_col="pr=open"; else pr_col="pr=NONE"; unprd=$(( unprd + 1 )); fi
        fi
        total=$(( total + 1 ))
        printf '%s\t%s ahead\t%s\t%s\t%s\n' "$short" "$n_ahead" "$(date -d "@$ts" +%F 2>/dev/null)" "${pr_col:--}" "$subj"
    done < <(git for-each-ref --format='%(refname:short)' "refs/remotes/$remote" 2>/dev/null)
    printf 'stranded: %d branch(es) ahead of %s' "$total" "$base_ref"
    (( with_prs )) && printf '; %d with NO open PR' "$unprd"
    printf '  [fetched %s just now; a branch listed here is work nothing else reads]\n' "$remote"
    return 0
}

cmd_upload() {
    _help_check "$@"
    (( $# > 0 )) || die "usage: ng upload <local-path> [--issue N] [--repo-path <path>] [--shape pin|latest] [--message <msg>]"
    exec "$_script_dir/upload-asset.sh" "$@"
}

# Best-effort session-id capture for `ng report-init` frontmatter.
# Layers in priority order:
#   0. $CLAUDE_CODE_SESSION_ID — the env var Claude Code exports into
#      every Bash tool call, naming the CALLER's own session
#      authoritatively. This is the only source that can't misattribute:
#      it is the running session, not "whatever wrote most recently in
#      some project dir". Issue #203: the freshest-jsonl heuristic below
#      stamped two workers' reports with the ORCHESTRATOR's pinned sid
#      (the workers ran `ng report-init` from the orchestrator's cwd, so
#      layer 2 picked the orchestrator's actively-written jsonl). That
#      breaks crash-resume, which keys off the report's session-id.
#   1. $CLAUDE_PROJECT_DIR/sessions/current_session_id — Claude Code
#      writes this when it knows; cheap and reliable.
#   2. Most-recently-modified ~/.claude/projects/<cwd-slug>/<uuid>.jsonl
#      where <cwd-slug> mirrors Claude Code's path normalisation:
#      every non-alphanumeric character (including '/' AND '_') becomes
#      '-', and the leading '-' from a leading '/' is preserved.
#      e.g. /shared/your-lab-m/user/operator/nexus → -shared-your-lab-m-user-your-nexus.
#      LAST-RESORT ONLY: freshest-jsonl is a heuristic, not the caller.
#   3. Fallback: scan ~/.claude/projects/ for any project dir whose name
#      contains the slugified cwd tail; pick the most-recently-modified.
#      A stderr warning fires so future divergences in Claude Code's
#      slug rule are visible.
#   4. Empty string — caller substitutes "unknown".
_report_session_id() {
    # Layer 0: the caller's own session, straight from Claude Code.
    if [[ -n "${CLAUDE_CODE_SESSION_ID:-}" ]]; then
        local env_sid="${CLAUDE_CODE_SESSION_ID//[$'\n\r\t ']/}"
        if [[ "$env_sid" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
            printf '%s' "$env_sid"
            return 0
        fi
    fi
    if [[ -n "${CLAUDE_PROJECT_DIR:-}" && -f "$CLAUDE_PROJECT_DIR/sessions/current_session_id" ]]; then
        local sid
        sid=$(<"$CLAUDE_PROJECT_DIR/sessions/current_session_id")
        sid="${sid//[$'\n\r\t ']/}"
        if [[ -n "$sid" ]]; then
            printf '%s' "$sid"
            return 0
        fi
    fi
    local cwd cwd_slug latest projects_dir
    cwd=$(pwd)
    cwd_slug=$(printf '%s' "$cwd" | sed 's|[^a-zA-Z0-9]|-|g')
    projects_dir="$HOME/.claude/projects"
    if [[ -d "$projects_dir/$cwd_slug" ]]; then
        latest=$(ls -t "$projects_dir/$cwd_slug"/*.jsonl 2>/dev/null | head -1)
        [[ -n "$latest" ]] && { basename -s .jsonl "$latest"; return 0; }
    fi
    # Fallback: cwd-tail substring match. Slugify the tail so dirs
    # under work/<project_with_underscores> still resolve.
    [[ -d "$projects_dir" ]] || return 0
    local tail tail_slug match
    tail="${cwd##*/}"
    tail_slug=$(printf '%s' "$tail" | sed 's|[^a-zA-Z0-9]|-|g')
    [[ -n "$tail_slug" ]] || return 0
    match=$(ls -t -d "$projects_dir"/*"$tail_slug"* 2>/dev/null | head -1)
    [[ -n "$match" && -d "$match" ]] || return 0
    echo "ng: warning: session-id slug '$cwd_slug' not found; falling back to '$(basename "$match")' (Claude Code's slug rule may have changed)" >&2
    latest=$(ls -t "$match"/*.jsonl 2>/dev/null | head -1)
    [[ -n "$latest" ]] && basename -s .jsonl "$latest"
}

# Resolve the tmux window the verb was invoked from. Empty when the
# caller isn't inside a tmux session.
#
# Target by $TMUX_PANE explicitly. Without `-t`, `tmux display-message`
# returns the ACTIVE window of the session — wrong when the verb runs
# in a non-active worker window (the orchestrator's window is active,
# the worker's isn't, and the report-init / wrap-up calls happen in
# the worker's pane). $TMUX_PANE is set by tmux for every pane and
# gives an unambiguous pane id (e.g. %110) for -t.
_report_tmux_window() {
    [[ -n "${TMUX:-}" ]] || return 0
    command -v tmux >/dev/null 2>&1 || return 0
    if [[ -n "${TMUX_PANE:-}" ]]; then
        tmux display-message -p -t "$TMUX_PANE" '#{window_name}' 2>/dev/null
    else
        tmux display-message -p '#{window_name}' 2>/dev/null
    fi
}

# Resolve a project slug for the report filename / frontmatter:
#   1. Explicit value (arg 1, may be empty).
#   2. The current `work/<project>` parent if cwd is inside one.
#   3. The literal "nexus" (workspace-level work).
#
# Issue #95 / #236 B4: when cwd is outside work/<project> AND the
# caller is a spawned worker (NEXUS_WORKER_WINDOW set by
# spawn-worker.sh), INFER the project from the window name instead of
# defaulting to the generic "nexus" and nagging. A worker that runs
# `ng report-init` from outside its worktree (e.g. inheriting the
# orchestrator's cwd) used to silently ship a `project=nexus`
# misattributed stub; the prior warning-then-write was the worst of
# both worlds — it still wrote the wrong stub and trained operators to
# ignore a false-positive warning. The window name is a worker-specific
# attribution that ties the report to its task. The orchestrator
# (NEXUS_WORKER_WINDOW unset) still resolves to "nexus" for genuine
# workspace-level work, and an explicit `--project nexus` always wins
# for cross-project worker reports.
_report_project_slug() {
    local explicit="${1:-}"
    if [[ -n "$explicit" ]]; then
        printf '%s' "$explicit"
        return 0
    fi
    # Fork-free by construction (your-org/nexus-code#638). The old body
    # forked `$(pwd)` and `printf|sed` on the report-init hot path; under
    # jobs-4 fork/RLIMIT_NPROC pressure either subprocess can fail, and a
    # failed `sed` yields an EMPTY slug (or a failed `pwd` falls through to
    # the literal `nexus`) — silently, with the verb still exiting 0. A
    # report then lands misattributed (`reports/_<date>_<slug>.md`) or
    # under the wrong project, which is exactly this workspace's dominant
    # defect class (silence used as correctness). $PWD is a bash builtin
    # var and the `${var##.../work/}` / `${var%%/*}` expansions are
    # pure-builtin, so this derivation cannot fail under fork pressure.
    local cwd="$PWD"
    if [[ "$cwd" == */work/* ]]; then
        # everything after the LAST `/work/`, then its first segment —
        # equivalent to the greedy `sed 's|.*/work/([^/]+).*|\1|'`.
        local after="${cwd##*/work/}"
        printf '%s' "${after%%/*}"
        return 0
    fi
    if [[ -n "${NEXUS_WORKER_WINDOW:-}" ]]; then
        # Never trust an env value verbatim in a filename: sanitize to
        # the slug charset and strip leading/trailing separators. Window
        # names are kebab-case already, so this is belt-and-suspenders.
        local wslug="${NEXUS_WORKER_WINDOW//[^A-Za-z0-9._-]/-}"
        wslug="${wslug#-}"; wslug="${wslug%-}"
        if [[ -n "$wslug" ]]; then
            printf '%s' "$wslug"
            return 0
        fi
    fi
    printf 'nexus'
}

# The PRIMARY nexus root — the one whose `reports/` is THE corpus.
#
# your-org/nexus-code#577 / #1077. The primary-root resolver used to live here
# as a private copy. It now lives in `monitor/_nexus-root.sh` and is sourced
# above, because `upload-asset.sh` needs the SAME answer and used to compute its
# own — rooting at its script location and never reading $NEXUS_ROOT, which is
# how a secondary clone's asset write landed inside the clone and destroyed the
# enclosing checkout (#1077). `_nexus_primary_root` is kept as the in-`ng` name
# so the call sites below read unchanged; the body is the shared function.
_nexus_primary_root() { nexus_primary_root "$@"; }

# The canonical corpus dir (`<primary>/reports`), or empty when it cannot be
# determined. Used both to RESOLVE a default and to JUDGE an explicit target.
_report_corpus_dir() {
    local root=""
    if [[ -n "${NEXUS_ROOT:-}" ]]; then
        root=$(_nexus_primary_root "$NEXUS_ROOT") || root=""
    fi
    if [[ -z "$root" ]]; then
        local cfg_root
        cfg_root=$("$_cfg" nexus.root 2>/dev/null) || cfg_root=""
        # Reject the example-template placeholder (see _nexus_primary_root).
        [[ -n "$cfg_root" && -d "$cfg_root" && "$cfg_root" != "/path/to/nexus" ]] \
            && root=$(_nexus_primary_root "$cfg_root")
    fi
    [[ -n "$root" ]] || return 0
    printf '%s/reports' "$root"
}

# Resolve the reports-dir for `ng report-init`:
#   1. Explicit --reports-dir.
#   2. The CORPUS — `<primary-root>/reports`, where the primary root is
#      $NEXUS_ROOT de-nested out of any `work/<clone>` it may point at
#      (your-org/nexus-code#577). Created if absent, so a fresh primary
#      clone does not silently fall through to a secondary's reports/.
#   3. Walk up from cwd looking for a `reports/` sibling — the
#      first such directory wins (handles workers in `work/<project>`
#      whose nexus root is two levels up).
#   4. `pwd/reports` (will be created).
_report_reports_dir() {
    local explicit="${1:-}"
    if [[ -n "$explicit" ]]; then
        printf '%s' "$explicit"
        return 0
    fi
    # The corpus wins over both the raw $NEXUS_ROOT/reports and the cwd walk-up.
    # Note the `-d` test is on the primary ROOT, not on `<root>/reports`: the
    # corpus dir is created on demand (mkdir below), so an as-yet-unpopulated
    # primary can never lose to a secondary clone that happens to have one.
    local corpus
    corpus=$(_report_corpus_dir)
    if [[ -n "$corpus" ]]; then
        printf '%s' "$corpus"
        return 0
    fi
    # Last resort: walk up from cwd. Run whatever tree that finds through the
    # same de-nesting rule (#577) — otherwise a worker with NEXUS_ROOT unset,
    # sitting in a secondary clone that has its own `reports/`, still writes into
    # the clone. This is the one remaining path by which a report could land
    # outside the corpus, so it gets the same structural correction rather than
    # only a warning.
    local d p
    d=$(pwd)
    while [[ "$d" != / && -n "$d" ]]; do
        if [[ -d "$d/reports" ]]; then
            p=$(_nexus_primary_root "$d")
            if [[ -n "$p" && "$p" != "$d" ]]; then
                printf '%s/reports' "$p"
            else
                printf '%s' "$d/reports"
            fi
            return 0
        fi
        d=$(dirname "$d")
    done
    printf '%s/reports' "$(pwd)"
}

# `ng report-init <slug> [--project N] [--issue N] [--comment-id ID] [--reports-dir P]`
#
# Writes a frontmatter'd report skeleton at the canonical path
# `<reports-dir>/<project>_<YYYY-MM-DD>_<HHMMSS>_<slug>.md`.
# Captures session-id and tmux window automatically. Prints the
# absolute path on stdout so the worker can `Write`/`Edit` against
# it directly.
#
# The frontmatter schema is enforced by `ng report-check`; both
# verbs read the same set of required fields.
cmd_report_init() {
    _help_check "$@"
    local slug=""
    local project_arg="" issue_arg="" comment_id_arg="" reports_dir_arg=""
    _argloop_prev_8=-1; while (( $# > 0 )); do (( $# != _argloop_prev_8 )) || _argloop_stuck "$1"; _argloop_prev_8=$#
        case "$1" in
            --project)     _need_val --project "$#" "${2:-}"; project_arg="$2";     shift 2 ;;
            --issue)       _need_val --issue "$#" "${2:-}"; issue_arg="$2";       shift 2 ;;
            --comment-id)  _need_val --comment-id "$#" "${2:-}"; comment_id_arg="$2";  shift 2 ;;
            --reports-dir) _need_val --reports-dir "$#" "${2:-}"; reports_dir_arg="$2"; shift 2 ;;
            --repo)
                # Structured rejection: reports/ centralization is
                # intentional, so silently accepting --repo (and
                # ignoring it, or routing the report somewhere else)
                # would be worse than a bare "unknown flag". Spell
                # out the reason here once instead of making every
                # confused operator re-derive it.
                cat >&2 <<'EOF'
ng: report-init does not accept --repo
  reports/ is always written under $NEXUS_ROOT (the primary
  clone), regardless of which worktree or secondary clone the
  worker is running from. This is intentional — centralized
  reports survive worktree cleanup.
  See `monitor/ng` top-of-file usage block for the full flag set.
EOF
                exit 1
                ;;
            --*) die "unknown flag: $(_arg_excerpt "$1")" ;;
            *)  if [[ -z "$slug" ]]; then slug="$1"
                else die "unexpected POSITIONAL argument $(_arg_excerpt "$1"). Flags must start with --; positionals are matched in order."; fi
                shift ;;
        esac
    done
    [[ -n "$slug" ]] || die "usage: ng report-init <slug> [--project <name>] [--issue <#>] [--comment-id <id>] [--reports-dir <path>] [--skeptic-role]"

    # Reject a numeric / leading-digit explicit --project. It lands
    # verbatim in both the filename and the YAML frontmatter, where
    # `project: 34` parses as an integer and the report misattributes to
    # a non-existent "34" project — operators have passed an issue
    # number here by mistake (#236 B4). Only the EXPLICIT arg is
    # validated; the cwd-/window-derived slugs are orchestrator-
    # controlled and trusted.
    if [[ -n "$project_arg" && ! "$project_arg" =~ ^[A-Za-z][A-Za-z0-9._-]*$ ]]; then
        die "report-init: --project must start with a letter and contain only [A-Za-z0-9._-] (got: '$project_arg') — pass a project name, not an issue number"
    fi

    local project reports_dir session_id window trigger
    project=$(_report_project_slug "$project_arg")
    # Backstop for the one remaining fork on this path — the command
    # substitution above (your-org/nexus-code#638). _report_project_slug is
    # now internally fork-free and always yields a non-empty slug by
    # design, so an empty result here means the substitution itself was
    # starved (fork/RLIMIT_NPROC pressure). Refuse loudly rather than write
    # a misattributed `reports/_<date>_<slug>.md`: a signal that cannot be
    # trusted must not silently pick a value.
    [[ -n "$project" ]] || die "report-init: could not derive a project slug (resource pressure?) — retry, or pass --project <name> explicitly"
    reports_dir=$(_report_reports_dir "$reports_dir_arg")
    session_id=$(_report_session_id)
    [[ -n "$session_id" ]] || session_id="unknown"
    window=$(_report_tmux_window)
    [[ -n "$window" ]] || window="<unset>"
    if [[ -n "$issue_arg" ]]; then
        if [[ -n "$comment_id_arg" ]]; then
            trigger="#${issue_arg} (comment ${comment_id_arg})"
        else
            trigger="#${issue_arg}"
        fi
    else
        trigger="<unset>"
    fi

    # Loudly flag a write OUTSIDE the corpus (your-org/nexus-code#577). A report
    # that lands in a secondary clone's own `reports/` is invisible to every
    # consumer that reads the corpus — skeptic verdict-detection,
    # `ng wrap-up-check`, `spawn-worker -r` resume discovery — and the #577
    # incident is exactly that: a completed skeptic's verdict sat in
    # `work/<clone>/reports/`, so the window it validated could never be retired
    # by the sanctioned path, leaving only a hand-clear of the marker that exists
    # to prevent hand-clearing.
    #
    # The DEFAULT resolution above is now structurally corpus-pinned (both the
    # $NEXUS_ROOT branch and the cwd walk-up de-nest through
    # _nexus_primary_root), so a worker can no longer drift out by accident. What
    # remains reachable is an explicit `--reports-dir`, which is a deliberate
    # choice (tests, one-off exports) and so warns rather than refuses — the
    # message names the corpus, making the fix a copy-paste.
    local corpus_dir
    corpus_dir=$(_report_corpus_dir)
    if [[ -n "$corpus_dir" ]]; then
        local rd_rp cp_rp
        rd_rp=$(cd "$reports_dir" 2>/dev/null && pwd -P) || rd_rp="$reports_dir"
        cp_rp=$(cd "$corpus_dir" 2>/dev/null && pwd -P) || cp_rp="$corpus_dir"
        if [[ "$rd_rp" != "$cp_rp" ]]; then
            cat >&2 <<EOF
ng report-init: WARNING — writing OUTSIDE the reports corpus.
  target: $(_arg_excerpt "$reports_dir")
  corpus: $corpus_dir
  A report outside the corpus is invisible to skeptic verdict-detection,
  \`ng wrap-up-check\` and resume discovery (your-org/nexus-code#577).
  Proceeding${reports_dir_arg:+ because --reports-dir was given explicitly}.
EOF
        fi
    fi

    mkdir -p "$reports_dir" || die "report-init: could not create reports dir: $reports_dir"

    local date_part time_part path
    date_part=$(date +%Y-%m-%d)
    time_part=$(date +%H%M%S)
    path="${reports_dir}/${project}_${date_part}_${time_part}_${slug}.md"
    [[ ! -e "$path" ]] || die "report-init: refusing to overwrite existing file: $path"

    # The skeleton intentionally uses `_(fill in)_` for body placeholders
    # instead of literal TODO/FIXME so a worker who runs the skeleton
    # through `report-check` immediately gets actionable failures rather
    # than a generic placeholder flag.
    #
    # `disposition: TODO` IS THE ONE DELIBERATE EXCEPTION TO THAT RULE
    # (your-org/nexus-code#1095 item 2). The field was optional, so
    # `report-init` MANUFACTURED its absence: every report was in the
    # escalating state from the moment it was created, and one of the
    # depth-2 escalations recorded on #1095 fired off a bare skeleton whose
    # Summary was still the placeholder. Emitting the key makes the omission
    # VISIBLE rather than silent — an absent field and a field that could
    # not be written are identical, which is what made the inference from
    # absence unfalsifiable.
    #
    # It needs NO new validation and deliberately adds none. Measured at
    # this ref: `_skeptic_stated_disposition` classifies `disposition: TODO`
    # as `unreadable frontmatter value-not-a-token`, and #836's existing
    # write-time gate in `cmd_report_check` already refuses that with a
    # message naming the field AND its line number. So the sentinel fails
    # loudly through machinery that was already here; a second parser is
    # exactly what #855 says not to add.
    #
    # RETROSPECTIVE BLAST RADIUS IS ZERO, and that is why this half ships
    # while a `report-check` presence requirement does not. This changes
    # only reports created from here on, whose authors are present by
    # construction. Requiring the field of reports that already exist would
    # refuse 256 of the 677 in the live corpus (2026-09-01).
    cat > "$path" <<EOF
---
project: ${project}
date: ${date_part}
session-id: ${session_id}
window: ${window}
trigger: ${trigger}
status: partial
disposition: TODO
---

# ${slug}

## Summary

_(one or two sentences — ng wrap-up quotes this into the link comment)_

## What Was Done

_(fill in)_

## Current State

_(fill in)_

## What Remains

_(fill in)_

## How to Resume

_(fill in)_
EOF

    printf '%s\n' "$path"
}

# `ng report-check <path> [--allow-todo]`
#
# Validates a report against the schema in `nexus.report`:
#   - YAML-style frontmatter delimited by `---` lines, with required
#     fields {project, date, session-id, status}.
#   - All five canonical sections present (## Summary, ## What Was
#     Done, ## Current State, ## What Remains, ## How to Resume).
#   - Body length ≥ monitor.report_min_chars (default 500).
#   - No literal `TODO`, `FIXME`, `<...>`, or `_(fill in)_`
#     placeholder text — unless `--allow-todo` is passed for
#     intentional in-progress checkpoints.
#
# Exit codes:
#   0  complete
#   1  incomplete (specifics on stderr)
#   2  file missing or unreadable
# _wrapup_dispositions <report> — the `## Dispositions` section as
# `issue<TAB>kind<TAB>text` rows, one per bullet (your-org/nexus-code#1352).
# Bullet grammar, one per line:  `- #N — KIND — text`  (or `owner/repo#N`).
# KIND is one of the three the issue names: ALREADY-ADDRESSED (name the
# fixing commit), VOID-AS-WRITTEN (give the re-derived numbers),
# GENUINELY-OPEN (state the residual). A bullet that does not parse is
# printed as `?<TAB>MALFORMED<TAB><line>` so report-check can refuse it —
# a disposition that will never be published is worse than none, because
# the report then becomes the authority for what is on the issue.
_wrapup_dispositions() {
    local f="$1"
    [[ -r "$f" ]] || return 1
    awk '
        /^## Dispositions[[:space:]]*$/ { in_s=1; next }
        in_s && /^## / { in_s=0 }
        in_s && /^[[:space:]]*-[[:space:]]/ {
            line=$0; sub(/^[[:space:]]*-[[:space:]]+/, "", line)
            if (match(line, /^([A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+)?#[0-9]+[[:space:]]+(—|--|-)[[:space:]]+(ALREADY-ADDRESSED|VOID-AS-WRITTEN|GENUINELY-OPEN)[[:space:]]+(—|--|-)[[:space:]]+.+/)) {
                ref=line; sub(/[[:space:]].*/, "", ref)
                rest=line; sub(/^[^[:space:]]+[[:space:]]+(—|--|-)[[:space:]]+/, "", rest)
                kind=rest; sub(/[[:space:]].*/, "", kind)
                text=rest; sub(/^[^[:space:]]+[[:space:]]+(—|--|-)[[:space:]]+/, "", text)
                printf "%s\t%s\t%s\n", ref, kind, text
            } else {
                printf "?\tMALFORMED\t%s\n", line
            }
        }
    ' "$f"
}

cmd_report_check() {
    _help_check "$@"
    local path=""
    local allow_todo=0
    # your-org/nexus-code#1363 — set by `ng wrap-up` when THAT wrap-up settles
    # the skeptic gate (`--skeptic-waive` / `--skeptic-satisfied`); it skips
    # only the disposition-vs-gate cross-check below. Not an escape hatch for
    # authors: the check it skips fires again at wrap-up unless the wrap-up
    # is the settlement.
    local gate_settling=0
    _argloop_prev_9=-1; while (( $# > 0 )); do (( $# != _argloop_prev_9 )) || _argloop_stuck "$1"; _argloop_prev_9=$#
        case "$1" in
            --allow-todo) allow_todo=1; shift ;;
            --skeptic-gate-settling) gate_settling=1; shift ;;
            --*) die "unknown flag: $(_arg_excerpt "$1")" ;;
            *)  if [[ -z "$path" ]]; then path="$1"
                else die "unexpected POSITIONAL argument $(_arg_excerpt "$1"). Flags must start with --; positionals are matched in order."; fi
                shift ;;
        esac
    done
    [[ -n "$path" ]] || die "usage: ng report-check <path> [--allow-todo] [--skeptic-gate-settling]"

    if [[ ! -f "$path" || ! -r "$path" ]]; then
        echo "ng report-check: file missing or unreadable: $(_arg_excerpt "$path")" >&2
        return 2
    fi

    local min_chars
    min_chars=$("$_cfg" monitor.report_min_chars 500 2>/dev/null || echo 500)
    [[ "$min_chars" =~ ^[0-9]+$ ]] || min_chars=500
    if [[ -n "${MONITOR_REPORT_MIN_CHARS:-}" && "${MONITOR_REPORT_MIN_CHARS}" =~ ^[0-9]+$ ]]; then
        min_chars="${MONITOR_REPORT_MIN_CHARS}"
    fi

    local -a missing=()

    # `## Dispositions` (your-org/nexus-code#1352): when present, every bullet
    # must parse — `- #N — KIND — text` with KIND in ALREADY-ADDRESSED |
    # VOID-AS-WRITTEN | GENUINELY-OPEN. wrap-up PUBLISHES these per issue and
    # reads each back; a bullet that cannot be published is refused here,
    # before the report becomes the only place the disposition lives.
    if grep -qE '^## Dispositions[[:space:]]*$' "$path"; then
        local _dl
        while IFS=$'\t' read -r _dref _dkind _dtext; do
            [[ "$_dkind" == MALFORMED ]] || continue
            missing+=("dispositions: bullet does not parse as '- #N — ALREADY-ADDRESSED|VOID-AS-WRITTEN|GENUINELY-OPEN — text': ${_dtext:0:80}")
        done < <(_wrapup_dispositions "$path")
    fi

    # Frontmatter: file must start with `---` line, frontmatter ends
    # at the next `---` line. The awk extracts the YAML body.
    #
    # Deliberately NOT on _fm_lib.sh:_fm_get: this verb VALIDATES the
    # canonical writer form (`ng report-init`'s exact shape — bare `---`
    # fences, `key: value` with a space and a non-empty value), so the
    # strict fence match and the `^key:[[:space:]]+[^[:space:]]` presence
    # greps below ARE the contract being enforced. The lenient shared
    # reader is for CONSUMING frontmatter (spawn-worker, channels);
    # using it here would blur what this validator accepts.
    local first_line
    first_line=$(head -n1 "$path")
    if [[ "$first_line" != "---" ]]; then
        missing+=("frontmatter: file must start with a '---' line")
    fi
    local fm
    fm=$(awk 'NR==1 && /^---$/{flag=1; next} flag && /^---$/{exit} flag' "$path")
    if [[ -n "$fm" ]]; then
        local key
        for key in project date session-id status; do
            if ! grep -qE "^${key}:[[:space:]]+[^[:space:]]" <<<"$fm"; then
                missing+=("frontmatter field: ${key}")
            fi
        done
        # session-id must not be literal "unknown" — that means the
        # capture heuristics failed and the report can't be resumed.
        if grep -qE '^session-id:[[:space:]]+unknown[[:space:]]*$' <<<"$fm"; then
            missing+=("frontmatter field: session-id (resolved to 'unknown'; set explicitly or fix capture)")
        fi
        # status must be one of the canonical values. Reads the
        # already-captured strict-form $fm string, not the file, so it
        # stays on the same strict parse as the checks above (see the
        # _fm_lib.sh note at the frontmatter extraction).
        if grep -qE '^status:[[:space:]]' <<<"$fm"; then
            local status
            status=$(awk -F': *' '/^status:/{print $2; exit}' <<<"$fm" | tr -d ' \t')
            case "$status" in
                completed|partial|blocked) ;;
                *) missing+=("frontmatter field: status (must be completed|partial|blocked, got '${status}')") ;;
            esac
        fi
        # `fanout:` is OPTIONAL (an absent field is not an authoring error,
        # #684) but when present it must be the one shape `ng wrap-up` reads
        # (your-org/nexus-code#1140): `<N> spawned / <M> returned`, M <= N.
        if grep -qE '^fanout:' <<<"$fm"; then
            local fanout
            fanout=$(awk -F': *' '/^fanout:/{sub(/^fanout: */, ""); print; exit}' <<<"$fm")
            if [[ "$fanout" =~ ^([0-9]+)[[:space:]]+spawned[[:space:]]*/[[:space:]]*([0-9]+)[[:space:]]+returned$ ]]; then
                (( BASH_REMATCH[2] > BASH_REMATCH[1] )) \
                    && missing+=("frontmatter field: fanout (returned ${BASH_REMATCH[2]} exceeds spawned ${BASH_REMATCH[1]})")
            else
                missing+=("frontmatter field: fanout (must be '<N> spawned / <M> returned', got '${fanout}')")
            fi
        fi
        # ── `disposition:` — VALIDATED AT WRITE TIME (your-org/nexus-code#836)
        #
        # The read-time validator in `wrap-up --skeptic-role` is a REACHABILITY
        # INVERSION: it sits behind a findings-count arm that short-circuits
        # first, so it is unreachable for a skeptic that under-reports (or
        # omits) `--skeptic-findings` and reachable only for one that reports
        # honestly. It checks the passes that need checking least, and the
        # honest pass is the one exposed to the failure.
        #
        # `report-check` sees the frontmatter UNCONDITIONALLY — it does not
        # depend on which flags `wrap-up` is later handed, or on any count the
        # author supplies — so this is where the check cannot be routed around.
        # It also fires while the AUTHOR IS STILL PRESENT and can fix it,
        # instead of at hand-off, where the failure mode is fail-OPEN into an
        # auto-filed second-pass request nobody asked for. Four of eleven
        # declined skeptic requests on 2026-08-08 came from that path.
        #
        # THE SAME PARSER, deliberately. A hand-rolled enumeration here would
        # drift from `_skeptic_stated_disposition` and then confidently accept
        # a value wrap-up rejects — two validators disagreeing about one field
        # is the defect class this repo keeps paying for. Whatever that parser
        # can read, this accepts; what it calls `unreadable`, this refuses.
        #
        # ONLY a value the author actually WROTE is judged. A report with no
        # `disposition:` line is untouched (most reports are not skeptic
        # reports), and prose inference is not second-guessed here — an
        # absent field is a different state from an unreadable one (`#684`)
        # and only the latter is an authoring error.
        #
        # MEASURED, because the enumeration is narrower than people believe:
        # `no-further-pass` and `second-pass` are the ONLY values that parse.
        # `merge` does NOT — it returns `unreadable` exactly like `credible`
        # and `revise`, both of which cost a hand-off on this board. Guidance
        # circulating that night named `merge` as legal; it is not. That a
        # value can be believed legal by the people who own the protocol is
        # the whole argument for validating where the author can see it.
        # THE PRESENCE TEST IS THE PARSER'S TOO — not a hand-rolled proxy in
        # front of it (your-org/nexus-code#836, residual).
        #
        # This check used to be gated on a hand-rolled `grep -qE` for a
        # line-anchored, lowercase, space-after-colon `disposition` field
        # (the literal is deliberately NOT reproduced here: the suite greps
        # this function for it to prove the gate is gone, and a copy in a
        # comment would satisfy that grep and silently retire the assertion)
        # against the STRICT frontmatter string. That gate is a second, weaker
        # copy of a question the parser already answers, and it drifted from it
        # immediately — which is the exact failure the paragraph above says it
        # was avoiding. Delegating the VALUE test while hand-rolling the
        # PRESENCE test leaves the same two-validators-disagreeing defect, one
        # level up: the enumeration no longer drifts, the reachable SET does.
        #
        # MEASURED at a91f82b, 14 spellings of an illegal value. The gate saw
        # 3 of them. The parser called all 14 unreadable:
        #
        #   disposition: merge            gate FIRES   -> refused (rc 1)
        #   Disposition: merge            gate MISSES  -> accepted (rc 0)
        #   disposition:merge             gate MISSES  -> accepted (rc 0)
        #   **Disposition: merge**        gate MISSES  -> accepted (rc 0)
        #     disposition: merge          gate MISSES  -> accepted (rc 0)
        #   *Disposition*: merge          gate MISSES  -> accepted (rc 0)
        #   DISPOSITION: merge            gate MISSES  -> accepted (rc 0)
        #
        # and the whole BODY surface was invisible, because the gate read only
        # `$fm`, while the parser scans frontmatter FIRST and then falls back to
        # the body. The body form `**Verdict: check. Disposition: merge.**` is
        # not exotic: this parser's own source records that 6 of 6 real skeptic
        # reports state the field in that same-line bolded shape.
        #
        # Every accepted row above then reproduces #836 VERBATIM downstream —
        # confirmed by driving `_wrapup_skeptic_step` against such a report:
        # `--skeptic-findings 0` terminates the chain having never evaluated the
        # disposition, and an honest count escalates with "YOUR DISPOSITION WAS
        # NOT READ" into a spurious second-pass request. That is the inversion
        # the write-time check exists to remove, surviving inside the fix for it.
        #
        # So ask the parser and gate on its ANSWER. Whatever it can read, this
        # accepts; what it calls `unreadable`, this refuses — with ONE deliberate
        # exception, stated here rather than only where it is implemented: a
        # markdown HEADING in the BODY is not treated as a field statement. That
        # carve-out and its justification are ~80 lines below, at the loop that
        # reads the authority's heading flag; it is a POLICY disagreement with the
        # parser, not a second parse. Naming it here because a headline claim of
        # "wherever it saw it" with the exception disclosed 80 lines later in
        # different vocabulary is an undeclared boundary — which is the defect
        # class this whole check exists to remove (skeptic Finding 2 on #855).
        #
        # SOURCE-SCOPED, deliberately. Only the two FIELD scans (`frontmatter`,
        # `body`) mean "the author wrote a field we could not read", which is an
        # authoring error and is what this refuses. `prose` is the inference
        # fallback — second-guessing it here would fail reports that merely
        # DISCUSS the protocol in prose, and #840's contract already says prose
        # inference is not judged at write time. `none` is the parser declining
        # to run at all (no path / unreadable file), which report-check has
        # already diagnosed above and must not double-report.
        #
        # A MARKDOWN HEADING IS NOT A FIELD STATEMENT, and this is the one place
        # the widened set had to be narrowed back. Census over 2,614 corpus
        # reports: widening to the parser's full surface newly refuses exactly
        # 2 files. One is a real defect —
        #     Disposition: no-further-pass. Fixes landed in `ff678db`.
        # a legal token with same-line commentary, which the parser bounds only
        # at a closing `**`, so it reads as one non-token string and fails OPEN
        # at wrap-up. That is #836 in the corpus and refusing it is the point.
        # The other is NOT —
        #     ### Disposition: fix at source (one-line surgical change)
        # an ordinary-English section title in a non-skeptic report, where the
        # word carries its normal sense. `structural_only` strips `#` as
        # structure, so the parser reads a HEADING as a stated field; report-check
        # deliberately does not refuse on that, because telling an ordinary
        # worker to rewrite a section title as `no-further-pass` is nonsense.
        #
        # The parser reading a heading as a governing field is a READ-TIME
        # defect in its own right (it degrades `ng skeptic-disposition`, hence
        # retire-preflight, `#813`) — but fixing it there changes what wrap-up
        # and the retire gate see, which needs its own evidence and its own
        # blast-radius argument. Scoped out here and reported, not silently
        # absorbed into a lint.
        #
        # So: refuse only when a NON-HEADING candidate line exists. Conservative
        # in the right direction — a report whose only disposition-shaped line
        # is a heading is left alone.
        # THE LINE LOCATOR REPORTS; IT DOES NOT DECIDE (skeptic finding 1).
        #
        # The refusal is the PARSER's call. The grep below only answers "which
        # line should the author look at", and it scans the RAW file while the
        # parser scans a TRANSFORMED one (HTML comments stripped, fences
        # skipped, code spans / blockquotes / table cells rejected). Those two
        # views diverge, so letting the locator gate the refusal re-instantiated
        # the exact class this change closes — a hand-rolled scanner overruling
        # the authority — and it did so in the FAIL-OPEN direction:
        #
        #   disposition<!-- n -->: merge     parser: unreadable   -> was ACCEPTED
        #
        # the parser strips the mid-line comment and reads the field; the raw
        # grep cannot see it, found no line, and the refusal was suppressed.
        # Exotic, but it is #836 reproducing inside the fix for #836, so it is
        # closed by construction rather than argued away.
        #
        # EMPTY MEANS TWO DIFFERENT THINGS and they get opposite answers —
        # the `absent` vs `unreadable` distinction (#684) applied one level down:
        #   * candidates exist but are ALL headings  -> the deliberate carve-out,
        #     do not refuse (this is the `### Disposition: fix at source` file);
        #   * NO candidate at all                    -> the parser saw a field we
        #     could not locate. Refuse anyway, saying so. Fail CLOSED.
        #
        # THE SECOND ARM IS UNREACHABLE BY ANY DOCUMENT, AND IT IS STILL TESTED
        # (skeptic Finding 3 on #855). The rationale above describes the PRE-F1
        # design, where this caller ran its OWN raw grep and could genuinely find
        # nothing the parser had found. F1 deleted that second scanner: `_lines`
        # now accumulates inside the same loop over `_fields` that computes the
        # verdict, so a non-empty `_fields` guarantees at least one `FNR` token,
        # and no report can empty `$_rc_shown`.
        #
        # I first concluded that made a killing assertion impossible and labelled
        # the arm unfalsifiable. That was WRONG, and the error is worth naming
        # because it is seductive: "unreachable by DOCUMENT" is not "unreachable,
        # full stop". This arm does not guard documents. It guards a PARSER
        # REGRESSION — and a regression is simulable, by stubbing the authority.
        # The suite now does exactly that (`_stub_parser`), driving both routes
        # to an empty locator: a verdict carrying NO locator field, and one whose
        # locator is non-numeric and dropped by `^[0-9]+h?$`.
        #
        # So the arm stays AND it is killable: removing this `-z` test reddens 4,
        # dropping the token filter reddens 2. Both were 0 before. That matters
        # beyond tidiness — deleting a fail-CLOSED guard because today's call
        # graph cannot reach it is precisely the reachability reasoning #836
        # exists to call unreliable, so the guard had to survive; but a guard no
        # test can kill is what #855 exists to stop shipping, so it had to become
        # falsifiable. Stubbing the authority is what satisfies both.
        #
        # THE BOUNDARY ON THAT REASONING, because it does not generalise: keeping
        # a guard that is merely LABELLED unfalsifiable is defensible only when it
        # is fail-CLOSED, as this one is — its worst case is over-refusal, which
        # is loud, and an author reads the message and fixes the report. For a
        # fail-OPEN guard the calculus inverts: an unkillable fail-open guard and
        # NO guard are the same artifact, differing only in the false assurance
        # the first one gives its reader. There, delete it or make it killable —
        # do not label it and move on.
        #
        # ALL CANDIDATES ARE LISTED, headings included, and they are labelled
        # CANDIDATES rather than "the offending line". The locator cannot tell a
        # fenced quotation from a live field, so naming one confidently is how it
        # pointed authors at a quotation they must not edit while the real field
        # went unnamed — and how a poisoning `### Disposition:` heading stayed
        # invisible across a three-round correction loop. An honest list beats a
        # confident wrong answer; this repo's whole defect class is the latter.
        local _rc_dstate _rc_dsource _rc_ddetail _rc_dlines _rc_txt _rc_shown
        local _rc_n _rc_nonhead=0
        read -r _rc_dstate _rc_dsource _rc_ddetail _rc_dlines \
            <<<"$(_skeptic_stated_disposition "$path" --with-lines 2>/dev/null)"
        if [[ "$_rc_dstate" == "unreadable" ]] \
           && [[ "$_rc_dsource" == "frontmatter" || "$_rc_dsource" == "body" ]]; then
            # ONE SCANNER. These line numbers come from the parser's own scan of
            # its own transformed view, so there is nothing here that can
            # disagree with the verdict about WHERE the field is — which was the
            # residual (skeptic F1 on #855) and the third turn of the same screw:
            # #840 hand-rolled the VALUE test in front of this parser, and the
            # first fix for that hand-rolled WHICH LINE in front of the same
            # parser. The hand-rolled half kept migrating one level up. It is
            # gone rather than narrowed.
            # THE CARVE-OUT READS THE AUTHORITY'S FLAG; `sed` IS DISPLAY ONLY.
            #
            # `<n>h` means THIS SCAN classified that line's prefix as
            # heading-shaped, over the transformed text it actually parsed.
            # Recomputing that here from the raw line — which is what the first
            # version did — put the predicate back on bytes the parser never
            # saw, and diverged on `<!--c-->### Disposition: …`: heading to the
            # authority, not-a-heading to a raw regex, carve-out silently lost.
            #
            # `sed` still fetches the line, but only to SHOW it, and showing the
            # author their RAW line is correct — that is the text they must edit.
            # A predicate over raw bytes is a second opinion; a display of them
            # is not.
            # THE CARVE-OUT IS SCOPED TO THE BODY, and the scoping is the whole
            # point rather than a tightening (skeptic Finding 2 on #855).
            # Its justification is "an ordinary-English section title in a
            # non-skeptic report" — `### Disposition: fix at source` is prose, and
            # refusing it would tell an ordinary worker to rewrite a heading as
            # `no-further-pass`. That argument is available ONLY in the body.
            # Frontmatter is YAML: `###` is not a heading there, and the word
            # cannot be carrying its ordinary sense in a key position, so the
            # justification is VOID and the carve-out must not extend to it.
            #
            # Unscoped, this discriminated on ONE property the authority reports
            # (heading-ness) while ignoring ANOTHER it reports in the same output
            # (`$_rc_dsource`) — leaving `### Disposition: merge` in frontmatter
            # passing at write time and `unreadable` at read time. That is a #836
            # inversion surviving inside the fix for #836, i.e. this PR's own
            # thesis turned on this PR. Legal values are unaffected either way:
            # a legal token never reaches here, because the parser returns it as
            # `stated` rather than `unreadable`.
            _rc_shown=""
            for _rc_n in ${_rc_dlines//,/ }; do
                [[ "$_rc_n" =~ ^[0-9]+h?$ ]] || continue
                [[ "$_rc_n" == *h && "$_rc_dsource" == "body" ]] || _rc_nonhead=1
                _rc_n="${_rc_n%h}"
                _rc_txt=$(sed -n "${_rc_n}p" "$path" | cut -c1-100)
                _rc_shown="${_rc_shown:+$_rc_shown | }${_rc_n}:${_rc_txt}"
            done
            if (( _rc_nonhead == 1 )) || [[ -z "$_rc_shown" ]]; then
                missing+=("frontmatter field: disposition (must be no-further-pass|second-pass; unreadable in ${_rc_dsource} — ${_rc_ddetail}) at ${_rc_shown:-<parser reported no line>}")
            fi
        elif [[ "$_rc_dstate" == "absent" ]]; then
            # ── ABSENCE IS ADVISORY HERE, NOT A REFUSAL, AND THE ASYMMETRY
            #    IS MEASURED (your-org/nexus-code#1095 item 2) ─────────────
            #
            # #1095 asks for `report-check` to REQUIRE the field. Measured
            # before deciding, against the live corpus at 2026-09-01:
            #
            #   ls reports/*.md | wc -l                                    -> 677
            #   grep -lE '^disposition: (no-further-pass|second-pass)$' \
            #        reports/*.md | wc -l                                  -> 421
            #
            # so 256 of 677 (37.8%) would be REFUSED retroactively — and
            # `cmd_report_check` is `ng wrap-up`'s own pre-flight, so a hard
            # requirement here does not merely fail a lint: it blocks the
            # hand-off verb every worker in the nexus runs. Of the newest 25
            # reports, every worker report is `absent`; the requirement would
            # be a nexus-wide stop, not a nudge.
            #
            # So the STAGED form ships: the generator enforces (`report-init`
            # now emits `disposition: TODO`, which #836's existing gate
            # already refuses, and which breaks nothing that already exists),
            # and the checker SAYS SO without refusing. That makes the
            # omission visible on the hand-written path too — the gap the
            # `report-init` half cannot reach — while the actual defect on
            # #1095, an obligation manufactured from absence, is closed where
            # it is manufactured, in `_wrapup_skeptic_step`'s require arm.
            #
            # NOT a silent pass and not a hidden refusal. `MONITOR_REPORT_
            # REQUIRE_DISPOSITION=1` opts into the strict form for anyone who
            # wants to run the eventual behaviour early — which is also what
            # makes this advisory FALSIFIABLE rather than decorative.
            # your-org/nexus-code#684 — THE DEFAULT PATH SAYS NOTHING.
            # An ABSENT field is a different state from an UNREADABLE one, and
            # only the latter is an authoring error; `test-ng-report-check.sh`
            # Test 13 encodes that contract with `assert_not_contains … 
            # "disposition"`. An earlier cut of #1095 emitted the advisory HERE
            # and broke it — base 105/0 -> head 103/2, on a test blob that was
            # byte-IDENTICAL at both refs, so the predicate had not moved: the
            # subject had. The advisory now lives in `cmd_wrap_up`, which is
            # where #1095's refusal actually bites and where the author is
            # still present to act on it. The strict knob keeps working here
            # because it is opt-in and Test 13 runs without it.
            if [[ "${MONITOR_REPORT_REQUIRE_DISPOSITION:-0}" == "1" ]]; then
                missing+=("frontmatter field: disposition (must be no-further-pass|second-pass; absent — ${_rc_ddetail})")
            fi
        elif [[ "$_rc_dstate" == "no-further-pass" && "$_rc_dsource" == "frontmatter" ]] \
             && (( gate_settling == 0 )); then
            # ── THE PERMISSIVE VALUE AGAINST A LIVE GATE (your-org/nexus-code#1363)
            #
            # Keyed on the report's own frontmatter `window:` — the field
            # `ng reports-for-window`, and through it `retire-preflight`, uses
            # to find this report — so the comparison is against the window
            # the field will be READ for. A report with no `window:` cannot
            # be compared and is left alone; `ng wrap-up` repeats the check
            # keyed on the invoking pane. Both marker and spawn stamp are on
            # disk at write time; only `--skeptic-decision require` is not,
            # and wrap-up adds that one. See `_disposition_gate_conflict`.
            local _rc_win _rc_conflict
            _rc_win=$(awk -F': *' '/^window:/{print $2; exit}' <<<"$fm" | tr -d ' \t')
            if [[ -n "$_rc_win" ]] \
               && ! _rc_conflict=$(_disposition_gate_conflict "$path" "$_rc_win" "" 0 ""); then
                missing+=("frontmatter field: disposition (no-further-pass CONTRADICTS a skeptic gate for window ${_rc_win}: $(printf '%s' "$_rc_conflict" | tr '\n' ';')) — retire-preflight reads this field as its FIRST gate and no-further-pass is the PERMISSIVE value; state second-pass, or settle the gate first (your-org/nexus-code#1363)")
            fi
        fi
    fi

    # Required sections.
    local section
    for section in "## Summary" "## What Was Done" "## Current State" "## What Remains" "## How to Resume"; do
        if ! grep -qFx "$section" "$path"; then
            missing+=("section: ${section}")
        fi
    done

    # Body length: file minus frontmatter.
    local body_chars
    body_chars=$(awk '
        BEGIN { in_fm=0; passed_fm=0 }
        NR==1 && /^---$/ { in_fm=1; next }
        in_fm && /^---$/ { in_fm=0; passed_fm=1; next }
        in_fm { next }
        passed_fm || NR>1 { print }
    ' "$path" | wc -c)
    if (( body_chars < min_chars )); then
        missing+=("body too short: ${body_chars} < ${min_chars} chars")
    fi

    # Placeholder text. `_(fill in)_` is the report-init skeleton
    # marker; TODO/FIXME are workers' own. `<...>` is the angle-bracket
    # placeholder common in templates.
    if (( allow_todo == 0 )); then
        if grep -qE '\bTODO\b|\bFIXME\b' "$path"; then
            missing+=("placeholder text: TODO/FIXME present (pass --allow-todo to skip)")
        fi
        if grep -qE '<\.\.\.>' "$path"; then
            missing+=("placeholder text: '<...>' present (pass --allow-todo to skip)")
        fi
        if grep -qE '_\(fill in\)_' "$path"; then
            missing+=("placeholder text: '_(fill in)_' from skeleton present (pass --allow-todo to skip)")
        fi
        if grep -qE '_\(later\)_' "$path"; then
            missing+=("placeholder text: '_(later)_' present (pass --allow-todo to skip)")
        fi
    fi

    if (( ${#missing[@]} == 0 )); then
        printf 'report-check: %s OK (%d body chars)\n' "$(basename "$path")" "$body_chars"
        return 0
    fi
    {
        printf 'ng report-check: %s — incomplete:\n' "$(basename "$path")"
        local m
        for m in "${missing[@]}"; do printf '  - %s\n' "$m"; done
    } >&2
    return 1
}

# The corpus visibility sentinel for `ng report-grep`. `## How to Resume`
# is one of the five headings `ng report-check` REQUIRES and
# `ng report-init` writes into every report skeleton. Measured against the
# live corpus (2026-07-30): 2268/2405 files carry it = 94.3%; the 137
# (5.7%) that do not are non-standard artifacts (channel-reply drafts,
# coordinator subdirs) that were never ng-report-init reports.
#
# COVERAGE BOUNDARY (on the axis the guard varies on — WHICH SEARCH ROOTS,
# not which callers): the guard's visibility signal is reliable for any
# root that contains >=1 standard report — which the DEFAULT reports root
# always does (2268 hits), so it NEVER false-fires there. It CANNOT vouch
# for a root scoped to only non-standard files (the 5.7%); there the
# sentinel is legitimately absent, and the guard treats that as a
# "don't know" (rc 3 + a candidate-cause message), never as a false zero.
# That is the safe failure direction: a spurious refusal costs a re-run; a
# false zero costs a wrong "no".
#
# Why a heading and not a generic "any visible content" probe (e.g.
# `grep -rl .`): the bare `*` in reports/.gitignore is paired with
# `!.gitignore`, so an ignore-file-aware search STILL sees `reports/.gitignore`
# itself. An any-content probe would therefore find that one file, conclude
# "tree visible", and hand back the suppressed FALSE zero — reintroducing
# the #618 bug. The heading lives only in the (ignored) report bodies, so it
# correctly collapses to zero under suppression. Property over proxy: the
# guard needs a token that is visible IFF real reports are.
_CORPUS_SENTINEL='## How to Resume'

# `ng report-grep [grep-opts...] <pattern> [path...]`
#
# Ignore-file-BLIND recursive search over the reports corpus, with a
# guard that refuses to hand back a false zero (issue #618).
#
# The operator's interactive `grep` is a shell function wrapping
# `ugrep --ignore-files`; `reports/.gitignore` is a bare `*`, so a plain
# `grep -r <anything> reports/` returns ZERO matches, no error, over
# ~1,600 files — silence indistinguishable from genuine absence. An agent
# asking "has this happened before?" gets a confident, wrong "no".
#
# This verb searches with `command grep -r`. `command` bypasses the
# operator's `grep` shell FUNCTION, so in the live interactive shell the
# ugrep wrapper never reaches this code — the verb is already blind-proof
# against that vector. The residual risk it guards is an ignore-file-aware
# grep EXECUTABLE ahead of /bin/grep on PATH (which `command grep` WOULD
# honour), plus the everyday case of a wrong/empty/non-standard root.
# Before it will TRUST a zero it probes for the sentinel `## How to Resume`
# (see `_CORPUS_SENTINEL`); if that is also absent the search cannot
# confirm it sees any report, so the verb REFUSES the zero and exits 3
# with a diagnostic — leading with the likely-real cause (root wrong /
# empty / holds no ng-report-init report) and naming the ignore-file
# interaction as the less-common alternative. Silence is never used as a
# proxy for absence.
#
# NB the guard is one-directional: it converts an untrustworthy zero into
# a loud refusal. It does NOT neutralize a bare `grep -r reports/` typed
# outside this verb — that still returns a silent zero; steering agents to
# this verb is prose-only (CLAUDE.md gotchas + the report/infra-review
# skills).
#
# COVERAGE BOUNDARY — this mechanism varies on TWO axes, name both:
#   (1) WHICH SEARCH ROOTS the sentinel covers (see `_CORPUS_SENTINEL`):
#       reliable for any root holding >=1 standard report; a root of only
#       non-standard files is a "don't know" (rc 3), never a false zero.
#   (2) WHICH INTERPRETER runs it. `cmd_report_grep` and its test use only
#       constructs common to bash 4.4 and later + zsh — no `mapfile`,
#       `${var@Q}`, negative array index, or `wait -n`; the test's `<<<`
#       here-strings are 4.4-safe. This is verified, not asserted: the
#       suite runs green in the bash-4.4 CI cell (the pinned version this
#       lab runs, #616), the default-bash cell (`jobs: 4`; the `jobs: 2`
#       cell was dropped for cost, #1300), and the zsh cell — a local
#       green alone would cover only the dev interpreter.
#       (A one-off red on an early commit was an unrelated PID-keyed port
#       collision in test-remote-identity-health.sh, not this code.)
#
# Default search root is the resolved reports dir (`_report_reports_dir`);
# explicit path arguments override it. Options preceding the pattern are
# forwarded to grep (`-l`, `-n`, `-i`, `-c`, `-E`, `--include=…`); a `--`
# terminates options so a pattern may start with `-`. Grep options that
# take a SEPARATE argument (e.g. `-m 5`) are not supported — fold them
# into `--opt=value` form or use `command grep` directly.
#
# Exit codes: 0 = matches printed; 1 = genuine no-match (corpus proven
# visible); 3 = corpus INVISIBLE to the search (visibility guard fired);
# >=2 (other) = underlying grep error, passed through.
cmd_report_grep() {
    _help_check "$@"
    local -a opts=() paths=()
    local pattern="" seen_pattern=0
    _argloop_prev_10=-1; while (( $# > 0 )); do (( $# != _argloop_prev_10 )) || _argloop_stuck "$1"; _argloop_prev_10=$#
        if (( seen_pattern )); then paths+=("$1"); shift; continue; fi
        case "$1" in
            --) shift
                if (( $# > 0 )); then pattern="$1"; seen_pattern=1; shift; fi
                continue ;;
            -*) opts+=("$1"); shift; continue ;;
            *)  pattern="$1"; seen_pattern=1; shift; continue ;;
        esac
    done
    (( seen_pattern )) || die "usage: ng report-grep [grep-opts] <pattern> [path...]   # ignore-file-blind corpus search with a visibility guard (#618)"
    [[ -n "$pattern" ]] || die "report-grep: empty pattern (would match everything); pass a real pattern"

    if (( ${#paths[@]} == 0 )); then
        local rd; rd=$(_report_reports_dir "")
        paths=("$rd")
    fi

    # The authoritative search: command grep never reads .gitignore.
    # (command bypasses the operator's `grep` shell function; a grep
    # executable earlier on PATH would still be honoured — that is the
    # regression vector the visibility guard below exists to catch.)
    local out rc
    out=$(command grep -r ${opts[@]+"${opts[@]}"} -e "$pattern" -- ${paths[@]+"${paths[@]}"})
    rc=$?

    if (( rc == 0 )); then
        printf '%s\n' "$out"
        return 0
    elif (( rc == 1 )); then
        # Zero hits. Before trusting it, prove the corpus is visible to
        # THIS search by probing for the mandatory sentinel heading.
        #
        # The >>> / <<< markers below bound the entire guard. The unit
        # test (test-ng-report-grep.sh) excises this exact span to prove
        # the guard is non-vacuous: with it removed the primitive returns
        # a SILENT zero (the #618 bug), and the negative control goes red.
        # Do not remove or renumber the markers without updating that test.
        # >>> VISIBILITY-GUARD-618
        local probe
        probe=$(command grep -rlF -e "$_CORPUS_SENTINEL" -- ${paths[@]+"${paths[@]}"} 2>/dev/null)
        if [[ -n "$probe" ]]; then
            # Sentinel found → corpus is visible → the zero is genuine.
            return 1
        fi
        {
            printf 'ng report-grep: VISIBILITY GUARD — a zero this search cannot vouch for.\n'
            printf '  No matches for "%s", AND the corpus sentinel "%s"\n' "$pattern" "$_CORPUS_SENTINEL"
            printf '  is also absent under: %s\n' "${paths[*]}"
            printf '  What that establishes is only this: NO report is visible to this\n'
            printf '  search under those roots. It does NOT establish that your pattern\n'
            printf '  is truly absent. This is a "don'"'"'t know", not a diagnosis.\n'
            printf '  Candidate causes (probe did not isolate one) — check most-actionable first:\n'
            printf '    1. Wrong / empty / narrowed root: check the root you typed. A\n'
            printf '       subtree of only non-standard files (~5.7%% of the corpus —\n'
            printf '       channel-reply drafts, coordinator subdirs) carries no such heading.\n'
            printf '    2. An ignore-file-aware grep ahead of /bin/grep on PATH suppressing\n'
            printf '       a gitignored tree (ugrep --ignore-files vs reports/.gitignore'"'"'s\n'
            printf '       bare `*`; issue #618) — then the tree is invisible and any zero is false.\n'
            printf '  Re-run against a root you KNOW holds reports to disambiguate.\n'
        } >&2
        return 3
        # <<< VISIBILITY-GUARD-618
    else
        # Underlying grep error (rc >= 2); grep already wrote to stderr.
        [[ -n "$out" ]] && printf '%s\n' "$out"
        return "$rc"
    fi
}

# Pull the first H1 from a report. Empty stdout if none parseable.
_wrapup_report_title() {
    awk '/^# / { sub(/^# +/, ""); sub(/[[:space:]]+$/, ""); print; exit }' "$1"
}

# Is a `. ` at this position a SENTENCE boundary, or merely a period?
#
# your-org/nexus-code#1114. The composer used to cut at the FIRST `". "` in
# the first 200 chars and call the result "the first sentence". Those are
# different rules, and the gap is a whole population: abbreviations (`e.g.`
# `Dr.` `Fig.`), version and enumeration tokens (`v2.` `2.1.`), and initials
# (`J. Smith`). A real BLOCK verdict published as the four characters
# `**BLOCK.` because the next thing after the period was `2.1.250`.
#
# THE DEFAULT IS INVERTED HERE, and that is the point. The old rule cut
# wherever it saw a period and asked nothing; this one cuts only where the
# boundary is POSITIVELY safe and otherwise declines to cut at all. Declining
# yields a LONGER teaser (up to the same 200-char cap), never a shorter one —
# so every case this predicate has not anticipated fails toward MORE of the
# author's text, not toward a fragment. That direction is the whole safety
# argument: a rule that guesses can only lose information, a rule that
# declines can only keep it.
#
#   $1 the token immediately before the period (no period, may carry markup)
#   $2 the single character following the `". "`
# Returns 0 when the cut is safe, 1 when it is not.
_wrapup_boundary_safe() {
    local tok="$1" nextch="$2" core
    # Strip surrounding markup/punctuation so `**BLOCK` is judged as `BLOCK`.
    if [[ "$tok" =~ ([A-Za-z0-9.]+)$ ]]; then core="${BASH_REMATCH[1]}"; else core="$tok"; fi

    # A sentence starts with a capital, or with a markup/quote character that
    # opens one. Anything else — a digit, a lowercase letter — says the period
    # belonged to the token before it, not to a sentence.
    case "$nextch" in
        [A-Z]|'*'|'_'|'`'|'"'|"'"|'('|'['|'#') ;;
        *) return 1 ;;
    esac

    # Ends in a digit ⇒ a version, a release, a numbered item (`v2.` `2.1.`
    # `Fig` is caught below, `250` here). Never a sentence end.
    [[ "$core" == *[0-9] ]] && return 1
    # A single letter ⇒ an initial (`J. Smith`).
    [[ "$core" =~ ^[A-Za-z]$ ]] && return 1
    # Known abbreviations, matched on the WHOLE token (case-insensitively),
    # never as a substring — `No` must not swallow `Nano`.
    local lc="${core,,}"
    case "$lc" in
        e.g|i.e|etc|vs|cf|approx|est|resp|viz|al \
        |dr|mr|mrs|ms|prof|sr|jr|st|inc|ltd|co \
        |fig|eq|no|ref|sec|app|vol|ch|pp|cap|min|max) return 1 ;;
    esac
    return 0
}

# Does this composed teaser carry a claim a reader can act on?
#
# your-org/nexus-code#1114, and this is the half that generalises past the
# boundary rule above. A sharper boundary is still a heuristic: it can only
# be right about the cases someone thought of. This predicate is keyed on the
# OUTPUT ALONE and is therefore independent of how the output was reached —
# whatever a future boundary rule fails to anticipate, this still sees.
#
# Two conditions, and the second is deliberately conditioned on LOSS:
#
#   * fewer than two alphanumeric-bearing tokens — one word is not an
#     assertion, whatever produced it. `**BLOCK.` `v2.` `Dr.` `Fig.` are all
#     exactly this.
#   * shorter than 20 characters AND the composer DROPPED text to get there.
#     Undropped, the teaser IS the author's whole Summary; `All tests pass.`
#     is terse, complete, and none of this function's business. Refusing it
#     would be second-guessing prose. The refusal is about the composer's own
#     lossy step, never about the author's brevity.
#
# THE BOUND, stated rather than left to be discovered: this catches the
# CATASTROPHIC case — a fragment standing in for a claim. It does not and
# cannot catch a teaser that is merely a poor summary. A floor honestly
# labelled as a floor is worth more than one presented as a guarantee.
#
#   $1 composed teaser   $2 the full flattened text it was composed from
# Returns 0 when the teaser is degenerate (do NOT publish), 1 when it is fine.
_wrapup_teaser_degenerate() {
    # NOT one `local` with `t="$teaser"` on the same line: bash 4.4 declares
    # every name in a `local` list before assigning any of them, so under
    # `set -u` the back-reference is an UNBOUND VARIABLE and the whole
    # predicate returns 1 — i.e. "not degenerate", the permissive answer.
    # Measured on this host (bash 4.4.20) while writing this function.
    local teaser="$1" full="$2" n=0 w t
    t="$teaser"
    # Judge the words, not the markup: `**BLOCK.` is one token, not two.
    t="${t//\*/}"; t="${t//_/}"; t="${t//\`/}"
    # your-org/nexus-code#1116 review, F5. `for w in $t` undergoes BOTH word
    # splitting (wanted) and PATHNAME EXPANSION (not wanted), so the token
    # count became a function of the invoking directory: a teaser containing
    # `[ab]?` counted 2 with `aa`/`bb` in cwd and 1 without. No realistic
    # teaser was shown to flip a refusal, so this is hardening rather than a
    # demonstrated defect — but a publication gate whose answer depends on
    # where it was called from is not a gate. `set -f` locally, restored
    # immediately, so the glob state cannot leak to the caller.
    local _had_f=0
    [[ "$-" == *f* ]] && _had_f=1
    set -f
    for w in $t; do
        [[ "$w" == *[[:alnum:]]* ]] && n=$(( n + 1 ))
    done
    (( _had_f )) || set +f
    (( n < 2 )) && return 0
    [[ "$teaser" != "$full" ]] && (( ${#t} < 20 )) && return 0
    return 1
}

# Pull a one-sentence summary from a report:
#   1. body of `## Summary` (case-insensitive) if present
#   2. else body of the section under the H1, before the next H2
# Flatten to a single line, drop **Key:** metadata lines, cut at the first
# SAFE sentence boundary (see `_wrapup_boundary_safe`), cap at 200 chars.
#
# Three outcomes, and the caller must distinguish all three:
#   rc 0, stdout non-empty  → publish this.
#   rc 0, stdout empty      → nothing parseable; the caller falls back to a
#                             title-only body.
#   rc 2, stdout = the teaser → DEGENERATE (your-org/nexus-code#1114). The
#                             composer could not produce a body carrying a
#                             claim. stdout is returned only so the caller can
#                             quote it in the diagnostic — it must NOT be
#                             published.
_wrapup_report_summary() {
    local report="$1"
    local text
    text=$(awk '
        BEGIN { IGNORECASE=1 }
        /^## Summary[[:space:]]*$/ { in_section=1; next }
        in_section && /^## /       { exit }
        in_section                 { print }
    ' "$report")
    if [[ -z "${text// /}" ]]; then
        text=$(awk '
            /^# / && !found_h1 { found_h1=1; next }
            found_h1 && /^## / { exit }
            found_h1           { print }
        ' "$report")
    fi
    # Flatten, strip `**Key:** value` metadata lines, collapse whitespace.
    #
    # your-org/nexus-code#1116 review, F2 — THE THIRD LOSSY STEP, and it was the
    # worst of the three. The `grep -v` drops `**Key:** value` lines, so a
    # Summary written entirely in that shape — a realistic skeptic verdict:
    #
    #     **Verdict:** BLOCK
    #     **Confidence:** high
    #     **Findings:** two of nine scenarios regress; the pin must stay
    #
    # flattens to EMPTY. Empty used to mean "nothing parseable", which routes
    # `cmd_wrap_up` to the title-only body — the very fallback the exit-3 block
    # rejects by name, published at rc 0 with the trigger rocketed. So a
    # ONE-word Summary was refused while a ZERO-word Summary was published as a
    # bare title: strictly worse than `#1114`'s original instance, which at
    # least published `**BLOCK.`.
    #
    # The distinction that matters is WHY the text is empty, and it is
    # available right here and nowhere later — hence the check at this line
    # rather than at the gate below:
    #
    #   no `## Summary` content at all  → genuinely nothing parseable; the
    #       title-only body is the honest answer and report-check owns the
    #       stub case. rc 0, empty stdout, unchanged.
    #   the Summary HAD content and the flatten consumed it → the composer
    #       destroyed the author's claim. That is a degenerate teaser by any
    #       reading, so it takes the refusal, not the fallback.
    local pre_strip="$text"
    text=$(printf '%s\n' "$text" \
        | grep -v '^\*\*[A-Za-z][A-Za-z ]*:\*\*' \
        | tr '\n' ' ' \
        | sed -e 's/[[:space:]][[:space:]]*/ /g' \
              -e 's/^[[:space:]]*//' \
              -e 's/[[:space:]]*$//')
    if [[ -z "$text" ]]; then
        [[ -n "${pre_strip//[[:space:]]/}" ]] || return 0
        # Had content, has none now: the strip ate the whole claim.
        printf '%s' ''
        return 2
    fi
    local prefix="${text:0:200}"
    # Walk the candidate boundaries in order and take the first SAFE one.
    # `%%` strips the LONGEST `. *` suffix, i.e. it finds the EARLIEST `. ` —
    # which is what the old rule used as its answer and is only a candidate.
    local pos=0 rest="$prefix" left tok abs cut=""
    while [[ "$rest" == *". "* ]]; do
        left="${rest%%. *}"
        abs=$(( pos + ${#left} ))
        tok="${left##* }"
        if _wrapup_boundary_safe "$tok" "${prefix:abs+2:1}"; then
            cut="${prefix:0:abs}."
            break
        fi
        pos=$(( abs + 2 ))
        rest="${prefix:pos}"
    done
    # EXTEND BEFORE YOU REFUSE. A safe boundary can still land on a fragment —
    # `Fixed. The composer now refuses…` cuts at a genuine sentence end and
    # yields the single word `Fixed.`, which is a perfectly ordinary way to
    # open a summary and must not become a hard stop. So when the first
    # sentence is degenerate, DISCARD the cut and fall through to the cap: the
    # author's next sentence comes along and the teaser says something. The
    # refusal below then fires only when there is nothing to extend INTO —
    # a Summary that is a fragment in its entirety.
    #
    # Order matters. Refusing first would have turned a cosmetic teaser problem
    # into a blocked wrap-up, i.e. a new failure introduced by the fix.
    if [[ -n "$cut" ]] && ! _wrapup_teaser_degenerate "$cut" "$text"; then
        prefix="$cut"
    elif (( ${#text} > 200 )); then
        # No safe boundary: keep as much as the cap allows, ending on a word
        # boundary so the teaser never stops mid-token. The word trim is
        # itself capped: `${prefix% *}` strips back to the LAST space, so a
        # 200-char window whose only space is near the front would trim away
        # almost everything and manufacture the very fragment this function
        # exists to prevent. Below the trim floor, keep the hard cut — a word
        # split at 200 chars costs a reader nothing.
        local trimmed="${prefix% *}"
        if (( ${#trimmed} >= 150 )); then prefix="$trimmed"; fi
        prefix="${prefix}..."
    fi
    if _wrapup_teaser_degenerate "$prefix" "$text"; then
        printf '%s' "$prefix"
        return 2
    fi
    printf '%s' "$prefix"
}

# Extract a report's FULL `## Summary` section body (case-insensitive
# header, everything up to the next H2), trailing blank lines trimmed.
#
# Distinct from `_wrapup_report_summary`, which squeezes the same section
# to ONE sentence capped at 200 chars for a GitHub link-comment teaser.
# In `--reply-to` mode the Summary IS the deliverable — the requester
# receives these bytes and nothing else — so it must not be truncated.
# Empty stdout when the section is absent (report-check already REQUIRES
# it, so that means a hand-written report bypassing the pre-flight).
#
# Fenced code blocks are tracked, so a ```-fenced snippet containing a line
# that starts with `## ` does NOT truncate the answer. The teaser helper
# above deliberately keeps its simpler scan (a truncated 200-char teaser is
# cosmetic); here a silent truncation would ship a half answer to a
# requester who has no way to notice.
_wrapup_report_section_summary() {
    awk '
        BEGIN { IGNORECASE=1 }
        /^```/                              { fence = !fence }
        !fence && /^## Summary[[:space:]]*$/ { in_section=1; next }
        in_section && !fence && /^## /      { exit }
        in_section                          { print }
    ' "$1" | awk '
        # Trim leading and trailing blank lines without buffering the
        # whole section: hold blanks until a non-blank line proves they
        # were interior.
        NF == 0 { if (seen) pending = pending "\n"; next }
        { if (seen && pending != "") { printf "%s", pending; pending = "" }
          seen = 1; print }
    '
}

# Deliver the wrap-up answer over the request/reply channel (agent-channel
# RFC Parts B+D). This is the `--reply-to` counterpart of the issue-comment
# step: same hand-off moment, different transport.
#
# The channel is NOT reimplemented here — this shells out to the existing
# `request-channel.sh reply` verb, so the atomic claim-first transition, the
# `body_bytes` unforgeable boundary, the byte-exact `replies/<id>/results.md`
# materialization, and the publish-inheritance rules all stay single-source.
#
#   $1 request-id  $2 answer-body-file  $3 source-window (may be empty)
#   $4 workdir     $5 issue-ref (owner/repo#N, empty in channel-only mode)
#
# Prints the resulting `.replied.md` path on success. Non-zero + stderr on
# failure; the caller surfaces it as a FAILED step and flips the exit code
# (unlike the GitHub steps, the channel reply IS the deliverable here — a
# silent failure would leave the requester blocked forever).
_wrapup_deliver_channel_reply() {
    local id="$1" body_file="$2" window="$3" wdir="$4" issue_ref="$5"
    local chan="$_script_dir/request-channel.sh"
    [[ -x "$chan" ]] || { printf 'request-channel.sh not found or not executable: %s\n' "$chan" >&2; return 1; }
    # STATUS IS KIND-AWARE, because `--status` is a CLOSED vocabulary that
    # SELECTS (your-org/nexus-code#1293, #1050). For an ordinary request this
    # is the ANSWER, so `answered` is pinned: --worker alone would default the
    # status to `spawned` (the orchestrator's "I dispatched someone" shape) and
    # the worker fields here are pure provenance for the requester.
    #
    # For a `spawn-skeptic` request, `answered` is REFUSED by the channel as
    # ambiguous — it cannot say whether the skeptic gate is discharged, which
    # is the whole defect #1293 fixes. The wrap-up that answers such a request
    # is the REVIEWER's own, so `spawned --worker <this window>` is both the
    # accurate statement and the one the channel accepts: the gate is
    # discharged by THAT window's verdict, not by this reply.
    #
    # With no window we do NOT guess. The channel refuses, loudly, and the
    # caller surfaces it as a FAILED step — which is correct: an unnamed
    # reviewer discharges nothing, and inventing a status here would put this
    # function back in the business of recording a decision it cannot make.
    local _req_status=answered
    if [[ -n "$window" ]]; then
        local _req_path _req_kind=""
        if _req_path=$("$chan" reqfile "$id" 2>/dev/null) && [[ -n "$_req_path" && -f "$_req_path" ]]; then
            _req_kind=$(awk -F': *' '/^kind:[[:space:]]/{print $2; exit}' "$_req_path" 2>/dev/null)
        fi
        [[ "$_req_kind" == "spawn-skeptic" ]] && _req_status=spawned
    fi
    local -a args=(reply "$id" --file "$body_file" --status "$_req_status")
    [[ -n "$window" ]] && args+=(--worker "$window")
    [[ -n "$wdir"   ]] && args+=(--dir "$wdir")
    [[ -n "$issue_ref" ]] && args+=(--issue "$issue_ref")
    "$chan" "${args[@]}"
}

# Post-once idempotency for wrap-up step 2 (B15 / your-org/your-nexus#236).
# `ng wrap-up` is the documented retry surface: on a partial failure
# (the rocket step fails, the log append fails, …) the verb returns 1 and
# the worker re-runs the WHOLE verb — there is no per-step retry. Without
# a guard, step 2 re-POSTs the link comment every time, so the issue
# thread accrues duplicate result comments (the symptom other-nexus reported).
#
# Step 4 already records every successful wrap-up comment in the action
# log with its url, keyed by (issue, report-basename, repo). Scan that log
# for a prior hit and reuse the recorded url instead of posting again.
# Keyed on the LOGICAL wrap-up identity, not the per-upload asset url
# (which the upload step regenerates on every retry). Echoes the most
# recent matching comment url on stdout; empty when none exists (the
# first, legitimate post). Failed prior attempts logged no comment-url,
# so a retry after a genuine comment failure correctly posts fresh.
_wrapup_prior_comment_url() {
    local issue="$1" report_basename="$2" repo="$3"
    local log_file="$STATE_DIR/action-log.jsonl"
    [[ -f "$log_file" ]] || return 0
    command -v jq >/dev/null 2>&1 || return 0
    jq -rs --arg i "$issue" --arg r "$report_basename" --arg repo "$repo" '
        [ .[]
          | select(.event == "wrap-up")
          | select(.issue == $i and .report == $r and .repo == $repo)
          | (."comment-url" // "")
          | select(. != "")
        ] | last // empty' "$log_file" 2>/dev/null
}

# _wrapup_trigger_already_answered <issue> <report-basename> <repo> <trigger>
# Has a PRIOR wrap-up already published an answer for THIS trigger comment?
# (your-org/nexus-code#1148.)
#
# The rocket must not fire for a run that published nothing (#1114's rule) —
# but `nothing-published` (#862) ALSO fires on an honest RETRY whose comment
# landed and whose rocket failed, and withholding there would make the
# documented retry surface unable to ever complete. The two are one variable
# apart and the exit code cannot separate them: both are rc 3.
#
# So separate them by EVIDENCE rather than by state name. The action log
# records, per wrap-up, which trigger it carried and what its comment step
# achieved.
#
# FAIL CLOSED (rc 1 => withhold). Withholding costs one watcher re-emit; a
# false rocket is SILENT — `_mark_processed rocket` evicts the mention from
# the #360 re-emit registry, marking the escalation handled with nothing
# delivered.
_wrapup_trigger_already_answered() {
    local issue="$1" report_basename="$2" repo="$3" trigger="$4"
    [[ -n "$trigger" && "$trigger" != "0" ]] || return 1
    local log_file="$STATE_DIR/action-log.jsonl"
    [[ -f "$log_file" ]] || return 1
    command -v jq >/dev/null 2>&1 || return 1
    local hit
    hit=$(jq -rs --arg i "$issue" --arg r "$report_basename" --arg repo "$repo" \
                 --arg t "$trigger" '
        [ .[]
          | select(.event == "wrap-up")
          | select(.issue == $i and .report == $r and .repo == $repo)
          | select((."trigger-comment" // "") == $t)
          | select((.comment // "") == "ok" or (.comment // "") == "edited"
                   or (.comment // "") == "updated-and-posted")
        ] | length' "$log_file" 2>/dev/null) || return 1
    [[ "$hit" =~ ^[0-9]+$ ]] || return 1
    (( hit > 0 ))
}


# Re-point a prior wrap-up link comment at a fresh asset upload (#524
# defect 2). Every `ng wrap-up` run re-uploads the report to a NEW
# SHA-pinned blob, so a re-wrap that merely REUSES the prior comment
# leaves the thread linking the PRE-correction report while printing
# success (observed: `#523` — the reused comment linked a stale blob
# with 0 mentions of the corrected finding; the new blob had 9).
#
# Reads the prior comment, splices every asset link ending in this
# report's basename over to <new-asset-url>, and writes back through
# the CAS path (_comment_patch_cas) so the re-point can't itself
# reintroduce the lost-update race. One retry on a detected concurrent
# edit (re-read + re-splice), then fail loud.
#
#   _wrapup_repoint_link_comment <target> <prior-comment-html-url>
#                                <report-basename> <new-asset-url>
#   stdout: comment html_url
#   rc 0  re-pointed (or already pointing at the new blob)
#   rc 2  cannot re-point (comment deleted / id unparseable / body no
#         longer references this report) — caller should post fresh
#   rc 1  hard failure (fetch/PATCH/verify), including CAS conflicts
#         that persisted across the retry
_wrapup_repoint_link_comment() {
    local target="$1" prior_url="$2" bname="$3" new_url="$4"
    local cid="${prior_url##*issuecomment-}"
    if [[ ! "$cid" =~ ^[0-9]+$ ]]; then
        printf 'wrap-up: prior comment url has no issuecomment-<id> suffix: %s\n' "$prior_url" >&2
        return 2
    fi
    local attempt meta cur_body cur_updated new_body out rc
    for attempt in 1 2; do
        meta=$(api "/repos/$target/issues/comments/$cid" 2>/dev/null) || {
            printf 'wrap-up: prior link comment %s no longer fetchable (deleted?)\n' "$cid" >&2
            return 2
        }
        cur_body=$(jq -r '.body // empty' <<<"$meta")
        cur_updated=$(jq -r '.updated_at // empty' <<<"$meta")
        if [[ -z "$cur_body" || -z "$cur_updated" ]]; then
            printf 'wrap-up: prior link comment %s: malformed metadata\n' "$cid" >&2
            return 2
        fi
        new_body=$(_replace_asset_links "$cur_body" "$bname" "$new_url")
        if [[ "$new_body" == "$cur_body" ]]; then
            if [[ "$cur_body" == *"$new_url"* ]]; then
                # Idempotent retry: the comment already links the new blob.
                printf '%s\n' "$prior_url"
                return 0
            fi
            printf 'wrap-up: prior link comment %s no longer references %s — posting fresh instead\n' \
                "$cid" "$bname" >&2
            return 2
        fi
        rc=0
        out=$(_comment_patch_cas "$target" "$cid" "$new_body" "$cur_updated") || rc=$?
        if (( rc == 0 )); then
            printf '%s\n' "$out"
            return 0
        fi
        # rc 4 = someone edited between our read and write; re-read the
        # CURRENT body and re-splice once. Anything else is a hard fail.
        (( rc == 4 )) || return 1
    done
    printf 'wrap-up: comment %s kept moving under concurrent edits; re-run ng wrap-up\n' "$cid" >&2
    return 1
}

# CAS-edit a wrap-up link comment to an EXPLICIT new body
# (your-org/nexus-code#656).
#
# `_wrapup_repoint_link_comment` above only ever rewrites asset URLs
# inside the existing body. That is right for a pure re-run, and it is
# why a CORRECTED `## Summary` could never reach the thread: the composed
# body was recomputed every run and then discarded, while the caller was
# told `UPDATED` and given exit 0.
#
# Same optimistic-concurrency shape as the re-point path, deliberately —
# an edit that silently clobbers a concurrent one would be the same class
# of defect in a new place.
_wrapup_set_comment_body() {
    local target="$1" prior_url="$2" new_body="$3"
    local cid="${prior_url##*issuecomment-}"
    [[ "$cid" =~ ^[0-9]+$ ]] || {
        printf 'wrap-up: prior comment url has no issuecomment-<id> suffix: %s\n' "$prior_url" >&2
        return 2
    }
    local attempt meta cur_body cur_updated out rc
    for attempt in 1 2; do
        meta=$(api "/repos/$target/issues/comments/$cid" 2>/dev/null) || {
            printf 'wrap-up: prior link comment %s no longer fetchable (deleted?)\n' "$cid" >&2
            return 2
        }
        cur_body=$(jq -r '.body // empty' <<<"$meta")
        cur_updated=$(jq -r '.updated_at // empty' <<<"$meta")
        [[ -n "$cur_updated" ]] || {
            printf 'wrap-up: prior link comment %s: malformed metadata\n' "$cid" >&2
            return 2
        }
        if [[ "$cur_body" == "$new_body" ]]; then
            printf '%s\n' "$prior_url"; return 0
        fi
        rc=0
        out=$(_comment_patch_cas "$target" "$cid" "$new_body" "$cur_updated") || rc=$?
        if (( rc == 0 )); then printf '%s\n' "$out"; return 0; fi
        (( rc == 4 )) || return 1
    done
    printf 'wrap-up: comment %s kept moving under concurrent edits; re-run ng wrap-up\n' "$cid" >&2
    return 1
}

# ---- skeptic protocol (skills/nexus.skeptic) ----------------------------
#
# Read a window's spawn-stamped skeptic provenance from
# monitor/.state/windows/<window>.json. Echoes five tab-separated
# fields: mode<TAB>depth<TAB>role<TAB>target<TAB>orig. Missing record /
# missing fields degrade to "auto 0 false '' ''" (back-compat:
# pre-skeptic spawns carry no skeptic fields → treated as auto). The
# `orig` field is the ORIGINAL worker window at the root of the skeptic
# chain — a recursive (second-or-later) skeptic reviews the whole chain
# back to it and may question it (skills/nexus.skeptic Change 2).
_skeptic_provenance() {
    local window="$1"
    local mode=auto depth=0 role=false target="" orig=""
    [[ -n "$window" ]] || { printf '%s\t%s\t%s\t%s\t%s' "$mode" "$depth" "$role" "$target" "$orig"; return 0; }
    local rec="$STATE_DIR/windows/$(wk_encode "$window").json"
    if [[ -f "$rec" ]] && command -v jq >/dev/null 2>&1; then
        local m d r t o
        m=$(jq -r '.skeptic_mode   // "auto"'  "$rec" 2>/dev/null) || m=auto
        d=$(jq -r '.skeptic_depth  // 0'       "$rec" 2>/dev/null) || d=0
        r=$(jq -r '.skeptic_role   // false'   "$rec" 2>/dev/null) || r=false
        t=$(jq -r '.skeptic_target // ""'      "$rec" 2>/dev/null) || t=""
        o=$(jq -r '.skeptic_orig   // ""'      "$rec" 2>/dev/null) || o=""
        [[ "$m" =~ ^(require|auto|deny)$ ]] && mode="$m"
        [[ "$d" =~ ^[0-9]+$ ]] && depth="$d"
        [[ "$r" == "true" ]] && role=true
        [[ "$t" != "null" ]] && target="$t"
        [[ "$o" != "null" ]] && orig="$o"
    fi
    printf '%s\t%s\t%s\t%s\t%s' "$mode" "$depth" "$role" "$target" "$orig"
}

# The RESOLUTION state of a window's skeptic require-gate
# (your-org/nexus-code#815).
#
# WHY THIS EXISTS. `ng skeptic resolve` is the ORCHESTRATOR's audited verb
# for releasing a require-marker whose verdict landed somewhere the marker
# could not see. It removes the marker and appends a rationale beside it.
# The producer path of `_wrapup_skeptic_step` then re-armed the marker
# UNCONDITIONALLY on the window's next wrap-up, silently reversing that
# decision — and because a worker's only way to record anything is to file
# a report and wrap up, a worker told "write your findings and wrap up"
# after a resolve RE-BLOCKED ITSELF BY COMPLYING, and could not record that
# fact without doing it again. Observed 2026-08-08 on `bench272F`: marker
# resolved at ~01:2x, back at 01:48 as a side effect of a `--no-comment`
# wrap-up whose only purpose was to persist a report.
#
# CONTRACT. One line on stdout, three space-separated fields:
#
#     <state> <detail> <rationale-path-or-->
#
#   none     — no resolution record exists for this window. The ordinary
#              path; arming is exactly what it has always been.
#   resolved — a resolution record exists and is the LAST state transition
#              for this gate (the marker is absent, or is not newer than the
#              record). Re-arming here reverses an orchestrator decision.
#   re-armed — a resolution record exists but the marker is NEWER, i.e. a
#              REAL new round was opened after the resolution (spawn-worker.sh
#              re-seeds pending/<target> when it actually spawns a skeptic).
#              Arming is a no-op re-stamp of a live gate; proceed.
#   unknown  — the record exists and could not be examined. NOT folded into
#              `none`: `none` is a positive finding (no record on disk),
#              `unknown` is the absence of a finding, and #815 is what
#              happens when those two share an arm.
#
# NOTE ON THE DIRECTION OF CAUTION, because it is the opposite of the
# sibling guards in this PR and that is deliberate. For `retire-preflight`
# and `spawn-decision`, doubt must refuse to ACT — the act destroys a window
# or duplicates one. Here the act is ARMING a validation gate, so refusing
# on doubt would mean LESS validation, and the fail-safe direction inverts:
# `unknown` ARMS (status quo) and says so loudly. Only a POSITIVE `resolved`
# finding suppresses. A guard that suppressed validation on a probe it could
# not run would be a strictly worse bug than the one being fixed.
#
# Suppression NEVER removes an existing marker — it only declines to WRITE
# one. So a same-second tie between a resolve and a genuine re-seed (which
# resolves to `resolved` here) still leaves the live marker in place and the
# gate held; the tie is harmless in the only direction it can fall.
# Epoch of the most recent skeptic CHAIN event naming this window
# (your-org/nexus-code#815 skeptic F6). `skeptic-verdict` is the one that clears
# a marker without any orchestrator action, and `skeptic-request` marks a new
# round opening; either one supersedes an older resolution record. Echoes an
# epoch, or 0 when nothing is on record / the log cannot be read — 0 is the
# fail-safe value here, because it keeps the PRE-F6 behaviour (treat the
# resolution as current, i.e. suppress) rather than silently re-arming.
_skeptic_last_chain_event_epoch() {
    local safe="$1" raw="${2:-}" log="$STATE_DIR/action-log.jsonl" ts=""
    # your-org/nexus-code#825 — this used to return the bare integer 0 for BOTH
    # "the log is readable and names no such event" and "I could not look at
    # all" (jq missing / log unreadable / `date -d` failed). The caller compared
    # `0 > <rationale mtime>`, which is false, so every probe FAILURE fell
    # through to `resolved` — i.e. the probe failing SUPPRESSED the require-gate,
    # exactly as if an orchestrator had resolved it.
    #
    # That is the collapse `_skeptic_resolution_state`'s own header rules out for
    # its sibling state, reintroduced one level down and in the suppressing
    # direction. Found by the skeptic reviewing the #815 F6 fix.
    #
    # Contract now: ONE line, two fields — `<state> <epoch>`, where state is
    #   event   — an event exists; epoch is its time
    #   none    — the log WAS readable and names no such event (a POSITIVE
    #             negative, safe to treat as "nothing has superseded")
    #   unknown — could not determine. Never folded into `none`.
    [[ -n "$safe" ]]  || { printf 'unknown 0'; return 0; }
    # A missing log is `unknown`, NOT `none`. The first version of this fix
    # promoted it to a positive negative on the reasoning "nothing was ever
    # recorded, so nothing can have superseded" — and that is an inference about
    # HISTORY drawn from an ARTIFACT'S ABSENCE, which does not follow. `none`
    # falls through to `resolved`, so an absent log SUPPRESSED the gate —
    # reinstating the #815 F6 fail-open this very function exists to close.
    #
    # THE PATH IS REACHABLE, BY ROUTINE LOG ROTATION. Recorded at length because
    # an earlier version of this comment claimed the opposite, and did so by
    # RE-ASSERTING a claim a reviewer had already refuted:
    #
    #     "log rotation … `action-log.jsonl` is not among the THREE paths
    #      `_prune_rotate_if_oversized` is called with"
    #
    # There are FOUR call sites, and the fourth is
    # `_prune_rotate_if_oversized "$ACTION_LOG" "$MONITOR_STATE_LOG_MAX_BYTES"
    # rename` (monitor/watcher/main.sh:2579), with
    # `ACTION_LOG="${STATE_DIR}/action-log.jsonl"` (:527). Mode `rename` is a
    # `mv`. So the watcher rotates this very log on a SIZE trigger, the file goes
    # missing by design, and the reviewing skeptic's original mechanism was right
    # all along.
    #
    # The miscount was a TRUNCATED ENUMERATION reported as a total: the grep that
    # produced "three" ended in `| head -8`, which cut the fourth line. The
    # re-derivation repeated the same truncated command. A capped enumeration
    # presented as complete is the defect this whole function exists to prevent,
    # committed twice in the prose justifying it.
    #
    # So the guard is load-bearing, not merely principled: without it, a routine
    # rotation answers `none 0` -> `resolved` -> require-gate SUPPRESSED.
    [[ -r "$log" ]]   || { printf 'unknown 0'; return 0; }
    command -v jq >/dev/null 2>&1 || { printf 'unknown 0'; return 0; }
    # Match the RAW window name as well as the sanitised one. `$safe` is the
    # marker-FILENAME form (`${w//[^a-zA-Z0-9_-]/_}`) while the action log stores
    # the raw tmux name, so for any window whose name carries a character outside
    # that class the join silently found nothing — and the miss landed in the
    # fail-open arm above. Two representations of one identity, compared as if
    # they were one.
    [[ -n "$raw" ]] || raw="$safe"
    # your-org/nexus-code#825, found by self-grepping this very function for the
    # rule it enforces. This read `|| jq_err=/dev/null`, and `[[ -s /dev/null ]]`
    # is ALWAYS false — so if `mktemp` failed, a jq PARSE ERROR became invisible
    # and fell through to the `none 0` arm, i.e. SUPPRESSED the gate. A failure
    # to obtain the instrument that distinguishes "parse error" from "no match"
    # is itself a could-not-look; it must not resolve to the permissive answer.
    local jq_err
    jq_err=$(mktemp "${TMPDIR:-/tmp}/skchain.XXXXXX") || { printf 'unknown 0'; return 0; }
    # your-org/nexus-code#825 — grep's EXIT CODE is checked, not discarded. This
    # is the twin of the mktemp defect one line above, and it sat adjacent to it
    # unnoticed: grep exits 0 on match, 1 on no-match, and >=2 on ERROR (unreadable
    # mid-stream, I/O failure, binary refusal). Discarding it made a grep FAILURE
    # indistinguishable from a clean no-match — both yield empty `ts`, which lands
    # on `none 0` -> `resolved` -> GATE SUPPRESSED. Measured by the reviewing
    # skeptic with a superseding verdict genuinely present in the log.
    #
    # rc 1 (no match) is the ONLY non-zero that means "nothing there".
    local grep_out grep_rc
    grep_out=$(grep -E '"event":"skeptic-(verdict|request)"' "$log" 2>/dev/null); grep_rc=$?
    if (( grep_rc > 1 )); then
        rm -f "$jq_err" 2>/dev/null || true
        printf 'unknown 0'; return 0
    fi
    # your-org/nexus-code#825 — the PIPELINE's rc is checked, covering EVERY
    # stage. The prior version checked `grep` (a command substitution) and left
    # `tail` (a pipeline stage) unchecked, so a `tail` failure with a superseding
    # verdict genuinely present answered `none 0` -> `resolved` -> gate
    # SUPPRESSED. That was the THIRD instance in this block, and the sweep that
    # was supposed to catch it enumerated command SUBSTITUTIONS — the syntax axis
    # — while the mechanism is "a command whose failure is indistinguishable from
    # an empty result", which spans substitutions AND pipeline stages alike. Same
    # wrong-axis error as the `| head -8` truncation being diagnosed two comments
    # above, committed inside the sweep meant to catch it.
    #
    # `ng` runs under `set -o pipefail`, so the assignment's rc is non-zero if
    # ANY stage fails. One check, mechanism-shaped, rather than one per syntax
    # form somebody remembered to look for.
    local pipe_rc
    ts=$(printf '%s\n' "$grep_out" \
           | jq -r --arg w "$safe" --arg r "$raw" '
               select((.["target-window"] // "") == $w or (.["target-window"] // "") == $r
                      or (.["orig-window"] // "") == $w or (.["orig-window"] // "") == $r
                      or (.window // "") == $w or (.window // "") == $r) | .ts' 2>"$jq_err" \
           | tail -1); pipe_rc=$?
    if (( pipe_rc != 0 )); then
        rm -f "$jq_err" 2>/dev/null || true
        printf 'unknown 0'; return 0
    fi
    if [[ -s "$jq_err" ]]; then
        rm -f "$jq_err" 2>/dev/null || true
        printf 'unknown 0'; return 0
    fi
    rm -f "$jq_err" 2>/dev/null || true
    # No matching record, from a log we successfully read and parsed.
    [[ -n "$ts" ]] || { printf 'none 0'; return 0; }
    local e; e=$(date -d "$ts" +%s 2>/dev/null) || e=""
    # An event EXISTS but its timestamp is unparseable: we know something
    # happened and cannot place it in time. That is doubt, not absence.
    [[ "$e" =~ ^[0-9]+$ ]] || { printf 'unknown 0'; return 0; }
    printf 'event %s' "$e"
}

_skeptic_resolution_state() {
    local pending_dir="$1" safe="$2" raw="${3:-}"
    [[ -n "$raw" ]] || raw="$safe"
    if [[ -z "$safe" ]]; then
        printf 'none no-window-key -\n'; return 0
    fi
    local marker="$pending_dir/$safe"
    local rationale="$pending_dir/.${safe}.cleared-rationale"
    if [[ ! -d "$pending_dir" ]]; then
        # The directory positively does not exist ⇒ nothing was ever armed
        # here, so nothing was ever resolved. A definite negative.
        printf 'none no-pending-dir -\n'; return 0
    fi
    if [[ ! -e "$rationale" ]]; then
        printf 'none no-resolution-record -\n'; return 0
    fi
    local r_mt m_mt
    r_mt=$(stat -c %Y "$rationale" 2>/dev/null) || r_mt=""
    if [[ ! "$r_mt" =~ ^[0-9]+$ ]]; then
        printf 'unknown resolution-record-mtime-unreadable %s\n' "$rationale"; return 0
    fi
    # your-org/nexus-code#815 skeptic F6 — marker-absence is NOT evidence that an
    # orchestrator resolved anything. It is also the normal TERMINAL state of a
    # healthy round: the skeptic-role path `rm -f`s the marker when a verdict
    # lands. `.cleared-rationale` is append-only and never removed, so without a
    # recency test the timeline reads:
    #
    #   t1 orchestrator resolve (marker rm, rationale written)  -> resolved
    #   t2 deliberate --skeptic-rearm (marker written)          -> re-armed
    #   t3 skeptic returns a verdict (ng clears the marker)     -> resolved  (!)
    #
    # at t3 no orchestrator did anything. Two consequences: the banner asserts a
    # cause it has not established, and a window resolved ONCE could never arm a
    # require-gate again for the rest of that NAME's life — `require` silently
    # degrading to advisory. Window names are recycled here (`orchestrator`,
    # `bench272F`, `spawnpath`), so the state outlives the window it described.
    #
    # The fix is the one this batch already applies in retire-preflight check
    # 1c: release evidence must POST-DATE the thing it releases. A resolution is
    # CURRENT only while no later skeptic-verdict / skeptic-request for this
    # window has superseded it.
    if [[ ! -e "$marker" ]]; then
        local _sk_ev_state _sk_ev_epoch
        read -r _sk_ev_state _sk_ev_epoch \
            <<<"$(_skeptic_last_chain_event_epoch "$safe" "$raw")"
        # EMPTY output means the helper did not run — the #684 lesson again.
        [[ -n "$_sk_ev_state" ]] || { _sk_ev_state=unknown; _sk_ev_epoch=0; }
        [[ "$_sk_ev_epoch" =~ ^[0-9]+$ ]] || _sk_ev_epoch=0
        # your-org/nexus-code#825 — `unknown` gets its OWN arm and never reaches
        # `resolved`. Suppression must rest on a POSITIVE finding that the
        # resolution is current; a probe that could not look establishes nothing.
        # `unknown` here routes to the same fail-safe the caller already applies
        # to its own unknown: ARM the gate and say so loudly.
        if [[ "$_sk_ev_state" == "unknown" ]]; then
            printf 'unknown chain-event-probe-failed %s\n' "$rationale"; return 0
        fi
        if [[ "$_sk_ev_state" == "event" ]] && (( _sk_ev_epoch > r_mt )); then
            printf 'none resolution-superseded-by-later-chain-event %s\n' "$rationale"; return 0
        fi
        printf 'resolved marker-absent-since-resolution %s\n' "$rationale"; return 0
    fi
    m_mt=$(stat -c %Y "$marker" 2>/dev/null) || m_mt=""
    if [[ ! "$m_mt" =~ ^[0-9]+$ ]]; then
        printf 'unknown marker-mtime-unreadable %s\n' "$rationale"; return 0
    fi
    if (( m_mt > r_mt )); then
        printf 're-armed marker-newer-than-resolution %s\n' "$rationale"
    else
        printf 'resolved marker-not-newer-than-resolution %s\n' "$rationale"
    fi
}

# ===========================================================================
# THE OBLIGATION'S SUBJECT (your-org/nexus-code#984, #977, #963)
# ===========================================================================
#
# Until this block, a skeptic obligation WAS A FILE'S EXISTENCE:
# `skeptic/pending/<key>`, holding a depth integer. Presence means armed,
# absence means not armed, and every lifecycle transition is a mutation of
# that one bit:
#
#   ARM       writes the file   (+ a `skeptic-request` event nothing reads back)
#   DISCHARGE `rm -f`s it       (+ a `skeptic-verdict` event naming a STAMP, #963)
#   DESTROY   `rm -f`s it       (no record at all — #977)
#   RESOLVE   `rm -f`s it AND WRITES `.<key>.cleared-rationale`
#
# That last line is the DIAGNOSIS, not an aside. #815 fixed "a wrap-up
# re-arms an obligation an orchestrator resolved", and it could be fixed
# only because `resolve` leaves a RECORD. The identical bug on the VERDICT
# path (#984) survived untouched — not because the suppression logic is
# weaker there, but because it is BLIND there: `_skeptic_resolution_state`
# reads `.cleared-rationale`, a verdict writes a deletion, and a deletion is
# not evidence of anything. The only transition with a durable record is the
# only transition the re-arm check can see.
#
# So this is not a new store. It gives the two undocumented transitions the
# same durable treatment `resolve` already has, and gives the record the one
# field it has never carried: WHAT THE OBLIGATION IS ABOUT.
#
# ── Why the subject is the ARTEFACT, not the issue and not the window ──────
#
# Keying on the WINDOW is #961/#962/#963 — one window serves many tasks, so
# presence and absence are both uninformative.
#
# Keying on the ISSUE would be better and would still be WRONG HERE. A worker
# legitimately re-wraps the same issue many times as the work progresses, and
# every one of those is new work that genuinely needs validating. Suppressing
# on the issue would convert `require` into "required once per issue", which
# is a way to dodge validation — the #977 failure arriving from the other
# side.
#
# What #984 identifies is narrower and exact: A RE-PUBLICATION OF THE SAME
# BYTES. The first reviewer returned `no-further-pass` and directed
# corrections; applying corrections needs a wrap-up; that wrap-up re-armed
# and cost a second reviewer a full pass on an artefact whose verdict was
# already recorded. So the subject is the report's CONTENT HASH and the
# suppression it authorises is correspondingly narrow:
#
#   same bytes, already validated  ->  do not re-arm   (the fix)
#   one byte different             ->  arm             (the negative control)
#
# Both arms are the property; "the second request was not filed" alone is
# not, which is why the guard asserts both.
#
# ── Direction of doubt ────────────────────────────────────────────────────
#
# Every function below fails toward ARMING. No sha256 tool, an unreadable
# report, a missing ledger, a malformed line: each yields "no subject" and
# therefore no suppression. This gate ARMS validation, so doubt must not
# reduce it — the same polarity `_skeptic_resolution_state` applies to its
# own `unknown`, and the opposite of the polarity the RETIRE gates apply,
# because there doubt must not authorise an irreversible act. The two are
# consistent: in both cases doubt resolves toward MORE validation.

# ── ONE APPEND-ONLY LEDGER PER KEY, AND WHY IT IS ONE FILE ────────────────
#
# `skeptic/pending/.<key>.ledger`, holding TAB-separated lines:
#
#   armed       <sha256> <iso> <issue> <report>
#   discharged  <sha256|-> <iso> <verdict> <issue> <by> <detail>
#
# A dotfile beside the marker, deliberately: `.cleared-rationale` already
# established the convention, `BK_RETIRE_SURFACES` prunes
# `skeptic/pending/{s}` — the MARKER — not the dotfiles beside it, and no code
# anywhere globs this directory (every consumer keys by name). So the durable
# half survives a teardown by construction, which is what lets a destroyed
# obligation still be ACCOUNTED FOR (#977).
#
# ONE file rather than two, and this is load-bearing rather than tidy. The
# question every read below must answer is "which arms have not yet been
# discharged", i.e. an ORDERING question between arms and discharges. Split
# across two files the only available ordering is a TIMESTAMP COMPARE, and a
# lexicographic compare over ISO strings is simply wrong across a UTC-offset
# change — the candidate remedy that got this far was rejected for exactly
# that. Appended to one file, ORDER IS FILE ORDER: a single `awk` pass reads
# the events in the order they happened, and there is no clock in the answer
# at all.

_skeptic_ledger_file() { printf '%s/.%s.ledger' "$1" "$2"; }

# _skeptic_artefact_sha <path>
# sha256 of a file's CONTENT. Prints the hex digest and returns 0; returns 1
# and prints nothing when the file is unreadable or no sha256 tool exists.
# Portable across sha256sum / shasum / openssl, the three-way this repo
# already uses in monitor/remote-client-helper.sh.
_skeptic_artefact_sha() {
    local f="${1:-}" h=""
    [[ -n "$f" && -f "$f" && -r "$f" ]] || return 1
    if   command -v sha256sum >/dev/null 2>&1; then h=$(sha256sum   < "$f" 2>/dev/null | awk '{print $1}')
    elif command -v shasum    >/dev/null 2>&1; then h=$(shasum -a 256 < "$f" 2>/dev/null | awk '{print $1}')
    elif command -v openssl   >/dev/null 2>&1; then h=$(openssl dgst -sha256 < "$f" 2>/dev/null | awk '{print $NF}')
    fi
    [[ "$h" =~ ^[0-9a-f]{64}$ ]] || return 1
    printf '%s' "$h"
}

# _skeptic_record_arm <pending-dir> <key> <sha> <issue> <report-path>
# Append the subject of the arm being written RIGHT NOW. Append-only: no
# read-modify-write race, no temp-file dance, and round N-1 survives beneath
# round N as the audit trail. Best-effort — a state dir that cannot be written
# must not fail a wrap-up; it just means no subject was recorded and therefore
# no suppression is possible later. Failing toward arming, as everywhere here.
_skeptic_record_arm() {
    local dir="$1" key="$2" sha="$3" issue="${4:-}" report="${5:-}"
    [[ -n "$dir" && -n "$key" && -n "$sha" ]] || return 0
    printf 'armed\t%s\t%s\t%s\t%s\n' "$sha" "$(date -Is 2>/dev/null || printf '?')" \
        "${issue:--}" "${report:--}" \
        >> "$(_skeptic_ledger_file "$dir" "$key")" 2>/dev/null || true
}

# _skeptic_current_arm_sha <pending-dir> <key>
# The sha of the LAST arm, whatever its discharge state. This answers "what is
# this window's obligation about right now" — the question `retire-window`'s
# destruction record and the delta notice ask. It is NOT the question a
# discharge asks; see `_skeptic_open_arms`.
_skeptic_current_arm_sha() {
    local f; f=$(_skeptic_ledger_file "$1" "$2")
    [[ -r "$f" ]] || return 1
    local sha
    sha=$(awk -F'\t' '$1 == "armed" && $2 ~ /^[0-9a-f]{64}$/ { s = $2 } END { if (s != "") print s }' \
        "$f" 2>/dev/null) || return 1
    [[ -n "$sha" ]] || return 1
    printf '%s' "$sha"
}

# _skeptic_open_arms <pending-dir> <key>
# The DISTINCT artefacts still OUTSTANDING on this key, one per line, in
# first-armed order. Empty output means none. "Outstanding" is
# `armed` MINUS `attributed-discharged` MINUS `resolved` — see the key rule
# below; it is deliberately NOT "armed since the last discharge", which is what
# it used to be and is `#961`.
#
# ── THE ATTRIBUTION RULE, AND THE DEFECT IT REPLACES ──────────────────────
#
# This function exists because the first version of this fix took the
# discharge's subject from the CURRENT arm — the last `armed` line at the
# moment the verdict landed. That is a value read off a stamp long after the
# thing it stamped stopped being true, which is `#963`'s exact subject
# reintroduced by `#963`'s own fix. Measured sequence:
#
#   1. W arms for R1                    (the reviewer is pinned to R1)
#   2. W re-wraps a later artefact R2 while the gate is still live
#   3. the verdict lands — it reviewed R1
#      recency names R2: an artefact NOBODY reviewed
#   4. W re-wraps R2 -> suppressed. VALIDATION SILENTLY SKIPPED.
#   5. W re-wraps R1 -> armed. The wasted pass #984 exists to stop.
#
# Both failure directions in one sequence, and step 2 is the ordinary case:
# `#984`'s own live instance is a worker re-wrapping while a marker is live.
#
# THE RULE: a discharge may name an artefact only when exactly ONE was armed
# since the last discharge. With two or more, state cannot say which the
# reviewer saw, so the record says so and names NOTHING — and a `discharged`
# line naming `-` can never match a 64-hex lookup, so it is inert by
# construction rather than by a caller remembering to check.
#
# The cost is a wasted pass in that specific sequence (step 5 arms). That is
# the correct direction: this gate ARMS validation, and a wasted review is
# recoverable where a skipped one is not.
#
# WHAT WOULD MAKE IT PRECISE, AND WHY IT IS NOT DONE HERE. Recording the
# subject at SPAWN time — the moment the reviewer is actually pinned — would
# resolve most ambiguity. It is also a SPAWN-TIME STAMP, which is `#963`'s
# whole subject: it goes stale the instant a retained reviewer is re-tasked by
# paste, and nothing in state can distinguish that from a fresh pin. So the
# ambiguity is reported rather than guessed away, and closing it properly
# belongs with `#963`'s remaining half.
#
# ── THE KEY IS (WINDOW, ARTEFACT), AND THIS IS WHERE IT IS ENFORCED (#961) ──
#
# `#961` is this scan's `delete seen` on a `discharged` line. Read it as an
# English sentence and it says: ONE VERDICT CLOSES EVERY OUTSTANDING
# OBLIGATION ON THIS WINDOW, INCLUDING THE ONES IT COULD NOT NAME. That is
# `#961`'s "a cleared marker is not clearance" living inside the record built
# to replace the marker — the natural repair for a container-keyed record
# turning out to be another container-keyed record.
#
# The corrected rule is one line long and follows from the key:
#
#   ATTRIBUTED discharge (a 64-hex subject) closes EXACTLY that artefact.
#   UNATTRIBUTED discharge (`-`)            closes NOTHING.
#   RESOLVED (an audited operator release)  closes EVERYTHING outstanding.
#
# `delete seen[$2]` rather than `delete seen`. A verdict on task A no longer
# clears the obligation for task B on the same window, which is the property
# `#961` asks a two-task fixture to assert rather than describe.
#
# WHY THIS DOES NOT REGRESS `#977` F1b. That guard exists because a scan which
# never forgets an arm makes a window permanently ambiguous from its second
# distinct artefact onward — nothing is attributed again, so `#984`'s
# suppression dies by the back door. It survives here because the sequence it
# plants discharges are ATTRIBUTED: arm A -> discharge A (n=1, attributed,
# closes A) -> arm B -> discharge B (n=1, attributed). The old reset and this
# subtraction agree on every attributed discharge and differ ONLY on the
# unattributed ones — which is exactly the population `#961` is about, and the
# only population where forgetting was ever load-bearing for a leak.
#
# COST, STATED RATHER THAN HIDDEN. Two arms open and no asserted subject now
# stays ambiguous instead of resetting, so the next verdict is ambiguous too.
# That is the honest state, and `--skeptic-subject` (`#963`) is the way out of
# it: a reviewer that says what it read costs nothing and resolves it exactly.
# A THIRD ARGUMENT, `keep-superseded`, DISABLES THE SUBTRACTION — and the one
# caller that passes it is why (your-org/nexus-code#1230). Superseding is right
# for COUNTING an obligation: three revisions of one report are one thing owed.
# It is wrong for judging a reviewer's ASSERTION, because a reviewer that read
# r1 while the worker moved on to r2 asserts r1 honestly, and r1 is precisely
# what the subtraction hides. Without this the fix converts its own pole A into
# its own pole B for the sequence #963 exists to protect: measured,
# `asserted` -> `asserted-not-armed` on exactly that case.
#
# The wider set is the PRE-supersede open set — still `armed` MINUS
# attributed-discharged MINUS resolved — so an already-discharged artefact
# asserted a second time is refused exactly as it was before.
_skeptic_open_arms() {
    local f; f=$(_skeptic_ledger_file "$1" "$2")
    [[ -r "$f" ]] || return 1
    awk -F'\t' -v keepsup="${3:-}" '
        $1 == "resolved"   { delete seen; delete deliv; next }
        $1 == "discharged" { if ($2 ~ /^[0-9a-f]{64}$/) delete seen[$2]; next }
        $1 == "armed" && $2 ~ /^[0-9a-f]{64}$/ {
            if (!($2 in everseen)) { everseen[$2] = 1; order[++n] = $2 }
            # SUPERSEDE ON RE-ARM (your-org/nexus-code#1156). A DELIVERABLE is
            # (issue, report path); the sha is evidence about which REVISION of
            # it. A second arm naming the same deliverable is the same
            # obligation at a later revision, so it REPLACES the earlier open
            # arm instead of adding a second one to count.
            #
            # Without this, a worker that re-runs `wrap-up` after each report
            # edit arms N rounds against ONE file, and no single verdict can
            # ever close N arms: every discharge lands `ambiguous-N-arms-
            # outstanding`, which renders identically to a skeptic that never
            # answered. Measured on the live `.annzpr11.ledger` (three arms,
            # one path, `ambiguous-3-arms-outstanding`) and reproduced at
            # `989b888`.
            #
            # IT IS DELIBERATELY NOT WINDOW-KEYED. Arms on DIFFERENT paths stay
            # distinct and still go ambiguous, which is the honest answer —
            # state cannot say which of two artefacts the reviewer saw. That is
            # the `#963`/`#984` sequence this scan exists to protect, and the
            # B8 fixture in `test-skeptic-channel.sh` (paths `/r/b.md` and
            # `/r/c.md`) is its positive control: it must STAY ambiguous.
            #
            # An arm with no path recorded (`-`) supersedes nothing: there is
            # no deliverable to key on, so it falls through to the old
            # behaviour rather than guessing.
            if (keepsup == "" && $5 != "" && $5 != "-") {
                d = $4 SUBSEP $5
                if ((d in deliv) && deliv[d] != $2) delete seen[deliv[d]]
                deliv[d] = $2
            }
            seen[$2] = 1
        }
        END { for (i = 1; i <= n; i++) if (order[i] in seen) print order[i] }
    ' "$f" 2>/dev/null || return 1
}

# _skeptic_arm_detail <pending-dir> <key> <sha>
# The LAST `armed` line for this exact artefact, so a refusal can name WHICH
# task is outstanding rather than asserting one anonymous bit. rc 1 + no output
# on every doubt. This is `#961`'s "the flag cannot be audited" — its content is
# `1`, there is no task id, so no reader can check it and every reader must
# guess. Both guesses on the record were reasonable and both were wrong.
_skeptic_arm_detail() {
    local dir="$1" key="$2" sha="$3" f line
    [[ "$sha" =~ ^[0-9a-f]{64}$ ]] || return 1
    f=$(_skeptic_ledger_file "$dir" "$key")
    [[ -r "$f" ]] || return 1
    line=$(awk -F'\t' -v s="$sha" '$1 == "armed" && $2 == s { l = $0 } END { if (l != "") print l }' \
        "$f" 2>/dev/null) || return 1
    [[ -n "$line" ]] || return 1
    printf '%s' "$line"
}

# _skeptic_record_resolution <pending-dir> <key> <by> <reason>
# An AUDITED OPERATOR RELEASE of every outstanding arm on this key. `ng skeptic
# resolve` already writes `.cleared-rationale` and removes the marker; before
# this it wrote nothing the ledger could see, so once the ledger became
# authoritative for the kill path an operator release would have cleared the
# marker and left the obligation outstanding forever — a brick, and a brick
# teaches the `rm` bypass `resolve` exists to replace.
#
# It closes EVERYTHING rather than one artefact deliberately: unlike a verdict,
# this is a person saying "this window's validation is done", which is a
# statement about the window, and it is on the record with a mandatory
# rationale. The one transition allowed to be window-keyed is the one a human
# signed.
_skeptic_record_resolution() {
    local dir="$1" key="$2" by="${3:-}" reason="${4:-}"
    [[ -n "$dir" && -n "$key" ]] || return 0
    [[ -e "$(_skeptic_ledger_file "$dir" "$key")" ]] || return 0
    printf 'resolved\t-\t%s\t%s\t%s\n' "$(date -Is 2>/dev/null || printf '?')" \
        "${by:--}" "${reason//[$'\t\n']/ }" \
        >> "$(_skeptic_ledger_file "$dir" "$key")" 2>/dev/null || true
}

# _skeptic_resolve_subject <report-path|sha256>
# Turn what a reviewer ASSERTED into a content hash. A 64-hex string is taken
# as itself; anything else must be a readable file and is hashed. rc 1 + no
# output otherwise — a subject that cannot be resolved is refused at the call
# site rather than silently downgraded to an inference, because the whole point
# of the flag is that it is an assertion.
_skeptic_resolve_subject() {
    local arg="${1:-}"
    [[ -n "$arg" ]] || return 1
    if [[ "$arg" =~ ^[0-9a-f]{64}$ ]]; then printf '%s' "$arg"; return 0; fi
    _skeptic_artefact_sha "$arg"
}

# _skeptic_open_arm_for_path <pending-dir> <key> <issue> <report-path> <open-arms>
# The sha of the LAST STILL-OPEN arm armed against this exact (issue, report
# path) — the DELIVERABLE the reviewer says it read, at whatever revision the
# ledger pinned. Empty output + rc 1 when no open arm names that path.
#
# This exists because `--skeptic-subject <path>` (your-org/nexus-code#963)
# resolves the path to the hash of its bytes AT WRAP-UP TIME, and if the worker
# amended the report after arming, those are bytes NOBODY ARMED — and, worse,
# bytes the reviewer may never have read. The assertion the reviewer actually
# made is "I reviewed the report at this PATH"; hashing it converts that into a
# claim about a revision they did not make. Matching the path back to the arm
# recovers the assertion that was given.
_skeptic_open_arm_for_path() {
    local dir="$1" key="$2" issue="${3:-}" rpath="${4:-}" arms="${5:-}" f sha
    [[ -n "$rpath" && "$rpath" != "-" && -n "$arms" ]] || return 1
    f=$(_skeptic_ledger_file "$dir" "$key")
    [[ -r "$f" ]] || return 1
    sha=$(awk -F'\t' -v iss="${issue:--}" -v rp="$rpath" -v open="$arms" '
        BEGIN { n = split(open, a, "\n"); for (i = 1; i <= n; i++) if (a[i] != "") o[a[i]] = 1 }
        $1 == "armed" && $2 ~ /^[0-9a-f]{64}$/ && $4 == iss && $5 == rp && ($2 in o) { s = $2 }
        END { if (s != "") print s }
    ' "$f" 2>/dev/null) || return 1
    [[ "$sha" =~ ^[0-9a-f]{64}$ ]] || return 1
    printf '%s' "$sha"
}

# _skeptic_open_arms_for_issue <pending-dir> <key> <issue> <open-arms>
# The subset of the still-open arms whose LAST `armed` row names this ISSUE,
# one per line. Empty output + rc 1 when the issue is unusable or nothing
# matches. `-` is never a match: an arm with no issue recorded is not evidence
# that it is THIS issue's arm.
#
# THE LEDGER FILE IS WINDOW-KEYED AND STAYS THAT WAY (your-org/nexus-code#1252).
# Window names are recycled across tasks and days, so one file is the union of
# unrelated rounds; re-keying the FILE would strand every row already written.
# The DELIVERABLE key is (issue, report path) and this codebase already uses it
# twice — `_skeptic_open_arms`s supersede rule (`$4 SUBSEP $5`) and
# `_skeptic_open_arm_for_path`s `$4 == iss`. The ambiguity count was the one
# place that ignored it.
_skeptic_open_arms_for_issue() {
    local dir="$1" key="$2" issue="${3:-}" arms="${4:-}" f out
    [[ -n "$issue" && "$issue" != "-" && -n "$arms" ]] || return 1
    f=$(_skeptic_ledger_file "$dir" "$key")
    [[ -r "$f" ]] || return 1
    out=$(awk -F'\t' -v iss="$issue" -v open="$arms" '
        BEGIN { n = split(open, a, "\n"); for (i = 1; i <= n; i++) if (a[i] != "") o[a[i]] = 1 }
        $1 == "armed" && $2 ~ /^[0-9a-f]{64}$/ && ($2 in o) { last[$2] = $4 }
        END { for (s in last) if (last[s] == iss) print s }
    ' "$f" 2>/dev/null) || return 1
    [[ -n "$out" ]] || return 1
    printf '%s' "$out"
}

# _skeptic_record_discharge <pending-dir> <key> <verdict> <issue> <by> [asserted-sha] [asserted-path]
# Record that the obligation on <key> was discharged by a verdict, naming the
# artefact ONLY when the ledger can say which one. Returns 0 always: a
# discharge that could not be recorded is a discharge that will be re-armed
# later, which is the pre-fix behaviour and is safe.
#
# <asserted-sha> is the reviewer's own statement of what it read
# (`--skeptic-subject`, your-org/nexus-code#963). When present it WINS over the
# ledger's inference, because an assertion by the party that did the reading
# beats a count made by a script that did not. It is still checked against the
# outstanding set, and a subject nobody armed is recorded as such rather than
# rejected or silently believed: `asserted-not-armed` names an artefact, so the
# record is checkable, and it closes nothing, because `delete seen[$2]` can only
# close a sha that is actually outstanding. Doubt still arms.
#
# ── THE FINAL VERDICT USED TO BE THE ONE THAT COULD NOT LAND (#1191) ──────
#
# `n == 0` — nothing outstanding — used to `return 0` having written NOTHING,
# and that is the whole of `#1191`. A chain whose last round was cleanly
# attributed has no open arm left, so the terminal verdict that CONCLUDES it
# arrives against an empty outstanding set and is dropped. Measured on the live
# `.olimit2.ledger`: two `check` rounds, both `attributed`, `open=0`, and then
# three `credible` verdicts filed by the documented verb which left the file
# BYTE-IDENTICAL. `your-org/nexus-code#1171` merged on the third of them while
# `ng skeptic-evidence olimit2` reported `standing_verdict=check`.
#
# The inverse of what a ledger is for: every intermediate verdict re-arms and
# lands, and the one that says *this is done* has nothing left to attach to.
#
# WHY THE ORIGINAL RATIONALE WAS RIGHT AND IS NOW ONLY HALF-RIGHT. It reads:
# "the ledger would otherwise grow a discharge record for a marker this codebase
# never armed (spawn-worker re-establishes markers without a subject), and an
# entry that names no artefact and answers no question is noise". True — of a
# key with NO LEDGER AT ALL. It stopped being true of a key WITH one the moment
# `#1156` made `_skeptic_verdict_evidence` the reader that answers "does a
# verdict exist": for that reader the row is not noise, it IS the answer, and
# dropping it produces `evidence=none` — "the verdict is GENUINELY ABSENT, a
# review is what is missing" — about a review that happened.
#
# So the two cases are separated by the one observation that distinguishes them,
# the ledger FILE's existence:
#
#   ledger absent   nothing ever armed this key WITH A SUBJECT. RECORDED as
#                   `no-arm-on-record` (#1207) — the verdict is real even when
#                   the arm never named an artefact, and dropping the row
#                   reported `evidence=none` about a review that happened.
#                   The row's subject is `-`, so it suppresses nothing.
#   ledger present  something armed it and every arm has since closed. The
#                   verdict is REAL and is recorded as `no-open-arm`.
#
# `sha` stays `-`, so the new row is INERT by the same construction every other
# unattributed row relies on: `_skeptic_artefact_discharged` and
# `_skeptic_open_arms`'s `delete seen[$2]` both require 64-hex, so it closes
# nothing, suppresses nothing and authorises nothing. It is a RECORD, and only a
# record — which is exactly what was missing.
#
# `_SK_DISCHARGE_RECORDED` is set to 1/0 for the caller, so a wrap-up that
# printed `verdict : credible` over a write that did not happen can say so. That
# silent success-shaped output is the half of #1191 that made it durable: the
# author had no cue to check.
_skeptic_record_discharge() {
    local dir="$1" key="$2" verdict="${3:-}" issue="${4:-}" by="${5:-}" asserted="${6:-}" asserted_path="${7:-}"
    _SK_DISCHARGE_RECORDED=0
    _SK_DISCHARGE_DETAIL=""
    [[ -n "$dir" && -n "$key" ]] || return 0
    local arms n sha detail ledger drift="" path_arm=""
    ledger=$(_skeptic_ledger_file "$dir" "$key")
    arms=$(_skeptic_open_arms "$dir" "$key") || arms=""
    n=$(printf '%s' "$arms" | grep -c . 2>/dev/null) || n=0
    [[ "$n" =~ ^[0-9]+$ ]] || n=0
    # THE ASSERTION IS JUDGED AGAINST THE WIDER SET (#1230). `arms` has had
    # superseded revisions of a deliverable subtracted, which is right for
    # counting and wrong for believing a reviewer: it read what it read, and a
    # worker's later re-wrap cannot retroactively make that a lie. `n` and the
    # ambiguity arms below keep using the narrow set.
    local arms_incl_superseded
    arms_incl_superseded=$(_skeptic_open_arms "$dir" "$key" keep-superseded) || arms_incl_superseded=""
    if [[ "$asserted" =~ ^[0-9a-f]{64}$ ]]; then
        sha="$asserted"
        if grep -qx "$asserted" <<<"$arms_incl_superseded"; then detail="asserted"
        else
            # ── THE ASSERTION WAS A PATH, AND HASHING IT LOST IT (#1156) ────
            #
            # A reviewer that passed `--skeptic-subject <report-path>` asserted
            # a DELIVERABLE. The hash above is of that path's bytes at WRAP-UP
            # time, and a worker that amended the report after arming has moved
            # them off the arm — so the assertion is refused as
            # `asserted-not-armed` even though the reviewer named exactly the
            # thing that was armed. Measured five times on the live
            # `.annzfix.ledger` and reproduced at `989b888`.
            #
            # When the PATH matches a still-open arm on the same issue, the
            # verdict attributes to THAT arm. `sha` becomes the ARMED sha, so
            # the row closes the arm by the identical 64-hex construction every
            # other reader already relies on (`delete seen[$2]`) — no reader
            # needs to learn a new closing rule.
            #
            # The detail is a DISTINCT class, never `asserted`: this issue is
            # about states that render identically, and "the reviewer read the
            # revision that was armed" and "the reviewer read a LATER revision
            # of the same deliverable" are different facts. Field 8 carries the
            # hash the reviewer actually held, so the drift is auditable rather
            # than asserted away. It is the ONLY row shape with 8 fields; every
            # other stays at 7, so the `NF < 7` truncation rule downstream is
            # untouched.
            if [[ -n "$asserted_path" ]]; then
                path_arm=$(_skeptic_open_arm_for_path "$dir" "$key" "$issue" "$asserted_path" "$arms") || path_arm=""
            fi
            if [[ -n "$path_arm" ]]; then sha="$path_arm"; detail="asserted-path"; drift="$asserted"
            else                          detail="asserted-not-armed"
            fi
        fi
    elif (( n == 1 )); then sha="$arms";  detail="attributed"
    elif (( n == 0 )); then
        # TWO DIFFERENT SHAPES, AND BOTH ARE RECORDED (your-org/nexus-code#1191,
        # #1207).
        #
        # `no-open-arm` — a ledger exists and everything on it is discharged. The
        # ordinary terminal verdict of a chain whose last round closed cleanly.
        #
        # `no-arm-on-record` — there is no ledger at all, so nothing ever armed
        # this key with a subject.
        #
        # ── WHY THE SECOND IS NO LONGER DROPPED ───────────────────────────────
        #
        # This arm used to `return 0` without writing, reasoning that "a `-` row
        # there would assert a verdict about a key with no history, which is the
        # one claim worse than the behaviour being replaced". The premise is right
        # and the conclusion inverts it, because the row asserts something
        # narrower than "this key has history": it asserts that A VERDICT WAS
        # DELIVERED, and that is simply true. `_skeptic_record_discharge` is
        # reached only from the wrap-up verdict path — as
        # `_skeptic_verdict_evidence`'s header puts it, "the row IS the verdict".
        #
        # The dangerous claim that header warns about is *a verdict exists when
        # none does*, because it invites releasing a gate on a pass that never
        # happened. Dropping the row produces the mirror error and it is not the
        # safe one: the key then reports `evidence=none`, documented in the same
        # header as "a POSITIVE claim ('nothing has ever settled this key')",
        # whose instruction to the operator is *nobody reviewed the work, get a
        # review*. Measured on this tree: a `credible` verdict from a real
        # reviewer, written nowhere, at rc 0, with the operator pointed at a
        # duplicate review of finished work.
        #
        # Nor does the row authorise anything. Its subject is `-`, so it can
        # never satisfy `_skeptic_artefact_discharged` (64-hex required) and can
        # close no arm — `delete seen[$2]` only fires on a sha. It records the
        # verdict and nothing else, which is exactly what was missing.
        #
        # The alternative on offer was an operator NOTICE saying the record needs
        # repairing by hand. That is strictly weaker: it leaves a false claim
        # standing on the ledger and asks a human to work around it, and this
        # repo's own rule is that a guard which trains its own bypass is worse
        # than no guard.
        #
        # The population is small and shrinking — `spawn-worker.sh` now records
        # the arm it establishes (#1207), which is what created this shape — but
        # it is not empty: markers predating the ledger feature (`8a2f36e`,
        # 2026-08-26) still land here, and two were live when this was written.
        if [[ -e "$ledger" ]]; then sha="-"; detail="no-open-arm"
        else                        sha="-"; detail="no-arm-on-record"
        fi
    else
        # NARROW BY ISSUE BEFORE DECLARING AMBIGUITY (your-org/nexus-code#1252).
        # A reused window name accumulates arms from unrelated tasks, so a
        # verdict on the CURRENT round lands `ambiguous-N` and attributes
        # NOTHING — measured: a three-round accumulation on one name reports
        # `open=3`, and 25 of the 31 ambiguous rows in the live pending dir
        # (2026-09-02) have exactly ONE open arm on the discharge's own issue.
        #
        # THE DOCTRINE IS UNCHANGED, ONLY THE SET IT RANGES OVER. "State cannot
        # say which artefact the reviewer saw" is still the rule; the reviewer's
        # own wrap-up `--issue` says which TASK it saw, and the arms carry the
        # same field. Two arms on ONE issue stay ambiguous — that is the
        # `#963`/`#984` sequence (a worker re-wrapping its own report) and the
        # B8 fixture in `test-skeptic-channel.sh`, both same-issue by
        # construction.
        #
        # IT CANNOT RELEASE A GATE THAT WOULD OTHERWISE REFUSE. It fires only
        # when n > 1, and it closes exactly ONE arm, so `open` falls to n-1 >= 1
        # and `retire-preflight` check 1b still refuses. The only thing that
        # changes is whether the verdict is ATTRIBUTED or lost.
        local _sk_narrow="" _sk_nn=0
        if [[ -n "$issue" && "$issue" != "-" ]]; then
            _sk_narrow=$(_skeptic_open_arms_for_issue "$dir" "$key" "$issue" "$arms") || _sk_narrow=""
        fi
        _sk_nn=$(printf '%s' "$_sk_narrow" | grep -c . 2>/dev/null) || _sk_nn=0
        [[ "$_sk_nn" =~ ^[0-9]+$ ]] || _sk_nn=0
        if (( _sk_nn == 1 )); then sha="$_sk_narrow"; detail="attributed-by-issue"
        else                       sha="-";           detail="ambiguous-${n}-arms-outstanding"
        fi
    fi
    # ── IDEMPOTENT ON (sha, verdict, issue, by) WITHIN A ROUND (your-org/nexus-code#1370)
    #
    # This append used to be unconditional, so three identical `ng wrap-up`
    # invocations wrote three rows — and two of those were attempts to RE-READ
    # truncated output, not verdicts (`.warm.ledger`, 2026-09-02). Identical
    # re-recordings can neither supersede nor be superseded, so they made
    # `unmatched` permanent, and last-write-wins then made a `sha=-` row the
    # STANDING one over the attributed row that carried the evidence.
    #
    # A row is a DUPLICATE when a prior `discharged` row carries the same
    # verdict, issue and author, the same subject — or, for a candidate that
    # attributes NOTHING (`sha=-`), ANY subject, since a `-` row adds no
    # information over an attributed row for the same tuple — and NO `armed`
    # or `resolved` row has landed since that prior row. The round boundary
    # is the load-bearing half, and it is #1366's negative control: a
    # legitimate second review round MUST still append. A re-arm between two
    # discharges — a different sha, so a different tuple, or the SAME sha
    # re-armed, which re-opens the arm and needs a fresh discharge to close it
    # — always yields two rows. A dedup on (verdict, issue, by) alone, or on
    # adjacency, or on a time window, looks equivalent and silently destroys
    # a real second verdict; the ledger then reads CLEANER, which is the
    # failure direction that survives review. So the boundary is checked, not
    # assumed.
    #
    # A drift row (8 fields, `asserted-path`) matches only a prior row holding
    # the same drift hash: a reviewer that read a DIFFERENT later revision has
    # said something new.
    local _sk_dup=""
    if [[ -r "$ledger" ]]; then
        _sk_dup=$(awk -F'\t' -v sha="$sha" -v v="${verdict:--}" -v iss="${issue:--}" \
                      -v by="${by:--}" -v drift="$drift" '
            $1 == "armed" || $1 == "resolved" { last = "" ; next }
            $1 == "discharged" && NF >= 7 {
                if ($4 != v || $5 != iss || $6 != by) next
                if (sha != "-" && $2 != sha) next
                if (drift != "" && (NF < 8 || $8 != drift)) next
                if (drift == "" && NF >= 8) next
                last = $7
            }
            END { if (last != "") print last }
        ' "$ledger" 2>/dev/null) || _sk_dup=""
    fi
    if [[ -n "$_sk_dup" ]]; then
        # Already on the ledger, in this round. RECORDED=1 is the truth here —
        # a matching row exists — and the detail names the row it duplicates,
        # so the banner reads `recorded (already-recorded:attributed)` rather
        # than claiming a fresh append.
        _SK_DISCHARGE_RECORDED=1; _SK_DISCHARGE_DETAIL="already-recorded:${_sk_dup}"
        return 0
    fi
    if [[ -n "$drift" ]]; then
        printf 'discharged\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$sha" \
            "$(date -Is 2>/dev/null || printf '?')" \
            "${verdict:--}" "${issue:--}" "${by:--}" "$detail" "$drift" \
            >> "$ledger" 2>/dev/null \
            && { _SK_DISCHARGE_RECORDED=1; _SK_DISCHARGE_DETAIL="$detail"; }
    else
        printf 'discharged\t%s\t%s\t%s\t%s\t%s\t%s\n' "$sha" \
            "$(date -Is 2>/dev/null || printf '?')" \
            "${verdict:--}" "${issue:--}" "${by:--}" "$detail" \
            >> "$ledger" 2>/dev/null \
            && { _SK_DISCHARGE_RECORDED=1; _SK_DISCHARGE_DETAIL="$detail"; }
    fi
    return 0
}

# _skeptic_last_discharged_sha <pending-dir> <key>
# THE MOST RECENT DISCHARGE, WHATEVER ITS STATE (your-org/nexus-code#1069).
# Prints its subject — a 64-hex sha when the discharge was attributed, or the
# literal `-` when it attributed nothing. rc 1 + no output only when there is no
# discharge line at all. Used only to say WHY a delta notice fired; it
# authorises nothing.
#
# ── WHAT THIS USED TO DO, AND WHY IT WAS WRONG ────────────────────────────
#
# It selected the last discharge CARRYING A 64-HEX SHA, which SKIPS an
# ambiguous (`-`) discharge and silently returns the previous ATTRIBUTED one.
# So with the ledger `arm A -> discharge A -> arm B -> arm C -> discharge
# ambiguous`, it returned A: not the last verdict, and the last discharge
# attributed nothing at all. The notice then told a reviewer "the report CHANGED
# since your last recorded verdict (A -> C)" — a stated fact that is not true,
# inside the notice whose entire purpose is to stop a reviewer re-deriving
# something. A confidently-wrong reason is a WORSE failure for that surface than
# no reason, because the reviewer has no cue to check.
#
# The `-` is returned rather than swallowed so the caller can branch to the
# IGNORANCE arm the no-record case already uses. That is the polarity every
# other arm of this gate applies: doubt is stated, never resolved toward the
# comfortable answer. A `-` can still never match a 64-hex lookup, so
# `_skeptic_artefact_discharged` — the arm that actually authorises suppression
# — is unaffected, exactly as #1067 relies on.
_skeptic_last_discharged_sha() {
    local f; f=$(_skeptic_ledger_file "$1" "$2")
    [[ -r "$f" ]] || return 1
    local sha
    sha=$(awk -F'\t' '$1 == "discharged" { s = $2 } END { if (s != "") print s }' \
        "$f" 2>/dev/null) || return 1
    [[ -n "$sha" ]] || return 1
    printf '%s' "$sha"
}

# _skeptic_artefact_discharged <pending-dir> <key> <sha>
# rc 0 + the matching ledger line when THIS EXACT artefact already has an
# attributed verdict against it; rc 1 otherwise, including every doubt. The
# `$2 == s` test against a 64-hex `s` is what makes an ambiguous (`-`)
# discharge inert.
_skeptic_artefact_discharged() {
    local dir="$1" key="$2" sha="$3" f line
    [[ -n "$dir" && -n "$key" ]] || return 1
    [[ "$sha" =~ ^[0-9a-f]{64}$ ]] || return 1
    f=$(_skeptic_ledger_file "$dir" "$key")
    [[ -r "$f" ]] || return 1
    line=$(awk -F'\t' -v s="$sha" '$1 == "discharged" && $2 == s { l = $0 } END { if (l != "") print l }' \
        "$f" 2>/dev/null) || return 1
    [[ -n "$line" ]] || return 1
    printf '%s' "$line"
}

# _skeptic_close_settlement <pending-dir> <key>
# rc 0 + the last `resolved` line IFF this key is recorded as SETTLED and
# NOTHING has armed since. rc 1 otherwise (your-org/nexus-code#1209).
#
# WHY IT EXISTS. A `close` is the CREDITOR's terminal act; a wrap-up is the
# DEBTOR's. A debtor may not reopen an obligation its creditor recorded as
# settled — which is exactly what the `resolved` arm above already enforces for
# `ng skeptic resolve`. `close` was merely INVISIBLE to that reader, because it
# keys on `pending/.<key>.cleared-rationale`, a file `close` does not write. So
# this is not a new concept; it is the existing one applied to the record it
# was blind to. Two verbs write a `resolved` row and only one of them writes
# that file.
#
# `armed_since` IS THE LOAD-BEARING NARROWING. Any `armed` row after the
# `resolved` row disables this entirely, and `spawn-worker.sh` appends one via
# `ng skeptic-arm` whenever the orchestrator appoints a reviewer. Re-opening
# therefore stays fully available to the party entitled to do it; only the
# debtor's silent SELF-re-arm is stopped. `--skeptic-rearm` overrides on the
# record, as it does for the two existing suppressions.
#
# Failure direction is ARM: absent, unreadable or malformed ledger -> rc 1 ->
# the gate arms exactly as before.
_skeptic_close_settlement() {
    local f line; f=$(_skeptic_ledger_file "$1" "$2")
    [[ -r "$f" ]] || return 1
    line=$(awk -F'\t' '
        $1 == "resolved" { if (NF >= 3) { l = $0; armed_since = 0 } next }
        $1 == "armed"    { if ($2 ~ /^[0-9a-f]{64}$/) armed_since = 1; next }
        END { if (l != "" && armed_since == 0) print l }
    ' "$f" 2>/dev/null) || return 1
    [[ -n "$line" ]] || return 1
    printf '%s' "$line"
}

# _skeptic_verdict_evidence <pending-dir> <key>
# WHAT THE LEDGER RECORDS ABOUT VERDICTS — the read that separates "no verdict
# exists" from "a verdict exists and the bookkeeping could not match it"
# (your-org/nexus-code#1156).
#
# ── WHY THIS EXISTS ──────────────────────────────────────────────────────
#
# Four times in one afternoon a window could not retire on a "missing" skeptic
# verdict that had in fact been DELIVERED, by four different mechanisms, and
# every one of them printed the same refusal:
#
#   annzfix       5 x `asserted-not-armed`  the report was AMENDED after arming,
#                                           so the content hash moved off the arm
#   annzpr11      `ambiguous-3-arms-…`      3 wrap-ups armed 3 rounds against ONE
#                                           report path; one discharge cannot
#                                           close three arms
#   devred        discharged + resolved,    a wrap-up RE-ARMED a closed chain,
#                 then a later `armed`      20 min after close
#   annzmerge     `asserted-not-armed`      + a live edge in the OTHER ledger
#   clmd          `asserted`, then a LATER   the reviewer re-derived both findings
#                 `asserted-not-armed`       against a head that moved MID-REVIEW,
#                                            and amending its report to publish
#                                            that moved the hash off the arm
#
# THE FIFTH IS THE STRONGEST ARGUMENT FOR THIS READ, and it is a different
# failure from the other four. They are ordinary bookkeeping — a re-run, a
# post-arm edit, a re-arm after close, a second ledger — and they make a verdict
# INVISIBLE. This one makes it WRONG: the ledger records the weaker FIRST verdict
# as matched and the stronger, later, more thorough one as unmatched, so an
# automated reader taking the attributed row gets `check` where the standing
# verdict is `credible`. And it fires precisely BECAUSE the skeptic did the
# harder, more correct thing — a reviewer that ignored the moving head, or
# re-armed and started over, would have recorded cleanly. A bookkeeping layer
# whose failure mode selects AGAINST the behaviour the protocol wants is a design
# fault, not an accounting gap. So: two discharges for one arm is a LEGITIMATE
# state, a superseding verdict is not a duplicate, and the ordering matters more
# than the attribution.
#
# The rows already differ. Only the reader did not. "A verdict exists but could
# not be matched to an arm" is a DIFFERENT INSTRUCTION to the orchestrator than
# "no verdict exists" — the first says fix the bookkeeping, the second says get
# a review — and printing them identically cost, on that one board, three
# duplicate `spawn-skeptic` requests (one for a PR that had already merged) and
# two pushes against skeptics that had already discharged.
#
# ── THE SAFE DIRECTION, WHICH IS THE WHOLE DESIGN ────────────────────────
#
# The dangerous error is claiming a verdict exists when none does: that invites
# an operator to release a gate on a pass that never happened. So a verdict is
# NEVER inferred. It is counted only from a `discharged` row PHYSICALLY PRESENT
# in this ledger and carrying a non-empty verdict field — never from an arm,
# never from a marker, never from a resolution, never from a report on disk.
# `_skeptic_record_discharge` is the only writer of that row and it is reached
# only from the wrap-up verdict path, so the row IS the verdict.
#
# Everything this cannot establish reports `?`, which asserts nothing in either
# direction: an unknown row type, a truncated row, or an `armed` row whose
# subject is not a sha. `none` is a POSITIVE claim ("nothing has ever settled
# this key") and is therefore reachable only from a fully-parsed ledger.
#
# ORDER, NOT TIMESTAMPS. The ledger is append-only, so line order IS time
# order. Comparing the ISO stamps would work today and would rot the first time
# two rows carry different UTC offsets — and this host's python cannot parse
# them anyway (`datetime.fromisoformat` is 3.7+; #935).
#
# OUTPUT — one line, key=value, no tabs:
#   evidence=<class> verdicts=<n> unmatched=<n> resolutions=<n> open=<n>
#   last_verdict=<v|-> last_by=<w|-> last_at=<iso|-> last_detail=<d|->
#
# CLASSES, most specific first (the precedence is the order below):
#   rearm-after-close             every open arm was armed AFTER the last
#                                 discharge/resolution — the chain was closed
#                                 and something re-armed it (#1156 pole C)
# NOTE there is deliberately NO class for "supersession could not be
# established". It was tried and removed: placed ABOVE the definite matching
# classes it let an admission of ignorance about the SUPERSESSION question mask
# `ambiguous-arms` or `unmatched-subject`, which answer the MATCHING question;
# placed below them it is UNREACHABLE, because the only way a later verdict row
# can exist after a matched one is for that later row to be unmatched, which
# already wins. A single-winner precedence chain is simply the wrong shape for a
# property orthogonal to the one it ranks. The relation rides `superseded=?`
# and `superseded_why=` instead — its own field, like the established case.
#
#   superseded-verdict            a verdict row exists AFTER the last cleanly-
#                                 matched one, so the row that ATTRIBUTES is not
#                                 the STANDING verdict. A reader taking the
#                                 attributed row gets the superseded answer —
#                                 seeing a verdict WRONG, which is worse than
#                                 not seeing it (#1156, the `clmd` case)
#   ambiguous-arms                a verdict could not choose among N arms (pole B)
#   unmatched-subject             a verdict names an artefact nobody armed (pole A)
#   no-open-arm                   a verdict arrived with NOTHING OUTSTANDING — the
#                                 terminal verdict of a chain whose last round
#                                 closed cleanly. Delivered, matched to nothing,
#                                 and until #1191 not recorded at all
#   unmatched-other               a verdict exists; its detail is one this reader
#                                 does not know, so matching is UNESTABLISHED
#   prior-verdict-other-artefact  verdict(s) on record, all attributed to OTHER
#                                 artefacts — the open arm genuinely has none
#   attributed                    a verdict is attributed and nothing is open
#   discharge-without-verdict     a settle row exists naming no verdict
#   resolved-only                 an operator resolution, no verdict
#   none                          nothing has ever settled this key
#   ?                             could not classify; asserts NOTHING
#
# rc 0 = looked · 1 = no ledger · 2 = ledger present but unreadable.
_skeptic_verdict_evidence() {
    local dir="${1:-}" key="${2:-}" f
    [[ -n "$dir" && -n "$key" ]] || return 1
    f=$(_skeptic_ledger_file "$dir" "$key")
    [[ -e "$f" ]] || return 1
    [[ -r "$f" ]] || return 2
    awk -F'\t' '
        $1 == "armed" {
            if (NF < 3) { malformed++; next }
            if ($2 ~ /^[0-9a-f]{64}$/) {
                if (!($2 in everseen)) { everseen[$2] = 1; order[++n] = $2 }
                # SUPERSEDE ON RE-ARM — THE SAME RULE `_skeptic_open_arms`
                # APPLIES, AND IT MUST BE THE SAME RULE (#1156). This renderer
                # answers `open=` with its OWN scan rather than by calling that
                # function, so the two are a divergence waiting to happen: the
                # first cut of #1156 taught the function to collapse revisions
                # of one deliverable and left this scan counting three, so
                # `_skeptic_open_arms` said 1 while `ng skeptic-evidence` said
                # 3 — and the renderer is what `retire-preflight` and the kill
                # gate read, so the operator-visible symptom would have
                # survived its own fix. Measured before this line existed.
                #
                # A DELIVERABLE is (issue, report path); the sha says which
                # REVISION. Arms on different paths, or the same path on a
                # different issue, stay distinct. An arm with no path recorded
                # supersedes nothing. The agreement between the two scans is
                # asserted by `test-skeptic-arm-recording.sh`.
                if ($5 != "" && $5 != "-") {
                    dlv = $4 SUBSEP $5
                    if ((dlv in deliv) && deliv[dlv] != $2) delete seen[deliv[dlv]]
                    deliv[dlv] = $2
                }
                seen[$2] = 1; lastarm[$2] = NR
                # Every arm in FILE ORDER, for the staleness question in END
                # (your-org/nexus-code#1199). Order is time order, so no clock.
                armnr[++na] = NR; armsha[na] = $2
                lastarmnr = NR   # the round boundary the #1370 standing rule reads
            } else { malformed++ }
            next
        }
        $1 == "discharged" {
            # A WELL-FORMED discharge row carries 7 fields, or 8 in the one
            # shape that has drift evidence to carry (`asserted-path`,
            # your-org/nexus-code#1156 — field 8 is the hash the reviewer held
            # when the armed bytes had moved). Nothing below reads past `$7`,
            # so the extra field is inert to every consumer.
            #
            # The rule that matters here is the SHORT one, and it is unchanged:
            # the writer emits fixed-arity printfs and every row in this nexus
            # live corpus measured NF=7 when this was written, so NF<7 is
            # truncation rather than an older schema. It must NOT be read as
            # "a verdict exists": that is
            # the one claim whose being wrong is worse than the behaviour it
            # replaces, because it invites an operator to release a gate on a
            # pass that never happened. Short rows go to `?`, which asserts
            # nothing in either direction.
            if (NF < 7) { malformed++; next }
            settle = NR
            if ($4 != "" && $4 != "-") {
                verdicts++
                # STANDING = the LAST verdict row, whatever its detail. The
                # ordering matters more than the attribution: a reader that takes
                # the cleanly-ATTRIBUTED row can be handed a SUPERSEDED verdict,
                # which is worse than being handed none.
                #
                # ONE EXCEPTION — ATTRIBUTABLE BEATS RECENT WHEN NOTHING ELSE
                # DIFFERS (your-org/nexus-code#1370). A later row with `sha=-`
                # carrying the SAME verdict, issue and author as the standing
                # row, with no `armed`/`resolved` row in between, is a
                # RE-RECORDING of the same verdict that attributes nothing — a
                # re-run of the verb, not a new round. Last-write-wins then
                # selected the row with the LEAST evidence (`.warm.ledger`:
                # `standing_*` pointed at the 17:08 `no-open-arm` row, while
                # the 16:59 `attributed` row for the same tuple carried the
                # sha). The writer now refuses such rows; this reads the
                # ledgers written before it did. A `-` row with a DIFFERENT
                # verdict, or one landing after a re-arm, is new information
                # and stands as before.
                by6 = ($6 != "" ? $6 : "-")
                if ($2 == "-" && standsubj ~ /^[0-9a-f]{64}$/ && standv == $4 \
                    && standissue == $5 && standby == by6 \
                    && lastvline > lastarmnr + 0 && lastvline > lastresnr + 0) {
                    standing_kept_over_dash++
                } else {
                    lastvline = NR
                    standv = $4; standat = $3; standd = $7
                    standissue = $5; standsubj = $2
                    standby = by6
                }
                d = $7
                # The last verdict row that NAMED an artefact, whatever its
                # detail — the reference the #1199 staleness axis compares
                # against. NOT the same as the standing row: #1191 recovers a
                # terminal verdict carrying `sha=-`, which then becomes the
                # standing row and names nothing.
                #
                # DELIBERATELY ABOVE THE if/else-if CHAIN BELOW, NOT INSIDE IT.
                # Placed between the `if {...}` and its first `else if`, this
                # statement RE-PARENTS the chain: the detail arms then hang off
                # THIS condition instead of the match test, and `unmatched-
                # subject` silently became `prior-verdict-other-artefact`. Six
                # assertions caught it. A bare statement dropped into an
                # else-chain changes control flow without changing any arm.
                if ($2 ~ /^[0-9a-f]{64}$/) { refline = NR; refsha = $2 }
                # `asserted` and `attributed` are BOTH clean matches — the first
                # is the reviewer stating what it read (--skeptic-subject, #963),
                # the second the ledger inferring it from a single open arm.
                # Counting `asserted` as unrecognised reported `unmatched` for a
                # row that matched perfectly: a claim in the WRONG direction, and
                # the live `clmd` ledger is what caught it.
                # `attributed-by-issue` (your-org/nexus-code#1252) is a CLEAN
                # match: several arms were open, exactly one of them named the
                # issue the discharge itself names, and `$2` carries the sha of that
                # arm, so it
                # closes the arm by the identical 64-hex construction. It is a
                # DISTINCT token because the evidence differs — a single open
                # arm versus a deliverable-key narrowing — and the token is
                # taught to this chain in the same commit that writes it, or it
                # would silently demote to `unmatched-other`.
                if (d == "attributed" || d == "asserted" || d == "attributed-by-issue") {
                    matched++; matchedline = NR; attrv = $4; attrat = $3
                    attrissue = $5
                }
                else if (d == "asserted-not-armed") {
                    unmatched_subject++
                    # ONE LABEL OVER TWO CONDITIONS (your-org/nexus-code#1252).
                    # `asserted-not-armed` says "the reviewer named bytes that
                    # are not on the outstanding set" and stops there, so two
                    # situations with OPPOSITE remedies print identically:
                    # the arm for those bytes was already DISCHARGED (a second
                    # verdict on reviewed work — the record is fine, nothing is
                    # owed), and the bytes were NEVER armed here at all (the ARM
                    # is what is wrong, and the artefact may be unreviewed).
                    # Measured on the live pending dir 2026-09-02: 5 of 58 rows
                    # are the first, 53 the second.
                    #
                    # THE DETAIL TOKEN IS UNTOUCHED. It SELECTS — this chain and
                    # `_sk_ev_explain` both match it exactly — so a new token
                    # would silently demote every such row to `unmatched-other`
                    # ("a detail this gate does not recognise"). The honesty goes
                    # on a `_why` field, exactly as `superseded_why` and
                    # `standing_stale_why` already do.
                    #
                    # `everseen` holds the arms seen SO FAR, which is the right
                    # scope: the question is what was outstanding when this
                    # verdict landed, not what was armed afterwards. The LAST
                    # such row wins, and the field is about the standing one when
                    # the standing row is this class.
                    if ($2 in everseen)
                        unmatched_why = "asserted-bytes-WERE-armed-here-and-that-arm-is-already-discharged"
                    else
                        unmatched_why = "asserted-bytes-were-NEVER-armed-here-the-ARM-named-something-else"
                }
                # `asserted-path` (your-org/nexus-code#1156) — the reviewer
                # named the DELIVERABLE (a report path) that was armed, and the
                # bytes at that path had moved since. It MATCHES: `$2` carries
                # the ARMED sha, so it closes the arm exactly as `attributed`
                # does, and field 8 carries the hash the reviewer held. Folding
                # it into `unmatched_other` would report "whether it matches is
                # UNESTABLISHED" about a row that establishes it.
                else if (d == "asserted-path") {
                    matched++; matchedline = NR; attrv = $4; attrat = $3
                    attrissue = $5
                }
                else if (d ~ /^ambiguous-/)         ambiguous++
                # `no-open-arm` (your-org/nexus-code#1191) — a REAL verdict that
                # arrived with nothing outstanding, which is the ordinary shape
                # of the TERMINAL verdict in a chain whose last round closed
                # cleanly. It is unmatched (it names no artefact and closes
                # nothing) but it is not UNRECOGNISED, and the two say opposite
                # things to a reader: `unmatched-other` means "whether it
                # matches is UNESTABLISHED", where this is established — there
                # was nothing to match.
                else if (d == "no-open-arm")        noopenarm++
                # A VERDICT ON A KEY WITH NO LEDGER AT ALL — distinct from
                # `no-open-arm`, which means a ledger exists and everything on
                # it is discharged. Different causes and different remedies:
                # there the chain closed cleanly and nothing is owed, here
                # nothing ever ARMED the key with a subject, so the repair is
                # to the arm. Folding them together would hand the operator
                # one instruction for two situations (#1191, #1207).
                else if (d == "no-arm-on-record")   noarm++
                else                                unmatched_other++
            } else { voidv++ }
            if ($2 ~ /^[0-9a-f]{64}$/) delete seen[$2]
            next
        }
        $1 == "resolved" {
            if (NF < 3) { malformed++; next }
            settle = NR; lastresnr = NR; resolutions++; delete seen; delete deliv; next
        }
        { malformed++ }
        END {
            open = 0; minopen = 0
            for (i = 1; i <= n; i++) if (order[i] in seen) {
                open++
                if (minopen == 0 || lastarm[order[i]] < minopen) minopen = lastarm[order[i]]
            }
            unmatched = unmatched_subject + ambiguous + unmatched_other + noopenarm + noarm
            # SUPERSEDED — a verdict row exists AFTER the last cleanly-matched
            # one, so the row that attributes cleanly is NOT the standing
            # verdict. Two discharges for one arm is a LEGITIMATE state, not an
            # error: a reviewer that re-derives its findings against a head that
            # moved mid-review must amend its report to publish that, and the
            # amendment moves the content hash off the arm. The bookkeeping then
            # records the WEAKER first verdict as matched and the stronger later
            # one as unmatched. Left unnamed, this layer selects AGAINST the
            # behaviour the protocol wants.
            #
            # ── A LATER ROW IS NOT AUTOMATICALLY A SUPERSEDING ONE ────────────
            #
            # The first draft decided this from LINE ORDER ALONE, which is
            # window-keyed newest-wins — the exact container error `#1156` exists
            # to fix, and `#962` forbids it. It did not re-enter through the
            # GATE, which never consults this; it re-entered through the
            # INSTRUCTION, and the instruction is what an operator acts on. A
            # rule can be forbidden in the decision path and come back in the
            # prose. Measured on a planted ledger: `credible` on issue 1156 by
            # `sk-a`, then `suspect` on issue 1200 by `sk-b`, and the refusal
            # said "the STANDING verdict is `suspect` … Take the LATER one" —
            # two verdicts on DIFFERENT TASKS, with the instruction discarding a
            # valid one.
            #
            # So supersession is established from the ISSUE ($5), not from
            # order, and it has THREE states because the honest answer is often
            # that it cannot be established at all:
            #
            #   1  same issue, DIFFERENT verdict — the dangerous case: a reader
            #      taking the attributed row gets an answer that no longer holds
            #   0  different issues (unrelated TASKS; neither supersedes the
            #      other), or the same verdict recorded twice (a RE-RECORD, not
            #      a supersession — nothing is weaker or stronger about two
            #      identical strings, and the loud clause was FALSE on three of
            #      the five superseded ledgers live on this board)
            #   ?  an issue field is absent on either row, so the relation
            #      cannot be established. Doubt is stated, never resolved toward
            #      the interesting answer.
            #
            #      THIS ARM IS DEFENSIVE, NOT COMMON, and an earlier revision of
            #      this comment said the opposite. It cited `#1146` for "the
            #      common case" — but `#1146` is about the REPORT FRONTMATTER
            #      written by `ng report-init` having no task/issue field, which
            #      is a DIFFERENT field from field 5 of a ledger row. Measured on
            #      this board: 0 of 72 `discharged` rows carry an empty or `-`
            #      issue. The arm is still right to exist, because
            #      `_skeptic_record_discharge` writes `${issue:--}` and a
            #      wrap-up with no issue therefore produces one by construction
            #      — but it has never fired on real data here, and saying
            #      "common" invited a reader to weigh it as the likely case.
            sup_state = 0; sup_why = "-"
            if (matchedline > 0 && lastvline > matchedline) {
                if (standissue == "" || standissue == "-" \
                    || attrissue == "" || attrissue == "-") {
                    sup_state = 2; sup_why = "issue-field-absent-cannot-establish"
                } else if (standissue != attrissue) {
                    sup_state = 0; sup_why = "different-issues-unrelated-tasks"
                } else if (standv == attrv) {
                    sup_state = 0; sup_why = "same-verdict-re-recorded-not-superseded"
                } else {
                    sup_state = 1; sup_why = "same-issue-differing-verdict"
                }
            }
            # `superseded=0` MUST NOT READ AS REASSURANCE WHERE THE QUESTION
            # DOES NOT APPLY (your-org/nexus-code#1199). `sup_state` is computed
            # only inside `matchedline > 0`, so a ledger whose verdicts are ALL
            # unmatched falls through at the initialiser and prints
            # `superseded=0` — glossed in skills/nexus.skeptic as "nothing; the
            # attributed row is fine" — while `attributed_verdict=-` on the same
            # line says there is no attributed row at all. Measured over the 64
            # ledgers in the live `.state/skeptic/pending` on 2026-08-31: 19
            # print `matched=0 superseded=0` and 14 of those carry a delivered
            # `standing_verdict`.
            #
            # The VALUE stays `0`: `retire-preflight` and `skeptic-channel` read
            # it, only `1` licenses "take the later one", and a third value here
            # would be a gate change smuggled in as a wording fix. The honesty
            # goes on `superseded_why`, whose whole purpose is to make the
            # judgement checkable rather than trusted. Distinct from
            # `standing_stale`, which answers whether the standing verdict is
            # about the CURRENT artefact; this answers whether `superseded` is
            # answering anything at all.
            if (sup_state == 0 && sup_why == "-" && verdicts > 0 && matched == 0)
                sup_why = "no-attributed-row-to-supersede"
            superseded = (sup_state == 2 ? "?" : sup_state)
            # ── #1199: THE STANDING VERDICT SUBJECT WAS AMENDED UNDER IT ──────
            #
            # A RE-PINNED round can complete, be reported, be acted on, and
            # write nothing here — a verdict is recorded on a wrap-up path a
            # re-pin does not traverse. The ledger then reports itself fully
            # consistent (`superseded=0 unmatched=0`) while its standing verdict
            # is pinned to the PRE-correction artefact, and a merge gate keyed on
            # `standing_at` can never clear.
            #
            # Measured on the live `.olayfacts.ledger`: `armed ac8744e` 10:49 ->
            # `discharged ac8744e check attributed` 11:03 -> `armed 34f3cb0`
            # 11:42 AGAINST THE SAME REPORT PATH. Round 2 ran 11:17-11:40 and is
            # in the report; the ledger has no row for it. But it does have the
            # comparison: a LATER arm, same path, different sha. The evidence
            # that the standing verdict is stale was already sitting in the file.
            #
            # THIS IS LEDGER-INTERNAL AND DELIBERATELY NOT A RE-HASH of the
            # report on disk. Re-hashing would also catch an amendment that
            # armed nothing, but it makes a read-only verb do I/O, and it makes a
            # claim about a file that may since have moved or been legitimately
            # amended after the pairing closed. What is asserted here is exactly
            # what the file records, and it cannot be falsified by anything
            # outside it. The re-hash variant is NOT implemented.
            #
            # IT IS A FIELD, NOT A CLASS. The relation is orthogonal to the
            # matching question the precedence chain ranks — the same reason
            # `superseded` rides its own field, and the reason there is no arm to
            # order wrongly (your-org/nexus-code#1121).
            #
            # THE REFERENCE IS THE LAST VERDICT THAT NAMED AN ARTEFACT, NOT THE
            # STANDING ONE — and getting that wrong is a defect this branch
            # INTRODUCED and a skeptic caught (F1). #1191 recovers a terminal
            # verdict carrying `sha=-`; that row is then the standing one, so
            # keying on `standsubj` refused the comparison and `standing_stale`
            # fell from a definite `1` to `?` on the exact history #1199 exists
            # to expose. Honest — never a false 0 — but a COVERAGE regression,
            # and invisible because the two fixes were never composed in the
            # suite. They are now.
            #
            #
            # NO LATER ARM IS `?`, NOT `0` — THIS DETECTORS OWN DOCTRINE APPLIED
            # TO ITS OWN BLIND SPOT (your-org/nexus-code#1199). This axis is
            # LEDGER-INTERNAL by deliberate design, so it needs a LATER `armed`
            # row to see anything. The mechanism #1199 describes writes no such
            # row: the report is amended IN PLACE at the same path and the
            # reviewer is re-pinned by `ng send`, which records neither an arm
            # nor a discharge — a grep of monitor/send.sh for the three writer
            # tokens returns 0, and the only non-test writers in the tree are two
            # sites in `_wrapup_skeptic_step` plus one in `cmd_skeptic_arm`,
            # reached only from `spawn-worker.sh`. Measured at 989b888: a healthy
            # arm/discharge pair and the re-pin shape produce the SAME LINE —
            # `standing_stale=0 standing_stale_why=no-arm-after-the-standing-
            # verdict` — so the `0` claimed "checked, and current" for a case
            # where nothing was checked.
            #
            # The `?` arm two branches down already exists for exactly this
            # reason: a 0 there would read as "checked, and current". An absence
            # answered with the same value as health is this workspaces dominant
            # failure mode, and it was arriving inside the fix for it.
            #
            # IT IS NOT A GATE CHANGE. The only consumer, in retire-preflight, is
            # `case "$_SK_EV_STALE" in 1) …; *) : ;; esac` — `?` and `0` both fall
            # to the no-op arm, so no refusal, clause or polarity moves. Only
            # `1` ever licensed anything and `1` is untouched.
            #
            # A SAME-SHA RE-ARM STAYS A DEFINITE `0`, and that is the line
            # between the two: re-arming re-hashes the artefact at the same path,
            # so the bytes WERE examined and found unchanged. That is a measured
            # currency claim, which is what a `0` is for.
            stale = "?"; stale_why = "-"
            if (refline > 0) {
                stale = "?"
                stale_why = "no-arm-after-the-standing-verdict-artefact-bytes-not-re-examined"
                for (i = 1; i <= na; i++) {
                    if (armnr[i] > refline) {
                        if (armsha[i] != refsha) {
                            stale = 1
                            # SAY WHICH ROW WAS COMPARED. When the standing row
                            # is not the attributing one, a reader checking the
                            # standing row against a later arm would not
                            # reproduce this answer, so the field names the
                            # reference it actually used.
                            if (refline == lastvline)
                                stale_why = "artefact-re-armed-with-a-different-sha-after-the-standing-verdict"
                            else
                                stale_why = "artefact-re-armed-with-a-different-sha-after-the-last-ATTRIBUTING-verdict-the-standing-row-names-none"
                            break
                        }
                        stale = 0
                        stale_why = "re-armed-with-the-SAME-sha-artefact-unchanged"
                    }
                }
            } else if (lastvline > 0) {
                stale_why = "standing-verdict-names-no-artefact-cannot-compare"
            } else {
                stale_why = "no-standing-verdict-to-compare"
            }
            if      (malformed > 0)                            ev = "?"
            else if (open > 0 && settle > 0 && minopen > settle) ev = "rearm-after-close"
            else if (sup_state == 1)                           ev = "superseded-verdict"
            else if (ambiguous > 0)                            ev = "ambiguous-arms"
            else if (unmatched_subject > 0)                    ev = "unmatched-subject"
            else if (noopenarm > 0)                            ev = "no-open-arm"
            # Directly below `no-open-arm` and above the `unmatched-other`
            # catch-all. Every arm above is itself a "delivered but unmatched"
            # class, so none is a permissive arm this could shadow — the
            # permissive outcomes, `attributed` and `none`, are both BELOW
            # (your-org/nexus-code#1121).
            else if (noarm > 0)                                ev = "verdict-without-arm"
            else if (unmatched_other > 0)                      ev = "unmatched-other"
            else if (verdicts > 0 && open > 0)                 ev = "prior-verdict-other-artefact"
            else if (verdicts > 0)                             ev = "attributed"
            else if (voidv > 0)                                ev = "discharge-without-verdict"
            else if (resolutions > 0)                          ev = "resolved-only"
            else                                               ev = "none"
            # `+0` before printing: an awk variable never assigned is the EMPTY
            # STRING, not 0, and `verdicts=` reads as a field that failed rather
            # than as a measured zero — the same "could not look" / "nothing to
            # find" confusion this whole verb exists to end.
            verdicts += 0; unmatched += 0; resolutions += 0; open += 0
            matched += 0
            if (unmatched_why == "") unmatched_why = "-"
            if (ev == "?") {
                verdicts = "?"; unmatched = "?"; resolutions = "?"; open = "?"
                matched = "?"; superseded = "?"; sup_why = "-"
                stale = "?"; stale_why = "-"
                unmatched_why = "-"
            }
            gsub(/[ \t]/, "_", standv); gsub(/[ \t]/, "_", standby)
            gsub(/[ \t]/, "_", standat); gsub(/[ \t]/, "_", standd)
            gsub(/[ \t]/, "_", attrv);  gsub(/[ \t]/, "_", attrat)
            gsub(/[ \t]/, "_", standissue); gsub(/[ \t]/, "_", attrissue)
            printf "evidence=%s verdicts=%s matched=%s unmatched=%s unmatched_why=%s superseded=%s superseded_why=%s standing_stale=%s standing_stale_why=%s resolutions=%s open=%s standing_verdict=%s standing_issue=%s standing_by=%s standing_at=%s standing_detail=%s attributed_verdict=%s attributed_issue=%s attributed_at=%s\n", \
                ev, verdicts, matched, unmatched, unmatched_why, superseded, sup_why, stale, stale_why, resolutions, open, \
                (standv  == "" ? "-" : standv),  (standissue == "" ? "-" : standissue), \
                (standby == "" ? "-" : standby), \
                (standat == "" ? "-" : standat), (standd  == "" ? "-" : standd), \
                (attrv   == "" ? "-" : attrv),   (attrissue  == "" ? "-" : attrissue), \
                (attrat  == "" ? "-" : attrat)
        }
    ' "$f" 2>/dev/null || return 2
}

# Config reader with env override for skeptic knobs. $1=config-key
# $2=env-var $3=default. Integers only.
_skeptic_cfg_int() {
    local key="$1" env="$2" def="$3" val=""
    val="${!env:-}"
    if [[ ! "$val" =~ ^[0-9]+$ ]]; then
        val=$("$_cfg" "$key" "$def" 2>/dev/null) || val="$def"
    fi
    [[ "$val" =~ ^[0-9]+$ ]] || val="$def"
    printf '%s' "$val"
}

# The responsible-default heuristic, printed when an `auto`-mode worker
# must decide. Single source of truth; mirrored in
# skills/nexus.skeptic/SKILL.md and skills/nexus.report.
_skeptic_print_heuristic() {
    cat <<'EOF'
  Spawn a skeptic when the task:
    (a) touched shared infrastructure (watcher/monitor/skills/spawn/CI), OR
    (b) produced or altered scientific results, figures, gene lists,
        data, or analysis, OR
    (c) made or proposed external (cross-repo / public) writes, OR
    (d) involved non-trivial reasoning you are uncertain about, OR
    (e) has high blast radius / is hard to reverse.
  Skip ONLY genuinely trivial, low-impact, easily-reversible,
  high-confidence work (a doc typo, a one-line config).
  Bias toward skepticism — an unreviewed wrong scientific/infra result
  costs far more than a skeptic pass.
EOF
}

# Emit the orchestrator's skeptic-spawn command template for a target
# window at a given depth. $1=target-window $2=depth $3=orig-window
# (the chain root; defaults to target — the FIRST skeptic's target IS
# the original deliverable). When orig differs from target, this is a
# RECURSIVE (second-or-later) skeptic that must review the WHOLE chain
# and may adjudicate a worker↔skeptic disagreement — the template names
# both windows and threads --skeptic-orig forward (skills/nexus.skeptic
# Change 2).
_skeptic_spawn_cmd() {
    local target="$1" depth="$2" orig="${3:-}"
    [[ -n "$orig" ]] || orig="$target"
    # `-r` IS NOT OPTIONAL HERE (your-org/nexus-code#1251).
    #
    # `spawn-worker.sh --skeptic-role` establishes the ARMED STATE — and for a
    # SECOND-or-later pass it is the ONLY writer that does, because the verdict
    # recommending the next round cleared every marker on its way out. Only
    # `-r` gives that arm a SUBJECT: `PRIOR_REPORT_RESOLVED` is what reaches
    # `ng skeptic-arm --report`. Without it spawn-worker writes the marker
    # alone, says `records NO SUBJECT` on stderr, and appends NO `armed` row —
    # measured, 0 rows against 1 with the flag.
    #
    # THE CONSEQUENCE IS NOT REPAIRABLE AFTERWARDS, which is why this belongs
    # in the printed command rather than in advice beside it. The verdict lands
    # `no-arm-on-record`, `ng skeptic-evidence` reports
    # `evidence=verdict-without-arm`, and `retire-preflight`'s remedy for that
    # state — "the repair is to the ARM" — cannot be performed: `noarm > 0`
    # outranks `attributed` and the ledger is append-only, so no append moves
    # the class. Measured from that state: a post-hoc `ng skeptic-arm` RE-OPENS
    # the arm (open 0 -> 1) and reports `rearm-after-close`; a re-filed
    # subject-asserting verdict attributes but leaves the class unchanged; an
    # operator resolution does not move it either. The only repairable moment
    # is ARM time, which is exactly here.
    #
    # `_SK_REPORT_PATH` is the report under hand-off, set by `cmd_wrap_up`,
    # which dies unless it is a readable file — so on the real path it is
    # reliably available. Absolutised because the ORCHESTRATOR runs this
    # command from its own cwd, not the worker's.
    #
    # When it does not resolve (a direct call from a unit suite), print a
    # PLACEHOLDER rather than dropping the flag. An unreadable `-r` exits 9 and
    # says so; an ABSENT `-r` produces exactly the silent subject-less arm this
    # block exists to prevent.
    local _sk_rep="${_SK_REPORT_PATH:-}" _sk_rep_dir="" _sk_rep_ph=0
    if [[ -n "$_sk_rep" && -r "$_sk_rep" ]]; then
        _sk_rep_dir=$(cd "$(dirname -- "$_sk_rep")" 2>/dev/null && pwd -P) \
            && _sk_rep="${_sk_rep_dir}/$(basename -- "$_sk_rep")"
    else
        _sk_rep='<report-the-skeptic-must-read>'; _sk_rep_ph=1
    fi
    printf '    monitor/spawn-worker.sh -n %s-skeptic -c <workdir> -p <prompt-file> \\\n' "$target"
    printf '        -r %s \\\n' "$_sk_rep"
    if [[ "$orig" != "$target" ]]; then
        printf '        --skeptic-role --skeptic-target %s --skeptic-orig %s --skeptic-depth %s\n' \
            "$target" "$orig" "$depth"
        printf '    # RECURSIVE skeptic: reviews the WHOLE chain, not just the prior skeptic.\n'
        printf '    # prompt-file: brief it per skills/nexus.skeptic/SKILL.md to —\n'
        printf '    #   (1) read the ORIGINAL worker `%s` (its deliverable + report) AND\n' "$orig"
        printf '    #       the prior skeptic `%s` (its critique/findings) — both cold, from files;\n' "$target"
        printf '    #   (2) it MAY question BOTH via the comms channel (both may still be parked\n'
        printf '    #       in await): `ng skeptic ask %s ...` and `ng skeptic ask %s ...`;\n' "$orig" "$target"
        printf '    #   (3) ADJUDICATE any worker↔skeptic disagreement — break the tie with a\n'
        printf '    #       reasoned verdict (worker-right / skeptic-right / both-wrong /\n'
        printf '    #       needs-more), citing evidence.\n'
    else
        printf '        --skeptic-role --skeptic-target %s --skeptic-depth %s\n' "$target" "$depth"
        printf '    # prompt-file: brief the skeptic per skills/nexus.skeptic/SKILL.md\n'
        printf '    # (mandate, bug-first checklist, verdict ladder, comms channel).\n'
    fi
    if (( _sk_rep_ph == 1 )); then
        printf '    # -r: SUBSTITUTE the report this skeptic must read. Do NOT drop the flag —\n'
        printf '    #     without it the arm records NO SUBJECT and the verdict lands as\n'
        printf '    #     `no-arm-on-record`, which nothing later can repair\n'
        printf '    #     (your-org/nexus-code#1251, #1207).\n'
    fi
}

# The skeptic decision/enforcement step of wrap-up. Returns non-zero
# ONLY to fail the wrap-up when an auto-mode worker did not decide AND
# config monitor.skeptic.enforce_auto_decision is truthy.
# Args: issue source_window repo
#       role decision rationale waive verdict target depth findings orig
#       contradicted rearm not_verdict
# Remove a window's OWN skeptic-pending marker — UNLESS this wrap-up
# declared itself not a skeptic verdict (your-org/nexus-code#879 F1).
#
# Reads `_sk_optout` from the caller's scope (bash locals are visible to
# callees). Centralised rather than inlined at the three producer-path
# removal sites, because the bug WAS three sites: a guard that must be
# repeated is a guard that gets missed on the fourth.
#
# Prints only when a marker actually exists, so an ordinary opt-out on a
# window that owed nothing stays quiet.
# _sk_marker_was_released <marker-path>
#
# rc 0 = this wrap-up really did clear the marker; rc 1 = `_sk_keep_own_marker`
# KEPT it because the opt-out fired (your-org/nexus-code#914 residual).
#
# WHY A PREDICATE AND NOT FOUR INLINE TESTS. `_sk_keep_own_marker` has four
# callers, and EVERY one used to follow it with an unconditional claim of
# release — printed AFTER the true "MARKER KEPT" block, so the FALSE sentence
# was the last thing on screen. One definition, mirroring the keeper it is
# paired with, is what stops the two drifting: a fifth caller gets the same
# answer without anybody remembering to copy the test.
_sk_marker_was_released() {
    (( ${_sk_optout:-0} == 1 )) && [[ -e "${1-}" ]] && return 1
    return 0
}

_sk_keep_own_marker() {   # $1 = marker path
    local _m="$1"
    if (( ${_sk_optout:-0} == 1 )); then
        if [[ -e "$_m" ]]; then
            printf '\n!! SKEPTIC MARKER KEPT — this wrap-up declared itself NOT a verdict.\n'
            printf '   The producer path would normally clear this window'"'"'s pending marker\n'
            printf '   here. It did NOT: --not-a-skeptic-verdict is a statement about THIS\n'
            printf '   HAND-OFF, not a release of a PENDING OBLIGATION (your-org/nexus-code#879 F1).\n'
            printf '   CONSEQUENCE: this window still cannot retire. If you owe a verdict,\n'
            printf '   file it with `ng wrap-up ... --skeptic-role --skeptic-verdict <v>`.\n'
            printf '   If an OPERATOR means to release it, waive WITHOUT the opt-out flag.\n'
        fi
        return 0
    fi
    rm -f "$_m" 2>/dev/null || true
}

_wrapup_skeptic_step() {
    local issue="$1" source_window="$2" repo="$3"
    local f_role="$4" f_decision="$5" f_rationale="$6" f_waive="$7"
    local f_verdict="$8" f_target="$9" f_depth="${10}" f_findings="${11}"
    local f_orig="${12:-}" f_contradicted="${13:-}" f_rearm="${14:-}"
    # your-org/nexus-code#879 — appended, and defaulted, so the unit
    # suite's existing 11-to-13-positional direct calls keep working.
    local f_not_verdict="${15:-}"
    local f_satisfied="${16:-0}" f_satisfied_by="${17:-}"
    # #879 F1 — set when the opt-out fires; read by _sk_keep_own_marker to
    # refuse every removal of this window's OWN pending marker downstream.
    local _sk_optout=0

    # Request-intent signal for cmd_wrap_up's "Step 2b" (spawn-skeptic
    # request filing, your-org/nexus-code#545). Default cleared here so a
    # direct call (unit suite) that resolves to a non-require path leaves
    # nothing for a caller to file; cmd_wrap_up also resets them before the
    # call. Only the two require paths below set _SK_SPAWN_REQ=1.
    _SK_SPAWN_REQ=0
    _SK_SPAWN_TARGET=""; _SK_SPAWN_DEPTH=""; _SK_SPAWN_ORIG=""
    _SK_PINNED_NOTIFIED=""; _SK_PINNED_WHY=""   # #1182 — the delivery receipt
    _SK_SPAWN_MODE=""; _SK_SPAWN_EFFECTIVE=""
    _SK_SPAWN_DELIBERATE=0; _SK_SPAWN_REASONS=""; _SK_SPAWN_CONTRADICTED=""; _SK_SPAWN_DELTA="${_SK_SPAWN_DELTA:-}"

    # Resolve provenance for the source window.
    local prov mode depth role target orig
    prov=$(_skeptic_provenance "$source_window")
    IFS=$'\t' read -r mode depth role target orig <<<"$prov"

    # Flag overrides win over provenance (role spawns may run wrap-up
    # off-tmux where source_window is empty).
    (( f_role == 1 )) && role=true
    [[ -n "$f_depth"  ]] && depth="$f_depth"
    [[ -n "$f_target" ]] && target="$f_target"
    [[ -n "$f_orig"   ]] && orig="$f_orig"
    [[ "$depth" =~ ^[0-9]+$ ]] || depth=0

    local pending_dir="$STATE_DIR/skeptic/pending"
    mkdir -p "$pending_dir" 2>/dev/null || true
    local sw_safe; sw_safe=$(wk_encode "$source_window")
    # Window extra only when a source window resolved — off-tmux wrap-ups
    # (orchestrator-side direct call, test harness) must not stamp an
    # empty "window" field, mirroring cmd_wrap_up's own discipline.
    local -a winx=()
    [[ -n "$source_window" ]] && winx=(--extra "window=$source_window")

    # =====================================================================
    # ROLE OPT-OUT (your-org/nexus-code#879) — a skeptic-STAMPED window
    # doing ORDINARY WORKER WORK.
    # =====================================================================
    #
    # The role is derived from PROVENANCE (`skeptic_role: true` in the
    # window record), not from the command line, and a window is stamped
    # for the life of the window rather than for the life of one task. A
    # retained skeptic that later authors a patch is therefore forced,
    # by the role path below, to supply a `--skeptic-verdict` — and if it
    # authored the work it is wrapping up, that verdict is a SELF-REVIEW
    # written against another window's skeptic markers.
    #
    # That is worse than refusing: the output is indistinguishable
    # downstream from an independent clearance, so the verb would be
    # MANUFACTURING the exact artefact the skeptic protocol exists to
    # prevent. The alternative on the board was to skip wrap-up entirely
    # (hand-rolled upload + comment), which loses the report-check
    # pre-flight, the templated link comment and the action-log wrap-up
    # event the window-cleanup loop reads — so the window looks un-wrapped.
    #
    # Neither is acceptable, so give the true state a way to be SAID. It
    # must be stated, never inferred: an inferred opt-out would be a way
    # to dodge a genuine skeptic obligation, which is why the reason is
    # mandatory and substantive (the `GH_IMPERSONATE_REASON` shape, and
    # the same 20-char floor `--skeptic-rearm` uses).
    #
    # It does NOT touch this window's skeptic markers. A window that owes
    # a verdict still owes it; the target stays blocked. The opt-out
    # relabels THIS wrap-up, it does not discharge an obligation.
    if [[ -n "$f_not_verdict" ]]; then
        # The same contradictions cmd_wrap_up refuses at parse time, refused
        # again HERE so the function is self-consistent for any caller —
        # the unit suites drive it directly, and a guard that lives only in
        # the CLI layer is a guard the tested surface does not have.
        if (( f_role == 1 )) || [[ -n "$f_verdict" ]]; then
            echo "ng wrap-up: --not-a-skeptic-verdict contradicts an asserted skeptic role/verdict." >&2
            echo "  One says this wrap-up IS a skeptic verdict, the other says it is not." >&2
            echo "  Pass exactly one." >&2
            return 1
        fi
        if [[ "$role" != "true" ]]; then
            echo "ng wrap-up: --not-a-skeptic-verdict is inert here — this window is not" >&2
            echo "  stamped as a skeptic (provenance says skeptic_role: false), so the" >&2
            echo "  ordinary worker wrap-up is already what runs. Drop the flag." >&2
            return 1
        fi
        if (( ${#f_not_verdict} < 20 )); then
            echo "ng wrap-up: --not-a-skeptic-verdict must carry a substantive reason (>=20 chars)" >&2
            echo "  naming WHAT NON-SKEPTIC WORK this window did. It is written to the audit" >&2
            echo "  trail, and it is what keeps the flag from becoming a way to dodge a" >&2
            echo "  skeptic obligation you actually owe." >&2
            return 1
        fi
        ( cmd_log_action monitor --event skeptic-role-not-asserted \
            "${winx[@]}" \
            --extra "stamped-target=${target:-}" \
            --extra "depth=$depth" \
            --extra "reason=$f_not_verdict" \
            --extra "issue=$issue" ) 2>/dev/null || true
        printf '\n=== SKEPTIC ROLE NOT ASSERTED (--not-a-skeptic-verdict) ===\n'
        printf 'This window is spawn-stamped as a skeptic'
        [[ -n "$target" ]] && printf ' for `%s`' "$target"
        printf ', but this wrap-up\n'
        printf 'is NOT a verdict. Reason: %s\n' "$f_not_verdict"
        printf 'CONSEQUENCE: the ordinary worker wrap-up runs from here — your own work\n'
        printf 'is what gets the skeptic decision (spawn mode `%s`). NO verdict is\n' "$mode"
        printf 'recorded and NO skeptic marker is cleared — not `%s`\n' "${target:-<none>}"
        printf 'and NOT THIS WINDOW'"'"'S OWN. If you still owe a verdict you still owe it,\n'
        printf 'and this window still cannot retire; file it with a separate\n'
        printf '`ng wrap-up ... --skeptic-role --skeptic-verdict <v>` (#879 F1).\n'
        # your-org/nexus-code#879 F1. The claim one line above — "NO skeptic
        # marker is cleared" — was made by this printf, by monitor/README.md
        # and by skills/nexus.skeptic/SKILL.md, and was FALSE. The producer
        # path this falls into clears `pending/${sw_safe}` — the OPTING-OUT
        # WINDOW'S OWN marker — in three branches (`denied-spawn`,
        # `denied-auto`, operator waive). So a window that genuinely owed a
        # verdict could discharge it by declaring this hand-off not a
        # verdict, and `retire-preflight.sh` flipped safe=0 -> safe=1.
        #
        # That is strictly worse than the defect #879 fixed: it converts a
        # FORCED FALSE VERDICT, which is visible in the record, into a
        # SILENT ABSENT one, which is not — and it lands in the gate every
        # retirement decision on this board is made from.
        #
        # THE DOCUMENTED BEHAVIOUR IS THE CORRECT ONE, so the code moves to
        # meet it rather than the three documents being softened to match
        # the code. An opt-out is a statement about THIS HAND-OFF; a pending
        # marker is a PENDING OBLIGATION. Different facts, and the marker
        # belongs to the second.
        #
        # The waive branch is guarded too, though it is an explicit operator
        # release rather than a side effect. Two reasons: the promise as
        # written is unconditional ("NO skeptic marker is cleared"), and the
        # directions of error are not symmetric — a marker wrongly KEPT is a
        # blocked retirement the operator can see and resolve, a marker
        # wrongly CLEARED is a silent false release. An operator who means
        # to waive can waive without also declaring a non-verdict.
        _sk_optout=1
        # Fall through to the PRODUCER PATH.
        role=false
    fi

    # =====================================================================
    # ROLE PATH — this wrap-up is a skeptic reporting its verdict.
    # =====================================================================
    if [[ "$role" == "true" ]]; then
        local verdict="$f_verdict"
        [[ -n "$verdict" ]] || {
            echo "ng wrap-up: --skeptic-role requires --skeptic-verdict <credible|check|suspect|refuted>" >&2
            # your-org/nexus-code#879 — a refusal must name its escape hatch,
            # or the only path it leaves open is the false one. This window's
            # role came from PROVENANCE, so a worker that never passed
            # --skeptic-role sees a demand for a verdict it may have no basis
            # for, and supplying one is the shortest way out.
            echo "  If this wrap-up is NOT a skeptic verdict — a skeptic-stamped window that" >&2
            echo "  did ordinary worker work — do NOT invent a verdict for it. Say so:" >&2
            echo "      ng wrap-up ... --not-a-skeptic-verdict \"<what non-skeptic work this was>\"" >&2
            echo "  which runs the ordinary worker wrap-up and records the reason. It does" >&2
            echo "  NOT clear any skeptic marker: a verdict you owe is still owed." >&2
            return 1
        }
        case "$verdict" in
            credible|check|suspect|refuted) ;;
            *) echo "ng wrap-up: --skeptic-verdict must be credible|check|suspect|refuted, got '$verdict'" >&2; return 1 ;;
        esac
        local reviewed="$target"
        [[ -n "$reviewed" ]] || reviewed="<unknown-target>"
        # your-org/nexus-code#601. This used to read
        #     [[ "$findings" =~ ^[0-9]+$ ]] || findings=0
        # which coerced a prose argument to the ONE value that means
        # "nothing found" — on the control path of the gate whose whole
        # purpose is to stop under-reported findings. A skeptic's four
        # findings (one HIGH, merge-blocking) printed as `findings: 0`
        # and TERMINATED the chain. Refuse instead; empty is still the
        # legitimate flag-absent case and keeps the 0 default.
        local findings="${f_findings:-}"
        if ! bk_require_int --skeptic-findings "$findings" --allow-empty; then
            echo "ng wrap-up: $BK_ERR" >&2
            return 1
        fi
        # your-org/nexus-code#881. The line that used to sit here was
        #     [[ -n "$findings" ]] || findings=0
        # and it is the SAME defect #601 fixed one line above, wearing the
        # other disguise. #601 stopped an UNREADABLE value becoming the
        # value that means "nothing found"; this stops an UNSTATED one
        # doing it. `bk_require_int --allow-empty` deliberately preserves
        # the distinction between empty and invalid — and the default then
        # threw the surviving half away two lines later.
        #
        # Downstream, that fabricated 0 was consumed as an OBSERVATION:
        # printed as `new findings : 0`, written to the action log as
        # `"findings":"0"`, and fed to the bounded-recursion gate that
        # decides whether a second pass is warranted. So "the skeptic
        # measured zero new issues" and "the skeptic never said" became
        # one record. MEASURED on this operator's log at the time of the
        # fix: 338 of 615 `skeptic-verdict` events carry `findings=0`, and
        # NONE of them can be classified — two hermetic wrap-ups differing
        # only in whether the flag was passed emit byte-identical records
        # across every event the verb writes. The population is
        # unrecoverable FROM THE ACTION LOG AND `.state/` — that is the
        # scope of the claim, and it is NOT "unrecoverable" full stop
        # (your-org/nexus-code#914 F4): the invocation survives in the
        # operator's session transcript, and the join is mechanical —
        # `skeptic-verdict` event -> `.window` -> `.state/windows/<w>.json`
        # `.session_id` -> `~/.claude/projects/*/<session_id>.jsonl` -> the
        # literal `ng wrap-up …` tool_use. Measured partially recoverable
        # (99/338 by one derivation, 82/338 by an independent one; the
        # DIRECTION of the split is unmeasured and must not be quoted —
        # see CHANGELOG `### Corrected`). Only the going-forward record can
        # be fixed HERE.
        #
        # So: NO SENTINEL. `-1` or `""`-coerced-to-a-number would be the
        # same defect in a new costume — a number a consumer can do
        # arithmetic on without noticing nobody supplied it. Absence is
        # carried as a separate BOOLEAN, every consumer branches on it
        # explicitly, and the one consumer that genuinely needs a number
        # (the threshold comparison) is simply not reached when there
        # isn't one.
        local findings_stated=0 findings_stated_s=false
        local findings_disp="not stated"
        if [[ -n "$findings" ]]; then
            findings_stated=1; findings_stated_s=true; findings_disp="$findings"
        fi
        # Log-argument set. `findings-stated` is emitted ALWAYS, so an
        # unstated count is a POSITIVE assertion on disk ("we asked and it
        # was not supplied") rather than a missing key — which would be
        # indistinguishable from a record written by an `ng` that predates
        # the field, and that ambiguity is the whole bug. `findings` is
        # emitted only when there is one.
        local -a findings_x=(--extra "findings-stated=$findings_stated_s")
        (( findings_stated == 1 )) && findings_x+=(--extra "findings=$findings")
        # The chain root. Defaults to the immediately-reviewed window —
        # the FIRST skeptic's target IS the original deliverable, so when
        # provenance carries no `orig` they coincide.
        local orig_eff="$orig"
        [[ -n "$orig_eff" ]] || orig_eff="$reviewed"
        # Sanitized chain-member marker keys (reused below).
        local orig_safe=""
        [[ -n "$orig_eff" && "$orig_eff" != "<unknown-target>" ]] \
            && orig_safe=$(wk_encode "$orig_eff")

        # THE SUBJECT THE REVIEWED WINDOW WAS ARMED FOR (your-org/nexus-code#963).
        #
        # `target-window` names a spawn-time STAMP, fixed for the life of the
        # window; `sk930` filed 12 verdicts across four issues and every one
        # recorded `target-window=procsafe`, so downstream an independent
        # clearance and a misfiled one are byte-identical. The event needs a
        # field that names a SUBJECT rather than a stamp.
        #
        # `subject-armed-sha` is exactly that and no more, and the name is
        # deliberately narrow: it is the content hash of the artefact the
        # reviewed window's obligation WAS ARMED FOR, taken from the arm
        # record written when the gate went up. It is NOT an assertion that
        # the reviewer read those bytes — nothing here can know that, and a
        # field that implied it would be the same manufactured-provenance
        # defect in a new costume. Making the reviewer ASSERT its subject is
        # #963's remaining half and is not attempted here.
        #
        # `-` when the arm predates this record or its report could not be
        # hashed. Emitted ALWAYS, so "we asked and there was none" is a
        # positive assertion on disk rather than a missing key — the same
        # discipline `findings-stated` established two blocks above, and for
        # the same reason: a missing key is indistinguishable from a record
        # written by an `ng` that predates the field.
        # Written as an `if`, not `A && B || C`: that parses as
        # `(A && B) || C` and would assign the same empty value whether the
        # window had no subject or the guard never ran — the two states this
        # field exists to keep apart (and the shell-grammar trap CLAUDE.md
        # documents as this workspace's dominant defect class).
        # ── WHAT THE REVIEWER ASSERTED, AND THE STALE-STAMP GUARD (#963) ──
        #
        # `$reviewed` above is a SPAWN-TIME STAMP. `--skeptic-subject` is the
        # reviewer's own statement of the artefact it read, and it is resolved
        # here so that a value the author fat-fingered is refused NOW — before
        # any GitHub hand-off, with the author still present — rather than
        # recorded as a plausible-looking hash nobody can trace.
        local _sk_asserted=""
        if [[ -n "${_SK_SUBJECT_ARG:-}" ]]; then
            if ! _sk_asserted=$(_skeptic_resolve_subject "$_SK_SUBJECT_ARG"); then
                echo "ng wrap-up: --skeptic-subject '$_SK_SUBJECT_ARG' is neither a 64-hex sha256" >&2
                echo "  nor a readable file. Pass the PATH of the report you reviewed (it is hashed" >&2
                echo "  for you), or its sha256. Nothing was recorded." >&2
                return 1
            fi
        fi
        local _sk_rev_key=""
        [[ -n "$reviewed" && "$reviewed" != "<unknown-target>" ]] && _sk_rev_key=$(wk_encode "$reviewed")

        # THE STALE STAMP, MADE LOUD. `sk930` was spawned to review `procsafe`,
        # was re-tasked by paste, and filed ten verdicts about other work — every
        # one recorded `target-window=procsafe`, every one clearing `procsafe`'s
        # gate. Nothing prompted for a correction and nothing validated the
        # default, because a provenance stamp is always plausible.
        #
        # The cheap discriminator: the issue this wrap-up is FOR versus the issue
        # the reviewed window's own last arm was ABOUT. They match on every
        # ordinary round (the arm is written by the target's wrap-up, carrying
        # the target's issue), and they diverge precisely on the re-tasked case.
        #
        # ONLY `--skeptic-subject` clears it, and deliberately NOT
        # `--skeptic-target`. Re-confirming the target is a value the reviewer
        # would supply unchanged — a prompt answered the same way every time,
        # which #1062 names as the shape that trains its reader to discount it.
        # The subject is different information every round, so supplying it
        # cannot become a reflex.
        if [[ -z "$_sk_asserted" && -n "$_sk_rev_key" && -n "$issue" ]]; then
            local _sk_last_arm_issue=""
            _sk_last_arm_issue=$(awk -F'\t' '$1 == "armed" { i = $4 } END { if (i != "") print i }' \
                "$(_skeptic_ledger_file "$pending_dir" "$_sk_rev_key")" 2>/dev/null) || _sk_last_arm_issue=""
            if [[ -n "$_sk_last_arm_issue" && "$_sk_last_arm_issue" != "-" \
                  && "$_sk_last_arm_issue" != "$issue" ]]; then
                echo "ng wrap-up: STALE SPAWN STAMP — this verdict names a target it may not have reviewed." >&2
                echo "  target-window : $reviewed   (a SPAWN-TIME stamp, fixed for the life of this window)" >&2
                echo "  its last arm  : issue $_sk_last_arm_issue" >&2
                echo "  this wrap-up  : issue $issue" >&2
                echo "  Those disagree, which is the signature of a retained reviewer re-tasked by" >&2
                echo "  paste (your-org/nexus-code#963: sk930 filed 10 verdicts on other work, all" >&2
                echo "  recorded against — and all CLEARING the gate of — the window it was spawned" >&2
                echo "  for). State what you actually reviewed:" >&2
                echo "      --skeptic-subject <path-to-the-report-you-reviewed>" >&2
                echo "  Re-confirming --skeptic-target does NOT clear this: it is the stamp being" >&2
                echo "  doubted. Nothing was recorded and no marker was touched." >&2
                return 1
            fi
        fi

        # ── READ THE DISPOSITION AND REFUSE *BEFORE* ANY SIDE EFFECT ──────
        #
        # This block used to sit ~200 lines further down, after the
        # `skeptic-verdict` event was logged, after the discharge was recorded
        # and after the pending marker was `rm`ed. A refusal there would have
        # printed "no marker was touched" having already cleared it — a check
        # asserting a property it never tested, which is this corpus's dominant
        # defect and the very class this batch exists to close. Caught by
        # reading the order rather than the message. Its position is now
        # load-bearing: everything below it MUTATES STATE, so nothing may be
        # inserted between them.
        local _sk_stated _sk_dsource _sk_ddetail
        local _sk_severity=0 _sk_honoured=0 _sk_author_asked=0 _sk_nothing_stated=0
        local _sk_disp_ok=0
        read -r _sk_stated _sk_dsource _sk_ddetail \
            <<<"$(_skeptic_stated_disposition "${_SK_REPORT_PATH:-}")"
        # EMPTY output is no longer a state — it means the parser did not run.
        # Pre-#684 that was indistinguishable from a clean `absent`, so a
        # crashed parser silently produced the quiet arm. Name it instead.
        if [[ -z "$_sk_stated" ]]; then
            _sk_stated=unreadable; _sk_dsource=none; _sk_ddetail=parser-produced-no-state
        fi

        # ── STATING NOTHING IS REFUSED, NOT ESCALATED (#1095, superseding
        #    #881's REMEDY while keeping #881's PROPERTY) ─────────────────
        #
        # `disposition:` has been validated WHEN PRESENT since #836. Nothing
        # ever required it. When both it and `--skeptic-findings` are absent,
        # #881 correctly refused to invent a clean termination and ESCALATED
        # instead — filing an automatic second-pass request whose own words are
        # "derived from ABSENCE, not from any measurement, and severity-blind
        # for that reason".
        #
        # That text is honest and the escalation logic is right. #1095's point
        # is that the CONSEQUENCE lands on the wrong person. An inference from
        # absence is UNFALSIFIABLE — a missing field and a field that could not
        # be written are identical — so a finished `no-further-pass` and an
        # abandoned review produce the SAME recommendation, and the orchestrator
        # must open the report to tell them apart, which is exactly what the
        # automation exists to avoid. Hit twice in one evening by two different
        # skeptics on two unrelated PRs, both reports carrying a clear verdict
        # in their Summary ("the PR is SOUND. Merge it.") and no field. A clear
        # verdict in the wrong field reads as no verdict at all.
        #
        # WHAT CHANGES AND WHAT DOES NOT. #881's PROPERTY — a pass that states
        # neither must never read as clean, and an omitted count must stay
        # distinguishable from a measured 0 — is preserved and strengthened:
        # the case cannot now reach the log at all. Only #881's REMEDY changes,
        # from escalate-to-the-orchestrator to refuse-to-the-author, and the
        # refusal deliberately reuses #881's own words so the same guards read
        # the same sentences. This is a deliberate supersession, not a
        # regression; #881's four surviving assertions are unchanged and one
        # was rewritten to name the new remedy.
        #
        # THE ESCAPE HATCH IS UNCHANGED AND IS STILL ONE LINE — state a count
        # or state a disposition. Only stating NEITHER is refused, which is the
        # same boundary #881 drew.
        #
        # GRAMMAR, NOT JUST PRESENCE. A spawn brief once told a worker to put
        # "disposition in the frontmatter" and PROSE went into a reserved
        # two-token field that ordinary workers also parse. So `unreadable` and
        # `found in the body` are named separately from `absent` — but only
        # when nothing else was stated either, because a skeptic that DID
        # supply a measurement has reported a result and #881's boundary holds.
        #
        # NOT a Summary fallback. That moves the guess rather than removing it,
        # and a Summary is prose.
        #
        # ── COVERAGE BOUNDARY: THIS COVERS SKEPTIC REPORTS ONLY ───────────
        #
        # This block is inside `if [[ "$role" == "true" ]]`, so it reaches a
        # report filed by a window whose provenance says `skeptic_role`. It
        # does NOT reach the absence-derived escalation on the WORKER path:
        # `_wrapup_file_spawn_skeptic_request` composes
        # `second-pass-no-disposition-stated` for ordinary workers too, and
        # that function is deliberately UNMODIFIED here.
        #
        # The split is not academic. Of the eight instances recorded on #1095
        # on 2026-08-27/28, FOUR are worker reports — including `panelive`,
        # which cost five identical spawn-skeptic requests in twenty minutes
        # and needed an orchestrator override to break. That instance is in
        # the UNCOVERED half.
        #
        # Extending to the worker path is separate work, and deliberately not
        # attempted here: a worker has no verdict to state, so "require a
        # disposition" is the wrong requirement for it, and choosing the right
        # one is a design decision rather than a port of this one. Do not read
        # #1095 as closed. The suite records the gap positively rather than by
        # omission — `PASS: #599 the derived recommendation flags its own
        # blindness` is the worker path still doing exactly what it did.
        _sk_disp_ok=0
        [[ "$_sk_dsource" == "frontmatter" ]] \
            && [[ "$_sk_stated" == "no-further-pass" || "$_sk_stated" == "second-pass" ]] \
            && _sk_disp_ok=1
        if (( _sk_disp_ok == 0 )) && (( findings_stated == 0 )); then
            echo "!! YOU STATED NEITHER A COUNT NOR A DISPOSITION." >&2
            echo "   No \`--skeptic-findings\`, and no readable frontmatter \`disposition:\` in" >&2
            echo "   the report. Nothing on record says this chain may end." >&2
            echo "   report : ${_SK_REPORT_PATH:-<none>}" >&2
            echo "   parser : state=$_sk_stated source=$_sk_dsource detail=$_sk_ddetail" >&2
            case "$_sk_stated" in
                absent)
                    echo "   Nothing was stated at all. Your verdict may be perfectly clear in the" >&2
                    echo "   Summary — both reports that hit this carried one — but nothing READS" >&2
                    echo "   the Summary." >&2 ;;
                unreadable)
                    echo "   A disposition IS written and the parser could not read it. It is a" >&2
                    echo "   reserved TWO-TOKEN field, not prose; ordinary workers parse it too." >&2 ;;
                *)
                    echo "   A disposition was found in the ${_sk_dsource}, not the frontmatter." >&2
                    echo "   Only a frontmatter field governs; a body mention is a quotation." >&2 ;;
            esac
            echo "   This is a REFUSAL, not a finding: it fires because nothing was stated," >&2
            echo "   not because this pass found substantive new issues (your-org/nexus-code#881)." >&2
            echo "   Until #1095 this ESCALATED instead — filing a second-pass request derived" >&2
            echo "   from absence alone, which is unfalsifiable and lands on an orchestrator who" >&2
            echo "   then has to read the report anyway. Refusing costs you one line, here," >&2
            echo "   while you are still the person who knows the answer." >&2
            # your-org/nexus-code#914.2. This promise is printed inside a
            # MANDATORY refusal, so the skeptic is COMPELLED down one of two
            # paths the verb says will end the chain — and at `suspect` or
            # `refuted` NEITHER does. Measured over the full 32-cell matrix
            # (verdict x disposition x count x contradicted): suspect 8/8 and
            # refuted 8/8 ESCALATE, INCLUDING with both remedies applied
            # together. `substantive=1` is set from the verdict alone, and the
            # only arm that could undo it requires `_sk_severity == 0`, which
            # the same verdict has already set to 1.
            #
            # THE PREDICATE IS THE VERDICT, NOT `_sk_severity`. The issue and
            # its follow-up comment both say to gate on `_sk_severity`, and
            # that is WRONG: `--skeptic-contradicted` also sets it, and
            # contradiction changes nothing — measured, credible +
            # contradicted + findings 0 + no-further-pass still prints
            # "Skeptic chain TERMINATES". Gating on severity would print
            # "neither statement will terminate" at 8 cells where BOTH do.
            if [[ "$verdict" == "suspect" || "$verdict" == "refuted" ]]; then
                echo "   NEITHER STATEMENT WILL TERMINATE THIS CHAIN, and this refusal will not" >&2
                echo "   pretend otherwise. Your verdict is \`$verdict\`, which sets substantive=1" >&2
                echo "   on its own and which #678 makes non-overridable by a disposition. State" >&2
                echo "   one anyway — it is what makes the escalation HONEST rather than derived" >&2
                echo "   from absence, and it is what the next skeptic reads:" >&2
            else
                echo "   EITHER statement terminates the chain honestly, and both are one line:" >&2
            fi
            echo "     --skeptic-findings 0        (you looked and found nothing new)" >&2
            echo "     disposition: no-further-pass (in the report frontmatter, at column 0)" >&2
            echo "   Nothing was published, no marker was touched, and no spawn-skeptic" >&2
            echo "   request was filed." >&2
            return 1
        fi

        local _sk_subj_sha=""
        if [[ -n "$reviewed" && "$reviewed" != "<unknown-target>" ]]; then
            _sk_subj_sha=$(_skeptic_current_arm_sha "$pending_dir" "$(wk_encode "$reviewed")") \
                || _sk_subj_sha=""
        fi
        # `repo=` DISAMBIGUATES THE NAMESPACE, and does NOT make this row PR
        # clearance (your-org/nexus-code#957). `issue=` alone named two
        # different things in two repos — this nexus's `github.repo` is the
        # asset/issue repo while the PRs live on the implementation repo — so a
        # bare `issue=1134` was unresolvable. `${repo:--}` because the unit
        # suites call this with 11 positionals and no repo.
        #
        # THE LIMIT, stated here because the field makes the row look more
        # authoritative than it is: it still names a TRACKING ISSUE, not a PR.
        # Across 27,584 log rows there is NO verdict->PR link in any state
        # anywhere, and 0 of 668 PRs carry a submitted review against 649 with
        # one REQUESTED. Do not read a namespaced row as "PR #N is cleared".
        #
        # (And the comment lives HERE, not inside the argument list: a comment
        # between `\`-continued lines silently TRUNCATES the arguments after
        # it. Measured — the row still emitted, without `repo` or `issue`.)
        ( cmd_log_action monitor --event skeptic-verdict \
            --extra "window=${source_window:-skeptic}" \
            --extra "target-window=$reviewed" \
            --extra "orig-window=$orig_eff" \
            --extra "verdict=$verdict" \
            --extra "depth=$depth" \
            "${findings_x[@]}" \
            --extra "subject-armed-sha=${_sk_subj_sha:--}" \
            --extra "subject-asserted-sha=${_sk_asserted:--}" \
            --extra "repo=${repo:--}" \
            --extra "issue=$issue" ) 2>/dev/null || true

        # A returned verdict SATISFIES the first-pass require-gate, so clear
        # EVERY blocking marker this validation touches: the immediately
        # reviewed target, the chain-root original worker, AND this skeptic's
        # OWN marker (the park-self marker a prior pass may have left). The
        # gate's contract is "a required skeptic has NOT returned a verdict";
        # once a verdict exists that is false for all three. Leaving any live
        # is exactly the leak this fixes — a substantive-but-minor verdict
        # (e.g. `check` with findings>=1) RECOMMENDS a second pass, but the
        # orchestrator routinely (and legitimately) declines it, and nothing
        # then cleared the speculatively-parked markers → retire-preflight
        # reported safe=0 on a DONE skeptic and its target forever, until a
        # manual `rm`. The block is RE-ESTABLISHED by spawn-worker.sh at the
        # moment an actual second-pass skeptic is spawned (so it is tied to a
        # REAL reviewer, not a recommendation), restoring the
        # parked-awaiting-skeptic exemption exactly when it is warranted.
        #
        # RECORD THE DISCHARGE BEFORE PERFORMING IT (your-org/nexus-code#984).
        #
        # Each `rm -f` below is a lifecycle transition — the obligation goes
        # from armed to discharged — and until this block every one of them
        # was a pure deletion. A deletion is not evidence: downstream, a
        # marker cleared by a verdict, a marker cleared by `ng skeptic
        # resolve`, and a marker destroyed by `ng retire-window` are
        # byte-identical, so the re-arm check could see only the one that
        # happened to leave a file behind (`resolve`). #984 is the direct
        # consequence — a wrap-up re-publishing an ALREADY-VALIDATED report
        # re-armed the gate and bought a second reviewer pass on bytes whose
        # verdict was already on the record.
        #
        # The record must be written FIRST. Written after, an interrupted
        # discharge leaves the marker gone and no ledger entry — the exact
        # ambiguity being removed, reintroduced in the failure path. Written
        # first, the worst case is a ledger entry for a marker that survived,
        # which is harmless: the entry authorises nothing on its own, it only
        # names an artefact whose verdict is on the record.
        #
        # `_skeptic_record_discharge` DOES record an arm that carried no
        # subject (a marker armed before this change, or one whose report
        # could not be hashed) — as `no-arm-on-record` since #1207, because
        # dropping the row reported `evidence=none` about a review that
        # actually happened. The pre-existing population still RE-ARMS, but
        # NOT because the ledger is untouched: the row's subject is `-`, and
        # `_skeptic_artefact_discharged` requires a 64-hex match, so the row
        # suppresses nothing. That is the safe direction, and it is why this
        # needs no migration.
        #
        # The earlier wording here said the population was "untouched" and a
        # row was never written. Both were false from #1207 onward, and the
        # conclusion they supported happened to stay true — which is why it
        # survived review (your-org/nexus-code#1253).
        # ── WHICH KEYS ARE CLEARED vs WHICH ARE RECORDED ──────────────────
        #
        # THREE markers are cleared, exactly as before this change: the
        # reviewed target, the chain-root original, and this skeptic's own
        # park-self marker. That behaviour is #815-era and is not touched.
        #
        # ONE is RECORDED — the window this verdict is explicitly ABOUT. The
        # first version recorded all three, and that is F2 (your-org/nexus-code
        # #977 skeptic pass): the loop wrote a ledger line under the FILING
        # window's own key, taking the sha from that window's own arm. So a
        # skeptic holding a live obligation for its OWN report, filing a
        # verdict about SOMEBODY ELSE, recorded `discharged <its own artefact>`
        # — a self-signed validation that then suppressed its own re-arm and
        # told the operator `THIS ARTEFACT IS ALREADY VALIDATED`, citing a
        # verdict about another window.
        #
        # The chain root is excluded for the same reason at one remove: at
        # depth 2 the reviewer examined the depth-1 skeptic's work, not the
        # original deliverable, so a discharge naming the root's artefact is a
        # claim nobody made. At depth 1 `reviewed` and `orig` COINCIDE and the
        # single record covers it.
        #
        # Clearing a marker and asserting that its artefact was validated are
        # different acts, and conflating them is what made the loss durable.
        local _sk_reviewed_key=""
        if [[ -n "$reviewed" && "$reviewed" != "<unknown-target>" ]]; then
            _sk_reviewed_key=$(wk_encode "$reviewed")
        fi
        # A verdict naming ITSELF as the target is a self-review; the marker is
        # still cleared (unchanged), but nothing is recorded — a window may not
        # sign its own artefact off, which is the general form of F2.
        if [[ -n "$_sk_reviewed_key" && -n "$source_window" \
              && "$reviewed" == "$source_window" ]]; then
            _sk_reviewed_key=""
        fi
        _SK_DISCHARGE_RECORDED=0; _SK_DISCHARGE_DETAIL=""
        # The RAW `--skeptic-subject` argument is threaded through beside the
        # hash it resolved to. A reviewer that named a PATH asserted a
        # DELIVERABLE; `_skeptic_resolve_subject` above turns that into the
        # bytes at wrap-up time, which is a DIFFERENT claim when the worker
        # amended the report after arming (your-org/nexus-code#1156). Passing
        # both lets the discharge attribute on the assertion that was actually
        # made and record the hash drift as evidence. Empty when the reviewer
        # passed a bare sha — a content assertion is left exactly as it was.
        local _sk_subject_path=""
        if [[ -n "${_SK_SUBJECT_ARG:-}" && ! "${_SK_SUBJECT_ARG}" =~ ^[0-9a-f]{64}$ ]]; then
            _sk_subject_path="$_SK_SUBJECT_ARG"
        fi
        [[ -n "$_sk_reviewed_key" ]] \
            && _skeptic_record_discharge "$pending_dir" "$_sk_reviewed_key" \
                   "$verdict" "$issue" "${source_window:-skeptic}" "$_sk_asserted" \
                   "$_sk_subject_path"
        local _sk_disch_key _sk_disch_seen=""
        for _sk_disch_key in \
            "$( [[ -n "$reviewed" && "$reviewed" != "<unknown-target>" ]] && wk_encode "$reviewed" )" \
            "$orig_safe" "$sw_safe"
        do
            [[ -n "$_sk_disch_key" ]] || continue
            [[ "$_sk_disch_seen" == *"|$_sk_disch_key|"* ]] && continue
            _sk_disch_seen="${_sk_disch_seen}|$_sk_disch_key|"
            rm -f "$pending_dir/${_sk_disch_key}" 2>/dev/null || true
        done

        # OBLIGATION: RECORD THE ROUND, DO NOT SETTLE THE PAIRING
        # (your-org/nexus-code#845, corrected by sk926).
        #
        # This used to `obligations.sh settle --debtor "$source_window"`, on
        # the reasoning that filing the verdict IS the discharge. That is
        # true of the ROUND and false of the PAIRING, and the difference is
        # the entire defect the gate was built to stop.
        #
        # Replaying the recorded timeline: `sk911` filed its verdict at
        # 09:19:36 and was retired at 09:21:21, while `papercuts` went on
        # being worked until 10:55 and needed a THIRD reviewer spawned at
        # 10:41:37. Settling here closed the edge 105 seconds before the
        # hazard began, so `retire-preflight` returned `safe=1` for the very
        # incident it was written for.
        #
        # A retained reviewer is the designated reviewer for the NEXT round —
        # that is why it is retained rather than retired — so it is owed
        # again the moment its target pushes a delta, and there is no instant
        # in between at which destroying it is safe. The pairing ends on
        # `ng skeptic close <target>` (the protocol's own end-of-pairing
        # signal), on supersession by a later reviewer, on the creditor
        # leaving tmux, or on an audited `ng obligation settle`. None of
        # those is "a verdict was filed".
        #
        # The verdict is still WRITTEN to the edge, because an operator
        # reading `ng obligation show` should see the rounds that have been
        # delivered — it just does not release anything.
        if [[ -n "$source_window" && -x "$_script_dir/obligations.sh" ]]; then
            ( "$_script_dir/obligations.sh" note --debtor "$source_window" \
                --text "round $depth verdict '$verdict' filed for $reviewed (issue ${issue:-none}) — round discharged, pairing NOT ended" \
                ) >/dev/null 2>&1 || true
        fi

        printf '\n=== SKEPTIC VERDICT (skills/nexus.skeptic) ===\n'
        printf 'reviewed window : %s\n' "$reviewed"
        [[ "$orig_eff" != "$reviewed" ]] && printf 'original worker : %s\n' "$orig_eff"
        printf 'verdict         : %s\n' "$verdict"
        printf 'depth           : %s\n' "$depth"
        printf 'new findings    : %s\n' "$findings_disp"
        # THE BANNER MUST NOT OUTLIVE THE WRITE (your-org/nexus-code#1191).
        #
        # This block printed `verdict : credible` three times over a ledger it
        # left BYTE-IDENTICAL, and the author had no cue to check — a
        # success-shaped output for a record that does not exist is this
        # corpus's dominant defect class arriving in the one surface whose job
        # is to say what happened. So the banner now reports the LEDGER, not
        # just the verdict, and names the escape hatch when there is nothing to
        # record against.
        case "${_SK_DISCHARGE_RECORDED:-0}:${_sk_reviewed_key:+k}" in
            1:k) printf 'ledger          : recorded (%s)\n' "${_SK_DISCHARGE_DETAIL:-?}" ;;
            # THIS ARM MEANS THE APPEND FAILED, NOT THAT NOTHING WAS ARMED
            # (your-org/nexus-code#1253). Since #1207 BOTH nothing-outstanding
            # shapes are WRITTEN — `no-open-arm` when a ledger exists and
            # `no-arm-on-record` when it does not — and
            # `_skeptic_record_discharge` has exactly one early return, which
            # this call site cannot reach (`pending_dir` is never empty and
            # `:k` guarantees a non-empty key). So reaching `0:k` means the
            # write itself failed.
            #
            # The old text asserted the opposite on all three of its clauses.
            # Driven against the state that triggers it — a ledger that EXISTS,
            # holds an arm and a prior `check`, made unwritable — it printed
            # "no ledger exists", "nothing ever armed it" and "will report
            # evidence=none" while `ng skeptic-evidence` independently reported
            # `attributed`. A diagnosis that is false in exactly the state that
            # produces it is worse than none, because it sends the operator to
            # repair an arm that is not broken.
            0:k) printf 'ledger          : NOT RECORDED — the ledger append FAILED. The verdict\n'
                 printf '                  above is real and is written NOWHERE.\n'
                 printf '                  ledger: %s\n' "$(_skeptic_ledger_file "$pending_dir" "$_sk_reviewed_key")"
                 printf '                  This is a WRITE failure, not a missing arm: since #1207 a\n'
                 printf '                  verdict is recorded whether or not anything was armed. The\n'
                 printf '                  file may well exist and already hold arms and verdicts, so\n'
                 printf '                  do NOT read this as "%s was never reviewed".\n' "$reviewed"
                 printf '                  Check permissions and free space on that path first.\n'
                 printf '                  `ng skeptic resolve` APPENDS TO THAT SAME FILE, so while it\n'
                 printf '                  is unwritable that remedy is a SILENT no-op at rc 0 — fix\n'
                 printf '                  the path, then re-run this wrap-up.\n' ;;
            *)   printf 'ledger          : not recorded — no reviewed target to key on\n' ;;
        esac

        # Bounded recursion. A second-pass skeptic is warranted only when
        # this pass found SUBSTANTIVE NEW issues (suspect/refuted verdict,
        # or findings >= threshold) AND depth is below the cap. This is
        # the diminishing-returns rule + the termination guarantee: depth
        # strictly increments and is capped, so the chain ends after at
        # most max_depth+1 passes.
        local max_depth thresh
        max_depth=$(_skeptic_cfg_int monitor.skeptic.max_depth MONITOR_SKEPTIC_MAX_DEPTH 3)
        thresh=$(_skeptic_cfg_int monitor.skeptic.findings_threshold MONITOR_SKEPTIC_FINDINGS_THRESHOLD 1)
        # Floor the threshold at 1. A threshold of 0 makes `findings(0)
        # >= thresh(0)` true, so a clean 0-findings pass would still
        # recommend a second pass — defeating the diminishing-returns
        # rule. A second pass is warranted only on >=1 substantive new
        # finding (or a suspect/refuted verdict), never on none.
        (( thresh < 1 )) && thresh=1
        local substantive=0
        if [[ "$verdict" == "suspect" || "$verdict" == "refuted" ]]; then
            substantive=1
        elif (( findings_stated == 1 )) && (( findings >= thresh )); then
            # your-org/nexus-code#881 — the comparison runs ONLY against a
            # number somebody supplied. Unguarded, `(( findings >= thresh ))`
            # with an empty `findings` is not even an error in bash: the
            # empty string evaluates as 0, so the arm silently answers
            # "below threshold" for a count that was never taken. That is
            # the fabricated zero surviving the removal of the default.
            substantive=1
        fi

        # your-org/nexus-code#678 — the derived escalation above is a COUNT,
        # and a count measures THOROUGHNESS, not DOUBT. The two are close to
        # inversely correlated: on 2026-08-02 this demanded a second pass four
        # times against authors who had explicitly written `no-further-pass`,
        # and all four were adjudicated and declined. The worst offender filed
        # SIX findings while leading with "safe to merge" — its most valuable
        # output being a negative result it volunteered about its own subject.
        # Meanwhile a lazy pass with one vague concern derives as LESS
        # contested. The signal is close to backwards.
        #
        # So check the PROPERTY — did the author's own disposition say more
        # work is needed — instead of the proxy. The author is the only party
        # who has read the evidence, so an explicit `no-further-pass` governs.
        # It is overridden only by a NAMED severity-bearing condition, never by
        # arithmetic:
        #   * verdict `suspect`/`refuted` — the pass's own bottom line is doubt,
        #     which contradicts `no-further-pass` at the level of the verdict
        #     rather than at the level of a tally;
        #   * a recorded worker contradiction — two parties on record disagreeing
        #     is exactly what a further pass adjudicates.
        # A BLANK disposition still escalates: that is genuine absence of signal,
        # and it is the case that SHOULD ask (#678 point 4).
        # your-org/nexus-code#684 — the parser now reports WHICH of four states
        # it saw and WHERE it saw it, because `absent` and `unreadable` call
        # for opposite handling and used to be the same empty string. Both
        # still ESCALATE (fail-safe), but only `absent` does so quietly:
        # `unreadable` means the author wrote a disposition we could not read,
        # which is the case where they believe they have communicated and have
        # not, so it is reported loudly and logged.
        [[ "$verdict" == "suspect" || "$verdict" == "refuted" ]] && _sk_severity=1
        [[ -n "$f_contradicted" ]] && _sk_severity=1
        if (( substantive == 1 )) && [[ "$_sk_stated" == "no-further-pass" ]] \
           && (( _sk_severity == 0 )); then
            _sk_honoured=1
            substantive=0
        elif (( substantive == 0 )) && [[ "$_sk_stated" == "second-pass" ]]; then
            # The MIRROR of the same defect, closed for symmetry. If the count
            # governs downward it must govern upward too, or "the count is not
            # the signal" is only asserted in the direction that reduces work.
            # An author who read the evidence and asked for another pass was
            # previously overruled by `findings=0` — the same arithmetic,
            # failing silent instead of loud, and worse: a dropped request is
            # unrecoverable silence, where a spurious one merely costs an
            # adjudication.
            _sk_author_asked=1
            substantive=1
        elif (( substantive == 0 )) && (( findings_stated == 0 )) \
             && [[ "$_sk_stated" != "no-further-pass" ]]; then
            # your-org/nexus-code#881 — NOTHING WAS STATED. Reachable only
            # with `_sk_stated` in {absent, unreadable}: `second-pass` is
            # caught by the arm above and `no-further-pass` is excluded
            # here. So the pass supplied neither a count nor a disposition
            # this parser could read, and the old code answered that with
            # a clean termination derived from a zero it invented.
            #
            # ESCALATE instead, on #678's own logic rather than against it.
            # #678 says the count is a bad signal and the AUTHOR's stated
            # disposition governs; its point 4 says a BLANK disposition is
            # genuine absence of signal and is the case that SHOULD ask.
            # Here BOTH surfaces are blank. There is no party on record
            # saying the chain may end, so the verb must not say it for
            # them.
            #
            # This does NOT make a legitimate wrap-up harder, and the
            # escape hatch is the honest statement itself: state a count
            # (`--skeptic-findings 0` for a real clean pass) or state a
            # disposition (`disposition: no-further-pass`, which
            # `report-check` has validated at write time since #836).
            # Either one terminates the chain. Only stating neither
            # escalates — and a pass that states neither has not reported
            # a result, it has just stopped.
            _sk_nothing_stated=1
            substantive=1
        fi

        if (( substantive == 1 )) && (( depth < max_depth )); then
            local next=$((depth + 1))
            # NOTE: no pending markers are (re-)written here. A second pass
            # is only RECOMMENDED — the markers that BLOCK retirement and
            # drive the parked-awaiting-skeptic exemption are re-established
            # by spawn-worker.sh if and when the orchestrator actually spawns
            # the next skeptic (it seeds pending/<target> + pending/<orig>).
            # Writing them here speculatively was the leak: when the
            # orchestrator declined the recommendation, nothing ever cleared
            # them and retire-preflight stayed safe=0 forever.
            ( cmd_log_action monitor --event skeptic-request \
                --extra "target-window=${source_window:-skeptic}" \
                --extra "orig-window=$orig_eff" \
                --extra "depth=$next" \
                --extra "reason=second-pass" \
                --extra "issue=$issue" ) 2>/dev/null || true
            # Signal cmd_wrap_up (Step 2b) to file a spawn-skeptic request
            # for the NEXT pass, flagged `deliberate=true` so the orchestrator
            # reads the prior verdict and decides (spawn+adjudicate / decline /
            # escalate) rather than rubber-stamping (#545 recommendation 5).
            # Only when a real source window resolved (an off-tmux skeptic
            # wrap-up has nothing to spawn against).
            #
            # The REASON is derived from the actual cause, not asserted. This
            # used to read `second-pass-dispute` unconditionally, justified as
            # "a recursion is by definition a prior-skeptic dispute" — and #681
            # made that false on its face by routing the MIRROR through here:
            # `_sk_author_asked` is the case where the author EXPLICITLY ASKED
            # for the next pass, so there is no dispute at all. A label that
            # says "dispute" for a request the author volunteered tells the
            # orchestrator's adjudication step the opposite of what happened
            # (your-org/nexus-code#681 skeptic F4).
            if [[ -n "$source_window" ]]; then
                _SK_SPAWN_REQ=1
                _SK_SPAWN_TARGET="$source_window"
                _SK_SPAWN_DEPTH="$next"
                _SK_SPAWN_ORIG="$orig_eff"
                _SK_SPAWN_MODE="$mode"
                _SK_SPAWN_EFFECTIVE="second-pass"
                _SK_SPAWN_DELIBERATE=1
                if (( _sk_author_asked == 1 )); then
                    # Not a dispute: the report's own disposition asked for it.
                    _SK_SPAWN_REASONS="second-pass-author-requested"
                elif (( _sk_severity == 1 )) && [[ "$_sk_stated" == "no-further-pass" ]]; then
                    # A dispute, and specifically one where a severity signal
                    # OVERRODE a stated no-further-pass. Name it, so the
                    # override rate is reconstructible from the request corpus
                    # and not only from the worker's terminal.
                    _SK_SPAWN_REASONS="second-pass-dispute,disposition-overridden"
                elif [[ "$_sk_stated" == "unreadable" ]]; then
                    # #684 — not a dispute either. The author stated something
                    # we could not read, so this request may be an artefact of
                    # the parse rather than of the evidence. Say so in the
                    # label, since the orchestrator adjudicates from it.
                    _SK_SPAWN_REASONS="second-pass-disposition-unreadable"
                elif [[ "$_sk_stated" == "second-pass" ]]; then
                    # your-org/nexus-code#685 — AGREEMENT, mislabelled as a
                    # dispute. `_sk_author_asked` only fires when the derived
                    # recommendation was NOT substantive; when both the count
                    # and the author independently reach "another pass", the
                    # author-asked arm never runs and this used to fall through
                    # to `second-pass-dispute`. The two parties concur, which is
                    # the OPPOSITE of what the orchestrator was being told.
                    _SK_SPAWN_REASONS="second-pass-author-concurs"
                elif [[ "$_sk_stated" == "absent" ]]; then
                    # #685 — no second party, so no dispute is possible. The
                    # author stated nothing and the recommendation is
                    # count-derived (severity-blind, per #599). Naming it that
                    # way is what lets the count-derived rate be separated from
                    # the genuinely-contested rate in the request corpus.
                    _SK_SPAWN_REASONS="second-pass-no-disposition-stated"
                else
                    # #685 — UNREACHABLE by construction: the parser has exactly
                    # four states and all four are handled above (this arm is
                    # reached only with `no-further-pass` AND `_sk_severity == 0`,
                    # which is honoured upstream and never becomes substantive).
                    # It is kept, and deliberately does NOT say "dispute": an
                    # unclassified request must not assert a disagreement it has
                    # not established. Reaching this means the parser grew a
                    # fifth state and the label space needs revisiting.
                    _SK_SPAWN_REASONS="second-pass-unclassified"
                fi
                _SK_SPAWN_CONTRADICTED="$f_contradicted"
                [[ -n "$f_contradicted" ]] \
                    && _SK_SPAWN_REASONS="${_SK_SPAWN_REASONS},worker-contradiction"
                # your-org/nexus-code#881 — an ORTHOGONAL token rather than a
                # sixth primary label. Whether a count was stated is a
                # different axis from which disposition state fired, and
                # every combination occurs; folding them into one label
                # space would make the corpus unqueryable on either axis.
                # It also disarms a false reading of the labels above: the
                # `absent` arm's rationale calls its recommendation
                # "count-derived", which is only true when there IS a count.
                (( findings_stated == 0 )) \
                    && _SK_SPAWN_REASONS="${_SK_SPAWN_REASONS},findings-not-stated"
            fi
            # #599 — surface a DISAGREEMENT between the derived
            # recommendation and the report's own stated conclusion,
            # rather than letting the count-derived value win silently.
            # `substantive` here comes from `findings >= threshold`, a
            # COUNT, which cannot tell a cosmetic nit from a
            # merge-blocking defect; it overrode a report that said "no
            # further pass warranted" three times in one session.
            # Reaching here with a stated `no-further-pass` means a
            # SEVERITY-BEARING signal overrode it (#678) — a count alone no
            # longer can. Name which one, so the override is auditable rather
            # than mysterious: an unexplained override is what made the old
            # count-derived escalation feel arbitrary.
            if [[ "$_sk_stated" == "no-further-pass" ]]; then
                # your-org/nexus-code#685 — the SYMMETRIC trace. The honoured
                # decision has logged `skeptic-disposition-honoured` since
                # #681; the OVERRIDE named its cause only in this printf, to
                # the worker's terminal. So the honoured rate was measurable
                # and the override rate was not — and the override is the
                # higher-stakes half, which makes it the direction least
                # likely to be questioned and therefore the one that most
                # needs a trace. `rule` names WHICH severity signal fired, so
                # "was #678's fix right?" is answerable from disk in both
                # directions rather than only the one that reduces work.
                local _sk_rule=""
                [[ "$verdict" == "suspect" || "$verdict" == "refuted" ]] \
                    && _sk_rule="verdict-$verdict"
                [[ -n "$f_contradicted" ]] \
                    && _sk_rule="${_sk_rule:+$_sk_rule,}worker-contradiction"
                ( cmd_log_action monitor --event skeptic-disposition-overridden \
                    --extra "window=${source_window:-skeptic}" \
                    --extra "orig-window=$orig_eff" \
                    --extra "depth=$depth" \
                    --extra "verdict=$verdict" \
                    "${findings_x[@]}" \
                    --extra "threshold=$thresh" \
                    --extra "rule=${_sk_rule:-none}" \
                    --extra "source=$_sk_dsource" \
                    --extra "issue=$issue" ) 2>/dev/null || true
                printf '\n!! RECOMMENDATION DISPUTED — read this before spawning anything.\n'
                printf '   YOUR REPORT states: no-further-pass (source: %s)\n' "$_sk_dsource"
                if [[ "$verdict" == "suspect" || "$verdict" == "refuted" ]]; then
                    printf '   OVERRIDDEN BY: verdict=%s. Your own bottom line is doubt, which\n' "$verdict"
                    printf '   contradicts no-further-pass at the level of the VERDICT, not a tally.\n'
                fi
                if [[ -n "$f_contradicted" ]]; then
                    printf '   OVERRIDDEN BY: a recorded worker contradiction (%s). Two parties on\n' "$f_contradicted"
                    printf '   record disagreeing is what a further pass exists to adjudicate.\n'
                fi
                if (( findings_stated == 1 )); then
                    printf '   Note the findings COUNT (%s >= threshold %s) is NOT what escalated this;\n' \
                        "$findings" "$thresh"
                    printf '   since #678 a count alone cannot override your stated disposition.\n'
                else
                    printf '   You stated NO findings count, so no count was involved in either\n'
                    printf '   direction — threshold %s was never applied (#881). Since #678 a count\n' "$thresh"
                    printf '   alone could not have overridden your disposition in any case.\n'
                fi
                printf '   The filed request carries recommendation=DISPUTED; the ORCHESTRATOR\n'
                printf '   adjudicates. If you meant no further pass, say so in your hand-off\n'
                printf '   comment; if the override is right, correct the disposition line.\n'
            elif (( _sk_author_asked == 1 )); then
                printf '\nNOTE: this escalation is YOURS, not the count'\''s. verdict=%s with\n' "$verdict"
                if (( findings_stated == 1 )); then
                    printf 'findings=%s would have derived a clean termination; your report states\n' "$findings"
                else
                    printf 'no stated count derives NOTHING in either direction (#881); your report states\n'
                fi
                printf '`second-pass`, and since #678 an explicit disposition governs in BOTH\n'
                printf 'directions — otherwise "the count is not the signal" would only hold\n'
                printf 'where it reduces work.\n'
            elif [[ "$_sk_stated" == "unreadable" ]]; then
                # your-org/nexus-code#684 — the LOUD arm. The author DID write
                # a disposition; we could not read it, so it did not govern.
                # Before #684 this printed the "you stated nothing" text
                # above, telling an author who had stated one to write one —
                # advice that is not just useless but actively misleading,
                # because the line they would "add" is already there.
                printf '\n!! YOUR DISPOSITION WAS NOT READ — this escalation may be an artefact.\n'
                printf '   A disposition IS present in your report (%s) and the parser could not\n' "$_sk_dsource"
                printf '   resolve it to a token: %s\n' "$_sk_ddetail"
                if (( findings_stated == 1 )); then
                    printf '   It therefore did NOT govern, and the escalation below was derived\n'
                    printf '   (verdict=%s, findings=%s >= threshold %s) as though you had said nothing.\n' \
                        "$verdict" "$findings" "$thresh"
                else
                    # your-org/nexus-code#881 — BOTH surfaces silent. Saying
                    # "as though you had said nothing" would be wrong by half
                    # here: you did say something (an unreadable disposition)
                    # and you also stated no count, so the escalation rests on
                    # absence alone rather than on any measurement.
                    printf '   It therefore did NOT govern. You also stated NO findings count, so\n'
                    printf '   nothing you supplied reached the gate at all: the escalation below is\n'
                    printf '   derived from that absence (verdict=%s), not from a measurement (#881).\n' \
                        "$verdict"
                fi
                printf '   FIX IT AT SOURCE: the value must BE exactly `no-further-pass` or\n'
                printf '   `second-pass`, on its own after the colon. Commentary belongs after a\n'
                printf '   closing `**` or on the next line. Then re-run `ng wrap-up`.\n'
                ( cmd_log_action monitor --event skeptic-disposition-unreadable \
                    --extra "window=${source_window:-skeptic}" \
                    --extra "orig-window=$orig_eff" \
                    --extra "depth=$depth" \
                    --extra "source=$_sk_dsource" \
                    --extra "detail=$_sk_ddetail" \
                    --extra "report=${_SK_REPORT_PATH:-}" \
                    --extra "issue=$issue" ) 2>/dev/null || true
            elif [[ "$_sk_stated" == "absent" ]]; then
                if (( findings_stated == 1 )); then
                    printf '\nNOTE: your report states NO disposition, so this escalation was derived\n'
                    printf '(verdict=%s, findings=%s >= threshold %s). A blank disposition is genuine\n' \
                        "$verdict" "$findings" "$thresh"
                    printf 'absence of signal and is the case that SHOULD ask (#678). Had you written\n'
                    printf '`disposition: no-further-pass`, it would have governed. Write one next time.\n'
                else
                    # your-org/nexus-code#881 — the case the fabricated zero
                    # used to swallow whole. Neither surface carried a
                    # statement, and the old code answered that with a clean
                    # termination derived from a count nobody took.
                    printf '\n!! YOU STATED NEITHER A COUNT NOR A DISPOSITION.\n'
                    printf '   No `--skeptic-findings`, and no readable `disposition:` in the report.\n'
                    printf '   Nothing on record says this chain may end, so the verb will not say it\n'
                    printf '   for you: the escalation below is derived from that absence alone\n'
                    printf '   (verdict=%s), not from any measurement (your-org/nexus-code#881).\n' "$verdict"
                    printf '   Until #881 an omitted count was silently recorded as a MEASURED 0 and\n'
                    printf '   terminated the chain here — indistinguishable, in the log, from a pass\n'
                    printf '   that had genuinely looked and found nothing.\n'
                    # Same correction as the refusal above (your-org/nexus-code#914.2):
                    # at suspect/refuted neither statement terminates anything.
                    if [[ "$verdict" == "suspect" || "$verdict" == "refuted" ]]; then
                        printf '   NEITHER statement will terminate this chain — your verdict is `%s`,\n' "$verdict"
                        printf '   which escalates on its own (#678). State one anyway: it is what makes\n'
                        printf '   this escalation HONEST rather than derived from absence:\n'
                    else
                        printf '   EITHER statement terminates it honestly, and both are one line:\n'
                    fi
                    printf '     --skeptic-findings 0        (you looked and found nothing new)\n'
                    printf '     disposition: no-further-pass (in the report frontmatter)\n'
                fi
            fi
            if (( _sk_nothing_stated == 1 )); then
                # your-org/nexus-code#881 — do NOT claim this pass "found
                # substantive new issues". It stated nothing; that is a
                # different fact and the header must not launder it into a
                # finding. The escalation is honest, its justification is not
                # a discovery.
                printf '\nSECOND-PASS SKEPTIC RECOMMENDED — not because this pass found substantive\n'
                printf 'new issues, but because it stated NOTHING: no count and no readable\n'
                printf 'disposition (verdict=%s) at depth %s (cap %s). The next skeptic reviews the\n' \
                    "$verdict" "$depth" "$max_depth"
            elif (( findings_stated == 1 )) && [[ "$findings" =~ ^[0-9]+$ ]] && (( findings == 0 )); then
                # your-org/nexus-code#914 (the 2026-09-02 re-derivation, confirmed by
                # bundlersk on #1437): a STATED, MEASURED zero is not "substantive new
                # issues". The escalation is real — the VERDICT sets the severity
                # signal on its own (#678) — but its justification is the verdict,
                # not a discovery, and saying otherwise contradicts the count on
                # the same line.
                printf '\nSECOND-PASS SKEPTIC RECOMMENDED — not because this pass found new issues\n'
                printf '(it stated findings=0), but because its verdict `%s` sets the severity\n' "$verdict"
                printf 'signal on its own (#678) at depth %s (cap %s). The next skeptic reviews the\n' \
                    "$depth" "$max_depth"
            else
                printf '\nSECOND-PASS SKEPTIC RECOMMENDED — this pass found substantive new issues\n'
                printf '(verdict=%s, findings=%s) at depth %s (cap %s). The next skeptic reviews the\n' \
                    "$verdict" "$findings_disp" "$depth" "$max_depth"
            fi
            printf 'WHOLE chain — the original worker `%s` AND this skeptic — and adjudicates\n' "$orig_eff"
            printf 'any worker↔skeptic disagreement. The orchestrator should spawn:\n\n'
            _skeptic_spawn_cmd "${source_window:-<this-skeptic-window>}" "$next" "$orig_eff"
            printf '\nYOU (this skeptic) are now reviewed by that next skeptic — do NOT go idle.\n'
            printf 'Enter the await loop on YOUR OWN window so its questions reach you, and\n'
            printf 'do NOT close the original worker `%s` channel (leave it parked for the\n' "$orig_eff"
            printf 'next skeptic; only the FINAL skeptic closes it when the chain terminates):\n'
            printf '    monitor/skeptic-channel.sh await %s; rc=$?; echo "AWAIT_RC=$rc"; exit $rc\n' "${source_window:-<this-skeptic-window>}"
            printf '    # end it in `exit $rc` and BACKGROUND it: a `;`-list reports its\n'
            printf '    # LAST statement`s status, so a trailing `echo` — or a bare\n'
            printf '    # `rc=$?` — reports 0 for a 4, a 10 or an 11 (#1161).\n'
            printf '    # BACKGROUND = the Bash tool`s run_in_background (it re-invokes you\n'
            printf '    # on exit) or a Monitor until-loop — NOT monitor/async-run.sh, which\n'
            printf '    # retains the rc and re-invokes nobody (#1523).\n'
            printf '\nA second pass is the ORCHESTRATOR'\''s call. If it DECLINES (the findings\n'
            printf 'are minor/acceptable and no further pass is warranted), it terminates the\n'
            printf 'chain normally — `ng skeptic close` the worker(s) and retire. The blocking\n'
            printf 'markers were already cleared by THIS verdict, so a declined recommendation\n'
            printf 'leaks nothing; the block returns only if a real next skeptic is spawned.\n'
        elif (( substantive == 1 )) && (( depth >= max_depth )); then
            # Chain terminates at the cap. All markers (reviewed, orig, self)
            # were already cleared above on the verdict — nothing to release.
            ( cmd_log_action monitor --event skeptic-escalate \
                --extra "window=${source_window:-skeptic}" \
                --extra "target-window=$reviewed" \
                --extra "orig-window=$orig_eff" \
                --extra "depth=$depth" \
                --extra "verdict=$verdict" \
                --extra "issue=$issue" ) 2>/dev/null || true
            printf '\nMAX SKEPTIC DEPTH REACHED (depth %s >= cap %s) and issues persist.\n' "$depth" "$max_depth"
            printf 'Do NOT spawn another skeptic — ESCALATE to the operator instead.\n'
            printf 'The chain is bounded by design; persistent issues at the cap are a\n'
            printf 'signal for human judgement, not more automated passes.\n'
        elif (( _sk_honoured == 1 )); then
            # your-org/nexus-code#678 — the count WOULD have escalated; the
            # author's explicit disposition governs and no request is filed.
            # Reported, not demanded: the disagreement is still surfaced (and
            # logged, so the decision stays auditable and its rate measurable),
            # but it no longer costs an orchestrator adjudication per instance.
            ( cmd_log_action monitor --event skeptic-disposition-honoured \
                --extra "window=${source_window:-skeptic}" \
                --extra "orig-window=$orig_eff" \
                --extra "depth=$depth" \
                --extra "verdict=$verdict" \
                "${findings_x[@]}" \
                --extra "threshold=$thresh" \
                --extra "source=$_sk_dsource" \
                --extra "issue=$issue" ) 2>/dev/null || true
            printf '\nSkeptic chain TERMINATES on YOUR stated disposition: no-further-pass.\n'
            printf 'A findings count of %s (>= threshold %s) would once have derived a second\n' \
                "$findings_disp" "$thresh"
            printf 'pass and demanded the orchestrator adjudicate it. It no longer does: a count\n'
            printf 'measures thoroughness, not doubt, and you are the party who read the\n'
            printf 'evidence (#678). No severity-bearing signal is present — verdict=%s, no\n' "$verdict"
            printf 'recorded worker contradiction — so nothing overrides you.\n'
            printf 'If you DID want another pass, the disposition line is what to change.\n'
        else
            # Clean termination. All markers (reviewed, orig, self) were
            # already cleared above on the verdict — nothing to release.
            #
            # your-org/nexus-code#881 — reachable with an UNSTATED count only
            # via a stated `no-further-pass`, which is the author governing
            # (the #678 rule) rather than a fabricated zero. Say which one it
            # was: "no substantive new issues" is a claim about the evidence,
            # and it must not be printed over a count that was never taken.
            if (( findings_stated == 1 )); then
                printf '\nSkeptic chain TERMINATES: no substantive new issues (verdict=%s, findings=%s).\n' \
                    "$verdict" "$findings"
            else
                printf '\nSkeptic chain TERMINATES on your stated `no-further-pass` (verdict=%s).\n' "$verdict"
                printf 'NOTE: you stated no findings count, so this is NOT a recorded "found nothing"\n'
                printf '— it is your disposition governing (#678/#881). If you did look and find\n'
                printf 'nothing, say so with `--skeptic-findings 0`; the log keeps the two apart.\n'
            fi
        fi
        return 0
    fi

    # =====================================================================
    # PRODUCER PATH — the original worker's wrap-up.
    # =====================================================================

    # Operator waiver: an explicit override that releases a required
    # skeptic. Operator-scoped + recorded loudly for audit.
    # ── SATISFIED: THE REQUIREMENT WAS MET, AND HERE IS THE EVIDENCE ─────
    #
    # your-org/nexus-code#1132. Before this the vocabulary had no way to say
    # "the required validation HAPPENED", so a met requirement had to be
    # recorded as a WAIVER — a statement that the requirement was SET ASIDE.
    # Those are opposite claims about the same gate, and the record kept only
    # the wrong one.
    #
    # THE WHOLE POINT IS THAT IT IS CHECKED, so it is deliberately NOT gated on
    # `NEXUS_WORKER_WINDOW`. `--skeptic-waive` and `ng skeptic resolve` are both
    # role-gated and verify NOTHING — measured, `ng skeptic resolve ghostwin
    # --reason "a verdict that has never existed anywhere, cited freely"`
    # succeeds. A mechanical check extends no trust, so it needs no role; and
    # that is what makes this usable by the party who OBSERVES the dispute,
    # which is the worker.
    #
    # RETIRE-GATE POLARITY: every doubt REFUSES. Unreadable ledger, evidence
    # `?`, no verdict, a citation that resolves to nothing, a citation no
    # discharge names, or more open arms than this citation can close — all rc
    # 1, marker untouched. The arming gates fail toward arming; this one is a
    # RELEASE, so it fails toward NOT releasing.
    if (( ${f_satisfied:-0} == 1 )); then
        if [[ -z "$sw_safe" ]]; then
            echo "ng wrap-up: --skeptic-satisfied needs a resolvable window key; none was found." >&2
            return 1
        fi
        if [[ -z "$f_satisfied_by" ]]; then
            echo "ng wrap-up: --skeptic-satisfied requires --skeptic-satisfied-by <report-path|sha256>." >&2
            echo "  It is the artefact whose verdict discharges the requirement. Without a citation" >&2
            echo "  this would be a waiver wearing a better word. Nothing was recorded." >&2
            return 1
        fi
        local _sat_sha _sat_ev _sat_verdicts _sat_class _sat_open
        if ! _sat_sha=$(_skeptic_resolve_subject "$f_satisfied_by"); then
            echo "ng wrap-up: --skeptic-satisfied-by '$f_satisfied_by' is neither a 64-hex sha256" >&2
            echo "  nor a readable file. Nothing was recorded." >&2
            return 1
        fi
        if ! _sat_ev=$(_skeptic_verdict_evidence "$pending_dir" "$sw_safe" 2>/dev/null); then
            echo "ng wrap-up: --skeptic-satisfied could not READ the ledger for '$source_window'." >&2
            echo "  That is a failure to look, not a finding. Nothing was recorded." >&2
            return 1
        fi
        # `evidence=` is the FIRST token of the first line, so the pattern must
        # allow start-of-line as well as a leading space. Requiring whitespace
        # matched nothing, `_sat_class` came back empty, and every case refused
        # with "classifies as ?" — a uniform refusal that looks like a working
        # gate and is really a broken probe. Caught by driving all six cases.
        _sat_class=$(printf '%s' "$_sat_ev" | sed -n '1s/.*\(^\|[[:space:]]\)evidence=\([^[:space:]]*\).*/\2/p')
        _sat_verdicts=$(printf '%s' "$_sat_ev" | sed -n '1s/.*[[:space:]]verdicts=\([0-9]*\).*/\1/p')
        [[ "$_sat_verdicts" =~ ^[0-9]+$ ]] || _sat_verdicts=0
        if [[ "$_sat_class" == "?" || -z "$_sat_class" ]]; then
            echo "ng wrap-up: --skeptic-satisfied refused — the ledger for '$source_window' classifies" >&2
            echo "  as '?', which asserts NOTHING in either direction. Nothing was recorded." >&2
            return 1
        fi
        if (( _sat_verdicts == 0 )); then
            echo "ng wrap-up: --skeptic-satisfied refused — NO verdict is on the ledger for" >&2
            echo "  '$source_window' (evidence=$_sat_class). `satisfied` means the validation" >&2
            echo "  HAPPENED; if it did not, this is a waiver, and --skeptic-waive is the honest" >&2
            echo "  verb. Nothing was recorded." >&2
            return 1
        fi
        if ! _skeptic_artefact_discharged "$pending_dir" "$sw_safe" "$_sat_sha" >/dev/null 2>&1; then
            echo "ng wrap-up: --skeptic-satisfied refused — a verdict exists, but NONE of them names" >&2
            echo "  the artefact you cited (sha $_sat_sha)." >&2
            echo "  Cite the artefact the reviewer actually discharged. Nothing was recorded." >&2
            return 1
        fi
        # A `resolved` row closes EVERY outstanding arm, not just the cited one
        # (`delete seen` wholesale). With more than one open arm this citation
        # cannot speak for the others, so refuse rather than close them
        # silently — the same shape #961 established for
        # `ambiguous-N-arms-outstanding`.
        _sat_open=$(_skeptic_open_arms "$pending_dir" "$sw_safe" 2>/dev/null | grep -c . ) || _sat_open=0
        [[ "$_sat_open" =~ ^[0-9]+$ ]] || _sat_open=0
        if (( _sat_open > 1 )); then
            echo "ng wrap-up: --skeptic-satisfied refused — $_sat_open arms are outstanding on" >&2
            echo "  '$source_window' and a settlement closes them ALL, so this ONE citation would" >&2
            echo "  silently discharge artefacts nobody reviewed. Land the other rounds first," >&2
            echo "  or use `ng skeptic resolve` and say so on the record. Nothing was recorded." >&2
            return 1
        fi
        # The EXISTING `resolved` row shape — every classifier and both entry
        # points already understand it. A NEW row kind would be swallowed
        # twice: `_skeptic_open_arms` has an implicit no-match arm (the arm
        # stays open and the window still cannot retire) and
        # `_skeptic_verdict_evidence` counts it `malformed`, whose FIRST class
        # arm turns the whole record into `?`. The novelty rides the
        # action-log `decision=` field and the rationale sidecar, neither of
        # which has a classifier.
        _skeptic_record_resolution "$pending_dir" "$sw_safe" \
            "ng wrap-up --skeptic-satisfied" \
            "requirement MET: verdict on the ledger discharges $_sat_sha"
        printf 'satisfied by %s\nverdict evidence: %s\n' "$f_satisfied_by" "$_sat_ev" \
            > "$pending_dir/.${sw_safe}.cleared-rationale" 2>/dev/null || true
        ( cmd_log_action monitor --event skeptic-decision \
            "${winx[@]}" \
            --extra "decision=satisfied" \
            --extra "by=$_sat_sha" \
            --extra "evidence=$_sat_class" \
            --extra "issue=$issue" ) 2>/dev/null || true
        _sk_keep_own_marker "$pending_dir/${sw_safe}"
        printf '\n=== SKEPTIC: SATISFIED (the required validation happened) ===\n'
        printf 'cited artefact: %s\n' "$f_satisfied_by"
        printf 'sha256        : %s\n' "$_sat_sha"
        printf 'ledger        : %s\n' "$_sat_ev"
        printf 'CONSEQUENCE: recorded as a SETTLEMENT, not a waiver — the record now says the\n'
        printf 'validation HAPPENED and names the artefact a reader can check.\n'
        if _sk_marker_was_released "$pending_dir/${sw_safe}"; then
            printf 'The marker for `%s` is released.\n' "$source_window"
        else
            printf 'The marker for `%s` was KEPT (see above): this wrap-up also carried\n' "$source_window"
            printf -- '--not-a-skeptic-verdict, which releases nothing (your-org/nexus-code#914).\n'
        fi
        return 0
    fi

    if [[ -n "$f_waive" ]]; then
        # Operator-scoped gate. The waive is an OPERATOR override, not a
        # worker self-service. Every spawned worker runs with
        # NEXUS_WORKER_WINDOW exported by spawn-worker.sh; the
        # orchestrator/operator session does not (ng already keys other
        # operator-vs-worker distinctions on exactly this — see the
        # report-init guard). So refuse a waive attempted from inside a
        # worker context. This is a discipline-and-audit control, not a
        # cryptographic boundary — a worker shares the filesystem and
        # could unset the var — but it blocks the casual self-waive, and
        # any bypass is then a deliberate, auditable act. The honest
        # claim is exactly this: operator-scoped + audited, not
        # cryptographically unforgeable (SKILL.md reconciled to match).
        if [[ -n "${NEXUS_WORKER_WINDOW:-}" ]]; then
            echo "ng wrap-up: --skeptic-waive is an operator override and was invoked from inside a" >&2
            echo "  worker context (NEXUS_WORKER_WINDOW=$NEXUS_WORKER_WINDOW). A worker cannot waive" >&2
            echo "  its own required skeptic. Leave the skeptic-pending marker in place for the" >&2
            echo "  operator to resolve (spawn the skeptic, or waive from the orchestrator session)." >&2
            echo "  THERE IS A THIRD POSSIBILITY and it is the common one here: a verdict may have" >&2
            echo "  been DELIVERED and the record unable to match it. Ask before assuming a pass is" >&2
            echo "  owed — \`monitor/ng skeptic-evidence <window>\` (your-org/nexus-code#1156)." >&2
            return 1
        fi
        ( cmd_log_action monitor --event skeptic-decision \
            "${winx[@]}" \
            --extra "decision=waived" \
            --extra "reason=$f_waive" \
            --extra "issue=$issue" ) 2>/dev/null || true
        # STATE THE MARKER'S ACTUAL STATE; DO NOT ASSERT ONE (#813 F5, #1132).
        #
        # `sw_safe` keys on the INVOKING PANE, not on the report's subject. So an
        # operator waiving a WORKER's gate from the orchestrator session removes
        # `pending/orchestrator` — a file that never existed — and `rm -f` is
        # silent on a miss. Measured: markers before `[panelive]`, after
        # `[panelive]`, `ng skeptic-obligations panelive` still
        # `outstanding=1`, while this text said the marker was cleared and the
        # window could retire. A false claim of release on a retire gate.
        local _sk_waive_had=0
        [[ -n "$sw_safe" && -e "$pending_dir/${sw_safe}" ]] && _sk_waive_had=1
        _sk_keep_own_marker "$pending_dir/${sw_safe}"
        printf '\n=== SKEPTIC: WAIVED (operator override) ===\n'
        printf 'reason: %s\n' "$f_waive"
        printf 'CONSEQUENCE: the required skeptic was waived by operator override;\n'
        if (( _sk_waive_had )) && _sk_marker_was_released "$pending_dir/${sw_safe}"; then
            printf 'the pending marker for `%s` is cleared, so THAT window can retire normally.\n' "$source_window"
        elif (( _sk_waive_had )); then
            # The sharpest of the four: `_sk_waive_had` tests PRESENCE-BEFORE,
            # which is exactly the condition under which the keep fires — so
            # this branch was taken EVERY time the opt-out was in play.
            # --skeptic-waive and --not-a-skeptic-verdict are NOT mutually
            # exclusive; the CLI guard excludes only --skeptic-role/--verdict.
            printf 'but the marker for `%s` was KEPT, because this wrap-up also carried\n' "$source_window"
            printf -- '--not-a-skeptic-verdict. NOTHING WAS RELEASED. Waive WITHOUT the opt-out\n'
            printf 'flag if you mean to release it (your-org/nexus-code#914).\n'
        else
            printf 'NO MARKER WAS PRESENT for `%s` — the window this wrap-up is keyed to.\n' "${source_window:-<none>}"
            printf 'NOTHING WAS RELEASED. If you are waiving ANOTHER window'\''s gate, this did\n'
            printf 'not do it: the key is the INVOKING pane, not the report'\''s subject. Use\n'
            printf '    ng skeptic resolve <that-window> --reason "<where the verdict landed>"\n'
            printf 'and check `ng skeptic-obligations <that-window>` afterwards.\n'
        fi
        printf '(recorded; proceeding without a skeptic pass)\n'
        return 0
    fi

    # Resolve the effective decision from spawn mode + worker decision.
    local effective=""
    case "$mode" in
        deny)
            if [[ "$f_decision" == "require" ]]; then
                effective=required-escalated   # responsible upgrade
            else
                effective=denied-spawn
            fi
            ;;
        require)
            if [[ "$f_decision" == "deny" ]]; then
                echo "ng wrap-up: this worker was spawned with --skeptic require; a skeptic is" >&2
                echo "  mandatory and you cannot waive it with --skeptic-decision deny. Proceed:" >&2
                echo "  leave the skeptic-pending marker in place (check \`ng skeptic-evidence\` first) and the orchestrator will spawn" >&2
                echo "  the skeptic. (Only an operator, from the orchestrator session, may release" >&2
                echo "  a requirement set in error.)" >&2
                echo "  If a verdict already came back, the marker being LIVE does not contradict" >&2
                echo "  that — check with \`monitor/ng skeptic-evidence <window>\` (#1156)." >&2
                return 1
            fi
            effective=required
            ;;
        auto|*)
            case "$f_decision" in
                require) effective=required ;;
                deny)    effective=denied-auto ;;
                "")      effective=undecided ;;
                *) echo "ng wrap-up: --skeptic-decision must be require|deny, got '$f_decision'" >&2; return 1 ;;
            esac
            # Auto decisions must carry a rationale (the responsible
            # choice must be articulated and recorded).
            if [[ "$effective" == "required" || "$effective" == "denied-auto" ]] && [[ -z "$f_rationale" ]]; then
                echo "ng wrap-up: an auto-mode skeptic decision requires --skeptic-rationale <text>" >&2
                echo "  (record WHY a skeptic is/ isn't warranted — see the heuristic below)." >&2
                _skeptic_print_heuristic >&2
                return 1
            fi
            ;;
    esac

    local next=$((depth + 1))
    case "$effective" in
        required|required-escalated)
            # your-org/nexus-code#815 — do NOT silently reverse an
            # orchestrator's `ng skeptic resolve`. See
            # `_skeptic_resolution_state` for the state vocabulary and for
            # why `unknown` arms rather than suppresses.
            local _sk_res_state _sk_res_detail _sk_res_path
            read -r _sk_res_state _sk_res_detail _sk_res_path \
                <<<"$(_skeptic_resolution_state "$pending_dir" "$sw_safe" "$source_window")"
            # EMPTY output means the probe did not run at all — the #684
            # lesson, applied here: name it rather than let a crashed probe
            # be indistinguishable from a clean `none`.
            if [[ -z "$_sk_res_state" ]]; then
                _sk_res_state=unknown
                _sk_res_detail=probe-produced-no-state
                _sk_res_path="-"
            fi
            # =============================================================
            # SUPPRESSION 2 of 2 — THIS EXACT ARTEFACT ALREADY HAS A VERDICT
            # (your-org/nexus-code#984)
            # =============================================================
            #
            # Independent of, and additional to, the `resolved` arm below.
            # That one asks "did an ORCHESTRATOR adjudicate this gate?"; this
            # one asks "is the thing I am about to require validation FOR the
            # same bytes a skeptic has already returned a verdict on?" Two
            # different questions with two different records, and #984 exists
            # because only the first had one.
            #
            # THE LIVE INSTANCE. A reviewer returned `no-further-pass` and
            # directed corrections. Applying corrections requires a wrap-up.
            # That wrap-up re-armed the gate and filed a second spawn-skeptic
            # request naming the same window, the same issue and the same
            # report path — differing only in the asset sha. The reviewer was
            # re-pinned and spent a full review cycle establishing that the
            # branch and `dev` were BYTE-IDENTICAL, i.e. that there was
            # nothing whatsoever to review. Nothing objected, because a
            # damper existed and it was ADVISORY: it printed a hint for a
            # human to act on. This is the same fact made ENFORCING.
            #
            # WHY IT CANNOT BE USED TO DODGE VALIDATION — the property that
            # keeps this from becoming #977 from the other side. Three
            # independent narrowings, each of which alone would be enough:
            #   * the key is a CONTENT hash, so one changed byte arms;
            #   * the ledger entry is written only by a real verdict landing
            #     on this key, never by a resolve, a waive, a teardown or a
            #     hand-`rm`;
            #   * `--skeptic-rearm "<what changed>"` overrides it, on the
            #     record, exactly as it overrides the `resolved` arm.
            # And the failure direction is ARM: no sha256 tool, an unreadable
            # report, no ledger, a malformed line — every one of them yields
            # "no match" and the gate arms normally.
            local _sk_art_sha="" _sk_art_line=""
            if [[ -n "$sw_safe" && -z "$f_rearm" ]]; then
                _sk_art_sha=$(_skeptic_artefact_sha "${_SK_REPORT_PATH:-}") || _sk_art_sha=""
                if [[ -n "$_sk_art_sha" ]]; then
                    _sk_art_line=$(_skeptic_artefact_discharged \
                        "$pending_dir" "$sw_safe" "$_sk_art_sha") || _sk_art_line=""
                fi
            fi
            if [[ -n "$_sk_art_line" ]]; then
                local _sk_art_v _sk_art_ts _sk_art_issue _sk_art_by
                IFS=$'\t' read -r _ _ _sk_art_ts _sk_art_v _sk_art_issue _sk_art_by \
                    <<<"$_sk_art_line"
                ( cmd_log_action monitor --event skeptic-rearm-suppressed \
                    "${winx[@]}" \
                    --extra "decision=$effective" \
                    --extra "mode=$mode" \
                    --extra "depth=$next" \
                    --extra "detail=artefact-already-validated" \
                    --extra "artefact-sha=$_sk_art_sha" \
                    --extra "discharged-verdict=${_sk_art_v:--}" \
                    --extra "discharged-at=${_sk_art_ts:--}" \
                    --extra "discharged-by=${_sk_art_by:--}" \
                    --extra "issue=$issue" ) 2>/dev/null || true
                printf '\n=== SKEPTIC: THIS ARTEFACT IS ALREADY VALIDATED — NOT RE-ARMING ===\n'
                printf 'The report being wrapped up is BYTE-IDENTICAL to one a skeptic has\n'
                printf 'already returned a verdict on, so re-arming would buy a second review\n'
                printf 'pass over nothing that changed (your-org/nexus-code#984).\n'
                printf '  report        : %s\n' "${_SK_REPORT_PATH:-<none>}"
                printf '  content sha256: %s\n' "$_sk_art_sha"
                printf '  verdict       : %s (issue %s) filed %s by %s\n' \
                    "${_sk_art_v:--}" "${_sk_art_issue:--}" "${_sk_art_ts:--}" "${_sk_art_by:--}"
                printf '  ledger        : %s\n' "$(_skeptic_ledger_file "$pending_dir" "$sw_safe")"
                # STATE THE MARKER'S ACTUAL STATE, DO NOT ASSERT ONE.
                #
                # "no marker is armed, so this window can retire" is reachable
                # and FALSE: arm(A) -> verdict discharges A -> arm(B) -> wrap
                # up A again (a revert, or a second worker re-publishing the
                # earlier artefact). The suppression correctly declines to
                # re-arm, and B's marker is still live — this path never
                # clears a marker, deliberately. A CONSEQUENCE line asserting
                # retirability would then be the `SKIPPED (upload failed)`
                # false-cause defect (#813 F5) in a new place: a verb telling
                # an operator the outcome it usually has rather than the one
                # it just produced.
                printf 'CONSEQUENCE: no spawn-skeptic request is filed for this wrap-up, and\n'
                if [[ -n "$sw_safe" && -e "$pending_dir/${sw_safe}" ]]; then
                    printf 'NO NEW gate was armed — but a PENDING MARKER IS ALREADY LIVE for this\n'
                    printf 'window (%s), armed by an earlier round.\n' "$pending_dir/${sw_safe}"
                    printf 'It is untouched: this path declines to CREATE an obligation, it never\n'
                    printf 'releases one. This window still cannot retire until that one is\n'
                    printf 'discharged or resolved.\n'
                else
                    printf 'no marker is armed, so this window can retire.\n'
                fi
                printf 'If the result has MATERIALLY CHANGED, EDIT THE REPORT — one changed byte\n'
                printf 'is a different artefact and arms the gate normally. To re-arm on\n'
                printf 'IDENTICAL bytes, say why, on the record:\n'
                printf '    ng wrap-up ... --skeptic-rearm "<what changed since that verdict>"\n'
                return 0
            fi
            if [[ "$_sk_res_state" == "resolved" && -z "$f_rearm" ]]; then
                ( cmd_log_action monitor --event skeptic-rearm-suppressed \
                    "${winx[@]}" \
                    --extra "decision=$effective" \
                    --extra "mode=$mode" \
                    --extra "depth=$next" \
                    --extra "detail=$_sk_res_detail" \
                    --extra "rationale=$_sk_res_path" \
                    --extra "issue=$issue" ) 2>/dev/null || true
                printf '\n=== SKEPTIC: REQUIRE GATE ALREADY RESOLVED — NOT RE-ARMING ===\n'
                printf 'This window'\''s skeptic-pending gate carries a RECORDED RESOLUTION that is\n'
                printf 'still current — no later skeptic verdict or request has superseded it (%s).\n' "$_sk_res_detail"
                printf 'rationale record: %s\n' "$_sk_res_path"
                if [[ -r "$_sk_res_path" ]]; then
                    printf -- '--- last resolution recorded ---\n'
                    # The 20-line cap lives INSIDE awk, not in a `| head -20`.
                    # `ng` runs under `set -o pipefail`, so a `head` that closes
                    # the pipe early SIGPIPEs its writer and colours the
                    # compound's rc — your-org/nexus-code#622/#682, whose
                    # boundary `monitor/watcher/early-exit-readers.manifest`
                    # records precisely so a new such site cannot slip in
                    # unclassified. It caught this one. The cap is not worth a
                    # manifest row.
                    awk '/^# skeptic-pending marker resolved/ { n = NR } { l[NR] = $0 }
                         END {
                             s = (n ? n : 1)
                             if (NR - s >= 20) s = NR - 19
                             for (i = s; i <= NR; i++) print "  " l[i]
                         }' "$_sk_res_path" 2>/dev/null
                    printf -- '--------------------------------\n'
                fi
                printf 'Your spawn mode is `%s`, so this wrap-up WOULD have re-armed the marker\n' "$mode"
                printf 'and filed a fresh spawn-skeptic request. It did NOT (your-org/nexus-code#815):\n'
                printf 'that silently reverses the orchestrator'\''s decision, and a worker told to\n'
                printf '"write your findings into a report and wrap up" after a resolve would\n'
                printf 're-block ITSELF by complying — then be unable to record even that without\n'
                printf 'triggering it again.\n'
                printf 'CONSEQUENCE: no marker written, no spawn-skeptic request filed. This\n'
                printf 'window can retire (retire-preflight will not see a live gate from here).\n'
                printf 'If your result has MATERIALLY CHANGED since that resolution and genuinely\n'
                printf 'needs a fresh validation pass, re-arm DELIBERATELY and on the record:\n'
                printf '    ng wrap-up ... --skeptic-rearm "<what changed since the resolution>"\n'
                return 0
            fi

            # ── STATING NOTHING IS REFUSED ON THE **WORKER** PATH TOO
            #    (your-org/nexus-code#1095 item 1, extending #1137) ─────────
            #
            # #1137 shipped the refusal for skeptic reports only — its block
            # sits inside `if [[ "$role" == "true" ]]` and says so in its own
            # COVERAGE BOUNDARY note. This is the other half.
            #
            # WHY THE HALF MATTERS MORE THAN THE HALF THAT SHIPPED. Of the
            # nine instances recorded on #1095, FIVE are worker reports,
            # including `panelive` — five identical spawn-skeptic requests in
            # twenty minutes, filed while a discharged `credible` verdict sat
            # in the ledger and `skeptic/panelive/` read `DONE`. The worker
            # was parked and could not complete; it took an explicit "stop
            # calling ng wrap-up" to break the loop. That instance is on THIS
            # path, and nothing above this line could have stopped it.
            #
            # THE OBJECTION #1137 RECORDED, AND THE MEASUREMENT THAT ANSWERS
            # IT. #1137 declined to port this on the grounds that "a worker
            # has no verdict to state, so `require a disposition` is the wrong
            # requirement for it". Half right, and the half that is wrong is
            # decisive: `_wrapup_file_spawn_skeptic_request` ALREADY READS
            # this field on the worker path and already acts on it — a worker
            # report carrying `disposition: no-further-pass` against a
            # `require` resolution composes `recommendation: DISPUTED`. So the
            # field is not being invented for workers; it is already CONSUMED
            # for them and merely OPTIONAL. This closes that gap, which is the
            # same gap #836 + #1137 closed on the skeptic side. What a worker
            # states is not a verdict on someone else's work — it is its own
            # view on whether this hand-off needs a further pass, which is
            # exactly the question the request about to be filed asks the
            # orchestrator to answer without it.
            #
            # SCOPE, DELIBERATELY NARROW — this is a REQUIRE-PATH refusal, not
            # a wrap-up-wide one. It sits inside `required|required-escalated`,
            # so a wrap-up that files no spawn-skeptic request derives nothing
            # from absence and is untouched. Measured against the live corpus
            # (677 reports, 2026-09-01): 256 carry no readable frontmatter
            # disposition, so a blanket requirement at `report-check` would
            # refuse 38% of the corpus and every future worker report. That is
            # NOT what ships here. The population this reaches is only the
            # wrap-ups that were about to manufacture an obligation.
            #
            # POSITION IS LOAD-BEARING, for the reason the role-path block
            # gives: everything BELOW mutates state — `skeptic-channel.sh
            # reset` archives the previous round's sentinels, the pending
            # marker is written, the arm is recorded, `skeptic-request` is
            # logged and the pinned skeptic is notified. Every early return
            # ABOVE is a suppression that files no request, so refusing above
            # them would newly block the #815 and #984 escape hatches for a
            # field nothing was about to read. Nothing may be inserted between
            # this block and the suppressions above it, or below it and the
            # reset.
            #
            # GRAMMAR, NOT JUST PRESENCE (#1095 item 3) — `absent`,
            # `unreadable` and "found in the body" are named separately, for
            # the same reason as on the role path: a spawn brief once put
            # PROSE into this reserved two-token field, and an author told
            # only "it is missing" edits the wrong line.
            if [[ -n "$source_window" ]]; then
                local _wk_stated _wk_dsource _wk_ddetail _wk_disp_ok=0
                read -r _wk_stated _wk_dsource _wk_ddetail \
                    <<<"$(_skeptic_stated_disposition "${_SK_REPORT_PATH:-}")"
                # EMPTY is not a state — it means the parser did not run. The
                # #684 lesson: a crashed parser must not be indistinguishable
                # from a clean `absent`.
                if [[ -z "$_wk_stated" ]]; then
                    _wk_stated=unreadable; _wk_dsource=none
                    _wk_ddetail=parser-produced-no-state
                fi
                [[ "$_wk_dsource" == "frontmatter" ]] \
                    && [[ "$_wk_stated" == "no-further-pass" || "$_wk_stated" == "second-pass" ]] \
                    && _wk_disp_ok=1
                if (( _wk_disp_ok == 0 )); then
                    echo "!! YOUR REPORT STATES NO DISPOSITION, AND THIS WRAP-UP REQUIRES A SKEPTIC." >&2
                    echo "   No readable frontmatter \`disposition:\` field in the report, so the" >&2
                    echo "   spawn-skeptic request about to be filed would have derived its whole" >&2
                    echo "   recommendation from that ABSENCE — which is severity-blind, and" >&2
                    echo "   unfalsifiable: a finished hand-off and an abandoned one look the same." >&2
                    echo "   report : ${_SK_REPORT_PATH:-<none>}" >&2
                    echo "   parser : state=$_wk_stated source=$_wk_dsource detail=$_wk_ddetail" >&2
                    case "$_wk_stated" in
                        absent)
                            echo "   Nothing was stated at all. Your view may be perfectly clear in the" >&2
                            echo "   Summary — but nothing READS the Summary." >&2 ;;
                        unreadable)
                            echo "   A disposition IS written and the parser could not read it. It is a" >&2
                            echo "   reserved TWO-TOKEN field, not prose." >&2 ;;
                        *)
                            echo "   A disposition was found in the ${_wk_dsource}, not the frontmatter." >&2
                            echo "   Only a frontmatter field governs; a body mention is a quotation." >&2 ;;
                    esac
                    echo "   This is a REFUSAL, not a finding: it fires because nothing was stated." >&2
                    echo "   Until your-org/nexus-code#1095 this ESCALATED instead — filing a request" >&2
                    echo "   derived from absence alone, which lands on an orchestrator who then has" >&2
                    echo "   to open the report anyway. Refusing costs you one line, here, while you" >&2
                    echo "   are still the person who knows the answer." >&2
                    echo "   Add ONE line to the report frontmatter, at column 0:" >&2
                    echo "     disposition: second-pass      (you agree this needs the skeptic)" >&2
                    echo "     disposition: no-further-pass  (you do NOT — recorded as DISPUTED for" >&2
                    echo "                                    the orchestrator, not silently dropped)" >&2
                    echo "   Nothing was published, no marker was written or reset, and no" >&2
                    echo "   spawn-skeptic request was filed." >&2
                    return 1
                fi
            fi

            # ORDER IS DELIBERATE (rebase resolution, bundle 4-GUARDS x 2-SKEPTIC).
            # #1095's worker-path refusal above is a DENY; #1209's suppression
            # below returns 0. A `return 0` placed AHEAD of a deny that can fire
            # on the same input is the arm-order-shadowing defect (#1121), so the
            # deny goes first. Both reach their intended state: a settled
            # obligation with no stated disposition is refused once, and after the
            # worker states one the suppression fires and the window retires.

            # SUPPRESSION 3 of 3 — THE OBLIGATION IS RECORDED AS SETTLED
            # (your-org/nexus-code#1209). The arm above reads
            # `.cleared-rationale`, which only `ng skeptic resolve` writes;
            # `skeptic-channel.sh close` records its settlement as a `resolved`
            # LEDGER ROW and drops a DONE sentinel, and this path read neither.
            # So a wrap-up re-armed a CLOSED obligation against a RETIRED
            # creditor, and the three states rendered byte-identically:
            # measured, three constructed ledgers whose `ng skeptic-evidence`
            # differs (`none` / `ambiguous-arms` / `rearm-after-close`) produced
            # request bodies with the SAME md5, differing only in the request id
            # and the created timestamp — both functions of wall clock, neither
            # of state.
            local _sk_close_row=""
            if [[ -n "$sw_safe" && -z "$f_rearm" ]]; then
                _sk_close_row=$(_skeptic_close_settlement "$pending_dir" "$sw_safe") || _sk_close_row=""
            fi
            if [[ -n "$_sk_close_row" ]]; then
                ( cmd_log_action monitor --event skeptic-rearm-suppressed \
                    "${winx[@]}" \
                    --extra "detail=obligation-recorded-as-settled" \
                    --extra "issue=$issue" ) 2>/dev/null || true
                printf '\n=== THIS OBLIGATION IS RECORDED AS SETTLED — NOT RE-ARMING ===\n'
                # NOT "closed by the reviewer": TWO verbs write a `resolved`
                # row, so the row's own field names the settler rather than
                # this header asserting one (#813 F5).
                printf 'ledger row: %s\n' "$_sk_close_row"
                printf 'Nothing has armed this key since that row, so re-arming here would\n'
                printf 'reopen a settled obligation against a creditor that may have retired.\n'
                if [[ -e "$pending_dir/${sw_safe}" ]]; then
                    printf 'CONSEQUENCE: no NEW marker written and no spawn-skeptic request filed.\n'
                    printf 'A marker already exists on this key, so check it before retiring.\n'
                else
                    printf 'CONSEQUENCE: no marker written, no spawn-skeptic request filed, and the\n'
                    printf 'DONE sentinel is left intact. This window can retire.\n'
                fi
                printf 'If your result has MATERIALLY CHANGED and genuinely needs a fresh pass,\n'
                printf 're-arm DELIBERATELY and on the record:\n'
                printf '    ng wrap-up ... --skeptic-rearm "<what changed since the settlement>"\n'
                printf 'The orchestrator appointing a reviewer also re-opens this normally, via\n'
                printf '`ng skeptic-arm` — that writes an `armed` row and this suppression lifts.\n'
                return 0
            fi
            if [[ "$_sk_res_state" == "unknown" ]]; then
                # Arming anyway (see the direction-of-caution note on
                # `_skeptic_resolution_state`), but never silently: a
                # suppression that should have fired and did not is exactly
                # the #815 loop, and the operator must be able to see it.
                ( cmd_log_action monitor --event skeptic-rearm-check-failed \
                    "${winx[@]}" \
                    --extra "detail=$_sk_res_detail" \
                    --extra "issue=$issue" ) 2>/dev/null || true
                printf '\n!! COULD NOT CHECK whether this window'\''s skeptic gate was already\n'
                printf '   resolved (%s). Arming anyway — on a gate that\n' "$_sk_res_detail"
                printf '   ARMS validation, doubt must not reduce it. If an orchestrator DID\n'
                printf '   resolve this marker, this wrap-up has just re-blocked the window\n'
                printf '   (your-org/nexus-code#815) and it needs resolving again.\n'
            fi
            if [[ -n "$f_rearm" ]]; then
                if (( ${#f_rearm} < 20 )); then
                    echo "ng wrap-up: --skeptic-rearm must be a substantive explanation (>=20 chars)" >&2
                    echo "  naming WHAT CHANGED since the resolution — it is written to the audit" >&2
                    echo "  trail and it overrides an orchestrator's recorded decision." >&2
                    return 1
                fi
                ( cmd_log_action monitor --event skeptic-rearm \
                    "${winx[@]}" \
                    --extra "prior-state=$_sk_res_state" \
                    --extra "detail=$_sk_res_detail" \
                    --extra "reason=$f_rearm" \
                    --extra "depth=$next" \
                    --extra "issue=$issue" ) 2>/dev/null || true
                printf '\n=== SKEPTIC: DELIBERATE RE-ARM (--skeptic-rearm) ===\n'
                printf 'prior gate state: %s (%s)\n' "$_sk_res_state" "$_sk_res_detail"
                printf 'reason: %s\n' "$f_rearm"
                printf 'Recorded. The require-gate is being re-established on purpose.\n'
            fi
            # Open a NEW skeptic round: archive the previous round's terminal
            # sentinels BEFORE writing the pending marker. A completed round
            # leaves $STATE_DIR/skeptic/<task>/DONE (and its .answered.md
            # verdicts) behind; left in place, the worker's very next
            # `skeptic-channel.sh await` returns exit 10 instantly and it
            # retires believing it was validated when no skeptic ever
            # spawned — the gate fails OPEN exactly on the re-validation
            # rounds, which exist because something was already found wrong
            # (issue #469). `reset` ARCHIVES the stale pair into
            # skeptic/.archive/<task>.reset-<ts>/ (outside the channel, your-org/nexus-code#1434) rather than bare-`rm`-ing only
            # the DONE (your-org/nexus-code#511): the forensic trail survives
            # and stale verdicts do not pollute the new round. await
            # independently refuses a DONE older than the marker; this is the
            # fail-fast half of that pair.
            [[ -n "$source_window" ]] \
                && "$_script_dir/skeptic-channel.sh" reset "$source_window" >/dev/null 2>&1 || true
            [[ -n "$sw_safe" ]] && printf '%s' "$next" > "$pending_dir/${sw_safe}" 2>/dev/null || true
            # RECORD WHAT THIS ARM IS ABOUT (your-org/nexus-code#984, #963).
            #
            # The marker holds a depth integer and nothing else, so from the
            # moment it is written nobody — including this window's own next
            # wrap-up — can say WHICH piece of work it is blocking on. That
            # is the field whose absence makes #961's flag "a logical OR over
            # an unbounded set of unrelated obligations, collapsed into one
            # bit with no task identity attached".
            #
            # This does not re-key the marker (that is #961's fix and it is a
            # migration). It ATTACHES the subject to the arm, so the
            # discharge can carry it forward and a later re-publication of
            # the same bytes is recognisable. A window with no resolvable
            # report, or a host with no sha256 tool, simply records no
            # subject and behaves exactly as it did before this change.
            if [[ -n "$sw_safe" ]]; then
                local _sk_arm_sha=""
                _sk_arm_sha=$(_skeptic_artefact_sha "${_SK_REPORT_PATH:-}") || _sk_arm_sha=""
                if [[ -n "$_sk_arm_sha" ]]; then
                    _skeptic_record_arm "$pending_dir" "$sw_safe" \
                        "$_sk_arm_sha" "$issue" "${_SK_REPORT_PATH:-}"
                fi
            fi
            ( cmd_log_action monitor --event skeptic-request \
                --extra "target-window=$source_window" \
                --extra "depth=$next" \
                --extra "mode=$mode" \
                --extra "decision=$effective" \
                --extra "issue=$issue" ) 2>/dev/null || true
            _wrapup_notify_pinned_skeptic "$source_window" "$next" "$issue"
            # Signal cmd_wrap_up (Step 2b) to file a spawn-skeptic request
            # so the orchestrator gets a PUSH signal (the watcher-mediated
            # request inbox), not just the pending marker + the 600s-delayed
            # orphaned-skeptic-pending backstop (#545). A clean first-pass
            # require is auto-spawnable (`deliberate=false`); it is escalated
            # to `deliberate=true` only when a prior skeptic already ran
            # (depth>0) or the worker overrode a skeptic suggestion
            # (--skeptic-contradicted). Only when a source window resolved.
            if [[ -n "$source_window" ]]; then
                _SK_SPAWN_REQ=1
                _SK_SPAWN_TARGET="$source_window"
                _SK_SPAWN_DEPTH="$next"
                _SK_SPAWN_ORIG=""          # first pass: orig == target
                _SK_SPAWN_MODE="$mode"
                _SK_SPAWN_EFFECTIVE="$effective"
                _SK_SPAWN_CONTRADICTED="$f_contradicted"
                local _delib=0 _reasons=""
                (( depth > 0 )) && { _delib=1; _reasons="prior-skeptic-depth-$depth"; }
                [[ -n "$f_contradicted" ]] \
                    && { _delib=1; _reasons="${_reasons:+$_reasons,}worker-contradiction"; }
                _SK_SPAWN_DELIBERATE=$_delib
                _SK_SPAWN_REASONS="$_reasons"
            fi
            printf '\n=== SKEPTIC REQUIRED (skills/nexus.skeptic) ===\n'
            if [[ "$effective" == "required-escalated" ]]; then
                printf 'Spawn mode was `deny`, but you escalated to require — recorded.\n'
            else
                printf 'This task requires an independent skeptic validation pass.\n'
            fi
            [[ -n "$f_rationale" ]] && printf 'rationale: %s\n' "$f_rationale"
            printf 'CONSEQUENCE: a skeptic MUST validate this result; this window cannot\n'
            printf 'retire until a skeptic returns a verdict (retire-preflight.sh enforces\n'
            printf 'the skeptic-pending marker — see skills/nexus.window-cleanup).\n'
            printf 'A skeptic-pending marker is set; the task is NOT complete until a\n'
            printf 'skeptic returns a verdict. The orchestrator should spawn:\n\n'
            _skeptic_spawn_cmd "$source_window" "$next"
            printf '\nWhile the skeptic reviews, DO NOT go idle — enter the await loop\n'
            printf 'so its requests reach you (and so the watcher sees you as\n'
            printf 'parked-awaiting-skeptic, not idle):\n'
            printf '    monitor/skeptic-channel.sh await %s; rc=$?; echo "AWAIT_RC=$rc"; exit $rc\n' "$source_window"
            printf '  RUN IT EXACTLY LIKE THAT, ending in `exit $rc`, and BACKGROUND it\n'
            printf '  (your-org/nexus-code#1161). The await budget is 900s and the Bash\n'
            printf '  tool ceiling is 600s, so the timeout path cannot finish in the\n'
            printf '  foreground — backgrounding is compulsory, not a preference.\n'
            printf '  BACKGROUND MEANS the Bash tool`s `run_in_background` option (the\n'
            printf '  harness re-invokes you when the job exits, which is what makes the\n'
            printf '  rc below actionable) or a `Monitor` until-loop. It does NOT mean\n'
            printf '  `monitor/async-run.sh`: that launcher RETAINS the rc and re-invokes\n'
            printf '  nobody — an await run through it expires correctly into an agent\n'
            printf '  that is not running to read it (measured: rc 4 retained, 809s idle\n'
            printf '  until the watcher backstop pasted; your-org/nexus-code#1523).\n'
            printf '  A `;`-list reports its LAST statement`s status, so a trailing\n'
            printf '  `echo`, and a bare trailing `rc=$?` TOO, make 0/4/10/11 all arrive\n'
            printf '  as 0. Capturing is not the fix; `exit $rc` is. Measured: 97%% of\n'
            printf '  backgrounded awaits on this board reported 0 whatever happened.\n'
            printf '  Then: a correct `exit 4` renders as `failed with exit code 4` and\n'
            printf '  is the ROUTINE outcome. Do NOT tidy the `exit $rc` away to silence\n'
            printf '  it — that is exactly how the silent-11 hazard comes back.\n'
            printf '  And read the COUNTERPART`s STATE as the primary signal (its pane\n'
            printf '  state, its report on disk, `settled_at`); the exit code is\n'
            printf '  corroboration. A displaced waiter exits 143, which this legend\n'
            printf '  does not cover and which flattens to 0 identically (#1178).\n'
            printf '  exit 0  → it acked open request(s) (now `.ack.md`): read each,\n'
            printf '            answer with `skeptic-channel.sh answer %s <req> ...`\n' "$source_window"
            printf '            (renames →`.answered.md`), then RE-ENTER await.\n'
            printf '  exit 4  → timed out with nothing pending: RE-ENTER await.\n'
            printf '  exit 10 → DONE sentinel: the skeptic closed the channel; stop\n'
            printf '            looping and proceed to retire.\n'
            printf '  exit 12 → DISPLACED: a NEWER await claimed this channel and reaped\n'
            printf '            this one (#615`s one-live-waiter lock, #1178). The newer\n'
            printf '            one is LIVE — do NOT re-arm, that would displace it in\n'
            printf '            turn. A non-displacement TERM still exits 143.\n'
            printf '  exit 11 → COUNTERPART-FINISHED: the skeptic recorded its verdict\n'
            printf '            (which cleared your pending marker) but never closed the\n'
            printf '            channel. Nothing further can arrive — do NOT re-enter\n'
            printf '            await. Read its report and proceed to retire.\n'
            ;;
        denied-spawn)
            # WHAT THIS ARM ACTUALLY KNOWS (your-org/nexus-code#1205). It knows
            # ONE fact: the SPAWN carried `--skeptic deny`. It used to assert
            # three — that the work was "trivial / low-impact", that there was
            # "No skeptic pass", and "Recorded." — and it has evidence for none
            # of them. `Recorded.` is the word that stops anyone checking.
            #
            # A window spawned `deny` that then DOES skeptic work is the case
            # this matters for: its verdict is never offered, so it is never
            # recorded, and downstream `ng skeptic-evidence` says
            # `evidence=none` while `retire-preflight` says the verdict is
            # "GENUINELY ABSENT — a review is what is missing", about a review
            # that happened.
            #
            # The report under hand-off often SAYS SO in machine-readable form,
            # so read it here, at the one moment the author is still present.
            # An empty parse is NAMED rather than folded into `absent` (#684).
            local _dn_st _dn_src _dn_det
            read -r _dn_st _dn_src _dn_det \
                <<<"$(_skeptic_stated_disposition "${_SK_REPORT_PATH:-}")"
            [[ -n "$_dn_st" ]] || { _dn_st=unreadable; _dn_src=none; _dn_det=parser-produced-no-state; }
            ( cmd_log_action monitor --event skeptic-decision \
                "${winx[@]}" \
                --extra "decision=denied" \
                --extra "reason=spawn-deny" \
                --extra "stated-disposition=$_dn_st" \
                --extra "issue=$issue" ) 2>/dev/null || true
            _sk_keep_own_marker "$pending_dir/${sw_safe}"
            printf '\n=== SKEPTIC: DISABLED AT SPAWN ===\n'
            printf 'The SPAWN carried `--skeptic deny`. That is the only thing this says:\n'
            printf 'it is NOT a finding that the work was trivial, and NOT a statement\n'
            printf 'that anything was reviewed. NO verdict is recorded, because none was\n'
            printf 'offered.\n'
            if _sk_marker_was_released "$pending_dir/${sw_safe}"; then
                printf 'CONSEQUENCE: no pending marker, so this window can retire normally.\n'
            else
                printf 'CONSEQUENCE: the pending marker above was KEPT, so this window still\n'
                printf 'CANNOT retire (your-org/nexus-code#914).\n'
            fi
            if [[ "$_dn_st" == "second-pass" || "$_dn_st" == "no-further-pass" ]]; then
                printf '\n!! THIS REPORT STATES A SKEPTIC DISPOSITION: %s (%s)\n' "$_dn_st" "$_dn_src"
                printf '!! report: %s\n' "${_SK_REPORT_PATH:-<unset>}"
                printf '!! Your window is stamped `--skeptic deny`, so NOTHING ABOVE\n'
                printf '!! REGISTERED A VERDICT. Downstream, `ng skeptic-evidence` will\n'
                printf '!! report `evidence=none` and `retire-preflight` will say the\n'
                printf '!! verdict is GENUINELY ABSENT — about a review that happened.\n'
                printf '!! If you performed a review, re-run wrap-up with the role flags:\n'
                printf '!!   --skeptic-role --skeptic-target <the window you reviewed> \\\n'
                printf '!!   --skeptic-verdict <credible|check|suspect|refuted> \\\n'
                printf '!!   --skeptic-subject <the report you read>\n'
                printf '!! That path WORKS from a deny-stamped window — this is a\n'
                printf '!! diagnostic, not a gate (your-org/nexus-code#1205).\n'
                printf '!! If the disposition describes YOUR OWN work rather than a review\n'
                printf '!! you performed, nothing is owed and you can ignore this.\n'
            fi
            ;;
        denied-auto)
            ( cmd_log_action monitor --event skeptic-decision \
                "${winx[@]}" \
                --extra "decision=denied" \
                --extra "reason=auto-worker-choice" \
                --extra "rationale=$f_rationale" \
                --extra "issue=$issue" ) 2>/dev/null || true
            _sk_keep_own_marker "$pending_dir/${sw_safe}"
            printf '\n=== SKEPTIC: NOT WARRANTED (worker decision, auto mode) ===\n'
            printf 'rationale: %s\n' "$f_rationale"
            if _sk_marker_was_released "$pending_dir/${sw_safe}"; then
                printf 'CONSEQUENCE: you judged no skeptic warranted; no pending marker is set,\n'
                printf 'so this window can retire normally (the decision + rationale are recorded).\n'
            else
                printf 'CONSEQUENCE: you judged no skeptic warranted, but the pending marker above\n'
                printf 'was KEPT, so this window still CANNOT retire (your-org/nexus-code#914).\n'
            fi
            printf '(recorded; proceeding without a skeptic pass)\n'
            ;;
        undecided)
            ( cmd_log_action monitor --event skeptic-decision \
                "${winx[@]}" \
                --extra "decision=auto-undecided" \
                --extra "issue=$issue" ) 2>/dev/null || true
            printf '\n=== SKEPTIC DECISION REQUIRED (auto mode) ===\n'
            printf 'CONSEQUENCE: you must record a skeptic decision + rationale now; if\n'
            printf 'you choose require, the retire gate applies (this window cannot retire\n'
            printf 'until a skeptic returns a verdict).\n'
            printf 'This worker was spawned in `auto` skeptic mode: YOU must make the\n'
            printf 'responsible call on whether your result warrants an independent\n'
            printf 'skeptic pass, and record it. Re-run wrap-up with ONE of:\n'
            printf '    --skeptic-decision require --skeptic-rationale "<why>"\n'
            printf '    --skeptic-decision deny    --skeptic-rationale "<why>"\n\n'
            _skeptic_print_heuristic
            local enforce
            enforce=$("$_cfg" monitor.skeptic.enforce_auto_decision true 2>/dev/null || echo true)
            [[ -n "${MONITOR_SKEPTIC_ENFORCE_AUTO_DECISION:-}" ]] && enforce="$MONITOR_SKEPTIC_ENFORCE_AUTO_DECISION"
            case "$enforce" in
                1|true|yes|on)
                    printf '\n(monitor.skeptic.enforce_auto_decision is on — wrap-up will not\n'
                    printf 'complete until you record a decision.)\n'
                    return 1
                    ;;
                *)
                    printf '\n(Advisory for now: recorded as auto-undecided. Make the call.)\n'
                    ;;
            esac
            ;;
    esac
    return 0
}

# The DISPOSITION a skeptic report states about itself, or empty when it
# states none (your-org/nexus-code#599).
#
# Echoes `second-pass` | `no-further-pass` | "".
#
# Why this exists: the second-pass recommendation is derived from a
# findings COUNT, and a count carries no severity. One cosmetic nit and
# one merge-blocking defect both read as `findings=1`, so the derived
# recommendation overrode reports that had explicitly concluded no
# further pass was warranted — three times in one session. The count is
# the wrong variable; the report's own conclusion is the right one.
#
# Three places a report can state it, in precedence order:
#   1. A FRONTMATTER `disposition:` field — the report's CURRENT-VALUE
#      header. Reports are append-only, so this wins outright over the
#      body; see the note at the frontmatter scan for the corpus case
#      that forces it.
#   2. A BODY field line — the form skills/nexus.skeptic directs skeptics
#      to write:
#          Disposition: no-further-pass
#      (case-insensitive, optional markdown bold, `_` or `-` separated),
#      including the very common `**Verdict: X. Disposition: Y.**` form.
#   3. A canonical prose sentence, matched narrowly. Deliberately NARROW:
#      a loose regex over a long adversarial report would match a
#      DISCUSSION of when a further pass is warranted and invert the
#      conclusion.
#
# CONTRACT (your-org/nexus-code#684). One line on stdout, three fields:
#
#     <state> <source> <detail>
#
#   state  : absent | no-further-pass | second-pass | unreadable
#   source : none | frontmatter | body | prose
#   detail : short machine-readable reason
#
# `state` is NEVER empty. That is the point of #684: the old contract
# returned the SAME empty sentinel for "the author stated nothing" and
# "the author stated it and we could not read it", and #681 had just built
# a governing policy on that sentinel — so a report whose disposition
# formatted unluckily silently became an escalation against an author who
# had used the sanctioned vocabulary. Only the first of those two warrants
# escalating SILENTLY; the second is the case where the author believes
# they have communicated and has not, and it must be LOUD.
#
# Because `state` is never empty, EMPTY OUTPUT now means the function did
# not run at all — a fifth condition callers can detect and report, where
# previously a crashed parser was indistinguishable from a clean `absent`.
#
# MEASURED, not asserted (877-report corpus, `reports/`):
#   * 23 reports carry a real stated disposition field. The pre-#684 parser
#     returned EMPTY on 7 of them — a 30% silent false-absent rate, every
#     one of which escalates against an author who did state a disposition.
#   * There is NO report where the old parser returned a token and this one
#     disagrees. The change is strictly additive on the corpus.
#   * #684 named the ANCHORING defect (`^disposition:` misses a same-line
#     verdict prefix). The corpus shows a second, unnamed and more common
#     one: 3 of the 7 have the label at LINE START and failed on the VALUE,
#     which ran past the token into commentary (`**Disposition:
#     no-further-pass** — the findings are concrete...`). Rule (5) is that
#     fix; without it the anchoring fix alone recovers under half of them.
#
# THE ABOVE PARAGRAPH WAS AN UNASSERTED CLAIM UNTIL your-org/nexus-code#681.
# It named the hazard precisely and the code did not avoid it: `tr -dc 'a-z-'`
# deleted word boundaries and the `case` substring-matched, so a MENTION of a
# token was indistinguishable from a STATEMENT of one, and an unanchored prose
# regex matched mid-clause discussion. Three demonstrated inversions, the worst
# handing an author who wrote `second-pass` the value `no-further-pass`.
#
# WHY IT MATTERS MORE NOW, stated plainly because #681 is what changed it:
# before #681 this value was ADVISORY — a misparse mislabelled a banner and the
# spawn request was filed anyway with `recommendation=DISPUTED`, costing an
# orchestrator one glance. Since #681 it GOVERNS: a misparse in the suppressing
# direction means NO REQUEST IS FILED AT ALL. Same parser, new blast radius, and
# the new one is the unrecoverable-silence direction. Hence the rules below,
# all fail-safe (they resolve doubt toward ESCALATE, never toward suppress):
#   * the field value must BE a token, not contain one;
#   * both tokens present -> refuse, so ARM ORDER can never decide;
#   * a present-but-unparseable field does not fall through to prose;
#   * and since #684, refusing SAYS SO (`unreadable`) instead of returning
#     the same silence as a report that never stated one.
#
# ON THE PROSE FALLBACK, and a deliberate DIVERGENCE from #684's proposal.
# #684 proposes demoting prose to "a hint instead of an answer" — i.e. let it
# escalate but never suppress. Measured against the corpus, that trade is
# BACKWARDS: all 7 prose-only reports state a correct, unambiguous author
# conclusion (6 `no-further-pass`, 1 `second-pass`), so demotion buys 6 false
# escalations and zero demonstrated safety. Prose therefore still governs.
# What DID need closing is a hazard #684 did not name and the pre-#684 regex
# had: its allowed prefix included `>`, so a BLOCKQUOTE — the syntax reports
# use to quote a PRIOR round's conclusion, as `kompot-consist-sk2` does — was
# read as this author's own. `source=prose` is reported either way, so the
# provenance is auditable even though the decision is unchanged.
#
# THIS PARAGRAPH USED TO SAY "`>` is now excluded" FULL STOP, AND THAT WAS
# FALSE. #687 excluded `>` from the PROSE anchor only. The FIELD scan runs
# first and short-circuits before prose is ever reached, and it still treated
# `>` as structure — so a blockquoted FIELD parsed as a statement, in the
# SUPPRESSING direction, and #687 is what introduced it. A guard summary
# claiming a closure the code had not made, in the file whose entire subject
# is that failure mode; found by the #687 skeptic (F1), fixed below.
#
# CONTAINERS vs EMPHASIS — the distinction the whole guard turns on, stated
# once here because it has now been got wrong four times. A mark is either:
#   * EMPHASIS/BLOCK structure — `*` `_` `#` `-` and whitespace. It DECORATES
#     a statement. Strip it; what remains is still the author speaking.
#   * a CONTAINER — `>` blockquote, `|` table cell, backtick code span,
#     ``` fence, <!-- html comment -->. It DELEGATES the text to something
#     else. It is never structure, and the token inside is a MENTION.
# Every instance of this class has been a container mistaken for emphasis.
# Before adding a mark to `structural_only`, ask which of the two it is.
#
# Enumerated and closed: blockquote, table cell, inline code span, fenced
# block, HTML comment. Enumerated and DELIBERATELY OPEN: the 4-space indented
# code block (your-org/nexus-code#689) — a 4-space indent also means "list
# continuation" inside a nested bullet, which these reports are full of, so
# the naive rule drops real dispositions. Zero corpus instances either way.
# Tests: monitor/test-bookkeeping-contract.sh, "#681 F1", "#684" and
# "#687 F1" blocks — including an explicit arm-ORDER assertion (order was the
# trap) and an after-a-container control for every container (a container-skip
# that never RESUMES is a worse and more invisible regression than the leak).
_skeptic_stated_disposition() {
    local report="${1:-}" _fields _seen="" _bad=0 _state _source _detail _val _sq _this
    # `_heading` — set when the field scan consumed a heading-shaped line. See
    # the block in the resolution loop below (your-org/nexus-code#895).
    local _heading=0
    # `--with-lines` (your-org/nexus-code#855 skeptic F1) — OPT-IN 4th output
    # field carrying the 1-based line numbers of the field lines THIS SCAN
    # actually consumed, comma-separated, or `-` when none.
    #
    # WHY IT LIVES HERE AND NOT IN THE CALLER. `report-check` needs to name the
    # offending line, and it used to find that line with its OWN grep over the
    # RAW file while this function scans a TRANSFORMED one (HTML comments
    # stripped, fences skipped, code spans / blockquotes / table cells / indented
    # code rejected). Two scanners over two representations diverge — measured:
    # `disposition<!-- n -->: merge` is a field HERE and invisible to a raw grep,
    # and a fenced `**Disposition: merge**` is a quotation here and a match
    # there. That is the #836 defect class one level up, and widening the
    # caller's grep only moves it again. So the authority reports the lines it
    # used and there is no second scan to disagree with.
    #
    # OPT-IN because four callers do `read -r st src det`; an unconditional 4th
    # field would silently land in `det`. Absent the flag the output is
    # byte-identical to before.
    local _with_lines=0 _lines="" _lno
    [[ "${2:-}" == "--with-lines" ]] && _with_lines=1
    # NOTE FOR EDITORS: no line in this function body may begin with `}` at
    # column 0 — the suite extracts the function with
    # `sed -n '/^_skeptic_stated_disposition()/,/^}/p'`, so a column-0 brace
    # (natural in an awk program) TRUNCATES the extraction and the suite then
    # silently tests a broken fragment. Asserted by "#684 parser extraction
    # round-trips" in test-bookkeeping-contract.sh.
    if [[ -z "$report" ]]; then
        printf 'absent none no-report-path'; return 0
    fi
    if [[ ! -r "$report" ]]; then
        printf 'unreadable none report-not-readable'; return 0
    fi

    # ---- FIELD scan, frontmatter FIRST ---------------------------------
    # Reports are APPEND-ONLY (skills/nexus.report). So the frontmatter is
    # the report's CURRENT-VALUE header and the body is a LOG: a later
    # append can supersede an earlier body statement, and the author edits
    # the header. `kompot-consist-sk2` is the corpus proof — its body says
    # `second-pass` and its frontmatter `no-further-pass`, with the author
    # writing verbatim "the frontmatter now carries the current values; the
    # 'second-pass' line above is the round-4 disposition and is kept as the
    # record of what was recommended then". Treating that as a CONFLICT
    # would refuse a report whose author was unambiguous. Hence: a
    # frontmatter field wins outright and the body is not consulted.
    # ---- BLOCK CONTEXT: the 4-space INDENTED CODE BLOCK (#689) ----------
    #
    # The last container in the enumeration, and the one that does NOT fall
    # out of the container/emphasis rule stated in the header. That rule
    # classifies MARKS, and it puts whitespace in the EMPHASIS class -
    # literally, ` ` and `\t` are members of `structural_only`'s strip set.
    # Every other container is self-identifying from the line's own bytes
    # (`>`, `|`, a backtick, a fence opener, `<!--`); this one's opening
    # delimiter is whitespace, which is simultaneously the strip class's core
    # member. So the indent's container-ness is not a property of a mark at
    # all - it is a property of the ENCLOSING BLOCK. At top level four spaces
    # opens a code block; inside a list item the same four spaces are the
    # item's own continuation text, and the author is still speaking. The
    # abstraction is not wrong; it is stated over the wrong unit for this one
    # construct. That is why a bare `^    ` skip is refused: it is a proxy for
    # the property, and this guard's whole history is proxies for properties.
    #
    # So measure the property. An indented chunk is a code block only when it
    # is indented >= 4 columns PAST the enclosing list item's content column,
    # AND it does not interrupt a paragraph (CommonMark: an indented code
    # block needs a preceding blank line). The blank-line requirement is what
    # makes list continuation safe - a continuation line sits directly under
    # its bullet, so `prevblank` is 0 and it parses as the statement it is.
    #
    # Defined ONCE, in a variable, and interpolated into BOTH scanners. The
    # field scan and the prose fallback had the SAME hole (the prose form
    # `No further skeptic pass is warranted.` under a 4-space indent parsed as
    # `no-further-pass prose inferred`), and #689 names only the field one. A
    # second copy of this rule is the "test stub that hardcodes what it
    # claims to parse" defect wearing a different hat.
    #
    # Corpus: across 2,483 files under `reports/`, EVERY line mentioning
    # `disposition` sits at indent 0, 2 or 3 - never >= 4. So this changes no
    # existing report's verdict, in either direction, and that is asserted
    # differentially rather than argued.
    local _blockctx='
            BEGIN { bctx = (want == "body") }
            bctx {
                _raw = $0; gsub(/\t/, "    ", _raw)
                _ind = match(_raw, /[^ ]/) ? RSTART - 1 : -1
                if (_ind < 0) { prevblank = 1; next }
                if (icb) {
                    if (_ind >= listcol + 4) { next }
                    icb = 0
                }
                if (match(_raw, /^ *([-*+]|[0-9]+[.)])[ ]+/)) {
                    listcol = RLENGTH
                } else {
                    if (_ind == 0) listcol = 0
                    if (prevblank && _ind >= listcol + 4) { icb = 1; prevblank = 0; next }
                }
                prevblank = 0
            }
    '
    for _source in frontmatter body; do
        _fields=$(awk -v want="$_source" '
            # EMPHASIS marks only. A container mark - `>` blockquote, `|`
            # table cell, backtick code span - is NOT structure: it delegates
            # the text to something else, which is the whole distinction this
            # guard turns on. Stripping `>` here is what made a BLOCKQUOTED
            # field parse as a statement (#687 regression, skeptic F1);
            # stripping `|` made a table cell parse as a malformed one.
            # (4b) THE LEADING-KEY CLAUSE (your-org/nexus-code#1246).
            #
            # NOTE FOR EDITORS: this comment sits INSIDE a single-quoted awk
            # program (opened at the `awk -v want=` line above), so an
            # APOSTROPHE here closes that string and the shell then parses awk
            # source as shell. It cost a parse error while this very block was
            # being written. Keep the prose apostrophe-free.
            #
            # Rule (4) used to accept exactly one non-structural prefix: a
            # bolded `Verdict:` at the head of the line. So the recogniser saw
            # `Disposition:` only when the FIRST colon-delimited key on the line
            # was literally `verdict` — and A REPORT ONLY LABELS ITS ROUNDS ONCE
            # IT HAS MORE THAN ONE. `**ROUND 2 VERDICT (current): `credible`.
            # Disposition: no-further-pass.**` therefore parsed as NO
            # DISPOSITION STATED, which makes `no-further-pass` — the
            # disposition whose entire purpose is to END a review chain —
            # unreachable on exactly the reports that need it. Downstream then
            # falls back to a findings-COUNT heuristic it honestly labels
            # "severity-blind" and files a `spawn-skeptic` request the reviewer
            # had explicitly ruled out. Eight were filed and declined by hand in
            # one day.
            #
            # The generalisation is deliberately NOT "accept `Disposition:`
            # anywhere", and it is NOT a sentence-boundary test either. Both
            # were measured over the 1,521-report corpus and both were wrong:
            #
            #   a bare sentence boundary accepts real PROSE — the bullet ending
            #   "...supports *intent*. Disposition: consolidate preserving
            #   current behaviour..." is a sentence, not a field — which is the
            #   exact failure rule (4) exists to prevent;
            #
            #   and bounding the VALUE at a period to rescue a wrapped bold
            #   overturns the boundary declared at "#684 (2) BOUNDARY" in
            #   monitor/test-bookkeeping-contract.sh, which states that an
            #   unbolded token followed by prose is `unreadable` ON PURPOSE and
            #   names a period bound as another proxy. It is asserted there; do
            #   not reintroduce it here.
            #
            # What is required instead is a pair of STRUCTURAL properties:
            #
            #   an ALLOWLISTED key    the leading key must NAME a verdict or a
            #                         round: `verdict`, `final`, `round <n>`,
            #                         `round <n> verdict`, each with an optional
            #                         short parenthetical. NOT merely "a short
            #                         clean word".
            #
            #                         THE FIRST DRAFT USED "SHORT AND CLEAN" AND
            #                         THAT WAS A PRESENCE TEST WEARING A VALIDITY
            #                         TESTS NAME (your-org/nexus-code#1257
            #                         skeptic F1). The regex is PREFIX-anchored,
            #                         so it validated only the span up to the
            #                         FIRST colon and said nothing about the
            #                         prose after it: measured,
            #                         `Note: the reviewer was happy.
            #                         Disposition: no-further-pass.` was read as
            #                         a STATED no-further-pass, and so was
            #                         `Summary: I read the diff and agreed. ...`.
            #                         Latent (0 of 1,524 corpus reports moved)
            #                         but its failure direction is SUPPRESSION of
            #                         a pass somebody is owed, which is the
            #                         direction that must never be widened
            #                         silently. An allowlist of named labels
            #                         cannot be satisfied by arbitrary prose;
            #                         `Note` and `Summary` are simply not in it.
            #
            #                         Anchoring the WHOLE prefix was considered
            #                         and rejected: a line opening `Verdict:` is
            #                         dev behaviour and admits prose between the
            #                         key and the field, so restricting that too
            #                         would be a separate, unrequested narrowing.
            #                         This change is parity plus a named set.
            #   AND a BALANCED bold   an EVEN number of `**` on the whole line.
            #                         An odd count means the bold OPENED and did
            #                         not close here, so the statement continues
            #                         onto the next line and rule (5) has no
            #                         structural terminator to bound the value
            #                         with. `overlaydeploy-sk` line 17 is
            #                         exactly that shape; leaving it unrecognised
            #                         lets the later, closed
            #                         `**Disposition: no-further-pass.**` in the
            #                         same report be the one that speaks, which
            #                         is both the current answer and the right
            #                         one. It is measured against the LINE, not
            #                         the prefix, because the closing `**` of a
            #                         well-formed field lives after the value.
            #
            # Corpus effect, dev vs this, over all 1,521 reports: EXACTLY ONE
            # verdict changes — `walkupsk` `absent` -> `no-further-pass`, the
            # reported defect. No other report moves in either direction, and
            # monitor/test-bookkeeping-contract.sh is 330/0 both before and
            # after.
            function leading_key_clause(pre, full,   n) {
                if (tolower(pre) !~ /^[ \t*_#-]*(round[ ]*[0-9]+[ ]*)?(verdict|final|round[ ]*[0-9]+)([ ]*\([a-z0-9 ,._-]{1,24}\))?[ \t*_`]*:/) return 0
                n = gsub(/\*\*/, "&", full)
                return (n % 2 == 0)
            }
            function structural_only(s,   t) {
                t = s; gsub(/[ \t*_#.\-]/, "", t); return (t == "")
            }
            NR == 1 && $0 ~ /^---[[:space:]]*$/ { fm = 1; next }
            fm && $0 ~ /^---[[:space:]]*$/       { fm = 0; next }
            (want == "frontmatter") != (fm == 1) { next }
            # A FENCED BLOCK is a quotation, exactly as an inline code span is
            # (rule 3) - and it is the form a report ABOUT this parser uses to
            # show an example disposition line. Found by running this parser
            # over the report that documents it: the fenced sample
            # `**Disposition: no-further-pass**` parsed as a STATEMENT, in the
            # SUPPRESSING direction. Rule (5) is what made it reachable, so the
            # #684 fix introduced this and the self-check caught it.
            $0 ~ /^[[:space:]]*(```|~~~)/ { fence = !fence; next }
            fence { next }
            '"$_blockctx"'
            # HTML COMMENT regions - the other multi-line container, and the
            # form that actually bites: `<!-- **Disposition: x** -->` on ONE
            # line is already rejected (the `<!` residue fails
            # structural_only), but the NORMAL multi-line spelling puts the
            # field on a bare line where nothing marks it as commented out.
            # Over-removal here is fail-SAFE (it resolves toward `absent`,
            # which escalates), so the greedy same-line strip is deliberate.
            {
                _l = $0
                if (incomment) {
                    _p = index(_l, "-->")
                    if (_p == 0) next
                    _l = substr(_l, _p + 3); incomment = 0
                }
                while (match(_l, /<!--.*-->/)) {
                    _l = substr(_l, 1, RSTART - 1) substr(_l, RSTART + RLENGTH)
                }
                _p = index(_l, "<!--")
                if (_p) { _l = substr(_l, 1, _p - 1); incomment = 1 }
                $0 = _l
            }
            {
                line = $0; low = tolower(line); start = 1
                while ((p = index(substr(low, start), "disposition")) > 0) {
                    pos = start + p - 1
                    start = pos + 11
                    # (1) WHOLE WORD. `report-stated-disposition` is a
                    # DIFFERENT label and it appears in real reports
                    # discussing this very bug. Mostly subsumed by rule (4)
                    # — a longer label puts letters in the prefix — but NOT
                    # on the verdict-prefixed path, where rule (4) passes on
                    # the opening **Verdict: on that line, and this is the only
                    # thing standing between `**Verdict: check.**
                    # report-stated-disposition: second-pass` and a fabricated
                    # statement. Asserted directly, because a mutation of this
                    # line reddened NOTHING until that case was written.
                    # `_` is deliberately NOT in the class: it is markdown
                    # emphasis, and including it rejected the italic
                    # `_Disposition_:` form while accepting `*Disposition*:`.
                    if (pos > 1) {
                        c = substr(low, pos - 1, 1)
                        if (c ~ /[a-z0-9-]/) continue
                    }
                    rest = substr(line, pos + 11)
                    # (2) label must be followed by an optional markdown
                    # closer, then a colon.
                    if (rest !~ /^[*_` \t]*:/) continue
                    pre = substr(line, 1, pos - 1)
                    # (3) a BACKTICKED label is a QUOTATION, not a
                    # statement. Odd backtick count before it => inside a
                    # code span. This is what rejects a markdown TABLE ROW
                    # quoting the idiom — a real corpus line, in a report
                    # ABOUT this parser, naming BOTH tokens.
                    nb = gsub(/`/, "`", pre)
                    if (nb % 2 == 1) continue
                    # (4) PREFIX RULE. Only two prefixes make this a stated
                    # field: nothing but markdown structure, or one bolded
                    # `Verdict:` — the documented neighbour and the ONLY
                    # same-line prefix that occurs in 877 reports. Every
                    # other loose corpus hit (8 of 10) is prose using the
                    # word in a sentence.
                    if (!structural_only(pre) && !leading_key_clause(pre, line)) continue
                    sub(/^[*_` \t]*:/, "", rest)
                    # (5) BOUND THE VALUE at the markdown bold close. A
                    # bolded field routinely continues into commentary —
                    # `**Verdict: `check`. Disposition: no-further-pass.**
                    # Substantive new findings: 4.` — and 6 of 6 real
                    # skeptic reports have that shape. `**` is a STRUCTURAL
                    # terminator; an em-dash is not, and is deliberately not
                    # honoured, so `second-pass — I reject no-further-pass`
                    # still refuses (#681 F1 (a2)).
                    sub(/\*\*.*$/, "", rest)
                    # FNR, not a re-derived position: this is the ORIGINAL line
                    # number of the transformed line the scan consumed, which is
                    # exactly what a caller cannot recompute without rebuilding
                    # this whole transformation.
                    #
                    # `h` = the prefix THIS SCAN classified is heading-shaped.
                    # Computed from `pre`, a slice of the TRANSFORMED line, so
                    # it is the view of this authority and not a second opinion
                    # about the document.
                    #
                    # NOTE FOR EDITORS: this awk program is a SINGLE-QUOTED
                    # shell string. No apostrophe may appear anywhere in it,
                    # comments included — one closes the quote and the whole
                    # file stops parsing (measured: `syntax error near
                    # unexpected token ;;` thousands of lines away, in cmd_pr).
                    #
                    # EXPOSED RATHER THAN RE-DERIVED, and the distinction is not
                    # academic. `report-check` needs heading-ness for its
                    # carve-out; it used to recompute it by re-reading the RAW
                    # line, which put the PREDICATE back on bytes this scan
                    # never classified. Measured divergence:
                    #
                    #   <!--c-->### Disposition: fix at source
                    #
                    # the comment strip leaves `### ` as the prefix, so THIS is
                    # a heading; a raw-byte regex sees `<!--c-->###` and says it
                    # is not, so the carve-out fails to fire and an ordinary
                    # section title is refused with "must be
                    # no-further-pass|second-pass". Anything the caller must know
                    # about a line, and this scan already knows, belongs here.
                    # The caller re-deriving it is the same drift class with a
                    # shorter fuse.
                    # A `#`-PREFIXED LINE IS NEVER A GOVERNING FIELD, IN EITHER
                    # MODE (your-org/nexus-code#895, corrected by the #955
                    # skeptic).
                    #
                    # The first version scoped this to `want == "body"`,
                    # reasoning that frontmatter is YAML and `###` is not a
                    # heading there. The premise is right and the conclusion was
                    # backwards. In YAML a leading `#` is a COMMENT, so the line
                    # is not LESS disabled than a heading, it is MORE. Reading it
                    # as a statement means COMMENTING A DISPOSITION OUT ACTIVATES
                    # IT: the syntax whose whole meaning is "ignore this line"
                    # became the syntax that authorises an irreversible
                    # `tmux kill-window`, and commenting a field out is the most
                    # natural way there is to neutralise one.
                    #
                    # Measured at 8551eea: `# disposition: no-further-pass`, the
                    # indented form, `#disposition: ...` and
                    # `### Disposition: ...` ALL returned `no-further-pass
                    # frontmatter stated` -- the proceed arm of
                    # retire-preflight.sh, unchanged from e256d4a. The body case
                    # was fixed and the more natural spelling was left open, one
                    # `want` value over.
                    #
                    # So the rule is stated over the PARSE, not over one caller:
                    # a `#`-prefixed line is one the author has marked as NOT a
                    # statement, and the modes differ only in what the mark is
                    # called.
                    #   body        -- ATX heading, which REQUIRES the space
                    #                  (CommonMark): #{1,6} then blank.
                    #   frontmatter -- YAML comment, which does NOT require a
                    #                  space and may be indented: a bare `#` at
                    #                  the start of the line. `#disposition: x`
                    #                  is a comment in YAML and is NOT a heading
                    #                  in markdown, which is exactly why one
                    #                  regex for both modes would miss it.
                    #
                    # THE BODY ARM NO LONGER REQUIRES THE SPACE EITHER (#962
                    # round 3). Scoping the body to the CommonMark ATX rule left
                    # `#disposition: no-further-pass` in the BODY reading as a
                    # governing field -- measured end-to-end at defbb8e8:
                    # `no-further-pass body stated`, then `retire-preflight`
                    # rc 0 `safe=1`, i.e. a kill authorised by the one spelling
                    # whose whole point is "ignore this line". That is the same
                    # asymmetry #895 closed one `want` value over, surviving in
                    # the OTHER direction: the demonstrated spelling fixed, the
                    # more natural one left open.
                    #
                    # Markdown has no comment syntax, so `#disposition:` in a
                    # body is not a heading and not a comment -- it is
                    # ambiguous. The tie is broken by FAIL DIRECTION, which is
                    # the only argument the history of this parser supports:
                    # reading
                    # it as a statement PERMITS a kill, reading it as a mark
                    # REFUSES one (`unreadable`, loud, releasable). An author
                    # who typed a `#` in front of a field is far likelier to
                    # mean "not this" than "assert this".
                    #
                    # Both arms are now one regex, and the mode still decides
                    # what the mark is CALLED (the `_source` split below picks
                    # the detail string), which is the part that actually
                    # differs between YAML and markdown.
                    #
                    # DECLARED IMPRECISION, so it is a boundary and not a bug:
                    # a non-ATX body line now reports the shared body detail
                    # `heading-is-a-section-title`, which for `#disposition: x`
                    # is not literally what the author wrote. A second mark was
                    # the obvious alternative and was REFUSED: the `<n>h` suffix
                    # is read directly by `cmd_report_check` as its #855
                    # carve-out flag, so a new mark would silently change WRITE
                    # time -- refusing reports that pass today -- to improve a
                    # hint string. The state, the source and the fail direction
                    # are all correct; only the noun is approximate, and the
                    # actionable remedy is printed by retire-preflight, not by
                    # this detail. Revisit together with the carve-out, never
                    # separately.
                    #
                    # Corpus, re-measured on the LIVE corpus at 2026-08-15T11:52Z
                    # rather than a frozen snapshot, and with a positive control
                    # in the same run (planted fixtures flip):
                    #   frontmatter `#`-prefixed disposition : 0 of 1,166
                    #   body non-ATX `#disposition:`          : 0 of 1,166
                    # Both closed at zero measured cost. The predicate matters:
                    # `^[[:space:]]*#[^[:space:]#].*disposition:` returns 0
                    # against the literal string `#disposition: x` -- it
                    # requires a character BETWEEN the `#` and the word, so it
                    # cannot match the spelling it is costing. Use
                    # `^[[:space:]]*#disposition:` (or drop the class) and run a
                    # control.
                    _hd = (pre ~ /^[ \t]*#/) ? "h" : ""
                    print FNR _hd "\t" rest
                }
            }
        ' "$report" 2>/dev/null) || _fields=""
        [[ -n "$_fields" ]] && break
    done

    if [[ -n "$_fields" ]]; then
        while IFS=$'\t' read -r _lno _val; do
            # Every consumed field line is recorded, not only the offending one:
            # `_bad` also fires on two legal-but-CONFLICTING values, where the
            # offender is the disagreement rather than any single line.
            _lines="${_lines:+$_lines,}$_lno"
            # ---- A HEADING IS A SECTION TITLE, NOT A STATEMENT (#895) --------
            #
            # `#` sits in `structural_only`s strip set, i.e. this parser
            # classified a heading as EMPHASIS. Apply the header rule stated
            # above and it is plainly the other kind: a heading DELEGATES the
            # text to a role - it names what a section is ABOUT - exactly as a
            # blockquote delegates to another speaker. It does not DECORATE an
            # assertion. `## Disposition: no-further-pass` is a title reading
            # "this section concerns the no-further-pass disposition"; it is not
            # the author saying it.
            #
            # The repo had ALREADY made this ruling and applied it in one place.
            # #855 carved headings out at `report-check`, and the carve-out is
            # reachable only from `unreadable` - so a heading carrying an
            # ILLEGAL value was treated as a title, while the SAME heading
            # carrying a LEGAL one was promoted to a governing statement. The
            # value decided whether the line was a title. That is backwards, and
            # it fails in the permitting direction: measured, a report whose
            # only disposition-shaped line was `## Disposition: no-further-pass`
            # returned `no-further-pass ... detail=stated` from
            # `ng skeptic-disposition`, which is `retire-preflight.sh`s
            # "gate does not apply" arm - a report authorising its own
            # `tmux kill-window`. It also SILENCED a contradicting prose request:
            # the same body without the heading returns `second-pass prose
            # inferred`, and the field scan short-circuits before prose ever
            # runs, so adding a section title overrode an author asking for
            # another pass.
            #
            # `unreadable`, not "skip". Skipping looks tidier and is unsafe:
            # `## Disposition: second-pass` currently BLOCKS retirement, and a
            # parser that silently drops it would move that report from NO-GO to
            # proceed. Never let ignoring text relax a gate. `unreadable` is
            # #684s channel for "you wrote a disposition and I could not read
            # it" - loud, NO-GO at read time, releasable (#813 F4) - and it is
            # already what an illegal-valued heading returns, so this makes the
            # two agree instead of splitting on the value.
            #
            # Write time is UNCHANGED and that composition is the point: this
            # resolves `unreadable source=body`, which is precisely the state
            # #855s carve-out consumes, so an ordinary worker writing
            # `### Disposition: fix at source` still passes `report-check`. The
            # title stays legal to WRITE; it stops governing when READ.
            #
            # Differential over a frozen corpus snapshot, asserted rather than
            # argued (test-bookkeeping-contract.sh, "#895"): zero of 1,133
            # reports change verdict. The three carrying a heading-shaped line
            # are all either fenced or already governed by frontmatter.
            if [[ "$_lno" == *h ]]; then _heading=1; continue; fi
            # Normalise PRESERVING word boundaries (#681 F1: the old
            # `tr -dc 'a-z-'` deleted spaces, welding a sentence into one
            # token-containing string, so a MENTION matched as a STATEMENT).
            _val=$(printf '%s' "$_val" | tr 'A-Z_' 'a-z-' | tr -c 'a-z0-9-' ' ' | tr -s ' ')
            _val="${_val# }"; _val="${_val% }"
            _sq="${_val// /}"; _this=""
            case "$_val" in
                no-further-pass|nofurtherpass) _this=no-further-pass ;;
                second-pass|secondpass)        _this=second-pass ;;
            esac
            if [[ -z "$_this" ]]; then
                case "$_sq" in
                    no-further-pass|nofurtherpass) _this=no-further-pass ;;
                    second-pass|secondpass)        _this=second-pass ;;
                esac
            fi
            # The value must BE a token, not CONTAIN one. Anything else is a
            # field the author DID write and we could NOT read -> `unreadable`,
            # which is loud, rather than `absent`, which is silent. That
            # distinction is the whole of #684: the fix for a misread is not a
            # tighter regex (another proxy) but a channel to say "I misread".
            #
            # AN EMPTY VALUE IS UNREADABLE, AND THAT IS CLAIMED, NOT INCIDENTAL
            # (your-org/nexus-code#855 skeptic D1). The BOLDED PARAGRAPH LABEL
            # idiom lands here:
            #
            #     **Disposition:** <prose explaining the call>
            #
            # Rule (5) bounds the value at the closing `**`, and for this shape
            # the closer immediately follows the colon, so `rest` bounds to the
            # EMPTY STRING. Before this field scan emitted line numbers, an
            # empty `rest` printed a BLANK line, `$(...)` stripped it, the scan
            # saw no fields at all and fell through to the prose scan -> `absent`.
            # Emitting `<lineno>\t<rest>` makes that record non-blank, so the
            # empty value now reaches this arm and resolves `unreadable`.
            #
            # WHY UNREADABLE IS THE RIGHT ANSWER, not a regression to route
            # around: the author DID write a disposition field. They wrote a
            # label, a colon, and a sentence, and they believe they have
            # communicated a verdict. `absent` says "nobody stated one" and is
            # simply false about this document; `unreadable` says "you stated
            # one and we could not read it", which is exactly #684 and is the
            # case that must be LOUD. Both effects are conservative: write-time
            # refuses, and `retire-preflight` reads NO-GO rather than proceed.
            #
            # IT IS CONSISTENT WITH THE HEADING CARVE-OUT in `cmd_report_check`,
            # and the pair is the boundary worth remembering: `### Disposition:
            # fix at source` is a SECTION TITLE — the word names a section, so
            # it is not a statement and is carved out. `**Disposition:** <prose>`
            # is a FIELD STATEMENT in prose form — the author is asserting the
            # value, just not in a shape the enumeration can hold. Title vs
            # statement, opposite answers, one principle.
            #
            # MEASURED INCIDENCE, so the cost is known rather than assumed:
            # re-parsing every corpus report that mentions the word, exactly ONE
            # real file changes verdict —
            # `reports/nexuscode-568watch-skeptic_2026-07-30_163146_…` at L167.
            # Named here so that whoever hits a NO-GO on that report can tell a
            # DECLARED behaviour from an accident, which is the whole reason
            # this is written down instead of quietly narrowed.
            [[ -z "$_this" ]] && { _bad=1; continue; }
            [[ -n "$_seen" && "$_seen" != "$_this" ]] && _bad=1
            _seen="$_this"
        done <<<"$_fields"
        if (( _bad )); then
            printf 'unreadable %s value-not-a-token' "$_source"
        elif (( _heading )) && [[ -z "$_seen" ]]; then
            # Reachable exactly when EVERY consumed field line was `#`-prefixed:
            # the `continue` above is the only path that consumes a line while
            # setting neither `_seen` nor `_bad`. Such a line is not a statement
            # (#895), so there is no value to report — say that, rather than
            # printing an empty state, which `read -r st src det` would silently
            # shift into `st`.
            #
            # The detail names the MARK THE AUTHOR ACTUALLY WROTE, because the
            # two modes call it different things and the remedy differs: a
            # section title should be left alone and the field written
            # elsewhere; a commented-out field should be uncommented or deleted.
            # `unreadable` for both, and for the same reason it is not a skip in
            # the body: `# disposition: second-pass` BLOCKS retirement today, so
            # resolving a commented-out field to `absent` would UN-BLOCK a kill.
            # Ignoring text must never relax a gate — in either mode.
            if [[ "$_source" == "frontmatter" ]]; then
                printf 'unreadable %s hash-prefixed-line-is-a-yaml-comment' "$_source"
            else
                printf 'unreadable %s heading-is-a-section-title' "$_source"
            fi
        else
            printf '%s %s stated' "$_seen" "$_source"
        fi
        (( _with_lines )) && printf ' %s' "${_lines:--}"
        return 0
    fi

    # ---- PROSE fallback — still governing, but now attributed ------------
    # Anchored at line start (a CONCLUSION is a sentence; a DISCUSSION of one
    # is mid-clause — #681 F1 (a3)), and `>` is deliberately NOT an allowed
    # prefix mark: a blockquote is how a report quotes a PRIOR round, and the
    # pre-#684 regex read such a quotation as this author's own conclusion.
    # Reported as `source=prose` so a caller can attribute it; see the header
    # for why it is not demoted further (the corpus says demotion is a losing
    # trade, 6 false escalations bought for zero demonstrated safety).
    local _pn=0 _ps=0 _prose
    # De-fence FIRST, for the same reason the field scan does: a fenced sample
    # sentence is a quotation. Matched from a HERESTRING, never `awk | grep -q`
    # - that pipeline is the #622 early-exit inversion this repo just swept.
    # `want=body` because the prose scan reads the whole file as markdown; it
    # has no frontmatter/body split to make. Over-removal here resolves toward
    # `absent`, which ESCALATES, so the fail direction is the safe one.
    _prose=$(awk -v want=body '
        $0 ~ /^[[:space:]]*(```|~~~)/ { fence = !fence; next }
        fence { next }
        '"$_blockctx"'
        { print }
    ' "$report" 2>/dev/null) || _prose=""
    grep -qiE '^[[:space:]]*[*_-]*[[:space:]]*no (further|second|additional) (skeptic )?pass (is )?(warranted|needed|required)' \
            <<<"$_prose" && _pn=1
    grep -qiE '^[[:space:]]*[*_-]*[[:space:]]*a (further|second) (skeptic )?pass (is )?(warranted|needed|required)' \
            <<<"$_prose" && _ps=1
    if (( _pn && _ps )); then
        printf 'unreadable prose both-conclusions-in-prose'; return 0
    fi
    (( _pn )) && { printf 'no-further-pass prose inferred'; return 0; }
    (( _ps )) && { printf 'second-pass prose inferred';     return 0; }
    printf 'absent none no-disposition-stated'; return 0
}

# The NEWEST report in the corpus whose FRONTMATTER `window:` field names
# the given window (your-org/nexus-code#813). Prints the path on stdout.
#
# Exit codes are the point of this helper, so read them before the output:
#   0  a report was found; its path is on stdout.
#   1  the scan RAN and found nothing. A positive negative — the corpus was
#      enumerable and no report claims this window.
#   2  the scan COULD NOT RUN (no corpus directory, or the enumeration
#      itself failed). NOT the same as 1, and never collapsed into it: the
#      whole of #813 (and #618/#707/#770 before it) is what happens when
#      "I looked and found none" and "I could not look" share an arm.
#
# FRONTMATTER-scoped on purpose. A body line reading `window: foo` — trivially
# common in a report that QUOTES a spawn command or a state path — is not a
# claim of authorship, and matching it would attribute another window's
# disposition to this one. awk stops at the closing fence per file.
_skeptic_window_reports() {
    local window="${1:-}" reports_dir="${2:-}"
    [[ -n "$window" ]] || return 2
    [[ -n "$reports_dir" ]] || reports_dir=$(_report_reports_dir)
    [[ -d "$reports_dir" ]] || return 2
    # `nullglob` so an empty corpus yields an empty list rather than the
    # literal glob — which would otherwise be handed to awk, fail to open,
    # and make an EMPTY corpus and an UNREADABLE one look alike.
    # `shopt -p` save/restore — the form monitor/watcher/main.sh uses, the one
    # `ng` already uses at its other two sites, and the one
    # monitor/watcher/test-ambient-shell-option-scope.sh sanctions. The flag
    # form this replaces ended in an unconditional-looking `shopt -u nullglob`,
    # which that lint (tightened by #823) correctly refuses: a sourced library
    # must hand its caller back the option state it arrived with, and a bespoke
    # flag cannot express "it was already on". `shopt -p` round-trips the ACTUAL
    # prior state, so this is strictly more correct, not merely lint-shaped.
    local _restore_nullglob
    _restore_nullglob=$(shopt -p nullglob)
    shopt -s nullglob
    local -a candidates=("$reports_dir"/*.md)
    eval "$_restore_nullglob"
    (( ${#candidates[@]} > 0 )) || return 1
    # your-org/nexus-code#813 skeptic F4 — `awk` is FATAL on the first file it
    # cannot open; it does not skip and continue. One chmod-000 member, one
    # `*.md` that is a directory or a dangling symlink, in a ~1000-file corpus
    # written by many agents across many sessions, took down retirement for
    # EVERY window at once — and `2>/dev/null` swallowed the one string naming
    # the offender, so the operator got an unactionable brick from the guard
    # whose whole subject is silent failure.
    #
    # Pre-filter to regular, readable files. A member that vanishes between
    # this filter and the awk open is still possible (narrow race), which is
    # why the awk's stderr is now CAPTURED and surfaced rather than discarded.
    local -a readable=()
    local _c _skipped=0
    for _c in "${candidates[@]}"; do
        if [[ -f "$_c" && -r "$_c" ]]; then readable+=("$_c"); else _skipped=$(( _skipped + 1 )); fi
    done
    _SKEPTIC_REPORT_SCAN_SKIPPED=$_skipped
    candidates=("${readable[@]}")
    (( ${#candidates[@]} > 0 )) || return 1
    # ONE awk over the whole corpus, not one per file. The per-file form
    # measured 17.7 s wall on this 977-report corpus (load ~45) because it
    # forked ~977 times; a synchronous pre-kill gate cannot cost that, and a
    # thousand forks per call is its own hazard under the worker RLIMIT_NPROC
    # ceiling. Single-pass reads more bytes and spends far less time.
    #
    # No `nextfile`: it is a GNU/mawk extension, not POSIX, and this must
    # behave identically wherever the nexus runs. The cost is reading each
    # report's body rather than stopping at its frontmatter fence — 112 MB of
    # sequential I/O, measured below the fork overhead it replaces.
    #
    # AND: this deliberately does NOT decide the exit status inside a main
    # rule. `exit 0` in a main rule still runs END, and an `END { exit 1 }`
    # overrides it — the first draft of this helper did exactly that and
    # returned a confident "no report names this window" for a corpus that
    # plainly contained one. It was caught only by sanity-checking the probe
    # against a known-present file, which is the discipline this whole issue
    # family is about.
    local matches awk_rc _awk_err
    _awk_err=$(mktemp "${TMPDIR:-/tmp}/skeptic-scan.XXXXXX") || _awk_err=/dev/null
    matches=$(awk -v w="$window" '
        FNR == 1 { infm = ($0 ~ /^---[[:space:]]*$/); next }
        !infm { next }
        /^---[[:space:]]*$/ { infm = 0; next }
        {
            if (index($0, "window:") == 1) {
                v = substr($0, 8)
                sub(/^[[:space:]]+/, "", v)
                sub(/[[:space:]]+$/, "", v)
                if (v == w) print FILENAME
                infm = 0
            }
        }
    ' "${candidates[@]}" 2>"$_awk_err"); awk_rc=$?
    # awk exits non-zero when it could not read part of the corpus (or died).
    # That is "I could not look", not "I looked and found none" — the whole
    # distinction this helper exists to preserve. Report it as such.
    if (( awk_rc != 0 )); then
        # Surface WHICH file, so the refusal names something actionable.
        _SKEPTIC_REPORT_SCAN_ERR=$(tr '\n' ' ' < "$_awk_err" 2>/dev/null | cut -c1-200)
        rm -f "$_awk_err" 2>/dev/null || true
        return 2
    fi
    rm -f "$_awk_err" 2>/dev/null || true
    [[ -n "$matches" ]] || return 1
    # EVERY match, newest first — NOT just the newest (your-org/nexus-code#962).
    #
    # This used to return one report: the newest by mtime whose frontmatter
    # `window:` matched. A window is not a task. Retained windows routinely
    # serve several issues in sequence — that is the design — so the governing
    # disposition for task A became whatever the same window last said about
    # task Z. `argsurf2` held a `second-pass` on #906 and was KILLED at
    # 03:01 on `sk952b`'s `no-further-pass` about #952, a true statement about
    # a different task.
    #
    # Two vectors, and the second is why "just compare filenames" is no fix:
    # reports are APPEND-ONLY by house convention, so appending to an OLDER
    # report moves its mtime ahead of a newer one and makes it govern. Following
    # the documented convention was enough to flip which task's disposition won.
    #
    # So the caller gets the whole set and applies a default-DENY aggregation.
    # A report that could not be stat'd is DROPPED FROM THE ORDERING but kept
    # in the set at the end, because failing to read its mtime must not remove
    # it from consideration — that would be doubt permitting.
    local f mt any=0
    local sorted=""
    while IFS= read -r f; do
        [[ -n "$f" ]] || continue
        mt=$(stat -c %Y "$f" 2>/dev/null) || mt=""
        [[ "$mt" =~ ^[0-9]+$ ]] || mt=0
        sorted="${sorted}${mt}\t${f}\n"
        any=1
    done <<<"$matches"
    (( any )) || return 2
    printf '%b' "$sorted" | sort -rn -k1,1 | cut -f2-
    return 0
}

# `ng skeptic-disposition <window> [--reports-dir <path>]` — the READ-ONLY
# probe behind retire-preflight's disposition gate (your-org/nexus-code#813).
#
# WHY A VERB. The parser (`_skeptic_stated_disposition`) and the corpus
# lookup both live here, and retire-preflight.sh is a standalone script that
# cannot source a CLI with top-level code. A second copy of the disposition
# vocabulary is exactly how `over-limit` once ended up permitted in the kill
# gate while the skill said "Do NOT close" (#603). One parser, one lookup,
# one answer, reached over a process boundary — the same shape as this
# script's existing shell-out to pane-state.sh.
#
# Output — ONE line, key=value:
#   state=<absent|no-further-pass|second-pass|unreadable|no-report|unknown>
#   source=<none|frontmatter|body|prose> report=<path|-> report_mtime=<epoch|0>
#   detail=<machine-readable reason>
#
# Two states here are NOT in the parser's vocabulary and carry this verb's
# own findings:
#   no-report — the corpus was enumerable and no report claims this window.
#               A POSITIVE negative; the gate does not apply.
#   unknown   — the corpus could not be enumerated at all. The gate cannot
#               be evaluated, and the caller must treat that as doubt.
#
# Exit: 0 whenever a determination was reached (including `no-report`);
#       2 when it was not (`state=unknown`).
# `ng skeptic-obligations <window> [--state-dir D]` — WHAT THIS WINDOW OWES,
# BY TASK (your-org/nexus-code#961).
#
# #961's complaint in one line: "The flag cannot be audited. Its content is `1`.
# There is no task id, no issue, no timestamp of the obligation it represents —
# so no reader can check it, and every reader must guess." Two readers guessed,
# six hours apart, on the same file; one read the marker as an arrear and
# re-dispatched a reviewer onto completed work, the other read it as clearance.
# Both were reasonable and both were wrong, because a bit cannot answer "which".
#
# This is the read that answers it. One line per artefact still outstanding,
# naming the issue and the report, so presence says WHICH obligation and absence
# is checkable.
#
# OUTPUT (machine-parseable, first line always present):
#   window=<w> key=<k> outstanding=<n> ledger=<present|absent>
#   arm sha=<sha> issue=<issue> armed=<iso> report=<path>      (n lines)
#
# EXIT: 0 = nothing outstanding · 1 = one or more outstanding · 2 = bad usage
#       · 3 = REFUSED, could not determine (a ledger exists but is unreadable
#         or unparseable). 3 is NEITHER present nor absent, and every consumer
#         on the kill path must treat it as doubt — `retire-preflight` does,
#         because it refuses on any non-zero.
#
# `ledger=absent` is reported as `outstanding=0` and that is NOT this verb
# over-claiming. It says exactly what it looked at, and the retire path reads it
# BESIDE the pending-marker check, which is older, independent, and unchanged.
# The two together can only ADD refusals: this verb fires solely when a ledger
# positively names artefacts nobody discharged. It can never release a gate the
# marker holds — which is the property that makes it safe to put on a kill path
# and safe to land on a state dir full of pre-ledger windows.
# `ng skeptic-arm <window> --report <path> [--issue N] [--state-dir D]`
# RECORD WHAT AN ARM IS ABOUT, from outside `ng` (your-org/nexus-code#1207).
#
# ── WHY THIS VERB EXISTS ──────────────────────────────────────────────────
#
# There are TWO writers of the armed state and, before this, only one of them
# could name a subject:
#
#   monitor/ng (wrap-up --skeptic-decision require)  marker + `armed` ledger row
#   monitor/spawn-worker.sh (--skeptic-role)         marker ONLY
#
# spawn-worker.sh's own comment states its position exactly: for a FIRST-pass
# skeptic its write is an idempotent re-stamp, but "for a SECOND-or-later pass it
# is the ONLY thing that restores the block". So every re-validation round — the
# rounds that exist BECAUSE something was already found wrong — established an
# armed state with no subject attached, and no verdict against it could be
# credited. Measured on the live board: `annz36` logged
# `subject-armed-sha:"-"` at verdict time with no `skeptic-request` event at all,
# and `ncpanestate` carries ONE `armed` row against four rounds of review, so all
# six of its delivered verdicts read `asserted-not-armed` — the arm never moved
# while the report was amended under it.
#
# The subject spawn-worker holds is the RIGHT one, which is what makes this fix
# a repair rather than a patch: `PRIOR_REPORT_RESOLVED` is the report the
# reviewer is being pointed at, already resolved against `$NEXUS_ROOT`. Arming
# against it names, per round, exactly what the reviewer was pinned to.
#
# A verb rather than a shared library because the ledger's row format has ONE
# writer and it is this file. `spawn-worker.sh` re-implementing the `printf`
# would make the format a two-place agreement maintained by hand, which is the
# defect class this bundle is otherwise closing.
#
# ── IDEMPOTENCE IS LOAD-BEARING, NOT TIDINESS ─────────────────────────────
#
# spawn-worker's marker write is deliberately an idempotent re-stamp, and it runs
# on FIRST-pass spawns where the worker's `require` wrap-up has already armed
# these exact bytes. Appending unconditionally would put a second `armed` row for
# one artefact on the ledger, and two open arms is precisely
# `ambiguous-N-arms-outstanding` — pole B of `#1156`. A fix for pole A that
# manufactures pole B is not a fix. So an arm is skipped when this sha is already
# OUTSTANDING on this key; a sha that was armed and then DISCHARGED is armed
# again, because that is a genuine new round on unchanged bytes.
#
# EXIT CODES — three of the four are not "recorded":
#   0  an `armed` row was appended
#   3  ALREADY CURRENT: this artefact is already outstanding on this key, so
#      nothing was appended. Not a failure; not a new arm either.
#   4  COULD NOT NAME A SUBJECT: the report is unreadable, or no sha256 tool
#      exists. Says so on stderr and appends nothing. The caller must not read
#      this as armed-with-a-subject, because a marker will still exist.
#   2  usage.
cmd_skeptic_arm() {
    local window="" report="" issue="" state_dir=""
    _argloop_prev_37=-1; while (( $# > 0 )); do (( $# != _argloop_prev_37 )) || _argloop_stuck "skeptic-arm $1"; _argloop_prev_37=$#
        case "$1" in
            --report)    _need_val --report    "$#" "${2:-}"; report="$2";    shift 2 ;;
            --issue)     _need_val --issue     "$#" "${2:-}"; issue="$2";     shift 2 ;;
            --state-dir) _need_val --state-dir "$#" "${2:-}"; state_dir="$2"; shift 2 ;;
            --*) die "skeptic-arm: unknown flag: $(_arg_excerpt "$1")" ;;
            *) if [[ -z "$window" ]]; then window="$1"; shift
               else die "skeptic-arm: unexpected argument: $(_arg_excerpt "$1")"; fi ;;
        esac
    done
    [[ -n "$window" && -n "$report" ]] || {
        echo "usage: ng skeptic-arm <window> --report <path> [--issue N] [--state-dir D]" >&2
        return 2
    }
    local sd="${state_dir:-$STATE_DIR}"
    local pend="$sd/skeptic/pending"
    local key; key=$(wk_encode "$window")
    # Resolve as given, else against NEXUS_ROOT — the same two-step
    # spawn-worker.sh applies to `-r`, so a relative reports/ path recorded by
    # `ng report-init` (which pins to the PRIMARY corpus) resolves from any cwd.
    # Without it a worker in a secondary clone hands over a path that is
    # unreadable where the hash is taken, and the arm silently carries no
    # subject: measured rc 1 from `_skeptic_artefact_sha` for a relative path, a
    # missing file, an unreadable file, a directory and an empty argument.
    local rp=""
    if   [[ -r "$report" ]]; then rp="$report"
    elif [[ -n "${NEXUS_ROOT:-}" && -r "$NEXUS_ROOT/$report" ]]; then rp="$NEXUS_ROOT/$report"
    fi
    local sha=""
    [[ -n "$rp" ]] && { sha=$(_skeptic_artefact_sha "$rp") || sha=""; }
    if [[ -z "$sha" ]]; then
        printf 'ng skeptic-arm: COULD NOT NAME A SUBJECT for %s — no `armed` row written.\n' "$window" >&2
        printf '  report as given : %s\n' "${report:-<none>}" >&2
        printf '  resolved to     : %s\n' "${rp:-<unresolved>}" >&2
        printf '  A marker may still exist, so the gate is shut with nothing on the ledger to\n' >&2
        printf '  credit a verdict against. A verdict WILL still be recorded (detail\n' >&2
        printf '  `no-arm-on-record`, evidence class `verdict-without-arm`) — but it cannot be\n' >&2
        printf '  attributed. Pass an absolute path, or one relative to NEXUS_ROOT.\n' >&2
        return 4
    fi
    # ALREADY OUTSTANDING → append nothing. See the idempotence note above.
    local arms=""; arms=$(_skeptic_open_arms "$pend" "$key") || arms=""
    if [[ -n "$arms" ]] && grep -qx "$sha" <<<"$arms"; then
        printf 'ng skeptic-arm: %s already has this artefact OUTSTANDING (%s…) — nothing appended.\n' \
            "$window" "${sha:0:12}" >&2
        return 3
    fi
    mkdir -p "$pend" 2>/dev/null || true
    _skeptic_record_arm "$pend" "$key" "$sha" "$issue" "$rp"
    printf 'armed %s sha=%s issue=%s report=%s\n' "$window" "$sha" "${issue:--}" "$rp"
    return 0
}

cmd_skeptic_obligations() {
    local window="" state_dir=""
    _argloop_prev_35=-1; while (( $# > 0 )); do (( $# != _argloop_prev_35 )) || _argloop_stuck "skeptic-obligations $1"; _argloop_prev_35=$#
        case "$1" in
            --state-dir) _need_val --state-dir "$#" "${2:-}"; state_dir="$2"; shift 2 ;;
            --*) die "skeptic-obligations: unknown flag: $(_arg_excerpt "$1")" ;;
            *) if [[ -z "$window" ]]; then window="$1"; shift
               else die "skeptic-obligations: unexpected argument: $(_arg_excerpt "$1")"; fi ;;
        esac
    done
    [[ -n "$window" ]] || { echo "usage: ng skeptic-obligations <window> [--state-dir D]" >&2; return 2; }
    local sd="${state_dir:-$STATE_DIR}"
    local pend="$sd/skeptic/pending"
    local key; key=$(wk_encode "$window")
    local ledger; ledger=$(_skeptic_ledger_file "$pend" "$key")
    # ── A LEDGER THAT CANNOT BE READ IS NOT AN EMPTY ONE (#1137 F2) ────
    #
    # `_skeptic_open_arms` returns 1 for two very different things: no ledger
    # exists (a legitimate `absent`, and the whole pre-#984 corpus), and a
    # ledger exists but could not be read or parsed. Collapsing both to
    # `arms=""` printed `outstanding=0` at rc 0 — a confident negative asserted
    # without looking, on a kill path, which is this workspace's dominant
    # defect class arriving inside the fix for it.
    #
    # Absent stays rc 0: the marker check is upstream, independent and
    # unchanged, so a window that never armed through this code is genuinely
    # unaffected. PRESENT-BUT-UNREADABLE is rc 3 — REFUSED, neither present nor
    # absent — because `retire-preflight` treats any non-zero as doubt and
    # doubt about an irreversible kill must refuse.
    local present=absent
    if [[ -e "$ledger" ]]; then
        present=present
        [[ -r "$ledger" ]] || present=unreadable
    fi
    local arms rc_arms=0
    arms=$(_skeptic_open_arms "$pend" "$key") || rc_arms=$?
    if [[ "$present" == "unreadable" ]] || { [[ "$present" == "present" ]] && (( rc_arms != 0 )); }; then
        [[ "$present" == "present" ]] && present=unparseable
        printf 'window=%s key=%s outstanding=? ledger=%s\n' "$window" "$key" "$present"
        printf 'ng skeptic-obligations: the ledger for %q EXISTS but could not be %s (%s).\n' \
            "$window" "$( [[ "$present" == unreadable ]] && printf 'read' || printf 'parsed' )" \
            "$ledger" >&2
        printf '  This is REFUSED, not reported as zero: "could not look" is not "nothing to find".\n' >&2
        return 3
    fi
    local n=0
    [[ -n "$arms" ]] && n=$(printf '%s\n' "$arms" | grep -c .)
    [[ "$n" =~ ^[0-9]+$ ]] || n=0
    printf 'window=%s key=%s outstanding=%s ledger=%s\n' "$window" "$key" "$n" "$present"
    local sha detail
    while IFS= read -r sha; do
        [[ -n "$sha" ]] || continue
        detail=$(_skeptic_arm_detail "$pend" "$key" "$sha") || detail=""
        if [[ -n "$detail" ]]; then
            local _f1 _f2 _f3 _f4 _f5
            IFS=$'\t' read -r _f1 _f2 _f3 _f4 _f5 <<<"$detail"
            printf 'arm sha=%s issue=%s armed=%s report=%s\n' \
                "$sha" "${_f4:--}" "${_f3:--}" "${_f5:--}"
        else
            printf 'arm sha=%s issue=- armed=- report=-\n' "$sha"
        fi
    done <<<"$arms"
    (( n > 0 )) && return 1
    return 0
}

# _skeptic_evidence_sides — THE ONE AUTHORITY for what each class establishes.
#
# `skledgsk2` B1: the operator advice in `_idle_probe.sh` sorts the classes into
# three groups, and the guard that checked it asserted only that each class was
# NAMED SOMEWHERE on the line. Moving `discharge-without-verdict` from the
# cannot-establish group to the delivered group — a claim false by its own name —
# left the suite green, because four assertions LABELLED "…on the
# cannot-establish side" were `assert_contains` over the whole line and were
# already implied by the naming loop above them. Four assertions whose text
# claimed what their code did not test.
#
# Prose cannot be parsed into sides reliably, so the sides are declared HERE, as
# data, and both the advice and its guard read this. The guard then checks
# SET EQUALITY PER GROUP rather than substring-anywhere — which also closes B2,
# where the needle for `?` was a single character satisfied by any question mark
# on the line.
_skeptic_evidence_sides() {
    printf 'no-verdict\tnone\n'
    printf 'cannot-establish\t? | resolved-only | discharge-without-verdict\n'
    printf 'delivered\tattributed | unmatched-subject | no-open-arm | verdict-without-arm | unmatched-other | ambiguous-arms | rearm-after-close | superseded-verdict | prior-verdict-other-artefact\n'
}

# `ng skeptic-evidence <window> [--state-dir D]` — DOES A VERDICT EXIST, AND
# COULD THE BOOKKEEPING MATCH IT (your-org/nexus-code#1156).
#
# READ-ONLY and AUTHORISES NOTHING. It changes no gate's verdict; it changes
# what a refusal SAYS. That separation is deliberate: a misclassification here
# can mislead a reader, and must never retire a window.
#
# `skeptic-obligations` answers "what is outstanding". This answers the
# question the four #1156 windows actually needed: "is that outstanding thing
# outstanding because nobody reviewed it, or because a delivered verdict could
# not be matched to it?" Those need opposite responses — get a review, versus
# repair the record — and until now they printed identically, which is what
# fired three duplicate `spawn-skeptic` requests and two pushes at reviewers
# that had already discharged.
#
# OUTPUT:
#   window=<w> key=<k> ledger=<present|absent|unreadable> evidence=<class> …
#   verdict at=<iso> verdict=<v> by=<who> detail=<d> sha=<sha|->   (one per row)
#
# EXIT: 0 = looked (WHATEVER it found — this verb has no opinion to fail on)
#       2 = bad usage · 3 = could not look. A caller on the kill path must
#       treat anything but 0 as "no evidence available" and keep the wording it
#       would have used without this verb, which is the conservative one.
# ng skeptic-orphans [--state-dir D] — your-org/nexus-code#1204.
#
# REPORT, NEVER REAP. Every skeptic-pending marker on the store, classified by
# the one discriminator the issue's measurement left standing — is the window
# PRESENT in tmux — evaluated BEFORE any age or ledger read. The age axis was
# measured to separate nothing (all four markers "stale" against the 600 s
# knob while one of them was a live worker with a live skeptic), and the
# ledger axis is silent for pre-#984 markers, so neither is a verdict input
# here; both are printed as context. `window_present=?` when tmux cannot be
# read — never `no`, because "could not look" must not print as "absent".
# The action log's LAST row for the window is printed so a reader can see how
# the window left the board. Exit 0 = looked; 3 = could not look (no store).
cmd_skeptic_orphans() {
    _help_check "$@"
    local state_dir=""
    _argloop_prev_37=-1; while (( $# > 0 )); do (( $# != _argloop_prev_37 )) || _argloop_stuck "skeptic-orphans $1"; _argloop_prev_37=$#
        case "$1" in
            --state-dir) _need_val --state-dir "$#" "${2:-}"; state_dir="$2"; shift 2 ;;
            --*) die "skeptic-orphans: unknown flag: $(_arg_excerpt "$1")" ;;
            *) die "skeptic-orphans: unexpected argument: $(_arg_excerpt "$1")" ;;
        esac
    done
    local sd pend; sd="${state_dir:-$STATE_DIR}"; pend="$sd/skeptic/pending"
    if [[ ! -d "$pend" ]]; then
        printf 'ng skeptic-orphans: no marker store at %s — could not look (this is not "no orphans")\n' "$pend" >&2
        return 3
    fi
    local windows tmux_ok=1
    if ! windows=$(tmux list-windows -F '#{window_name}' 2>/dev/null); then tmux_ok=0; windows=""; fi
    local log="$sd/action-log.jsonl" now; now=$(date +%s)
    local m key present age_s last_ev last_ts verdict n=0 n_live=0 n_orph=0 n_unk=0
    for m in "$pend"/*; do
        [[ -f "$m" ]] || continue
        key=$(basename -- "$m"); case "$key" in .*) continue ;; esac
        n=$((n+1))
        if (( tmux_ok )); then
            if grep -qxF -- "$key" <<<"$windows"; then present=yes; else present=no; fi
        else present='?'; fi
        age_s=$(( now - $(stat -c %Y -- "$m" 2>/dev/null || echo "$now") ))
        last_ev='-'; last_ts='-'
        if [[ -r "$log" ]]; then
            local row; row=$(grep -F -- "\"window\":\"$key\"" "$log" 2>/dev/null | tail -1)
            if [[ -n "$row" ]]; then
                last_ev=$(sed -n 's/.*"event":"\([^"]*\)".*/\1/p' <<<"$row"); last_ts=$(sed -n 's/.*"ts":"\([^"]*\)".*/\1/p' <<<"$row")
                [[ -n "$last_ev" ]] || last_ev='?'; [[ -n "$last_ts" ]] || last_ts='?'
            fi
        fi
        case "$present" in
            yes) verdict=live;     n_live=$((n_live+1)) ;;
            no)  verdict=orphaned; n_orph=$((n_orph+1)) ;;
            *)   verdict='?';      n_unk=$((n_unk+1)) ;;
        esac
        printf 'marker=%s window_present=%s verdict=%s age_s=%s last_event=%s last_event_ts=%s\n' \
            "$key" "$present" "$verdict" "$age_s" "$last_ev" "$last_ts"
    done
    printf 'markers=%s live=%s orphaned=%s unknown=%s tmux=%s store=%s\n' \
        "$n" "$n_live" "$n_orph" "$n_unk" "$( (( tmux_ok )) && printf readable || printf unreadable )" "$pend"
    if (( n_orph > 0 )); then
        printf 'ng skeptic-orphans: %d marker(s) name a window NOT in tmux. Nothing was reaped: a marker is a required-verdict obligation, and an absent pane does not discharge it. Per orphan, read `ng skeptic-evidence <window>` and release it on the record with `ng skeptic resolve <window> --reason …` — never a bare rm (your-org/nexus-code#961, #1204).\n' "$n_orph" >&2
    fi
    return 0
}

cmd_skeptic_evidence() {
    _help_check "$@"
    local window="" state_dir=""
    _argloop_prev_36=-1; while (( $# > 0 )); do (( $# != _argloop_prev_36 )) || _argloop_stuck "skeptic-evidence $1"; _argloop_prev_36=$#
        case "$1" in
            --state-dir) _need_val --state-dir "$#" "${2:-}"; state_dir="$2"; shift 2 ;;
            --*) die "skeptic-evidence: unknown flag: $(_arg_excerpt "$1")" ;;
            *) if [[ -z "$window" ]]; then window="$1"; shift
               else die "skeptic-evidence: unexpected argument: $(_arg_excerpt "$1")"; fi ;;
        esac
    done
    [[ -n "$window" ]] || { echo "usage: ng skeptic-evidence <window> [--state-dir D]" >&2; return 2; }
    local sd="${state_dir:-$STATE_DIR}"
    local pend="$sd/skeptic/pending"
    local key; key=$(wk_encode "$window")
    local ledger; ledger=$(_skeptic_ledger_file "$pend" "$key")
    local ev rc=0
    ev=$(_skeptic_verdict_evidence "$pend" "$key") || rc=$?
    if (( rc == 1 )); then
        # No ledger at all. `absent` is a claim about THIS reader's input and is
        # made only because the file's non-existence was positively observed.
        printf 'window=%s key=%s ledger=absent evidence=none verdicts=0 matched=0 unmatched=0 unmatched_why=- superseded=0 superseded_why=- standing_stale=? standing_stale_why=no-standing-verdict-to-compare resolutions=0 open=0 standing_verdict=- standing_issue=- standing_by=- standing_at=- standing_detail=- attributed_verdict=- attributed_issue=- attributed_at=-\n' \
            "$window" "$key"
        return 0
    fi
    if (( rc != 0 )) || [[ -z "$ev" ]]; then
        printf 'window=%s key=%s ledger=unreadable evidence=? verdicts=? matched=? unmatched=? unmatched_why=- superseded=? superseded_why=- standing_stale=? standing_stale_why=- resolutions=? open=? standing_verdict=- standing_issue=- standing_by=- standing_at=- standing_detail=- attributed_verdict=- attributed_issue=- attributed_at=-\n' \
            "$window" "$key"
        printf 'ng skeptic-evidence: the ledger for %q exists but could not be read (%s).\n' \
            "$window" "$ledger" >&2
        printf '  Reported as `?`, which asserts NOTHING in either direction.\n' >&2
        return 3
    fi
    printf 'window=%s key=%s ledger=present %s\n' "$window" "$key" "$ev"
    # The rows themselves, so the reader can check the classification rather
    # than believe it. A summary nobody can audit is the liability this whole
    # cluster is made of.
    # THE DUMP OBEYS THE SAME WIDTH RULE THE CLASSIFIER DOES. It used to print
    # `verdict=<v>` from any row with 3+ fields, so a ledger classified `?`
    # BECAUSE of a truncated row still displayed that row as a verdict — the
    # summary refusing to count it while the audit trail below asserted it. The
    # rows are the evidence for the class; they cannot contradict it.
    awk -F'\t' '$1 == "discharged" {
        if (NF < 7) {
            printf "verdict-row TRUNCATED fields=%d at=%s — NOT counted as a verdict\n",
                NF, (NF >= 3 && $3 != "" ? $3 : "-")
            next
        }
        printf "verdict at=%s verdict=%s issue=%s by=%s detail=%s sha=%s\n",
            $3, ($4 != "" ? $4 : "-"), ($5 != "" ? $5 : "-"), ($6 != "" ? $6 : "-"),
            ($7 != "" ? $7 : "-"), ($2 != "" ? $2 : "-")
    }' "$ledger" 2>/dev/null || true
    return 0
}

# `ng reports-for-window <window> [--reports-dir <path>]`
# The reports a WINDOW actually claims, newest first — by the frontmatter
# `window:` field, never by the FILENAME (your-org/nexus-code#1195).
#
# An agent has TWO names and they disagree on 19% of this corpus. The report
# FILENAME carries a cwd-derived project slug: `_report_project_slug` takes the
# first segment after the last `/work/` in `$PWD`, and falls back to
# `$NEXUS_WORKER_WINDOW` only when `report-init` ran OUTSIDE a `work/` tree.
# Measured, one agent, one window, same second, `cd` the only variable:
#
#   nc-exskep_…_probe-inside.md     project=nc-exskep     window=exskep
#   demo-window_…_probe-outside.md  project=demo-window   window=exskep
#
# So `ls reports/ | grep <window>` is a SILENT ZERO for 136 of 709 reports,
# and 21 windows are indexed under two or more slugs. It errs both ways: for
# one live window a filename grep returns 6 where the frontmatter says 3.
#
# Exit codes are inherited from `_skeptic_window_reports` and are the point:
#   0  found; paths on stdout, newest first
#   1  the scan RAN and found none — a positive negative
#   2  the scan COULD NOT RUN — never collapsed into 1
_usage_reports_for_window="usage: ng reports-for-window <window> [--reports-dir <path>]"
cmd_reports_for_window() {
    local window="" reports_dir=""
    _argloop_prev_38=-1; while (( $# > 0 )); do (( $# != _argloop_prev_38 )) || _argloop_stuck "$1"; _argloop_prev_38=$#
        case "$1" in
            --reports-dir) _need_val --reports-dir "$#" "${2:-}"; reports_dir="$2"; shift 2 ;;
            -h|--help)     echo "$_usage_reports_for_window"; return 0 ;;
            -*)            die "ng reports-for-window: unknown flag: $(_arg_excerpt "$1")" ;;
            *)             [[ -z "$window" ]] || die "$_usage_reports_for_window"
                           window="$1"; shift ;;
        esac
    done
    [[ -n "$window" ]] || die "$_usage_reports_for_window"
    local out rc=0
    out=$(_skeptic_window_reports "$window" "$reports_dir") || rc=$?
    if (( rc == 2 )); then
        echo "ng reports-for-window: COULD NOT LOOK — the reports corpus was not enumerable" >&2
        echo "  (missing directory, or the scan itself failed). This is NOT 'no reports'." >&2
        return 2
    fi
    if (( ${_SKEPTIC_REPORT_SCAN_SKIPPED:-0} > 0 )); then
        printf 'ng reports-for-window: %s corpus member(s) were unreadable and SKIPPED — this answer is partial.\n' \
            "$_SKEPTIC_REPORT_SCAN_SKIPPED" >&2
    fi
    (( rc == 0 )) || return "$rc"
    printf '%s\n' "$out"
}

cmd_skeptic_disposition() {
    _help_check "$@"
    local window=""
    local reports_dir=""
    _argloop_prev_11=-1; while (( $# > 0 )); do (( $# != _argloop_prev_11 )) || _argloop_stuck "$1"; _argloop_prev_11=$#
        case "$1" in
            --reports-dir) _need_val --reports-dir "$#" "${2:-}"; reports_dir="$2"; shift 2 ;;
            --*) die "unknown flag: $(_arg_excerpt "$1")" ;;
            *)  if [[ -z "$window" ]]; then window="$1"
                else die "unexpected POSITIONAL argument $(_arg_excerpt "$1"). Flags must start with --; positionals are matched in order."; fi
                shift ;;
        esac
    done
    [[ -n "$window" ]] || die "usage: ng skeptic-disposition <window> [--reports-dir <path>]"
    local reports rc
    reports=$(_skeptic_window_reports "$window" "$reports_dir"); rc=$?
    if (( rc == 2 )); then
        local det="corpus-not-enumerable"
        [[ -n "${_SKEPTIC_REPORT_SCAN_ERR:-}" ]] \
            && det="corpus-not-enumerable:${_SKEPTIC_REPORT_SCAN_ERR// /_}"
        printf 'state=unknown source=none report=- report_mtime=0 blocking=0 reports=0 detail=%s\n' "$det"
        return 2
    fi
    if (( rc == 1 )); then
        printf 'state=no-report source=none report=- report_mtime=0 blocking=0 reports=0 detail=no-report-names-this-window\n'
        return 0
    fi

    # ── DEFAULT-DENY ACROSS EVERY REPORT THIS WINDOW FILED (#962) ─────────
    #
    # A disposition is a property of a TASK. Each report is one task's
    # statement, and `no-further-pass` on report B says nothing whatever about
    # report A. So the aggregate is not "what the newest report said" — it is
    # "does ANY report still ask", which is the allowlist/default-deny shape
    # `bk_pane_kill_authorized` uses on the same kill path, for the same reason:
    # a denylist with a permissive default arm retires whatever its author did
    # not think of.
    #
    # PRECEDENCE, most-blocking first:
    #   second-pass  a named ask; the #962 live case
    #   unreadable   the author believes they communicated and have not
    #   otherwise    the NEWEST report's own state (unchanged behaviour when a
    #                window served exactly one task, which is 1585 of 1654)
    #
    # `report_mtime` is the MAXIMUM over the BLOCKING reports, never the newest
    # overall. That mtime is what a `.cleared-rationale` must post-date for
    # retire-preflight to count the gate released, so taking the max means one
    # release must post-date EVERY outstanding ask rather than only the oldest.
    # Doubt refuses; a release is required to be unambiguous.
    local st src det mt
    # TWO mtimes, and keeping them apart is the whole of your-org/nexus-code#1137 F1.
    #
    #   agg_sel_mt   the SELECTED report's own mtime — used only to rank
    #                equals against each other while choosing which report to
    #                NAME.
    #   max_block_mt the MAXIMUM over EVERY blocking report — the value
    #                printed as `report_mtime`, because that field is the
    #                RELEASE BAR and a release must post-date every
    #                outstanding ask, not merely the one that happens to be
    #                named.
    #
    # They were one variable, and the header three blocks up has always said
    # `report_mtime` is the MAXIMUM over blocking reports. The code never
    # reached it: `agg_mt="$rmt"` inside the selection `if` is a WRITE, not a
    # record, so a RANK PROMOTION (`second-pass` outranks `unreadable`)
    # overwrote a higher mtime DOWNWARD with the newly-selected report's own.
    # A trailing `(( rmt > agg_mt )) && agg_mt="$rmt"` could not repair it,
    # because by then it compares the very `rmt` it just assigned.
    #
    # Note the DIRECTION: the bar ends up too LOW, so a release record dated
    # between the two asks clears a window whose newer ask is still
    # outstanding. Pinning the mtime to the SELECTED report — the intuitive
    # reading of the symptom — makes the hole BIGGER, not smaller. Measured end to end: one blocking report ->
    # `safe=0`; ADD a second blocking ask of the other rank -> `safe=1 safe to
    # retire`. Adding an outstanding obligation made the window retireable,
    # which is #962's own class in the permitting direction.
    #
    # The precondition is all three of: >=2 blocking reports, of DIFFERENT
    # ranks, with a release record dated BETWEEN their mtimes. Without a
    # release record the state is refused either way, which is why the
    # simpler two-report fixture does not show it.
    local agg_state="" agg_src="" agg_det="" agg_report="" agg_sel_mt=0
    local max_block_mt=0
    local n_reports=0 n_blocking=0
    local first_state="" first_src="" first_det="" first_report="" first_mt=0
    local r rmt
    while IFS= read -r r; do
        [[ -n "$r" ]] || continue
        n_reports=$(( n_reports + 1 ))
        read -r st src det <<<"$(_skeptic_stated_disposition "$r")"
        # EMPTY means the parser did not run — #684's lesson. Never let a
        # crashed parser be indistinguishable from a clean `absent`.
        if [[ -z "$st" ]]; then
            st=unreadable; src=none; det=parser-produced-no-state
        fi
        rmt=$(stat -c %Y "$r" 2>/dev/null) || rmt=0
        [[ "$rmt" =~ ^[0-9]+$ ]] || rmt=0
        if (( n_reports == 1 )); then
            first_state="$st"; first_src="$src"; first_det="$det"
            first_report="$r"; first_mt="$rmt"
        fi
        case "$st" in
            second-pass|unreadable)
                n_blocking=$(( n_blocking + 1 ))
                # THE BAR FIRST, and unconditionally: every blocking report
                # raises it, whichever one ends up being named.
                (( rmt > max_block_mt )) && max_block_mt="$rmt"
                # THEN the selection, which decides only which report to NAME
                # in the diagnostic. `second-pass` outranks `unreadable`;
                # among equals the later one is named. It reads `agg_sel_mt`,
                # never `max_block_mt`, so a promotion can no longer drag the
                # bar down with it.
                if [[ -z "$agg_state" ]] \
                   || { [[ "$st" == "second-pass" && "$agg_state" == "unreadable" ]]; } \
                   || { [[ "$st" == "$agg_state" ]] && (( rmt > agg_sel_mt )); }; then
                    agg_state="$st"; agg_src="$src"; agg_det="$det"
                    agg_report="$r"; agg_sel_mt="$rmt"
                fi
                ;;
        esac
    done <<<"$reports"

    if [[ -n "$agg_state" ]]; then
        # Name the count so a reader can tell "this window's one report asks"
        # from "one of its seven does", which is the whole distinction.
        printf 'state=%s source=%s report=%s report_mtime=%s blocking=%s reports=%s detail=%s\n' \
            "$agg_state" "$agg_src" "$agg_report" "$max_block_mt" "$n_blocking" "$n_reports" \
            "${agg_det}${n_reports:+,of-${n_reports}-reports}"
        return 0
    fi
    printf 'state=%s source=%s report=%s report_mtime=%s blocking=0 reports=%s detail=%s\n' \
        "$first_state" "$first_src" "$first_report" "$first_mt" "$n_reports" "$first_det"
    return 0
}

# File a `kind=spawn-skeptic` request into the watcher-mediated request
# inbox (monitor/request-channel.sh) so the orchestrator gets a PUSH
# signal to spawn the required skeptic — instead of relying on the pending
# marker (pull) or the 600s-delayed orphaned-skeptic-pending backstop
# (your-org/nexus-code#545). Driven by the _SK_SPAWN_* globals that
# `_wrapup_skeptic_step` sets on a require/second-pass resolution. Called
# by cmd_wrap_up AFTER the report is uploaded + the link comment posted, so
# the request can carry the asset + comment URLs and the skeptic always has
# a complete artifact.
#
# The request `## Details` carries POINTERS, not inline copies (keeps the
# emitted summary small): issue + trigger-comment (the operator's original
# ask), report path + asset URL + comment URL (the deliverable to
# validate), the worker's stored prompt_file (the orchestrator's spawn
# brief + woven-in operator context), window + session-id (the live worker
# to question), and depth/orig/mode + the deliberate flag/reasons (recursion
# + arbitration state). The orchestrator composes the skeptic brief from
# these, spawns, then `ng request ack <id>`.
#
# BEST-EFFORT: like the retain step, a filing failure is surfaced on stderr
# but NEVER flips the wrap-up exit code — the hand-off itself already
# succeeded, and the pending marker + orphan backstop still guarantee the
# skeptic is not lost. Echoes a single status token to stdout for the
# caller to fold into its summary: `filed <id>` | `skipped (<why>)` |
# `FAILED (<why>)`.
#
# Provenance of the `ng` that FILED the request (your-org/nexus-code#685,
# round 10).
#
# Every other field describes the DECISION; none described the CODE that
# made it, and in this workspace those are routinely different vintages.
# The cost is measured, not hypothetical: seven consecutive depth-2
# requests were filed carrying `deliberate-reasons: second-pass-dispute`
# on reports that correctly stated `no-further-pass` — the exact defect
# `#681`/`#685` had already fixed. Deciding whether that was a live
# regression or an undeployed fix took a forensic pass, and only worked
# because an unrelated reword (`, source=…`) happened to differ between
# the two revisions. Absent that accident the requests were
# indistinguishable, and the reasonable reading — "the fix is broken" —
# was the wrong one. An artifact that records its own provenance answers
# it in one line.
#
# BEST-EFFORT by construction: a provenance field must never fail a
# wrap-up, so every probe is guarded and the value degrades to `unknown`.
# `+dirty` is not cosmetic — a locally-edited `ng` would otherwise report
# a clean commit it does not correspond to, which is the same
# false-confidence failure one level down.
_ng_provenance() {
    local d sha="" dirty=""
    d="${_script_dir:-}"
    [[ -n "$d" ]] || { printf '%s' 'unknown'; return 0; }
    sha=$(git -C "$d" rev-parse --short HEAD 2>/dev/null) || sha=""
    if [[ -n "$sha" ]]; then
        [[ -n "$(git -C "$d" status --porcelain -- ng 2>/dev/null)" ]] && dirty="+dirty"
    else
        sha=$(sha1sum "$d/ng" 2>/dev/null | cut -c1-12) || sha=""
        [[ -n "$sha" ]] && sha="sha1:$sha"
    fi
    printf '%s @ %s%s' "$d/ng" "${sha:-unknown}" "$dirty"
}

# _live_skeptic_window <target> — the `live-skeptic-window:` field.
#
# WHAT MAKES A SKEPTIC WINDOW "LIVE" (your-org/nexus-code#771).
#
# The predecessor answered a different question than the one it was
# named for. It matched a NAMING CONVENTION:
#
#     grep -qxF "${target}-skeptic" <<<"$(tmux list-windows -a …)"
#
# Skeptic windows are not named that way. Measured against this nexus's
# own provenance store: of 468 records carrying `skeptic_role: true`,
# 198 — 42% — have a window name the pattern cannot match (`fig4sk`,
# `nexuscode-716sk`, `debench-skeptic3`, `skeptic-B7`, `audit-skeptic`
# for target `ncode-audit`). Every one of them was invisible to this
# field from the moment it was spawned.
#
# `#771` was filed with a different hypothesis — that the detector keyed
# on wrap-up bookkeeping, so a RE-PINNED skeptic (which has by
# construction already wrapped up) read as gone. The observed symptom is
# real and was reported accurately: `fig4sk` was `state=busy`, re-pinned,
# working the exact delta, while the request said `live-skeptic-window:
# no`. The mechanism was not. Re-pinning correlates because iterative
# rounds are exactly when an operator reaches for `…-skeptic2` or a short
# name — but wrap-up state never entered the predicate, and the field was
# equally wrong for those 198 windows on their FIRST pass.
#
# So the answer is: a skeptic window is live when the SPAWN RECORD says
# it is a skeptic for this target, AND a tmux window of that name exists
# now, AND its pane does not positively assert a dead agent.
# `monitor/.state/windows/<w>.json` carries `skeptic_role` and
# `skeptic_target`, written by `spawn-worker.sh --skeptic-role` itself.
# That is the record; the name was only ever a proxy for it. The
# convention match is kept as a UNION member, not a replacement, so a
# window spawned before provenance existed still counts.
#
# Provenance alone would be the opposite error: records are never pruned
# (1059 of them here, most long dead), so it answers "was there ever a
# skeptic", not "is one live". Hence the intersection with tmux.
#
# WHICH WAY IT ERRS, AND WHY. The field never suppresses the request —
# the request is filed either way and the orchestrator decides. So:
#
#   * a wrong `no` costs a DUPLICATE skeptic: a rebuilt enumeration
#     (on the #771 round, a 40-gene label set, an exclusion table and a
#     GO ranking), two skeptics posting into one operator-facing issue,
#     and a second reviewer blind to the first's RETRACTED findings.
#     Four such requests in twelve minutes.
#   * a wrong `yes` costs the orchestrator one look at a named window.
#     It cannot cost a MISSING review, because the request still exists
#     and still has to be adjudicated.
#
# The costs are not symmetric, so the field errs toward `yes`: the
# liveness gate is `bk_pane_asserts_dead`, which returns true for
# `absent` and for nothing else. Every indeterminate reading — `empty`
# most of all, which means "don't know yet" and never "finished" — and
# every state a future pane-state.sh adds resolves to ALIVE. A denylist
# of "gone" states with a permissive default arm is the shape that
# retired a live worker on 2026-06-15; this is its inverse for the
# inverse question.
#
# And "could not look" is its own answer. `unknown` is emitted whenever
# the lookup was blind — no tmux, no window list, no jq to read the
# records — rather than collapsing into `no`, which is the
# silence-reads-as-absence class #771 also names. Every verdict carries
# the evidence it rests on so the reader can tell the three apart.
# SIDE-CHANNEL (your-org/nexus-code#845). The return value is PROSE — it is
# the `live-skeptic-window:` field of an operator-facing request — so a caller
# that needs the ANSWER rather than the sentence cannot parse it without
# re-encoding the grammar. Two globals carry the machine-readable half:
#
#   _LIVE_SKEPTIC_VERDICT  yes | no | unknown
#   _LIVE_SKEPTIC_NAME     the first live reviewer's window name, on `yes`
#
# They are set on EVERY exit path, including the blind ones, so a caller that
# forgets to reset them cannot read a stale `yes` from a previous call and
# paste into a window that is not there. `unknown` is a distinct verdict and
# never collapses into `no` — that collapse is #771's own defect.
_live_skeptic_window() {
    local target="$1"
    _LIVE_SKEPTIC_VERDICT=unknown
    _LIVE_SKEPTIC_NAME=""

    command -v tmux >/dev/null 2>&1 || {
        printf 'unknown (no tmux on PATH — could NOT look; this is not evidence that no skeptic exists)'
        return 0
    }
    # `session:index name` — name LAST so a window name containing spaces
    # stays intact under `read -r idx rest`.
    local live_rows
    live_rows=$(tmux list-windows -a -F '#{session_name}:#{window_index} #{window_name}' 2>/dev/null)
    if [[ -z "$live_rows" ]]; then
        printf 'unknown (tmux listed no windows at all — could NOT look; this wrap-up is itself running in one)'
        return 0
    fi

    # --- candidates: the spawn records, then the legacy name convention ---
    local windir="$STATE_DIR/windows"
    local -a candidates=()
    local records=0 prov_blind=0 w
    if [[ -d "$windir" ]]; then
        if command -v jq >/dev/null 2>&1; then
            # THE RULE THIS FIX NAMES, APPLIED TO THIS FIX. One `jq` over all
            # records is cheap, but a single MALFORMED record aborts the batch
            # — jq exits non-zero having emitted only the files it reached, and
            # with stderr suppressed the truncation is invisible. A confident
            # `no` built on a partial enumeration is `#771`'s own defect
            # rewritten one layer down. So the rc is read: partial results are
            # still used (they are valid), but the lookup is marked BLIND, and
            # a blind lookup may not produce `no`.
            #
            # NO `shopt -u` TAIL, and the omission is the point. This block is a
            # COMMAND SUBSTITUTION — a subshell — so `nullglob` dies with it and
            # the unset was already a no-op. It was also the single failing
            # assertion in the whole suite on `dev@16728e7`
            # (`watcher/test-ambient-shell-option-scope.sh` P2, all six unit
            # cells): `ng` is SOURCED by `watcher/test-skeptic-channel.sh:324`,
            # and P2 reads source text rather than executing scope rules, so it
            # cannot tell a subshell from a function body and flags any
            # unconditional `shopt -u` in a sourced file.
            #
            # ADJUDICATED rather than patched away. The guard is behaving as
            # specified — its boundary already declares that it counts instead
            # of executing scope rules and errs toward flagging — and this code
            # was dead weight, so the guard was NOT widened. Deleting beats the
            # save/restore form used at :3338 because these are different
            # situations: there the `shopt -s` is in a FUNCTION body and can
            # genuinely reach a caller, here it cannot. Save/restore in a
            # subshell is ceremony implying a hazard that does not exist. The
            # file-scoped MARKER was rejected outright: it would exempt all of
            # `ng`, including code written later.
            #
            # HOW IT GOT IN, because that is the part worth keeping: neither PR
            # was red alone. `#791` taught the scope guard's source graph to
            # resolve `NG="…/monitor/ng"` — the gap-5d extensionless-node fix —
            # which put `ng` into P2's population for the FIRST time. `#781`
            # added this `shopt -s`/`-u` pair. They merged 32 minutes apart, the
            # merge was textually clean and semantically incompatible, and
            # nothing tests the merged tree before it becomes `dev`.
            local recs_out recs_rc
            recs_out=$(
                shopt -s nullglob
                set -- "$windir"/*.json
                (( $# )) || exit 0
                jq -r --arg t "$target" \
                   'select((.skeptic_role == true) and (.skeptic_target == $t)) | .window' \
                   "$@" 2>/dev/null
            ); recs_rc=$?
            (( recs_rc == 0 )) || prov_blind=1
            while IFS= read -r w; do
                [[ -n "$w" ]] || continue
                candidates+=("$w"); records=$(( records + 1 ))
            done <<<"$recs_out"
        else
            prov_blind=1
        fi
    fi
    # Legacy convention. A union member, never the mechanism.
    candidates+=("${target}-skeptic")

    # --- intersect with the live window list ------------------------------
    local -a live_idx=() live_name=()
    local idx rest c seen matched=""
    while IFS= read -r rest; do
        [[ -n "$rest" ]] || continue
        idx="${rest%% *}"; rest="${rest#* }"
        for c in "${candidates[@]}"; do
            [[ "$rest" == "$c" ]] || continue
            # De-duplicate: a window can match both a record and the
            # convention. Newline-delimited membership string, so an empty
            # array never has to be expanded.
            seen=0
            case "$matched" in *$'\n'"$rest"$'\n'*) seen=1 ;; esac
            if (( ! seen )); then
                matched="${matched:-$'\n'}${rest}"$'\n'
                live_idx+=("$idx"); live_name+=("$rest")
            fi
            break
        done
    done <<<"$live_rows"

    if (( ${#live_name[@]} == 0 )); then
        if (( prov_blind )); then
            printf 'unknown (could NOT fully read the spawn records — no `jq`, or a malformed record aborted the scan. The records are where a skeptic window is IDENTIFIED; the legacy `%s-skeptic` name alone misses 42%% of them, so this is not evidence of absence)' \
                "$target"
            return 0
        fi
        _LIVE_SKEPTIC_VERDICT=no
        printf 'no (checked %d spawn record(s) naming this target + the legacy `%s-skeptic` name; none is a live tmux window)' \
            "$records" "$target"
        return 0
    fi

    # --- liveness: alive unless the pane POSITIVELY asserts otherwise -----
    local i state dead_all=1 first_live="" first_state="" dead_report=""
    for i in "${!live_name[@]}"; do
        state=$(_live_skeptic_pane_state "${live_idx[$i]}")
        if [[ -z "$state" ]]; then
            # Could not classify. Presume alive — see the failure-direction
            # argument above; a window that exists is already strong evidence.
            state="unclassified"
        fi
        if bk_pane_asserts_dead "$state"; then
            dead_report="${dead_report}${dead_report:+, }${live_name[$i]}=absent"
            continue
        fi
        dead_all=0
        [[ -n "$first_live" ]] || { first_live="${live_name[$i]}"; first_state="$state"; }
    done

    if (( dead_all )); then
        _LIVE_SKEPTIC_VERDICT=no
        printf 'no (window(s) exist but the pane asserts a DEAD agent: %s — nothing to re-pin)' \
            "$dead_report"
        return 0
    fi
    _LIVE_SKEPTIC_VERDICT=yes
    _LIVE_SKEPTIC_NAME="$first_live"
    printf 'yes: `%s` (state=%s) — a reviewer for this target already exists; RE-PIN it rather than spawning a duplicate' \
        "$first_live" "$first_state"
}

# _wrapup_notify_pinned_skeptic <target-window> <round> <issue>
#
# THE MECHANISM FOR your-org/nexus-code#845 INSTANCE 1 — the 2h 18m
# `tmuxwrap`/`sk897` wait, and the seven pairs before it.
#
# When a target re-arms its require gate it has, by construction, just
# produced a delta somebody must review. If a reviewer is already PINNED to
# this target — which is the correct posture across rounds, and the reason
# `_live_skeptic_window` exists — then that reviewer is sitting IDLE waiting
# to be told the delta exists. It cannot learn this on its own: an idle pane
# observes nothing, and the target may not paste into a window it did not
# create.
#
# Before this, the only thing that happened here was a `spawn-skeptic`
# request filed into the orchestrator's inbox. That is a request to SPAWN,
# and against an already-pinned reviewer the orchestrator's correct action is
# not to spawn but to ROUTE — which is exactly the step it has to remember,
# and exactly the step it forgot. So the routing happens here instead, in the
# verb that already knows both ends of the pair.
#
# THE REQUEST IS STILL FILED. This does not replace the orchestrator's
# decision; `_SK_SPAWN_REQ` is untouched. It removes the orchestrator from the
# CRITICAL PATH of a pair that already knows about each other, while leaving
# it on the path for a pair that does not.
#
# FAILURE MODES, stated rather than assumed:
#   * no live skeptic (`no`) → nothing to notify; the spawn request is the
#     whole mechanism, as before. Silent.
#   * `unknown` (could not look — no tmux, no jq, a malformed record) →
#     nothing is notified and it SAYS SO on stdout. It must not guess a
#     window name and paste into it; a wrong paste lands a delta notice in
#     somebody else's pane. Erring toward the pre-existing behaviour is safe
#     here because the spawn request still goes out.
#   * the skeptic pane is busy / user-typing / unresolvable → `_wake_gate`
#     defers (rc 5) and says why. The obligation edge is still reopened, so
#     `retire-preflight` protects the pair even when the wake did not land.
#   * a stale pin (the record names a window that has since been reused for
#     something else) → the notification is a NOTICE, not an instruction, and
#     names the target explicitly, so a mis-delivered one is legible rather
#     than actionable.
#
# Best-effort throughout: a wrap-up must not fail because a pane was busy.
_wrapup_notify_pinned_skeptic() {
    local target="$1" round="$2" issue="${3:-}"
    # THE RECEIPT (your-org/nexus-code#1182). Cleared here, BEFORE the first
    # early return, so a stale value from an earlier call can never be read as
    # this call's delivery. Set ONLY on a confirmed delivery below.
    _SK_PINNED_NOTIFIED=""; _SK_PINNED_WHY=""
    [[ -n "$target" ]] || return 0

    # NO command substitution. `_live_skeptic_window` reports its verdict
    # through globals, and `$( … )` is a subshell that would discard them —
    # a redirection is not. This is the whole reason the side channel exists.
    _LIVE_SKEPTIC_VERDICT=unknown; _LIVE_SKEPTIC_NAME=""
    if declare -F _live_skeptic_window >/dev/null 2>&1; then
        _live_skeptic_window "$target" >/dev/null 2>&1 || true
    fi

    if [[ "$_LIVE_SKEPTIC_VERDICT" != "yes" || -z "$_LIVE_SKEPTIC_NAME" ]]; then
        if [[ "$_LIVE_SKEPTIC_VERDICT" == "unknown" ]]; then
            printf '\nNOTE: could not establish whether a skeptic is already pinned to this\n'
            printf 'window, so none was notified of this round. That is a BLIND lookup, not\n'
            printf 'a finding of "none" (your-org/nexus-code#771). The spawn-skeptic request\n'
            printf 'below still goes out; if a reviewer IS pinned, route the delta by hand:\n'
            printf '    monitor/skeptic-channel.sh notify-delta <skeptic-window> --target %s --round %s\n' \
                "$target" "$round"
        fi
        return 0
    fi

    local sk="$_LIVE_SKEPTIC_NAME"

    # Reopen the edge FIRST, and unconditionally. The wake is best-effort and
    # can legitimately defer; the RECORD is what makes the pair visible to
    # `retire-preflight` and survives a wake that never landed. Ordering them
    # the other way would leave the #845 instance-2 hole open on exactly the
    # runs where the notification failed.
    if [[ -x "$_script_dir/obligations.sh" ]]; then
        ( "$_script_dir/obligations.sh" open \
            --debtor "$sk" --creditor "$target" --kind skeptic-verdict \
            --round "$round" --by "ng wrap-up (require re-arm)" \
            --detail "target re-armed round $round${issue:+ on issue $issue}; pinned reviewer owes a delta pass" \
            ) >/dev/null 2>&1 || true
    fi

    # SAY WHY THIS FIRED (your-org/nexus-code#984).
    #
    # The notice as sent could not distinguish "the target filed a NEW round"
    # from "the target's marker was RE-ARMED over unchanged bytes". The only
    # way to tell was to diff the refs yourself — so every recipient
    # re-derived the same fact, and on the live instance a reviewer received
    # this notice twice, the first time with the branch and `dev`
    # BYTE-IDENTICAL, and burned a full review cycle establishing that there
    # was nothing whatsoever to review.
    #
    # The arm's subject record answers this directly and cheaply: compare the
    # sha the gate was just armed for against the sha of the last recorded
    # discharge. Three answers, and the third is stated as ignorance rather
    # than guessed — a notice that says "I could not tell" costs the reviewer
    # one diff; a notice that guesses wrong costs it a review pass.
    local _nd_now _nd_prev _nd_detail="" _nd_key
    _nd_key=$(wk_encode "$target")
    _nd_now=$(_skeptic_current_arm_sha      "$STATE_DIR/skeptic/pending" "$_nd_key") || _nd_now=""
    _nd_prev=$(_skeptic_last_discharged_sha "$STATE_DIR/skeptic/pending" "$_nd_key") || _nd_prev=""
    # `_nd_why` is the same three-or-four-way answer as a SINGLE TOKEN, carried
    # into the action-log event and the paste note (your-org/nexus-code#1062).
    #
    # #1062's measurement: two skeptics, two different workers, each notified
    # twice with a BYTE-IDENTICAL record — same `round` (it does not increment
    # on a re-arm), and the same paste note both times — while the underlying
    # states were "nothing to review" and "a genuine delta". The prose above
    # already distinguishes them for a human reader; nothing distinguished them
    # for the LOG, so the fraction of spurious notices stayed invisible, and a
    # signal that fires when nothing happened teaches its reader to discount it.
    local _nd_why=""
    if [[ -n "$_nd_now" && "$_nd_prev" == "-" ]]; then
        # #1069. The last discharge attributed NOTHING, so no comparison is
        # available. Say so; do not reach past it for an older verdict and
        # present that as "your last".
        _nd_why=indeterminate
        _nd_detail="WHY THIS FIRED: CANNOT BE ESTABLISHED FROM STATE — the last recorded discharge attributed no artefact (more than one was armed in that round, so state cannot say which one the reviewer saw). Diff the refs yourself; do not read this notice as evidence that anything changed."
    elif [[ -n "$_nd_now" && -n "$_nd_prev" && "$_nd_now" == "$_nd_prev" ]]; then
        _nd_why=unchanged-rearm
        _nd_detail="WHY THIS FIRED: the report is BYTE-IDENTICAL (sha256 ${_nd_now:0:12}…) to the one your last recorded verdict covered, so this is a DELIBERATE RE-ARM over unchanged bytes, not new work — the re-arm reason is in the action log (\`skeptic-rearm\`). Do NOT re-derive the delta: there is none in the report."
    elif [[ -n "$_nd_now" && -n "$_nd_prev" ]]; then
        _nd_why=changed
        _nd_detail="WHY THIS FIRED: the report CHANGED since your last recorded verdict (sha256 ${_nd_prev:0:12}… -> ${_nd_now:0:12}…), so there IS a delta in the artefact."
    elif [[ -n "$_nd_now" ]]; then
        _nd_why=first-round
        _nd_detail="WHY THIS FIRED: this is the FIRST recorded round for this artefact (sha256 ${_nd_now:0:12}…); no prior verdict is on record against it."
    else
        _nd_why=no-record
        _nd_detail="WHY THIS FIRED: CANNOT BE ESTABLISHED FROM STATE — no artefact record exists for this window (an arm written before your-org/nexus-code#984, or a report that could not be hashed). Diff the refs yourself; do not read this notice as evidence that anything changed."
    fi

    local out rc
    out=$("$_script_dir/skeptic-channel.sh" notify-delta "$sk" \
            --target "$target" --round "$round" --detail "$_nd_detail" \
            --why "$_nd_why" --subject-sha "${_nd_now:--}" --prior-sha "${_nd_prev:--}" 2>&1); rc=$?
    printf '\n=== PINNED SKEPTIC NOTIFIED (your-org/nexus-code#845) ===\n'
    printf 'reviewer  : %s\n' "$sk"
    printf 'obligation: %s owes %s a round-%s verdict (recorded)\n' "$sk" "$target" "$round"
    printf '%s\n' "$_nd_detail"
    if (( rc == 0 )); then
        printf 'delivery  : delivered — it now knows this round exists\n'
        # CONFIRMED DELIVERY, and only here. `skeptic-channel.sh` exits before
        # logging on a paste failure, so rc 0 is a receipt and not a hope
        # (your-org/nexus-code#1182).
        _SK_PINNED_NOTIFIED="$sk"; _SK_PINNED_WHY="${_nd_why:-unknown}"
    else
        printf 'delivery  : NOT delivered (rc %s): %s\n' "$rc" "${out##*$'\n'}"
        printf '            The obligation is recorded either way, so retire-preflight will\n'
        printf '            refuse to retire %s while you are still waiting on it. Retry with\n' "$sk"
        printf '              monitor/skeptic-channel.sh notify-delta %s --target %s --round %s\n' \
            "$sk" "$target" "$round"
    fi
}

# _live_skeptic_pane_state <session:index> — pane state, or empty when it
# could not be established. Queried BY INDEX: pane-state.sh is index-keyed
# and answers nothing at all for a window NAME (the Step-5b defect).
_live_skeptic_pane_state() {
    local idx="$1"
    [[ -x "$_script_dir/pane-state.sh" ]] || return 0
    local line
    line=$(timeout 20 "$_script_dir/pane-state.sh" "$idx" 2>/dev/null) || return 0
    # A BASH REGEX, not `grep … | head -1`. Two reasons, and the second is
    # the load-bearing one:
    #   * an alternating-field `awk -F'[ =]'` split is wrong here — window
    #     names contain spaces, which breaks key/value pairing for every
    #     field after `name=`;
    #   * `| head -1` is an EARLY-EXIT READER, and this file runs under
    #     `pipefail` (your-org/nexus-code#622/#682). Adding one moves the
    #     checked population in `early-exit-readers.manifest`. No pipe, no
    #     row, no EPIPE to reason about.
    [[ "$line" =~ (^|[[:space:]])state=([^[:space:]]+) ]] || return 0
    printf '%s' "${BASH_REMATCH[2]}"
}

# Args: issue report_path asset_url comment_url trigger_comment repo [reply_to]
# `issue` is empty on a channel-only wrap-up; `reply_to` then names the
# request the skeptic should read to see what was actually asked.
# _wrapup_issue_ref_state <repo> <issue>
#
# Does <issue> exist in <repo>? Prints exactly one of `exists|absent|unknown`.
# THREE-VALUED ON PURPOSE: "could not look" is not "not there", and this runs on
# a path where the wrong answer strands a skeptic.
#
# WHY (your-org/nexus-code#1346). `cmd_wrap_up` resolves its repo as
# `target=$(_resolve_repo write "$repo_arg")`, which falls back to the operator's
# configured `github.repo` when `--repo` was not given. That default is then
# stamped into the request as `issue: <repo>#<n>` — a REPO-QUALIFIED pointer
# whose repo the caller never asserted. Measured on a live request:
#
#   issue: your-org/your-nexus#1134
#   gh issue view 1134 -R your-org/your-nexus  -> could not resolve
#   gh issue view 1134 -R your-org/nexus-code   -> OPEN, a real issue
#
# The failure is silent HERE and loud somewhere ELSE: the skeptic follows the
# pointer in a different window minutes later and reads "the issue was deleted"
# rather than "the pointer was mis-stamped". A well-formed pointer to nothing is
# strictly worse than a blank one, because a blank invites a question.
#
# A READ, so it runs on the operator's own credentials and needs no token.
_wrapup_issue_ref_state() {
    local repo="${1:-}" issue="${2:-}"
    [[ -n "$repo" && "$issue" =~ ^[0-9]+$ ]] || { printf 'unknown'; return 0; }
    command -v gh >/dev/null 2>&1 || { printf 'unknown'; return 0; }
    local out rc
    out=$(gh issue view "$issue" --repo "$repo" --json number 2>&1); rc=$?
    if (( rc == 0 )); then printf 'exists'; return 0; fi
    # Distinguish "GitHub answered, and it is not there" from "we could not
    # ask". Only the first is a finding; a network/auth failure must not refuse
    # a filing and strand the review.
    case "$out" in
        *"Could not resolve to an Issue"*|*"Could not resolve to an issue"*|*"not found"*|*"NOT_FOUND"*)
            printf 'absent' ;;
        *)  printf 'unknown' ;;
    esac
}

_wrapup_file_spawn_skeptic_request() {
    local issue="$1" report_path="$2" asset_url="$3" comment_url="$4"
    # `repo_explicit` defaults to 1: a direct caller that passes a repo
    # POSITIONALLY is asserting it. Only `cmd_wrap_up` can know whether its repo
    # came from `--repo` or from the `github.repo` default, so only it passes 0.
    local trigger_comment="$5" repo="$6" reply_to="${7:-}" repo_explicit="${8:-1}"
    (( ${_SK_SPAWN_REQ:-0} == 1 )) || { printf 'skipped (no require)'; return 0; }

    local target="$_SK_SPAWN_TARGET"
    local depth="${_SK_SPAWN_DEPTH:-1}"
    [[ "$depth" =~ ^[0-9]+$ ]] || depth=1
    # Origin must be filename-safe / un-spoofable ([A-Za-z0-9_-]); the
    # request-channel `file` verb dies otherwise. The real (unsanitized)
    # window also rides the body as `target-window=` / `window=`.
    #
    # your-org/nexus-code#960 — THIS LINE USED TO BE `wk_legacy_key` SPELLED
    # BY HAND: `"${target//[^A-Za-z0-9_-]/_}"`, the same map as
    # `_bookkeeping.sh`'s legacy key with the character ranges written
    # `A-Za-z` instead of `a-zA-Z`. The spelling is why it survived #941's
    # sweep and three skeptic passes — a grep for the defect idiom is
    # sensitive to how the class is written, and nothing warns you.
    #
    # WHY NO WRITER/READER AGREEMENT CHECK COULD HAVE CAUGHT IT. The channel's
    # `_chan_safe` IS `wk_encode`, and `request-channel.sh` reads back through
    # it, so both ends agree perfectly. The loss happened UPSTREAM of the
    # encoder: `lossy ∘ injective` is lossy, and `wk_encode` was handed a name
    # whose distinguishing bytes were already gone. A destroyed pre-image is
    # invisible to any check that compares the two ends.
    #
    # Two consequences, both measured on #960 and both re-derived by
    # `watcher/test-skeptic-spawn-origin-key.sh`:
    #   F1  the idempotency globs below key on `origin`, so `a.b`'s REQUIRED
    #       spawn-skeptic request was silently `skipped (already filed)`
    #       because `a_b`'s was in the inbox — a required skeptic never runs,
    #       reached by a suppressed WRITE rather than by a deletion, which is
    #       why #941's deletion-scoped count of nine did not include it.
    #   F2  `windows/${origin}.json` was a cross-window HIT, not a miss: `a.b`
    #       did not lose its provenance, it ADOPTED `a_b`'s and filed a
    #       request carrying another window's prompt_file and session_id.
    #
    # F2 is fixed by keying that read with `wk_encode`, which is what the
    # WRITER uses (`_bookkeeping.sh`) and what the ledger read four blocks
    # below already used. F1 needs an origin that is injective *and* spellable
    # in the validator's alphabet, which `wk_encode` is not — see
    # `wk_encode_word` in `_bookkeeping.sh` for the alphabet, the declared
    # non-identity on `_`, and the decline-path consequence.
    local origin; origin=$(wk_encode_word "$target")
    [[ -n "$origin" ]] || { printf 'skipped (empty origin)'; return 0; }
    # Belt and braces: the encoder's alphabet is the validator's by
    # construction, so a mismatch is a code defect, not a data one. Say so
    # here rather than letting `request-channel file` die with the raw name.
    [[ "$origin" =~ ^[A-Za-z0-9_-]+$ ]] || {
        printf 'FAILED (wk_encode_word produced an origin outside [A-Za-z0-9_-]: %s)' "$origin"
        return 1
    }

    local chan="$_script_dir/request-channel.sh"
    [[ -x "$chan" ]] || { printf 'FAILED (request-channel.sh missing)'; return 1; }

    # Idempotency: a wrap-up retry re-enters this path, and the pending
    # marker already guards against a double-SPAWN, but a duplicate REQUEST
    # is avoidable noise. Skip when a non-terminal spawn-skeptic request for
    # this origin+depth already sits in the inbox. Targeted globs only —
    # never a broad rm/scan.
    local slug="skeptic-d${depth}"
    local reqdir="$STATE_DIR/requests"
    if [[ -d "$reqdir" ]]; then
        local existing g
        # Save/restore, not a bare `shopt -u` tail: `ng` is SOURCED
        # (`watcher/test-skeptic-channel.sh:324` does `source "$NG"` to exercise
        # these functions), so an unconditional unset hands that caller nullglob
        # OFF however it had it — your-org/nexus-code#721's leak class exactly.
        # Same form as watcher/main.sh. Surfaced by #778, once the scope guard's
        # source graph learned to resolve `NG="…/monitor/ng"`; before that this
        # file was invisible to P2 because the edge did not exist.
        local _aso_r; _aso_r=$(shopt -p nullglob)
        shopt -s nullglob
        for g in "$reqdir"/*-"${origin}"-"${slug}".new.md \
                 "$reqdir"/*-"${origin}"-"${slug}".claimed.md; do
            existing="$g"; break
        done
        eval "$_aso_r"
        [[ -n "${existing:-}" ]] && { printf 'skipped (already filed)'; return 0; }

        # your-org/nexus-code#599 — RE-FIRE against an already-ADJUDICATED
        # request.
        #
        # The guard above only sees UNRESOLVED requests (`.new` /
        # `.claimed`). The moment the orchestrator answers one it becomes
        # `.replied` / `.done`, and the next wrap-up — the release path
        # re-enters wrap-up routinely — files an identical sibling. Four
        # identical depth-1 requests for `nexuscode-overlimit` in one
        # night, three of them duplicating a THEN-LIVE skeptic.
        #
        # Each duplicate costs a full orchestrator adjudication: read the
        # request, read the prior verdict, decide spawn/decline/escalate,
        # write a rationale. That is the expensive path in the protocol,
        # spent on a question already answered. And the correct answer
        # CHANGES between firings, so an orchestrator that learns to
        # pattern-match "duplicate → decline" will eventually decline one
        # that had become legitimate — a genuinely-needed skeptic silently
        # not spawned.
        #
        # The discriminator must therefore distinguish "the same question
        # again" from "the deliverable moved on". Over-aggressive dedup is
        # the WORSE failure here, so the test is deliberately narrow: skip
        # only when an adjudicated request for this (origin, depth) cites
        # the SAME report path AND that report has not been touched since
        # the request was filed. An amended report (this corpus is
        # append-only, so an amendment is an mtime bump on the same path)
        # is new information and files a fresh request.
        local adjudicated="" cited report_mtime req_mtime
        local _aso_r2; _aso_r2=$(shopt -p nullglob)   # see the note above
        shopt -s nullglob
        for g in "$reqdir"/*-"${origin}"-"${slug}".replied.md \
                 "$reqdir"/*-"${origin}"-"${slug}".done.md; do
            cited=$(sed -n 's/^report-path:[[:space:]]*//p' "$g" 2>/dev/null | head -1)
            [[ "$cited" == "$report_path" ]] || continue
            report_mtime=$(stat -c %Y "$report_path" 2>/dev/null) || report_mtime=0
            req_mtime=$(stat -c %Y "$g" 2>/dev/null) || req_mtime=0
            [[ "$report_mtime" =~ ^[0-9]+$ ]] || report_mtime=0
            [[ "$req_mtime"    =~ ^[0-9]+$ ]] || req_mtime=0
            (( report_mtime > req_mtime )) && continue   # deliverable moved on
            adjudicated="$g"; break
        done
        eval "$_aso_r2"
        if [[ -n "$adjudicated" ]]; then
            printf 'skipped (already adjudicated: %s — same report, unchanged since)' \
                "$(basename "$adjudicated")"
            return 0
        fi
    fi

    # Resolve prompt_file + session-id from the window provenance record.
    #
    # `wk_encode`, NOT `$origin` (your-org/nexus-code#960 F2). This is a STATE
    # path and the state key is whatever the WRITER used — `_bookkeeping.sh`
    # writes `windows/$(wk_encode "$window").json`. `$origin` is a different
    # key in a different alphabet, for a filename in the request inbox; using
    # it here made a MISS into a cross-window HIT. Same encoder as the
    # `_skeptic_verdict_evidence` call below, which was already correct.
    local rec="$STATE_DIR/windows/$(wk_encode "$target").json"
    local prompt_file="" session_id=""
    if [[ -f "$rec" ]] && command -v jq >/dev/null 2>&1; then
        prompt_file=$(jq -r '.prompt_file // ""' "$rec" 2>/dev/null); [[ "$prompt_file" == null ]] && prompt_file=""
        session_id=$(jq -r '.session_id // ""'  "$rec" 2>/dev/null); [[ "$session_id" == null ]] && session_id=""
    fi

    local orig_eff="$_SK_SPAWN_ORIG"
    [[ -n "$orig_eff" ]] || orig_eff="$target"     # first pass: orig == target
    local deliberate=false
    (( ${_SK_SPAWN_DELIBERATE:-0} == 1 )) && deliberate=true

    # A RECORDED DECLINE IS THE SETTLEMENT (your-org/nexus-code#1285). The
    # `#599` guard above suppresses a re-file only when the adjudicated request
    # cites the SAME report, UNCHANGED since — so a worker that re-touched its
    # report (this corpus is append-only; a re-wrap is an mtime bump) re-filed
    # the identical (target, issue, depth) TEN MINUTES after the orchestrator
    # had declined it, and the precondition block could not see the decline
    # because nothing consulted the reply. Liveness and verdict-delivery are
    # both PROXIES for "has this obligation been settled"; a `status: declined`
    # reply IS the settlement. So: if any adjudicated request for this
    # (origin, depth) was DECLINED, a re-file must state what is NEW —
    # `--skeptic-delta "<what changed since the decline>"` — or be deliberate
    # (`--skeptic-contradicted`). Otherwise it is skipped, loudly, naming the
    # decline. A `spawned` reply is left to the live-skeptic field: that one
    # means "re-pin", which is a different action from "settled".
    local declined="" dstatus dwhen
    if [[ -d "$reqdir" && "$deliberate" == false && -z "${_SK_SPAWN_DELTA:-}" ]]; then
        local _aso_r3; _aso_r3=$(shopt -p nullglob)
        shopt -s nullglob
        for g in "$reqdir"/*-"${origin}"-"${slug}".replied.md \
                 "$reqdir"/*-"${origin}"-"${slug}".done.md; do
            dstatus=$(sed -n 's/^status:[[:space:]]*//p' "$g" 2>/dev/null | tail -1 | tr -d '[:space:]')
            [[ "$dstatus" == declined ]] || continue
            declined="$g"
        done
        eval "$_aso_r3"
    fi
    if [[ -n "$declined" ]]; then
        dwhen=$(date -Is -r "$declined" 2>/dev/null || echo '?')
        printf 'skipped (DECLINED: %s answered this (window, depth) with status declined at %s — a decline is the settlement, and a re-file must state what is NEW: re-run wrap-up with --skeptic-delta "<what changed since the decline>" or --skeptic-contradicted; your-org/nexus-code#1285)' \
            "$(basename "$declined")" "$dwhen"
        return 0
    fi

    # #599 — the request layer has the window records available and
    # consulted none of them. A live skeptic window for this target means
    # a reviewer ALREADY EXISTS, which is exactly the information that
    # made three of the four duplicate adjudications resolve to "decline,
    # re-pin the live skeptic" — a conclusion the orchestrator had to
    # reach by hand, from tmux, every time.
    #
    # Surfaced as a body field. On its own it does NOT suppress: a live
    # skeptic makes the answer "re-pin", not "no skeptic needed", and those
    # are different actions, so dropping the request on the mere EXISTENCE of
    # a reviewer would discard one the orchestrator still has to act on.
    #
    # WHAT DOES SUPPRESS IS A DELIVERY RECEIPT (your-org/nexus-code#1182).
    # `_wrapup_skeptic_step` calls `_wrapup_notify_pinned_skeptic` TEN LINES
    # BEFORE it sets `_SK_SPAWN_REQ=1`. That function locates the pinned
    # reviewer, reopens the obligation edge and delivers the delta notice — so
    # one `ng wrap-up` performs the re-pin and then files a request whose body
    # instructs the orchestrator to perform the re-pin. Measured on this
    # board: 12 of 12 confirmed deliveries since 2026-08-30 were followed
    # 9-20s later by exactly such a request. When the re-pin is already DONE,
    # the only action the request could ask for has happened.
    #
    # It keys on the RECEIPT, not on the probe's prose, not on elapsed time
    # and not on mtime. `deliberate=true` always files, and so does every
    # non-receipt case, including a live reviewer whose paste FAILED — that
    # one still needs routing.
    local live_skeptic; live_skeptic=$(_live_skeptic_window "$target")
    # THE LEDGER'S OWN ANSWER, SURFACED (your-org/nexus-code#1209). Three
    # materially different states -- no verdict at all, several arms
    # outstanding, and an obligation already settled -- rendered BYTE-IDENTICAL
    # request bodies, so three requests that had three different correct
    # answers were indistinguishable to the orchestrator reading them.
    #
    # Surfaced, NEVER used to suppress -- the same discipline as
    # `live-skeptic-window` above, and for the same reason: `rearm-after-close`
    # means *decline and settle* while `ambiguous-arms` means *decline and land
    # the arms*, and those are different actions.
    #
    # A non-zero rc prints an explicit `?` saying so. An unreadable ledger is a
    # failure to LOOK, and must never render as a clean one.
    # `pending_dir` is a local of `_wrapup_skeptic_step`, NOT of this function,
    # so it must be recomputed here — referencing it directly was an unbound
    # variable under `set -u`, which is what production runs.
    local sk_evidence sk_pending_dir="$STATE_DIR/skeptic/pending"
    sk_evidence=$(_skeptic_verdict_evidence "$sk_pending_dir" "$(wk_encode "$target")" 2>/dev/null \
                  | tr '\n' ' ' | sed 's/  */ /g; s/ $//') \
        || sk_evidence=""
    [[ -n "$sk_evidence" ]] \
        || sk_evidence='? (no readable ledger for this target — this is NOT evidence that the ledger is clean)'
    if [[ -n "${_SK_PINNED_NOTIFIED:-}" && "$deliberate" == false ]]; then
        printf 'skipped (live reviewer `%s` was notified of this round over the channel (why=%s, delivery confirmed) and the obligation edge is open — the only action this request could ask for is the RE-PIN that already happened)' \
            "$_SK_PINNED_NOTIFIED" "${_SK_PINNED_WHY:-unknown}"
        return 0
    fi

    # #599 — the auto-recommendation is SEVERITY-BLIND. `substantive` is
    # derived from a findings COUNT (`findings >= threshold`), so any
    # verdict carrying one minor finding recommends a second pass. Three
    # times it overrode a report whose own text said no further pass was
    # warranted.
    #
    # A count is not a disposition. The fix is not to pick a better
    # threshold — it is to READ the stated disposition and, when the two
    # disagree, refuse to pick either. A disagreement between what the
    # tool derived and what the skeptic actually concluded is a finding
    # in its own right, and the orchestrator is the one entitled to
    # resolve it.
    local stated dsource ddetail derived recommendation
    read -r stated dsource ddetail <<<"$(_skeptic_stated_disposition "$report_path")"
    [[ -z "$stated" ]] && { stated=unreadable; dsource=none; ddetail=parser-produced-no-state; }
    derived="second-pass"
    [[ "${_SK_SPAWN_EFFECTIVE:-required}" == "required" ]] && derived="require"
    case "$stated" in
        no-further-pass)
            recommendation="DISPUTED (derived=${derived}; the report states no-further-pass, source=${dsource})" ;;
        second-pass)
            recommendation="$derived (report agrees: second-pass, source=${dsource})" ;;
        unreadable)
            # your-org/nexus-code#684 — the state that used to be
            # indistinguishable from `absent`. The orchestrator must not read
            # this as "the author had no view": they had one and it did not
            # survive the parse, so the FIRST move is to look at the report,
            # not to spawn.
            recommendation="$derived (report states a disposition the parser COULD NOT READ (${dsource}: ${ddetail}) — this request may be a PARSE artefact, not a finding; read the report's disposition line before spawning)" ;;
        *)
            # your-org/nexus-code#881 — "derived from a findings COUNT" is a
            # CLAIM, and it is false exactly when no count was stated. This
            # is the surface the ORCHESTRATOR adjudicates from, so an
            # absence described as a measurement here is the original defect
            # one layer downstream. `findings-not-stated` is set by
            # `_wrapup_skeptic_step` on precisely that case.
            # your-org/nexus-code#879 F2 — the #881 fix above was applied to
            # the ROLE path only, and this arm is reached from BOTH. On the
            # PRODUCER path there is no count anywhere in the derivation:
            # `derived` is `require`, and it comes from the window's
            # SPAWN MODE. `findings-not-stated` is set only by the role
            # path, so a producer-path request fell into the `else` and told
            # the orchestrator its recommendation was "derived from a
            # findings COUNT" — describing a computation the verb does not
            # perform on that path. Same defect as #881, one arm over: a
            # derivation named after the wrong input is no more true than an
            # absence named as a measurement.
            if [[ ",${_SK_SPAWN_REASONS:-}," == *",findings-not-stated,"* ]]; then
                recommendation="$derived (report states NO disposition AND the skeptic stated NO findings count — this recommendation is derived from ABSENCE, not from any measurement, and is severity-blind for that reason: nothing is on record either way, so read the report before acting)"
            elif [[ "$derived" == "require" ]]; then
                # your-org/nexus-code#916 (sk903, via #873's review). The first
                # draft of this arm dropped `severity-blind`, and the
                # `#599` assertion that guards it was RIGHT to fail.
                #
                # The sentence it replaced made TWO claims:
                #   (a) "derived from a findings COUNT" — FALSE on this path,
                #       which is what #879 F2 correctly removed; and
                #   (b) "which is severity-blind" — TRUE on BOTH paths.
                # Rewriting the sentence killed (b) along with (a). A
                # spawn-mode requirement cannot judge severity either: the mode
                # was fixed when the window was spawned, before any result
                # existed. So the blindness is the SAME; only its cause differs.
                #
                # The irony is worth recording, because it is this file's own
                # subject: #879 F2 was "the line describes a computation it does
                # not perform", and its fix made the line stop describing a
                # limitation it DOES have. Removing a false claim is not licence
                # to remove a true one standing next to it.
                recommendation="$derived (report states no disposition; this is a FIRST-PASS requirement derived from the window'\''s spawn mode — no findings count exists on this path and none was consulted. It is severity-blind for that reason: a spawn mode is fixed before any result exists and cannot weigh how serious the work turned out to be. Read the report before acting)"
            else
                recommendation="$derived (report states no disposition — derived from a findings COUNT, which is severity-blind; read the report before acting)"
            fi ;;
    esac

    # Compose the pointer body. First non-empty line = the emit summary
    # (request-channel streams it verbatim into `--- requests ---`), so make
    # it a self-describing one-liner. Everything else is the pointer table.
    # Subject line + the issue pointer differ by delivery surface: a
    # channel-only wrap-up has no issue to name, so the request id the
    # worker must answer takes its place (the skeptic reads the same
    # request to see what was actually asked).
    # A `reply-to:` row appears ONLY on a channel wrap-up, so the
    # default-path request body is byte-identical to the pre-flag shape.
    local subject_ref issue_line
    if [[ -n "$issue" ]]; then
        # A DEFAULTED REPO IS NOT AN ASSERTION ABOUT WHERE AN ISSUE LIVES
        # (your-org/nexus-code#1346).
        #
        # `cmd_wrap_up` resolves `target=$(_resolve_repo write "$repo_arg")`,
        # which falls back to the configured `github.repo` when `--repo` was
        # omitted. Stamping that into `issue: <repo>#<n>` publishes a
        # repo-QUALIFIED pointer the caller never made. Measured live:
        # `issue: your-org/your-nexus#1134`, where `#1134` is a nexus-code
        # issue and does not exist in your-nexus.
        #
        # THE REFUSAL IS KEYED ON THE LOCAL, DETERMINISTIC FACT — "an issue was
        # named and the repo was DEFAULTED" — and never on a network answer.
        # An earlier draft refused on a live `gh issue view` returning
        # not-found, which made the VERDICT depend on GitHub being reachable:
        # fixtures with synthetic issue numbers passed offline and failed
        # online. A guard whose answer depends on the network is worse than
        # either answer.
        if (( repo_explicit == 0 )); then
            printf 'ng wrap-up: REFUSING to file the spawn-skeptic request — issue %s would be\n' "$issue" >&2
            printf '  stamped as %s#%s, but that repo was NOT given on the command line. It is\n' "$repo" "$issue" >&2
            printf '  the configured default (`github.repo`), supplied because `--repo` was\n' >&2
            printf '  omitted — so the pointer would assert a repo you never named, and a wrong\n' >&2
            printf '  one 404s in the SKEPTIC'"'"'s window minutes later, reading as a deleted\n' >&2
            printf '  issue rather than a mis-stamped pointer. Name the repo the issue lives in:\n' >&2
            printf '      ng wrap-up %s <report> --repo <owner>/<name>\n' "$issue" >&2
            printf '  Nothing is lost: the pending marker still holds the retire gate shut and the\n' >&2
            printf '  orphan backstop still surfaces the outstanding review.\n' >&2
            printf 'skreq=refused-defaulted-repo\n'
            return 0
        fi
        # BEST-EFFORT ANNOTATION, never a verdict. Runs only when it can, and
        # `unknown` (no gh, no network, non-numeric) is indistinguishable from
        # not asking — which is why it may not decide anything.
        local _ref_state; _ref_state=$(_wrapup_issue_ref_state "$repo" "$issue")
        subject_ref="issue #${issue}"
        issue_line="issue: ${repo}#${issue}"
        case "$_ref_state" in
            absent)  issue_line="${issue_line}"$'\n'"issue-ref: DOES NOT RESOLVE — ${repo}#${issue} was not found at filing time. The repo WAS given explicitly, so either it or the number is wrong. Do not read a 404 here as a deleted issue (your-org/nexus-code#1346)" ;;
            unknown) issue_line="${issue_line}"$'\n'"issue-ref: UNVERIFIED — GitHub could not be asked at filing time; confirm the repo before trusting this pointer (your-org/nexus-code#1346)" ;;
        esac
        [[ -n "$reply_to" ]] && issue_line="${issue_line}"$'\n'"reply-to: ${reply_to}"
    else
        subject_ref="channel request ${reply_to:--}"
        issue_line="reply-to: ${reply_to:--} (channel-only wrap-up; no GitHub issue)"
    fi
    local body
    body=$(cat <<EOF
spawn-skeptic: validate \`${target}\` (${subject_ref}, depth ${depth}, ${_SK_SPAWN_EFFECTIVE:-required}$( [[ "$deliberate" == true ]] && printf ', DELIBERATE' ))

${issue_line}
trigger-comment: ${trigger_comment:--}
report-path: ${report_path}
report-asset-url: ${asset_url:--}
report-asset-url-note: SNAPSHOT pinned at filing time. NOT re-pointed when the report is amended and re-wrapped (the filing step skips as "already filed"), so it can be a PRE-CORRECTION snapshot missing the finding you are being asked to review. report-path is AUTHORITATIVE — read it (your-org/nexus-code#1148).
link-comment-url: ${comment_url:--}
worker-prompt-file: ${prompt_file:--}
window: ${target}
session-id: ${session_id:--}
target-window: ${target}
orig-window: ${orig_eff}
depth: ${depth}
mode: ${_SK_SPAWN_MODE:-auto}
effective: ${_SK_SPAWN_EFFECTIVE:-required}
recommendation: ${recommendation}
report-stated-disposition: ${stated} (source: ${dsource}; ${ddetail})
live-skeptic-window: ${live_skeptic}
ledger-evidence: ${sk_evidence}
deliberate: ${deliberate}
delta-since-decline: ${_SK_SPAWN_DELTA:--}
deliberate-reasons: ${_SK_SPAWN_REASONS:--}
worker-contradicted: ${_SK_SPAWN_CONTRADICTED:--}
filed-by-ng: $(_ng_provenance)

Orchestrator: compose a skeptic brief from these pointers (skills/nexus.skeptic),
spawn-worker.sh --skeptic-role -r \`${report_path}\` against \`${target}\` (orig \`${orig_eff}\`, depth ${depth}),
then \`ng request ack <id>\`. deliberate=true → read the prior verdict / the worker's
contradiction and decide (spawn+adjudicate | decline | escalate) before spawning.
EOF
)

    local id
    if id=$(printf '%s' "$body" | "$chan" file \
                --origin "$origin" --kind spawn-skeptic \
                --slug "$slug" --priority normal - 2>/dev/null); then
        [[ -n "$id" ]] && { printf 'filed %s' "$id"; return 0; }
        printf 'FAILED (no id returned)'; return 1
    fi
    printf 'FAILED (request-channel file errored)'; return 1
}

# `ng wrap-up <issue> <report-path> [--trigger-comment <id>]
#                                  [--repo OWNER/REPO]
#                                  [--trigger-repo OWNER/REPO]
#                                  [--retain <reason>|--no-retain]`
#
# The universal end-of-task hand-off, folded into one verb:
#   1. upload the report to the asset repo (via upload-asset.sh)
#   2. post a templated comment on <issue> with the asset URL
#      (post-once idempotent: a re-run does not duplicate the link
#      comment for this issue+report+repo — it RE-POINTS the prior
#      comment's asset URL at the fresh upload via the CAS edit
#      path, since step 1 mints a new blob every run; #524 defect 2)
#   3. rocket-react the trigger comment if --trigger-comment is set
#   4. append a wrap-up entry to the action log
#   5. append a window-retain entry (auto by default; --no-retain
#      opts out; --retain <reason> overrides the default tag)
#
# `--reply-to <request-id>` — CHANNEL DELIVERY (agent-channel RFC B+D).
# A worker spawned to answer a confined request-channel request
# (`monitor/.state/requests/*.md`, typically filed by a remote SSH
# client that wants DATA back, not a repo change) has no GitHub issue
# to wrap up to. `--reply-to` keeps ONE wrap-up verb — same report-check
# pre-flight, same skeptic gate, same action log, same window retain —
# and swaps the delivery step:
#
#   --reply-to <id>              → steps 1/2/3 (upload, issue comment,
#                                  rocket) are SKIPPED; the answer is
#                                  delivered as step 2c over the channel.
#                                  NO GitHub artifact is created.
#   --reply-to <id> --issue <n>  → BOTH. Steps 1/2/3 run as usual, and
#                                  the channel reply carries the freshly
#                                  minted asset + comment URLs.
#
# The answer body is `--answer-file <path>` when given, else the report's
# FULL `## Summary` section (report-check already guarantees it exists),
# plus a provenance footer naming the report and any GitHub artifacts.
# Delivery rides `request-channel.sh reply` — the channel is not
# reimplemented here — so the reply lands as a `.replied.md` transition
# plus a byte-exact `replies/<id>/results.md` the requester can `fetch`.
# A failed channel delivery FAILS the wrap-up (the requester is blocked
# on it); a missing `## Summary` body fails too, rather than delivering
# an empty answer.
#
# The delivery surface is chosen by the ORCHESTRATOR at spawn time
# (`spawn-worker.sh --reply-to`, which injects the matching wrap-up
# instruction), never parsed from a remote client's prose.
#
# Exit code 0 iff all attempted steps succeed. On partial success the
# verb still attempts every reachable step (the rocket and log-action
# don't depend on the upload), then emits a structured stderr report
# naming which steps ok/failed so the caller can retry the failed ones.
#
# `--repo` governs the issue-thread repo (steps 2 + log target).
# `--trigger-repo` (if omitted, defaults to `--repo`) governs where
# the rocket-react posts in step 3 — needed when the trigger comment
# lives on a different repo than the issue thread (e.g. PR-#4
# dogfood: worker on a `nexus-code` clone wraps up against
# `your-nexus#1` with the trigger comment on `nexus-code#4`).
# The asset repo is always taken from config (github.asset_repo) by
# upload-asset.sh.
#
# Retain-by-default (step 5): a successful wrap-up auto-logs a
# `window-retain` event for the source tmux window so the watcher's
# idle-worker probe suppresses the wrapped row into a footer for the
# `monitor.retain_ttl_seconds` window (default 24 h). The auto-tag is
# `wrap-up-<YYYY-MM-DD>`. Pass `--retain <reason>` for a custom tag,
# or `--no-retain` to close-immediately (short-lived helper that's
# truly done; context-pressure wrap-ups where the worker won't be
# resumed). The retain is logged only when the verb runs inside the
# worker's tmux pane (source_window resolved from $TMUX_PANE);
# off-tmux invocations silently skip step 5 since there's no window
# to retain.
#
# ── THE OUTPUT IS PERSISTED, AND `--last` RE-READS IT (your-org/nexus-code#1370)
#
# `_cmd_wrap_up_recorded` below (the dispatcher's target) is a thin wrapper
# around `cmd_wrap_up`, the verb proper — which keeps its name so the
# interface lints (`test-bookkeeping-contract` #906(A), `test-ng-usage-flag-
# coverage`) still find the arg loop under `cmd_wrap_up()`. It records every invocation's stdout + stderr + exit code under
# `$STATE_DIR/wrap-up-output/<window>/`, and it owns the two READ-ONLY forms:
#
#     ng wrap-up --last    [<window>]   # print the last record, verbatim
#     ng wrap-up --explain [<window>]   # …plus the window's ledger evidence
#
# Neither runs the hand-off: no upload, no comment, no skeptic step, no
# ledger row, no action-log event. That is the entire point. Before this,
# the only way to re-read a wrap-up's output — after a `| tail` ate its head,
# say — was to RUN THE VERB AGAIN, and the verb ARMS: Step 0b appends a
# discharge row keyed on the report sha on every invocation, exit-3 paths
# included. `warmsk` ran it three times with an identical command line, two of
# them purely to read the half of the diagnostic a pipe had discarded, and the
# ledger gained two `no-open-arm` rows that bind to nothing. The warning that
# says "the skeptic step runs again" is printed BY the run that has already
# done it — a guard whose only delivery channel is the output of the action it
# guards, so every attempt to read it fires the thing it warns about (#1366).
#
# The record is written THROUGH the streams, not captured from them: a `die`
# inside the verb is a bare `exit`, so a `> file 2> file` capture would lose
# the very message the caller most needs and never get the chance to replay
# it. Two FIFOs, two backgrounded readers whose pids the wrapper can `wait`
# on — measured on bash 4.4, a bare `wait` does NOT reap process
# substitutions, and a `tee`-into-`>(…)` form races its own footer.
_wrapup_record_dir() {   # <window-or-empty> -> dir path
    local w="${1:-}" key
    if [[ -n "$w" ]]; then key=$(wk_encode "$w"); else key="_no-window"; fi
    printf '%s/wrap-up-output/%s' "$STATE_DIR" "$key"
}

# _wrapup_record_open <argv...> -> path of a fresh record with its header written
# rc 1 (and nothing printed) when the record cannot be created; the caller then
# runs the verb UNRECORDED rather than refusing a hand-off over bookkeeping.
_wrapup_record_open() {
    local w dir f ts a
    w=$(_report_tmux_window)
    dir=$(_wrapup_record_dir "$w")
    mkdir -p "$dir" 2>/dev/null || return 1
    ts=$(date -u +%Y%m%dT%H%M%SZ 2>/dev/null) || ts="unknown"
    f="$dir/${ts}.$$.txt"
    {
        printf '# ng wrap-up — persisted invocation record (your-org/nexus-code#1370)\n'
        printf '# Re-read with: ng wrap-up --last [<window>]   — READ-ONLY: arms nothing, posts nothing.\n'
        printf 'ts: %s\n' "$(date -Is 2>/dev/null || printf '?')"
        printf 'window: %s\n' "${w:--}"
        printf 'cwd: %s\n' "$PWD"
        printf 'argv: ng wrap-up'
        for a in "$@"; do printf ' %q' "$a"; done
        printf '\n---\n'
    } > "$f" 2>/dev/null || return 1
    ln -sfn "$(basename "$f")" "$dir/last" 2>/dev/null || true
    # Bounded: keep the newest 20 records per window.
    local -a old
    old=( $(ls -1 "$dir" 2>/dev/null | grep -E '\.txt$' | sort | head -n -20) )
    for a in "${old[@]}"; do rm -f "$dir/$a" 2>/dev/null; done
    printf '%s' "$f"
}

# _wrapup_show_record last|explain [<window>]
_wrapup_show_record() {
    local mode="$1"; shift
    local w="" a n=0
    for a in "$@"; do
        case "$a" in
            --last|--explain) continue ;;
            -*) die "wrap-up: --$mode is READ-ONLY and takes only an optional <window>; it never runs the hand-off. Drop $(_arg_excerpt "$a"), or drop --$mode to actually wrap up." ;;
            *)  w="$a"; n=$(( n + 1 )) ;;
        esac
    done
    (( n <= 1 )) || die "wrap-up: --$mode is READ-ONLY and takes at most one <window>; it never runs the hand-off. Drop the extra positionals, or drop --$mode to actually wrap up."
    [[ -n "$w" ]] || w=$(_report_tmux_window)
    local dir f
    dir=$(_wrapup_record_dir "$w")
    f="$dir/last"
    if [[ ! -r "$f" ]]; then
        {
            printf 'ng wrap-up --%s: no persisted record for window %s\n' "$mode" "${w:-<none: off-tmux, and no <window> given>}"
            printf '  looked in: %s\n' "$dir"
            printf '  Records are written by every `ng wrap-up` run since your-org/nexus-code#1370;\n'
            printf '  a run that predates it left none. Nothing was re-run.\n'
        } >&2
        return 1
    fi
    cat "$f"
    if ! grep -q '^rc: ' "$f" 2>/dev/null; then
        printf '\n[record: no `rc:` footer — the verb exited before the wrapper could write one\n'
        printf ' (a parse-time refusal or a `die`); the last [stderr] line above is why]\n'
    fi
    if [[ "$mode" == "explain" ]]; then
        printf '\n=== ledger evidence (read-only) ===\n'
        if [[ -n "$w" ]]; then
            local pend key ev
            pend="$STATE_DIR/skeptic/pending"; key=$(wk_encode "$w")
            if [[ -e "$pend/$key" ]]; then
                printf 'pending marker : PRESENT (%s) — this window cannot retire\n' "$pend/$key"
            else
                printf 'pending marker : absent\n'
            fi
            ev=$(_skeptic_verdict_evidence "$pend" "$key" 2>/dev/null) || ev=""
            printf 'skeptic-evidence: %s\n' "${ev:-ledger=absent (no ledger for this window)}"
            printf 'ledger file    : %s\n' "$(_skeptic_ledger_file "$pend" "$key")"
        else
            printf '(no window: nothing to look up)\n'
        fi
    fi
    return 0
}

# Globals for the in-flight record, read by `_wrapup_record_finish` — which
# runs EITHER from the wrapper's normal path OR from an EXIT trap, because a
# `die` inside the verb is a bare `exit` that would otherwise leave the record
# without its footer and the readers without an EOF to drain to.
_WU_REC=""; _WU_FIFO_DIR=""; _WU_P1=""; _WU_P2=""; _WU_SO=""; _WU_SE=""

_wrapup_record_finish() {   # <rc>
    local rc="${1:-0}"
    [[ -n "${_WU_REC:-}" ]] || return 0
    # Restore the caller's streams. On the `exit`-from-inside path this is
    # what CLOSES our write ends of the two FIFOs, so the readers see EOF —
    # without it the `wait` below would deadlock against ourselves.
    if [[ -n "${_WU_SO:-}" && -n "${_WU_SE:-}" ]]; then
        exec 1>&"$_WU_SO" 2>&"$_WU_SE"
        exec {_WU_SO}>&- {_WU_SE}>&-
    fi
    [[ -n "${_WU_P1:-}" ]] && wait "$_WU_P1" 2>/dev/null
    [[ -n "${_WU_P2:-}" ]] && wait "$_WU_P2" 2>/dev/null
    [[ -n "${_WU_FIFO_DIR:-}" ]] && rm -rf "$_WU_FIFO_DIR"
    printf -- '---\nrc: %s\n' "$rc" >> "$_WU_REC" 2>/dev/null
    if (( rc != 0 )); then
        printf 'ng wrap-up: this output is persisted at %s\n' "$_WU_REC" >&2
        printf '  Re-read it with `ng wrap-up --last` (READ-ONLY — arms nothing, posts nothing). Do NOT re-run\n' >&2
        printf '  the verb to see this again: every run re-arms the skeptic step (your-org/nexus-code#1370).\n' >&2
    fi
    _WU_REC=""; _WU_FIFO_DIR=""; _WU_P1=""; _WU_P2=""; _WU_SO=""; _WU_SE=""
    return 0
}

_cmd_wrap_up_recorded() {
    # No _help_check here: it keys the usage arm on FUNCNAME[1], and the arm
    # belongs to cmd_wrap_up, which runs it.
    local _wu_a _wu_mode=""
    for _wu_a in "$@"; do
        case "$_wu_a" in
            --last)    _wu_mode=last ;;
            --explain) _wu_mode=explain ;;
        esac
    done
    if [[ -n "$_wu_mode" ]]; then
        _wrapup_show_record "$_wu_mode" "$@"
        return $?
    fi
    local _wu_rec=""
    _wu_rec=$(_wrapup_record_open "$@") || _wu_rec=""
    if [[ -z "$_wu_rec" ]]; then
        printf 'ng wrap-up: NOTE — could not persist this run'"'"'s output under %s; `--last` will not be able to replay it.\n' "$STATE_DIR/wrap-up-output" >&2
        cmd_wrap_up "$@"
        return $?
    fi
    local _wu_fifo_dir _wu_fo _wu_fe _wu_rc
    _wu_fifo_dir=$(mktemp -d "${TMPDIR:-/tmp}/ng-wrapup-rec.XXXXXX" 2>/dev/null) || _wu_fifo_dir=""
    if [[ -z "$_wu_fifo_dir" ]] || ! mkfifo "$_wu_fifo_dir/o" "$_wu_fifo_dir/e" 2>/dev/null; then
        [[ -n "$_wu_fifo_dir" ]] && rm -rf "$_wu_fifo_dir"
        printf 'ng wrap-up: NOTE — no FIFO for the output record; running unrecorded.\n' >&2
        cmd_wrap_up "$@"
        return $?
    fi
    _wu_fo="$_wu_fifo_dir/o"; _wu_fe="$_wu_fifo_dir/e"
    # Save the caller's streams; the readers below inherit them, and
    # `_wrapup_record_finish` restores them.
    exec {_WU_SO}>&1 {_WU_SE}>&2
    # stdout: verbatim to the caller AND appended to the record.
    tee -a "$_wu_rec" < "$_wu_fo" & _WU_P1=$!
    # stderr: verbatim to the caller; prefixed `[stderr] ` in the record so
    # the two streams stay distinguishable when re-read.
    ( while IFS= read -r _wu_l || [[ -n "$_wu_l" ]]; do
          printf '%s\n' "$_wu_l" >&2
          printf '[stderr] %s\n' "$_wu_l" >> "$_wu_rec"
      done ) < "$_wu_fe" & _WU_P2=$!
    _WU_REC="$_wu_rec"; _WU_FIFO_DIR="$_wu_fifo_dir"
    trap '_wrapup_record_finish "$?"' EXIT
    cmd_wrap_up "$@" > "$_wu_fo" 2> "$_wu_fe"
    _wu_rc=$?
    trap - EXIT
    _wrapup_record_finish "$_wu_rc"
    return "$_wu_rc"
}

# ── wrap-up pre-flights 0e / 0f (your-org/nexus-code#1140, #1459) ───────────
#
# 0e — FAN-OUT COMPLETENESS (#1140). Two skeptics published verdicts computed
# on a PARTIAL subagent fan-out — their results arrived after wrap-up, one
# late arrival invalidated a published finding, and nothing distinguished a
# settled verdict from a provisional one because the artefact looked
# identical. `ng wrap-up` cannot see in-flight subagents directly, but the
# SPAWNED half is measurable from the session transcript: every `Agent` tool
# use is a spawn. So the gate MEASURES spawns and REQUIRES the author to
# declare the returned count in the report frontmatter:
#     fanout: <N> spawned / <M> returned
# Undeclared with N > 0 -> REFUSED (the number to write is printed). Declared
# with a spawned count that disagrees with the transcript -> REFUSED. Declared
# short (M < N) -> the link comment CARRIES the incompleteness. A verdict on a
# partial fan-out is not wrong to publish; it is wrong to publish SILENTLY.
# The returned half is declared, not measured: results arrive as
# task-notifications, teammate messages or files read back, none of which is
# one shape across harness versions — a measured "returned" would be a proxy.
# When the transcript cannot be found (a hand-written report, another home),
# the gate SAYS SO on stderr and does not refuse: "could not look" is not
# "none", and it is not "refuse every wrap-up" either.
_wu_frontmatter_field() {   # <report> <key> -> value (first match), empty if none
    awk -v k="$2" '
        NR == 1 && /^---$/ { fm = 1; next }
        fm && /^---$/      { exit }
        fm && index($0, k ":") == 1 { sub("^" k ":[[:space:]]*", ""); print; exit }
    ' "$1" 2>/dev/null
}
_wu_cc_homes() {
    [[ -n "${NEXUS_CC_HOME:-}" ]]      && printf '%s\n' "$NEXUS_CC_HOME"
    [[ -n "${CLAUDE_CONFIG_DIR:-}" ]] && printf '%s\n' "$CLAUDE_CONFIG_DIR"
    [[ -n "${HOME:-}" ]]              && printf '%s\n' "$HOME/.claude"
    return 0
}
_wu_transcript_for_session() {   # <session-id> -> path; rc 1 when none found
    local sid="$1" home p
    [[ -n "$sid" && "$sid" != unknown ]] || return 1
    while IFS= read -r home; do
        [[ -n "$home" ]] || continue
        for p in "$home"/projects/*/"$sid.jsonl"; do
            [[ -f "$p" ]] || continue     # no nullglob: an unmatched glob is the literal
            printf '%s' "$p"; return 0
        done
    done < <(_wu_cc_homes)
    return 1
}
_wu_fanout_spawned() {   # <transcript> -> N (top-level Agent tool uses); rc 2 = unmeasurable
    command -v python3 >/dev/null 2>&1 || return 2
    python3 - "$1" <<'PY'
import json, sys
n = 0
try:
    with open(sys.argv[1], encoding='utf-8', errors='replace') as fh:
        for line in fh:
            try:
                o = json.loads(line)
            except Exception:
                continue
            if o.get('type') != 'assistant' or o.get('isSidechain'):
                continue
            c = (o.get('message') or {}).get('content')
            if not isinstance(c, list):
                continue
            for b in c:
                if isinstance(b, dict) and b.get('type') == 'tool_use' and b.get('name') in ('Agent', 'Task'):
                    n += 1
except OSError:
    sys.exit(2)
print(n)
PY
}
_WU_FANOUT_LINE=""
_wu_fanout_preflight() {   # <report> ; sets _WU_FANOUT_LINE; rc 1 = refuse
    local report="$1" sid transcript spawned declared d_spawned d_returned
    _WU_FANOUT_LINE=""
    sid=$(_wu_frontmatter_field "$report" session-id | tr -d ' \t')
    declared=$(_wu_frontmatter_field "$report" fanout)
    if ! transcript=$(_wu_transcript_for_session "$sid"); then
        printf 'ng wrap-up: fan-out (your-org/nexus-code#1140): could not look — no transcript for session-id %s under %s; the spawned count is UNMEASURED, not zero.\n' \
            "${sid:-<none>}" "$(_wu_cc_homes | tr '\n' ' ')" >&2
        return 0
    fi
    spawned=$(_wu_fanout_spawned "$transcript") || {
        printf 'ng wrap-up: fan-out (your-org/nexus-code#1140): could not look — python3 unavailable or transcript unreadable (%s); the spawned count is UNMEASURED, not zero.\n' "$transcript" >&2
        return 0
    }
    [[ "$spawned" =~ ^[0-9]+$ ]] || spawned=0
    if [[ -n "$declared" ]]; then
        if [[ "$declared" =~ ^([0-9]+)[[:space:]]+spawned[[:space:]]*/[[:space:]]*([0-9]+)[[:space:]]+returned$ ]]; then
            d_spawned="${BASH_REMATCH[1]}"; d_returned="${BASH_REMATCH[2]}"
        else
            printf 'ng wrap-up: REFUSED — `fanout:` is malformed (%s); write `fanout: %s spawned / <returned> returned` (your-org/nexus-code#1140).\n' \
                "$declared" "$spawned" >&2
            return 1
        fi
        if (( d_spawned != spawned )); then
            printf 'ng wrap-up: REFUSED — `fanout:` declares %s spawned but the session transcript records %s `Agent` tool use(s) (%s). Fix the declaration to `%s spawned / <returned> returned` (your-org/nexus-code#1140).\n' \
                "$d_spawned" "$spawned" "$transcript" "$spawned" >&2
            return 1
        fi
        if (( d_returned < d_spawned )); then
            _WU_FANOUT_LINE="Fan-out INCOMPLETE at wrap-up: ${d_returned} of ${d_spawned} subagents had returned — this verdict rests on a partial evidence set and may be superseded (your-org/nexus-code#1140)."
            printf 'ng wrap-up: fan-out INCOMPLETE (%s of %s returned) — stated in the link comment, not silently (your-org/nexus-code#1140).\n' \
                "$d_returned" "$d_spawned" >&2
        elif (( d_returned > d_spawned )); then
            printf 'ng wrap-up: REFUSED — `fanout:` declares more returned (%s) than spawned (%s) (your-org/nexus-code#1140).\n' "$d_returned" "$d_spawned" >&2
            return 1
        fi
        return 0
    fi
    if (( spawned > 0 )); then
        printf 'ng wrap-up: REFUSED — this session spawned %s subagent(s) (`Agent` tool uses in %s) and the report declares no `fanout:`. Add to the frontmatter:\n' \
            "$spawned" "$transcript" >&2
        printf '    fanout: %s spawned / <returned> returned\n' "$spawned" >&2
        printf '  where <returned> is how many delivered a result this report USES. A verdict on a partial fan-out is not wrong to publish; it is wrong to publish silently (your-org/nexus-code#1140).\n' >&2
        return 1
    fi
    return 0
}
#
# 0f — GUARDS-FOR-DIFF vs THE REPORT (#1459). A report lists the guards it
# ran; that list is derived by hand, and an under-derived affected set exits
# green and silent. `ng guards-for-diff` is the mechanical derivation and was
# run by nobody at wrap-up time. This runs the SELECTOR and names each
# selected guard the report never mentions — advisory by default,
# `--strict-guards` refuses. It is EXPENSIVE (the selector asks every
# declaring guard for its population; ~80 s measured), so it runs on its own
# only for a wrap-up that describes nexus-code work: cwd inside a repository
# carrying monitor/guards-for-diff.sh AND the report under the primary's
# reports corpus. Test harnesses drive wrap-up on fixture reports elsewhere
# and never pay it; `--guards` forces it, `--no-guards-preflight` /
# NG_WRAPUP_GUARDS_PREFLIGHT=0 skip it.
_wu_guards_applicable() {   # <report> -> rc 0 iff the automatic arm applies
    local top corpus rp
    top=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
    [[ -f "$top/monitor/guards-for-diff.sh" ]] || return 1
    corpus=$(_report_reports_dir 2>/dev/null) || return 1
    [[ -n "$corpus" ]] || return 1
    rp=$(realpath -m "$1" 2>/dev/null) || rp="$1"
    corpus=$(realpath -m "$corpus" 2>/dev/null) || true
    [[ "$rp" == "$corpus"/* ]]
}
_wu_guards_preflight() {   # <report> <strict:0|1> ; rc 1 only when strict and something is unreported
    local report="$1" strict="${2:-0}" top bin selected rc line suite base missing=0 n_sel=0
    top=$(git rev-parse --show-toplevel 2>/dev/null) || top="."
    bin="${NG_GUARDS_FOR_DIFF_BIN:-$top/monitor/guards-for-diff.sh}"
    [[ -f "$bin" ]] || { printf 'ng wrap-up: guards pre-flight (your-org/nexus-code#1459): %s not found — skipped, NOT clear.\n' "$bin" >&2; return 0; }
    selected=$(timeout "${NG_WRAPUP_GUARDS_TIMEOUT:-600}" bash "$bin" --quiet 2>/dev/null); rc=$?
    case "$rc" in
        0) ;;
        3) printf 'ng wrap-up: guards pre-flight (your-org/nexus-code#1459): no registered guard reads this diff (exit 3) — a measured answer, NOT a clearance (#1078).\n' >&2; return 0 ;;
        2) printf 'ng wrap-up: guards pre-flight (your-org/nexus-code#1459): guards-for-diff REFUSED (exit 2) — a population probe errored; nothing here is clear.\n' >&2; return 0 ;;
        124|137) printf 'ng wrap-up: guards pre-flight (your-org/nexus-code#1459): the selector did not finish within %ss — UNMEASURED, not clear.\n' "${NG_WRAPUP_GUARDS_TIMEOUT:-600}" >&2; return 0 ;;
        *) printf 'ng wrap-up: guards pre-flight (your-org/nexus-code#1459): selector exit %s — UNMEASURED, not clear.\n' "$rc" >&2; return 0 ;;
    esac
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        suite="${line#bash }"; base="${suite##*/}"
        n_sel=$(( n_sel + 1 ))
        if ! grep -qF -- "$base" "$report"; then
            (( missing == 0 )) && printf 'ng wrap-up: guards pre-flight (your-org/nexus-code#1459) — SELECTED BUT NOT REPORTED (guards-for-diff selected them for this diff; the report never names them):\n' >&2
            printf '    %s\n' "$suite" >&2
            missing=$(( missing + 1 ))
        fi
    done <<<"$selected"
    # The index's own blind spot, stated beside the answer (#1078): a suite
    # that declares no population is invisible to the selector.
    local n_tracked n_declaring
    n_tracked=$(git -C "$top" ls-files 2>/dev/null | grep -cE '(^|/)test-[^/]*\.sh$')
    n_declaring=$(grep -cvE '^(#|$)' "$top/monitor/watcher/guard-populations.manifest" 2>/dev/null || echo '?')
    printf 'ng wrap-up: guards pre-flight: %s selected, %s unreported; %s of %s tracked suites declare no population and are INVISIBLE to this pre-flight (your-org/nexus-code#1078) — its green is never "every guard that matters ran".\n' \
        "$n_sel" "$missing" "$(( n_tracked - ${n_declaring/\?/0} ))" "$n_tracked" >&2
    if (( missing > 0 && strict == 1 )); then
        printf 'ng wrap-up: REFUSED under --strict-guards — name the selected guards above in the report (what each returned), or run them and report.\n' >&2
        return 1
    fi
    return 0
}


cmd_wrap_up() {
    _help_check "$@"
    # `--reply-to` changes the POSITIONAL ARITY (the issue becomes optional),
    # so pre-scan for it before binding positionals. Everything below the
    # `channel_mode == 0` branches is the untouched pre-flag code path.
    local reply_to="" _scan_i
    local -a _scan=("$@")
    for (( _scan_i = 0; _scan_i < ${#_scan[@]}; _scan_i++ )); do
        case "${_scan[_scan_i]}" in
            --reply-to)   reply_to="${_scan[_scan_i+1]:-}"; break ;;
            --reply-to=*) reply_to="${_scan[_scan_i]#--reply-to=}"; break ;;
        esac
    done
    local channel_mode=0
    [[ -n "$reply_to" ]] && channel_mode=1

    # your-org/nexus-code#906 C / F1. Positionals are collected INSIDE the
    # loop in BOTH modes now. Default mode used to pre-bind them —
    # `issue="${1:-}"; report_path="${2:-}"` before the loop ran — which is
    # the same shape as the fifteen verbs converted alongside this one, so
    # `ng wrap-up --repo <r> <issue> <report>` bound `--repo` to the issue
    # and then reported the ISSUE NUMBER as an unknown flag.
    #
    # This is the highest-traffic hand-off verb on the board — the worker
    # floor instructs every worker to run it — so it is the last verb that
    # should have been left out. Channel mode already collected positionals
    # in the loop; the fix is to stop treating that as the special case.
    local issue="" report_path=""
    local -a positionals=()
    local answer_file="" issue_flag=""
    local trigger_comment="" repo_arg="" trigger_repo_arg="" body_file="" no_comment=0 allow_stub=0
    local guards_mode="" guards_strict=0
    local retain_reason="" no_retain=0
    # Skeptic-protocol flags (skills/nexus.skeptic). All optional and
    # backward-compatible: a wrap-up with none of these falls back to
    # the worker's spawn-stamped mode (provenance record) or `auto`.
    local sk_decision="" sk_rationale="" sk_waive="" sk_contradicted="" sk_rearm=""
    local sk_role=0 sk_verdict="" sk_target="" sk_depth="" sk_findings="" sk_orig=""
    local sk_satisfied=0 sk_satisfied_by=""
    local sk_subject=""
    local sk_not_verdict=""
    _argloop_prev_12=-1; while (( $# > 0 )); do (( $# != _argloop_prev_12 )) || _argloop_stuck "$1"; _argloop_prev_12=$#
        case "$1" in
            --trigger-comment)  _need_val --trigger-comment "$#" "${2:-}"; trigger_comment="$2";   shift 2 ;;
            --repo)             _need_val --repo "$#" "${2:-}"; repo_arg="$2";          shift 2 ;;
            --trigger-repo)     _need_val --trigger-repo "$#" "${2:-}"; trigger_repo_arg="$2";  shift 2 ;;
            --comment-body-file) _need_val --comment-body-file "$#" "${2:-}"; body_file="$2";        shift 2 ;;
            --no-comment)       no_comment=1;               shift   ;;
            --allow-stub)       allow_stub=1;               shift   ;;
            --guards)            guards_mode=force;          shift   ;;
            --no-guards-preflight) guards_mode=skip;         shift   ;;
            --strict-guards)     guards_strict=1;            shift   ;;
            --retain)           _need_val --retain "$#" "${2:-}"; retain_reason="$2";     shift 2 ;;
            --no-retain)        no_retain=1;                shift   ;;
            --skeptic-decision)  _need_val --skeptic-decision "$#" "${2:-}"; sk_decision="$2";      shift 2 ;;
            --skeptic-rationale) _need_val --skeptic-rationale "$#" "${2:-}"; sk_rationale="$2";     shift 2 ;;
            --skeptic-waive)     _need_val --skeptic-waive "$#" "${2:-}"; sk_waive="$2";         shift 2 ;;
            # `--skeptic-satisfied --skeptic-satisfied-by <report-path|sha256>`:
            # the required validation HAPPENED, and this is the artefact whose
            # verdict discharges it (your-org/nexus-code#1132). Distinct from
            # `--skeptic-waive`, which records that the requirement was SET
            # ASIDE. Unlike a waiver this is CHECKED against the ledger, which
            # is exactly why it is not gated on the caller's role.
            --skeptic-satisfied)    sk_satisfied=1;             shift   ;;
            --skeptic-satisfied-by) _need_val --skeptic-satisfied-by "$#" "${2:-}"; sk_satisfied_by="$2"; shift 2 ;;
            # --skeptic-contradicted "<what/why>": the worker overrode one or
            # more of a prior skeptic's suggestions. Flags the filed
            # spawn-skeptic request `deliberate=true` so the orchestrator
            # arbitrates rather than rubber-stamps (your-org/nexus-code#545).
            --skeptic-contradicted) _need_val --skeptic-contradicted "$#" "${2:-}"; sk_contradicted="$2"; shift 2 ;;
            --skeptic-delta) _need_val --skeptic-delta "$#" "${2:-}"; _SK_SPAWN_DELTA="$2"; shift 2 ;;
            # --skeptic-rearm "<what changed>": deliberately re-establish a
            # require-gate that an orchestrator already RESOLVED
            # (your-org/nexus-code#815). Without it, a `require` wrap-up whose
            # marker carries a recorded resolution declines to re-arm rather
            # than silently reversing the orchestrator's decision.
            --skeptic-rearm)     _need_val --skeptic-rearm "$#" "${2:-}"; sk_rearm="$2";          shift 2 ;;
            --skeptic-role)      sk_role=1;                 shift   ;;
            --skeptic-verdict)   _need_val --skeptic-verdict "$#" "${2:-}"; sk_verdict="$2";       shift 2 ;;
            --skeptic-target)    _need_val --skeptic-target "$#" "${2:-}"; sk_target="$2";        shift 2 ;;
            --skeptic-depth)     _need_val --skeptic-depth "$#" "${2:-}"; sk_depth="$2";         shift 2 ;;
            --skeptic-findings)  _need_val --skeptic-findings "$#" "${2:-}"; sk_findings="$2";      shift 2 ;;
            --skeptic-orig)      _need_val --skeptic-orig "$#" "${2:-}"; sk_orig="$2";          shift 2 ;;
            # --skeptic-subject <report-path|sha256>: THE REVIEWER SAYS WHAT IT
            # READ (your-org/nexus-code#963's remaining half).
            #
            # Every other identifier on this path is a SPAWN-TIME STAMP —
            # `skeptic_target` in the window record, fixed for the life of the
            # window — so a retained reviewer re-tasked by paste files its
            # verdict under whatever it was originally spawned for. `sk930`
            # filed 12 verdicts across four issues and every one recorded
            # `target-window=procsafe`; downstream, an independent clearance and
            # a misfiled one are byte-identical.
            #
            # A stamp cannot be repaired by a better stamp. The only thing that
            # can say which artefact a verdict is ABOUT is the reviewer, and
            # this is where it says so — the one field on this path that is an
            # ASSERTION rather than an inference.
            --skeptic-subject)   _need_val --skeptic-subject "$#" "${2:-}"; sk_subject="$2";       shift 2 ;;
            # --not-a-skeptic-verdict "<why>": this window's PROVENANCE says
            # skeptic_role, but this wrap-up is ordinary worker work, not a
            # verdict (your-org/nexus-code#879). Takes the producer path and
            # records the reason; clears no skeptic marker.
            # Arrived on `dev` while this branch was open, i.e. AFTER the arms
            # around it were guarded — a new member of the very class Test 17e
            # closes, added by a PR that could not have seen the lint. `_need_val`
            # here is what keeps the class shut across the merge seam; the lint
            # is what would have caught it had it not been.
            --not-a-skeptic-verdict) _need_val --not-a-skeptic-verdict "$#" "${2:-}"; sk_not_verdict="$2"; shift 2 ;;
            # Channel-delivery flags (your-org/nexus-code remote-reply).
            # --reply-to was already read by the pre-scan; consume it here
            # so it doesn't fall through to the unknown-flag arm.
            --reply-to)          _need_val --reply-to "$#" "${2:-}"; reply_to="$2";         shift 2 ;;
            --reply-to=*)        reply_to="${1#--reply-to=}"; shift ;;
            --issue)             _need_val --issue "$#" "${2:-}"; issue_flag="$2";       shift 2 ;;
            --answer-file)       _need_val --answer-file "$#" "${2:-}"; answer_file="$2";      shift 2 ;;
            -*) die "unknown flag: $(_arg_excerpt "$1")" ;;
            # Positionals trail, lead, or interleave with the flags in EITHER
            # mode (#906 C / F1). The `-*)` arm above still rejects an
            # unknown FLAG; anything reaching here is a positional by
            # elimination, because every flag arm consumes its own value.
            *) positionals+=("$1"); shift ;;
        esac
    done
    if (( channel_mode == 0 )); then
        # Default mode: exactly <issue> <report-path>, in that order, wherever
        # they sit relative to the flags (#906 C / F1). The arity check is the
        # one that used to run before the loop.
        case "${#positionals[@]}" in
            2) issue="${positionals[0]}"; report_path="${positionals[1]}" ;;
            0|1) die "usage: ng wrap-up <issue> <report-path> [--trigger-comment <id>] [--repo <owner/name>] [--trigger-repo <owner/name>]" ;;
            *) die "wrap-up: too many positional arguments (expected <issue> <report-path>, got ${#positionals[@]})" ;;
        esac
        # The channel-only flags are inert without --reply-to. Refuse rather
        # than accept-and-ignore, so a mistyped dispatch fails at the caller.
        [[ -z "$issue_flag" ]] \
            || die "wrap-up: --issue is only valid with --reply-to (in the default form the issue is the first positional)"
        [[ -z "$answer_file" ]] \
            || die "wrap-up: --answer-file is only valid with --reply-to (it supplies the CHANNEL reply body)"
    else
        # <report-path> is the only required positional; a second one is the
        # legacy `<issue> <report>` shape, accepted for symmetry.
        case "${#positionals[@]}" in
            0) die "usage: ng wrap-up --reply-to <request-id> <report-path> [--issue <n>] [--answer-file <path>] [--repo <owner/name>]" ;;
            1) report_path="${positionals[0]}"; issue="$issue_flag" ;;
            2) [[ -z "$issue_flag" ]] || die "wrap-up: issue given twice (--issue <n> AND a leading positional)"
               issue="${positionals[0]}"; report_path="${positionals[1]}" ;;
            *) die "wrap-up: too many positional arguments in --reply-to mode (expected <report-path>, optionally preceded by <issue>)" ;;
        esac
        [[ "$reply_to" =~ ^[A-Za-z0-9_-]+$ ]] \
            || die "wrap-up: --reply-to must be a request id matching [A-Za-z0-9_-]+, got: $reply_to"
        [[ -z "$issue" || "$issue" =~ ^[0-9]+$ ]] \
            || die "wrap-up: --issue must be a positive integer, got: $issue"
        if [[ -n "$answer_file" && ! -f "$answer_file" ]]; then
            die "wrap-up: --answer-file not found: $answer_file"
        fi
        # Channel-ONLY mode creates NO GitHub artifact — that is the whole
        # point, and the invariant the tests pin. A trigger comment to rocket
        # implies an issue thread; refuse rather than quietly reaching out.
        if [[ -z "$issue" ]]; then
            [[ -z "$trigger_comment" ]] \
                || die "wrap-up: --trigger-comment needs a GitHub thread; pass --issue <n> too, or drop it (channel-only wrap-up posts nothing to GitHub)"
            [[ -z "$body_file" ]] \
                || die "wrap-up: --comment-body-file needs a GitHub thread; pass --issue <n> too"
        fi
    fi
    if (( no_retain == 1 )) && [[ -n "$retain_reason" ]]; then
        die "wrap-up: --no-retain and --retain are mutually exclusive"
    fi
    # Numeric-flag validation, hoisted to PARSE TIME (#601). The same
    # check exists inside _wrapup_skeptic_step (which the unit suite
    # drives directly), but by the time that runs the wrap-up has
    # already uploaded the report and posted the comment — so a
    # rejected value would strand a half-completed hand-off. Failing
    # here costs the caller nothing but a re-run with the right value.
    bk_require_int --skeptic-findings "$sk_findings" --allow-empty || die "wrap-up: $BK_ERR"
    bk_require_int --skeptic-depth    "$sk_depth"    --allow-empty || die "wrap-up: $BK_ERR"
    # your-org/nexus-code#879 — CONTRADICTIONS, refused at parse time rather
    # than silently resolved by precedence. "This is not a verdict" and
    # either "I am a skeptic reporting" or "here is my verdict" cannot both
    # be true, and a caller that types both has a wrong belief about which
    # hand-off it is performing. Hoisted here for the #601 reason: refusing
    # after the upload + comment would strand a half-completed hand-off.
    if [[ -n "$sk_not_verdict" ]]; then
        (( sk_role == 0 )) \
            || die "wrap-up: --not-a-skeptic-verdict contradicts --skeptic-role (one says this wrap-up IS a skeptic verdict, the other says it is not). Pass exactly one."
        [[ -z "$sk_verdict" ]] \
            || die "wrap-up: --not-a-skeptic-verdict contradicts --skeptic-verdict '$sk_verdict' (you supplied a verdict and declared this is not one). Pass exactly one."
    fi
    [[ -f "$report_path" ]] || die "wrap-up: report not found: $report_path"
    # A report cited from OUTSIDE the corpus still uploads fine (the GitHub link
    # works), but it is invisible to every corpus reader — skeptic
    # verdict-detection, `ng wrap-up-check`, `spawn-worker -r` resume discovery.
    # This is the last point at which the #577 mistake is catchable: report-init
    # is now corpus-pinned, but a worker can still hand-write a report or cite an
    # older one inside its own clone. WARN, never refuse: a completed hand-off is
    # worth more than a blocked one, and the fix (copy into the corpus) is one
    # command that the message spells out.
    local _wu_corpus _wu_rp_dir
    _wu_corpus=$(_report_corpus_dir)
    if [[ -n "$_wu_corpus" ]]; then
        _wu_rp_dir=$(cd "$(dirname "$report_path")" 2>/dev/null && pwd -P) || _wu_rp_dir=""
        if [[ -n "$_wu_rp_dir" && "$_wu_rp_dir" != "$(cd "$_wu_corpus" 2>/dev/null && pwd -P)" ]]; then
            cat >&2 <<EOF
ng wrap-up: WARNING — the cited report is OUTSIDE the reports corpus.
  report: $report_path
  corpus: $_wu_corpus
  The upload and link comment will succeed, but this report is invisible to
  skeptic verdict-detection, \`ng wrap-up-check\` and resume discovery
  (your-org/nexus-code#577). Copy it into the corpus:
      cp $report_path $_wu_corpus/
EOF
        fi
    fi
    # --no-comment and --comment-body-file are mutually exclusive: one
    # asks to skip step 2 entirely, the other supplies a custom body
    # for it. Trying both is a config error, not a "do the safer of
    # the two" — fail loud.
    if (( no_comment == 1 )) && [[ -n "$body_file" ]]; then
        die "wrap-up: --no-comment and --comment-body-file are mutually exclusive"
    fi
    if [[ -n "$body_file" && ! -f "$body_file" ]]; then
        die "wrap-up: --comment-body-file not found: $body_file"
    fi

    local target trigger_target basename
    # Channel-ONLY mode never touches GitHub, so a missing/ambiguous repo
    # config must not block the hand-off — the repo is only carried through
    # as a log/skeptic-provenance label there. Every mode that DOES post
    # keeps the strict resolve-or-exit contract.
    if (( channel_mode == 1 )) && [[ -z "$issue" ]]; then
        target=$(_resolve_repo write "$repo_arg" 2>/dev/null) || target=""
    else
        target=$(_resolve_repo write "$repo_arg") || exit $?
    fi
    # Rocket-react target. Defaults to `target` (back-compat: when
    # the trigger lives in the same repo as the issue thread, the
    # caller doesn't need to pass --trigger-repo). An explicit value
    # goes through _resolve_repo write so the strict-mode validation
    # applies to it too — same leak-prevention as the issue target.
    if [[ -n "$trigger_repo_arg" ]]; then
        trigger_target=$(_resolve_repo write "$trigger_repo_arg") || exit $?
    else
        trigger_target="$target"
    fi
    basename=$(basename -- "$report_path")

    # Per-step outcomes. ok | failed | skipped.
    local upload_st=failed comment_st=skipped rocket_st=skipped log_st=failed
    # your-org/nexus-code#1114: the teaser the composer REFUSED to publish,
    # carried out so the diagnostic can quote the exact bytes back at the
    # author. Naming what it would have posted is what makes the refusal
    # actionable rather than merely obstructive.
    local degenerate_teaser=""
    local asset_url="" comment_url="" failure_detail=""
    # Channel delivery (Step 2c). `skipped` unless --reply-to is in play.
    local channel_st=skipped channel_path=""
    # No issue ⇒ no GitHub surface at all: the upload has nothing to attach
    # to and the comment has nowhere to land. Mark them skipped up front so
    # the aggregate exit-code check below (which only flips on `failed`)
    # reads the channel-only run as a clean success.
    if [[ -z "$issue" ]]; then
        upload_st=skipped
    fi

    # Temp file for per-step stderr capture. RETURN trap cleans it up.
    local err_buf
    err_buf=$(mktemp)
    trap "rm -f '$err_buf'" RETURN

    # Step 0: pre-flight report-check. Refuse to ship a stub asset
    # URL into the issue thread — fix the report first. --allow-stub
    # forwards --allow-todo so the worker can wrap an intentional
    # in-progress checkpoint (rare; the verb's defaults are strict).
    : > "$err_buf"
    local -a check_args=("$report_path")
    (( allow_stub == 1 )) && check_args+=(--allow-todo)
    # your-org/nexus-code#1363 — this wrap-up SETTLES the gate (an operator
    # waive, or a checked `--skeptic-satisfied`), so a `no-further-pass` in
    # the report is not a contradiction of a marker this run is about to
    # release. Every other wrap-up gets the check.
    if [[ -n "$sk_waive" ]] || (( sk_satisfied == 1 )); then
        check_args+=(--skeptic-gate-settling)
    fi
    if ! ( cmd_report_check "${check_args[@]}" ) >/dev/null 2>"$err_buf"; then
        {
            printf 'ng wrap-up: report-check failed — fix the report before wrapping up.\n'
            printf 'Pass --allow-stub to override for an intentional checkpoint.\n'
            cat "$err_buf"
        } >&2
        return 1
    fi

    # #1095 item 2 — THE ADVISORY LIVES HERE, not in `cmd_report_check`.
    #
    # It has to be visible somewhere: `report-init` now emits `disposition:
    # TODO`, but that half cannot reach a hand-written report. It must NOT be
    # visible in `report-check`, whose #684 contract is that an ABSENT field
    # is not an authoring error (see the block there). `wrap-up` is the one
    # place both hold: it is where #1095's refusal bites, and the author is
    # still present to fix it in one line.
    #
    # NOT inside the pre-flight subshell above — that one discards stderr on
    # success (`>/dev/null 2>"$err_buf"`, printed only on failure), so an
    # advisory emitted there would be swallowed on exactly the runs that need
    # it. Emitted on wrap-up's OWN stderr instead.
    #
    # Uses `_skeptic_stated_disposition`, the single scanner, rather than a
    # second grep: that function scans a TRANSFORMED file (fences skipped,
    # code spans and indented code rejected) and a raw grep diverges from it.
    local _wu_disp_state
    _wu_disp_state=$(_skeptic_stated_disposition "$report_path" 2>/dev/null | awk '{print $1}')
    if [[ "$_wu_disp_state" == "absent" ]]; then
        {
            printf 'ng wrap-up: ADVISORY: %s carries no frontmatter `disposition:` field.\n' "$(basename "$report_path")"
            printf '  Not a failure here. But `ng wrap-up` REFUSES a hand-off that REQUIRES a\n'
            printf '  skeptic while the report states no disposition (your-org/nexus-code#1095),\n'
            printf '  because the request it would file derives its whole recommendation from\n'
            printf '  that absence. One line, at column 0 in the frontmatter:\n'
            printf '      disposition: no-further-pass    |    disposition: second-pass\n'
            printf '  Set MONITOR_REPORT_REQUIRE_DISPOSITION=1 to make `report-check` refuse.\n'
        } >&2
    fi

    # Source tmux window. Captured so the watcher's idle classifier can
    # match wrap-up events ↔ windows directly instead of via the
    # report-basename heuristic (issue #109). Empty when wrap-up is
    # invoked outside tmux (orchestrator-side direct call). Shares
    # `_report_tmux_window` with `report-init` so both surfaces target by
    # $TMUX_PANE — without -t, display-message returns the active window
    # of the session, NOT the calling pane's window. Resolved HERE (before
    # the GitHub hand-off) so the skeptic gate can run first.
    local source_window
    source_window=$(_report_tmux_window)

    # Step 0c (your-org/nexus-code#1181): unsettled async waits. BEFORE Step
    # 0b, because 0b ARMS; a refusal here must leave nothing behind.
    _wrapup_async_preflight "$source_window" || return 1

    # Step 0d (your-org/nexus-code#1363): `disposition: no-further-pass` against
    # a live or about-to-be-armed skeptic gate. `report-check` (Step 0) already
    # compared the frontmatter against the MARKER and the spawn stamp, keyed on
    # the report's own `window:` field; this repeats it keyed on the INVOKING
    # window and adds the one input only this invocation knows —
    # `--skeptic-decision require`. Skipped when this wrap-up is itself the
    # SETTLEMENT of the gate (`--skeptic-waive`, `--skeptic-satisfied`), for
    # the reason report-check was told to skip it above.
    if [[ -z "$sk_waive" ]] && (( sk_satisfied == 0 )); then
        local _wu_conflict
        if ! _wu_conflict=$(_disposition_gate_conflict "$report_path" "$source_window"                                 "$sk_decision" "$sk_role" "$sk_not_verdict"); then
            {
                printf 'ng wrap-up: REFUSED — the report states `disposition: no-further-pass`, and a skeptic
'
                printf '  pass is REQUIRED or PENDING for this window (your-org/nexus-code#1363):
'
                printf '%s
' "$_wu_conflict" | sed 's/^/    - /'
                printf '  `retire-preflight.sh` reads that field as its FIRST gate, and `no-further-pass` is the
'
                printf '  permissive value — so the contradiction can only ever make retirement EASIER than
'
                printf '  the marker says it should be. State `disposition: second-pass` (a skeptic pass is
'
                printf '  owed and you agree), or — if the pass HAPPENED — settle it with the exact command named
'
                printf '  above; do NOT re-run a settlement that already succeeded. Nothing was published, no marker
'
                printf '  was touched, and no spawn-skeptic request was filed.
'
            } >&2
            return 1
        fi
    fi

    # Step 0b (skeptic protocol, skills/nexus.skeptic): run the skeptic
    # decision/enforcement BEFORE the external GitHub hand-off. A wrap-up
    # that the skeptic step REFUSES (an undecided `auto` worker under
    # enforce, a `require` worker trying to `--skeptic-decision deny`, a
    # worker-context waive, a malformed skeptic-role verdict) must NOT
    # have already announced "done" on the issue thread or rocketed the
    # trigger — and crucially must NOT double-post on the worker's retry.
    # Running it first makes the gate honest with the protocol's own claim
    # ("not complete until a skeptic returns"): on refusal we return early,
    # before any upload/comment/rocket/log. On the require/auto-require
    # path it sets the pending marker and prints the await-loop guidance,
    # then the hand-off proceeds normally (the report IS what the skeptic
    # reads; posting it is correct, and the retire gate still blocks the
    # window until a verdict lands).
    #
    # It ALSO signals — via the _SK_SPAWN_* globals — whether a
    # `kind=spawn-skeptic` request should be FILED into the watcher-mediated
    # request inbox so the orchestrator gets a push signal to spawn the
    # skeptic (your-org/nexus-code#545). The request is filed LATER, after
    # Step 2 posts the link comment, so it can carry the asset + comment
    # URLs — see the "Step 2b" block below. Reset the globals first so a
    # non-require path (deny/waive/role-terminal) leaves nothing to file.
    # Step 0d2 (your-org/nexus-code#1491): DOES THE COMMENT TARGET CONTAIN THIS
    # ISSUE? Asked HERE, before anything mutates, because of what happened when
    # it was not asked at all.
    #
    # A wrap-up passed `--repo <asset-repo>`. That flag selects the
    # ISSUE-THREAD target (`--trigger-repo` is the separate knob), so the
    # routing behaved exactly as specified — the caller's expectation that
    # `--repo` chose the UPLOAD destination was the wrong half. The issue lived
    # on a different repo, the comment POST 404'd, and the run had already
    # released the skeptic marker in Step 0b and went on to write a ledger
    # entry. The hand-off never reached the thread; the marker that exists to
    # say "a review is owed" was gone.
    #
    # THE COMPANION RULE THIS RESTORES: order any two-part operation so the
    # failure mode is the OBSERVABLE one (#1050). Step 0b arms and releases, so
    # a target this run can already prove wrong must stop it BEFORE 0b runs —
    # not after, where the only remedy is compensation.
    #
    # THREE-VALUED, and only a POSITIVE 404 refuses. A network failure, a rate
    # limit, an auth problem or a missing `gh` are all "could not look", and a
    # probe that could not look must not block a hand-off it has no finding
    # against: it warns and proceeds, and the existing post-failure path still
    # reports a failed comment and exits 1. The refusing arm is cheap to be
    # right about — the issue is absent from that repo, and no retry changes it.
    if [[ -n "$issue" && -n "$target" ]] && (( no_comment == 0 )); then
        local _tp_out _tp_rc=0
        _tp_out=$(api -X GET "/repos/$target/issues/$issue" --jq '.number' 2>&1) || _tp_rc=$?
        if (( _tp_rc != 0 )) && [[ "$_tp_out" == *"Not Found"* || "$_tp_out" == *"HTTP 404"* ]]; then
            {
                printf 'ng wrap-up: REFUSED — issue #%s does not exist on `%s`, which is where this\n' "$issue" "$target"
                printf '  wrap-up would post its link comment. Nothing was published, NO MARKER WAS\n'
                printf '  TOUCHED, no request was filed and nothing was logged.\n'
                printf '  `--repo` selects the ISSUE-THREAD target. It does NOT select the upload\n'
                printf '  destination (the report always uploads to the configured asset repo) and it\n'
                printf '  does NOT select the trigger — that is `--trigger-repo`. If the issue lives\n'
                printf '  elsewhere, name that repo:\n'
                printf '      ng wrap-up %s <report> --repo <owner>/<repo-that-has-the-issue>\n' "$issue"
                printf '  This check exists because the 404 used to be discovered AFTER the skeptic\n'
                printf '  marker had been released and the ledger written — every visible artefact\n'
                printf '  said the hand-off happened and the thread was never told\n'
                printf '  (your-org/nexus-code#1491).\n'
            } >&2
            return 1
        fi
        if (( _tp_rc != 0 )); then
            printf 'ng wrap-up: WARNING — could not verify that issue #%s exists on `%s` (%s).\n' \
                "$issue" "$target" "$(printf '%s' "$_tp_out" | tr '\n' ' ' | cut -c1-160)" >&2
            printf '  That is a failure to LOOK, not a finding, so the hand-off proceeds. If the\n' >&2
            printf '  comment then fails, this line is why the pre-flight did not catch it.\n' >&2
        fi
    fi

    # Step 0e (your-org/nexus-code#1140): fan-out completeness — see the
    # helper block above cmd_wrap_up. Refuses an undeclared fan-out; carries a
    # declared-short one into the link comment.
    _wu_fanout_preflight "$report_path" || return 1

    # Step 0f (your-org/nexus-code#1459): guards-for-diff against the report.
    if [[ "$guards_mode" != skip && "${NG_WRAPUP_GUARDS_PREFLIGHT:-1}" != 0 ]]; then
        if [[ "$guards_mode" == force ]] || _wu_guards_applicable "$report_path"; then
            _wu_guards_preflight "$report_path" "$guards_strict" || return 1
        fi
    fi

    _SK_SPAWN_REQ=0
    _SK_SPAWN_TARGET=""; _SK_SPAWN_DEPTH=""; _SK_SPAWN_ORIG=""
    _SK_PINNED_NOTIFIED=""; _SK_PINNED_WHY=""   # #1182 — the delivery receipt
    _SK_SPAWN_MODE=""; _SK_SPAWN_EFFECTIVE=""
    _SK_SPAWN_DELIBERATE=0; _SK_SPAWN_REASONS=""; _SK_SPAWN_CONTRADICTED=""
    # The report under hand-off, so the role path can read the skeptic's
    # own STATED disposition and compare it against the count-derived
    # recommendation (your-org/nexus-code#599). Passed as a global rather
    # than a 14th positional to keep the existing call shape — and the
    # unit suite's direct calls to _wrapup_skeptic_step — intact; the
    # reader treats an unset/absent path as "states no disposition".
    _SK_REPORT_PATH="$report_path"
    # The reviewer's ASSERTED subject (your-org/nexus-code#963). A global for
    # the same reason `_SK_REPORT_PATH` is one: the unit suites drive
    # `_wrapup_skeptic_step` with 11-to-15 positionals and a 16th would break
    # every one of them. Unset means "the reviewer asserted nothing", which is
    # the pre-flag behaviour exactly.
    _SK_SUBJECT_ARG="$sk_subject"
    _wrapup_skeptic_step \
        "$issue" "$source_window" "$target" \
        "$sk_role" "$sk_decision" "$sk_rationale" "$sk_waive" \
        "$sk_verdict" "$sk_target" "$sk_depth" "$sk_findings" "$sk_orig" \
        "$sk_contradicted" "$sk_rearm" "$sk_not_verdict" \
        "$sk_satisfied" "$sk_satisfied_by" \
        || return $?

    # Step 1: upload the report. Stdout = URL; stderr = progress + errors.
    # Skipped entirely in channel-only mode (no issue ⇒ no asset thread).
    if [[ -z "$issue" ]]; then
        : # upload_st already `skipped`
    elif asset_url=$("$_script_dir/upload-asset.sh" "$report_path" --issue "$issue" 2>"$err_buf"); then
        # Trim trailing newline (`$()` already strips it, but be explicit).
        asset_url="${asset_url%$'\n'}"
        if [[ -n "$asset_url" ]]; then
            upload_st=ok
        else
            upload_st=failed
            failure_detail+=$'  upload: upload-asset.sh exited 0 but no URL on stdout\n'
        fi
    else
        upload_st=failed
        failure_detail+="  upload: upload-asset.sh failed: $(tr '\n' ' ' < "$err_buf")"$'\n'
    fi

    # Step 2: post the comment. Three modes:
    #   - --no-comment: skipped (worker plans to post via `ng reply`).
    #   - --comment-body-file <path>: caller supplies prose; the verb
    #     substitutes {{REPORT_URL}} with the asset URL, or appends a
    #     "Full report: <URL>" footer when no token is present.
    #   - default: templated body from the report's H1 + Summary.
    # Always skipped if upload failed — without an asset URL the
    # comment body would be a dead link.
    if (( no_comment == 1 )); then
        comment_st=skipped
    elif [[ "$upload_st" == ok ]]; then
        local body
        if [[ -n "$body_file" ]]; then
            body=$(<"$body_file")
            if [[ "$body" == *"{{REPORT_URL}}"* ]]; then
                body="${body//\{\{REPORT_URL\}\}/$asset_url}"
            else
                # No token → append a footer so the link is always
                # present regardless of what the worker wrote.
                body="${body}"$'\n\nFull report: '"$asset_url"
            fi
        else
            local title summary summary_rc
            summary_rc=0
            title=$(_wrapup_report_title "$report_path")
            summary=$(_wrapup_report_summary "$report_path") || summary_rc=$?
            if (( summary_rc == 2 )); then
                # your-org/nexus-code#1114. The composer could not build a body
                # carrying a claim. Publish NOTHING — see the exit-3 block at
                # the foot of this function for why a degraded stand-in is
                # worse than silence plus a loud stop.
                comment_st=degenerate-teaser
                degenerate_teaser="$summary"
            elif [[ -z "$title" ]]; then
                body=$(printf '## %s\n\nReport: %s\n' "$basename" "$asset_url")
            elif [[ -n "$summary" ]]; then
                body=$(printf '## %s\n\n%s\n\nFull report: %s\n' "$title" "$summary" "$asset_url")
            else
                body=$(printf '## %s\n\nFull report: %s\n' "$title" "$asset_url")
            fi
        fi
        # your-org/nexus-code#1140: a declared-short fan-out is STATED in the
        # comment a reader will actually see, never only on wrap-up's stderr.
        if [[ -n "${_WU_FANOUT_LINE:-}" && "$comment_st" != degenerate-teaser ]]; then
            body="${body}"$'\n\n'"${_WU_FANOUT_LINE}"
        fi
        # your-org/nexus-code#1114: everything below PUBLISHES. A degenerate
        # teaser must not reach any of it — not the fresh POST, not the
        # in-place edit, not the re-point. The refusal is the whole fix.
        if [[ "$comment_st" == degenerate-teaser ]]; then
            : # nothing publishable was composed; fall through to reporting
        else
        : > "$err_buf"
        # Post-once idempotency (B15 / your-org/your-nexus#236): if a
        # prior wrap-up for this (issue, report, repo) already posted the
        # link comment, don't double-post on a retry. But step 1 just
        # re-uploaded the report to a NEW blob, so reusing the prior
        # comment AS-IS would pin the thread to the STALE upload while
        # printing success (#524 defect 2). Re-point the prior comment's
        # asset link(s) at the new blob via the CAS edit path; when the
        # comment is gone or no longer references this report, post the
        # canonical link comment fresh (a duplicate beats a stale link).
        local prior_comment_url
        prior_comment_url=$(_wrapup_prior_comment_url "$issue" "$basename" "$target")
        if [[ -n "$prior_comment_url" ]]; then
            # your-org/nexus-code#605. Re-pointing alone SILENTLY DISCARDS
            # a supplied --comment-body-file: the prior body stays, exit is
            # 0, and the line printed reads `UPDATED`. A repeat wrap-up is
            # the NORMAL shape of the skeptic protocol (verdict → worker
            # fixes → skeptic verifies and wraps up again on the same
            # issue), so the dropped body is precisely the comment that
            # tells the orchestrator whether the PR is mergeable. It cost a
            # real verdict on PR #596.
            #
            # So: decide whether this is an idempotent RETRY (same content,
            # only the asset blob moved) or NEW INFORMATION.
            #   same  → re-point only, as before. `UPDATED` is honest.
            #   differ→ re-point the old comment (so no comment in the
            #           thread cites a stale blob — the invariant post-once
            #           re-pointing exists to hold) AND post the new body as
            #           a NEW comment. A second verdict is new information,
            #           not a corrected link.
            # Nothing supplied a body → unchanged behaviour.
            # your-org/nexus-code#656. This comparison used to run ONLY when
            # a --comment-body-file was supplied, so the AUTO-COMPOSED
            # canonical body — the one that quotes `## Summary` — was
            # recomputed every run and then silently discarded. A corrected
            # Summary (a retracted claim, a refuted result, a revised
            # verdict) could not reach the thread through this path at all,
            # while the caller was told `UPDATED` and handed exit 0.
            #
            # On the reporter's own night that false claim stayed off
            # GitHub only because the ~300-char truncation happened to cut
            # just before it. Safety by coincidence is not safety.
            #
            # So compare ALWAYS, and split by WHAT differs:
            #   supplied body differs  → NEW comment (#605: a second
            #       verdict is new information, not a corrected link)
            #   composed body differs  → EDIT this comment (it IS the
            #       canonical link comment; a corrected Summary belongs in
            #       place, not as a duplicate)
            #   same                   → re-point only, and say `unchanged`
            local body_is_new=0 body_is_edit=0
            local prior_body prior_norm
            prior_body=$(api "/repos/$target/issues/comments/${prior_comment_url##*issuecomment-}" 2>/dev/null \
                | jq -r '.body // empty' 2>/dev/null) || prior_body=""
            if [[ -z "$prior_body" ]]; then
                # Cannot read the prior body ⇒ cannot establish that this
                # run's content is redundant. Only a SUPPLIED body is worth
                # posting fresh on that basis; for the composed body the
                # re-point path below already republishes the link.
                [[ -n "$body_file" ]] && body_is_new=1
            else
                # Normalise away the one difference a pure retry always
                # has: the asset link moved to this run's blob.
                prior_norm=$(_replace_asset_links "$prior_body" "$basename" "$asset_url")
                if [[ "$prior_norm" != "$body" ]]; then
                    if [[ -n "$body_file" ]]; then body_is_new=1; else body_is_edit=1; fi
                fi
            fi
            local repoint_rc=0
            comment_url=$(_wrapup_repoint_link_comment \
                "$target" "$prior_comment_url" "$basename" "$asset_url" \
                2>"$err_buf") || repoint_rc=$?
            if (( repoint_rc == 0 )) && (( body_is_edit == 1 )); then
                # The canonical link comment's own content changed — edit it
                # in place (your-org/nexus-code#656). Failure here is LOUD:
                # reporting success for a correction that did not publish is
                # the defect being fixed, not an acceptable degradation.
                : > "$err_buf"
                local edited_url
                if edited_url=$(_wrapup_set_comment_body "$target" "$comment_url" "$body" 2>"$err_buf"); then
                    comment_url="$edited_url"
                    comment_st=edited
                else
                    comment_st=failed
                    failure_detail+=$'  comment: composed body changed but the in-place edit FAILED — the correction is NOT published\n'
                    [[ -s "$err_buf" ]] && failure_detail+="    $(head -3 "$err_buf" | tr '\n' ' ')"$'\n'
                fi
            elif (( repoint_rc == 0 )) && (( body_is_new == 1 )); then
                # The link is fixed; now publish the content that would
                # otherwise have been dropped.
                : > "$err_buf"
                local fresh_url
                if fresh_url=$(_post_body "/repos/$target/issues/$issue/comments" "$body" 2>"$err_buf"); then
                    comment_url="$fresh_url"
                    comment_st=updated-and-posted
                else
                    # Loud, and NON-zero overall: the caller supplied a body
                    # that is now published nowhere. Reporting success here
                    # would be the #605 defect wearing a different hat.
                    comment_st=failed
                    failure_detail+="  comment: --comment-body-file content differs from the existing wrap-up comment, and POST of the new comment failed: $(tr '\n' ' ' < "$err_buf")"$'\n'
                    comment_url=""
                fi
            elif (( repoint_rc == 0 )); then
                # your-org/nexus-code#862 — THE RESIDUE, and the reason this
                # arm is not simply "nothing happened".
                #
                # #656 (the `edited` arm above) closed the case where the
                # composed body ITSELF changed: a corrected `## Summary` now
                # reaches the thread. What it cannot close is the case the
                # append-only convention actively PRODUCES. Reports are
                # append-only and this comment quotes `## Summary` alone, so
                # a superseding verdict written where the convention says to
                # write it — appended further down — leaves the composed body
                # BYTE-IDENTICAL. There is genuinely nothing to publish, and
                # the old message said exactly that, truthfully, at exit 0.
                #
                # Truthful and useless: the report DID change, the thread did
                # not, and nobody was told. The only artefact is an absence.
                #
                # Discriminate on whether the ASSET LINK MOVED. `prior_norm`
                # is `prior_body` with asset links rewritten to THIS run's
                # URL, so the two differ iff the link moved.
                #
                #   link moved  no  → nothing changed anywhere. Quiet, exit 0.
                #   link moved  yes → the composed body is byte-identical
                #                     anyway. NOTHING PUBLISHED, exit 3.
                #
                # THE BICONDITIONAL IS NOT EXACT, AND THIS IS THE STATED
                # BOUND (your-org/nexus-code#873 review, F1). The URL pins the
                # ASSET REPO HEAD, not this report's bytes. A concurrent
                # upload by another window moves that head, so the link can
                # move while THIS report did not — a spurious rc 3.
                #
                # The direction matters, and it is the safe one: this can
                # only speak when it should have been quiet, never go quiet
                # when it should speak. A false NOTHING PUBLISHED costs a
                # reader one confused minute; a false silence is `#862`
                # itself, and is undetectable downstream.
                #
                # Keyed here rather than on a report-content hash because an
                # honest re-run must stay silent: a warning that fired on
                # every idempotent retry would be tuned out within a day and
                # then be worth less than nothing. The false-alarm mode is
                # named in the stderr block rather than left for a reader to
                # discover by hunting.
                #
                # Exit 3, distinct from 1, because the caller must be able to
                # tell "a step failed, retry it" from "nothing failed, nothing
                # published, go and say it yourself". A retry cannot fix this
                # one — only the caller can.
                #
                # Keyed on the asset, not on a report-content hash, so an
                # honest re-run stays silent. A warning that fired on every
                # idempotent retry would be tuned out within a day and would
                # then be worth less than nothing.
                if [[ -n "$prior_body" && "$prior_norm" != "$prior_body" ]]; then
                    comment_st=nothing-published
                else
                    comment_st=updated
                fi
            elif (( repoint_rc == 2 )); then
                : > "$err_buf"
                if comment_url=$(_post_body "/repos/$target/issues/$issue/comments" "$body" 2>"$err_buf"); then
                    comment_st=ok
                else
                    comment_st=failed
                    failure_detail+="  comment: POST /repos/$target/issues/$issue/comments failed: $(tr '\n' ' ' < "$err_buf")"$'\n'
                    comment_url=""
                fi
            else
                comment_st=failed
                failure_detail+="  comment: re-point of prior link comment $prior_comment_url failed: $(tr '\n' ' ' < "$err_buf")"$'\n'
                comment_url=""
            fi
        elif comment_url=$(_post_body "/repos/$target/issues/$issue/comments" "$body" 2>"$err_buf"); then
            comment_st=ok
        else
            comment_st=failed
            failure_detail+="  comment: POST /repos/$target/issues/$issue/comments failed: $(tr '\n' ' ' < "$err_buf")"$'\n'
            comment_url=""
        fi
        fi
    fi

    # Step 2b (skeptic protocol, your-org/nexus-code#545): file the
    # `kind=spawn-skeptic` request into the watcher-mediated request inbox
    # so the orchestrator gets a PUSH signal to spawn the required skeptic.
    # Runs here — AFTER upload + comment — so the request carries the asset
    # + comment URLs (the skeptic always has a complete artifact). Driven by
    # the _SK_SPAWN_* globals set in Step 0b; a no-op unless the skeptic
    # step resolved to a require/second-pass path with a real source window.
    # Best-effort: the status is surfaced but never flips the wrap-up exit
    # (the pending marker + orphan backstop still guarantee the skeptic is
    # not lost).
    local skreq_status=""
    if (( ${_SK_SPAWN_REQ:-0} == 1 )); then
        skreq_status=$(_wrapup_file_spawn_skeptic_request \
            "$issue" "$report_path" "$asset_url" "$comment_url" \
            "$trigger_comment" "$target" "$reply_to" \
            "$( [[ -n "$repo_arg" ]] && printf 1 || printf 0 )") || true
    fi

    # Step 2c (remote-request channel): deliver the ANSWER back over the
    # request/reply channel instead of (or, with --issue, in addition to)
    # the GitHub issue thread. Runs AFTER upload + comment so a both-surfaces
    # wrap-up can hand the requester the asset/comment URLs it just minted.
    #
    # The answer body is, in precedence order:
    #   1. --answer-file <path>  — the answer is an artifact (table, dataset,
    #      code, diff) that does not belong in a prose Summary.
    #   2. the report's FULL `## Summary` section — the default. report-check
    #      (Step 0) already guarantees the section exists and is non-stub, so
    #      this is a checked deliverable, not a hope.
    # Either way a provenance footer is appended naming the report path (and
    # the GitHub artifacts when both surfaces ran), so the requester can walk
    # back to the full write-up.
    if (( channel_mode == 1 )); then
        local ans_tmp
        ans_tmp=$(mktemp "${TMPDIR:-/tmp}/wrapup-answer.XXXXXX")
        if [[ -n "$answer_file" ]]; then
            cat -- "$answer_file" > "$ans_tmp"
        else
            _wrapup_report_section_summary "$report_path" > "$ans_tmp"
        fi
        if [[ ! -s "$ans_tmp" ]]; then
            channel_st=failed
            failure_detail+="  channel: answer body is EMPTY (no --answer-file, and the report has no '## Summary' content) — the requester would get nothing"$'\n'
        else
            {
                printf '\n---\n'
                printf 'report: %s\n' "$report_path"
                [[ -n "$asset_url"   ]] && printf 'report-asset: %s\n' "$asset_url"
                [[ -n "$comment_url" ]] && printf 'issue-comment: %s\n' "$comment_url"
            } >> "$ans_tmp"
            local issue_ref=""
            [[ -n "$issue" && -n "$target" ]] && issue_ref="$target#$issue"
            : > "$err_buf"
            if channel_path=$(_wrapup_deliver_channel_reply \
                    "$reply_to" "$ans_tmp" "$source_window" "$PWD" "$issue_ref" \
                    2>"$err_buf"); then
                channel_st=ok
            else
                channel_st=failed
                channel_path=""
                failure_detail+="  channel: ng request reply $reply_to failed: $(tr '\n' ' ' < "$err_buf")"$'\n'
            fi
        fi
        rm -f "$ans_tmp"
    fi

    # Step 2d: PUBLISH PER-ISSUE DISPOSITIONS AND READ THEM BACK
    # (your-org/nexus-code#1352). A decline recorded only inside a gitignored
    # report is unreachable from the issue it disposes — not from the issue,
    # not from a search, not from a link — so the queue overstates work and a
    # closing comment once asserted "stated in the comment above" about text
    # that existed only in the report. Each `## Dispositions` bullet is posted
    # on ITS issue and then READ BACK by a direct GET of the comment (the
    # #1125 shape: a write with no read-back is not evidence). Published ones
    # are recorded in a per-report ledger so a retry never double-posts; any
    # bullet that was not published is named and flips the exit, because a
    # worker that dispositions five issues and comments on two has published
    # 40% of its result.
    local disp_st=skipped disp_ok="" disp_fail="" disp_ledger=""
    if [[ "$upload_st" == ok && -n "$issue" ]] && grep -qE '^## Dispositions[[:space:]]*$' "$report_path" 2>/dev/null; then
        disp_st=ok
        mkdir -p "$STATE_DIR/dispositions" 2>/dev/null || true
        disp_ledger="$STATE_DIR/dispositions/${basename}.tsv"
        local _dref _dkind _dtext _drepo _dnum _durl _dcid _dback _dbody _dtag
        _dtag="ng-disposition ${basename}"
        while IFS=$'\t' read -r _dref _dkind _dtext; do
            [[ -n "$_dref" && "$_dkind" != MALFORMED ]] || continue
            _dnum="${_dref##*#}"; _drepo="${_dref%#*}"; [[ -n "$_drepo" ]] || _drepo="$target"
            if [[ -r "$disp_ledger" ]] && grep -qE "^${_drepo}#${_dnum}"$'\t' "$disp_ledger" 2>/dev/null; then
                printf 'disposition %s#%s: already published (%s)\n' "$_drepo" "$_dnum" "$(grep -E "^${_drepo}#${_dnum}"$'\t' "$disp_ledger" | cut -f2 | sed -n 1p)"
                disp_ok="${disp_ok:+$disp_ok }${_drepo}#${_dnum}"
                continue
            fi
            _dbody=$(printf '**Disposition** from `%s` (report `%s`): **%s** — %s\n\nFull report: %s\n\n<!-- %s -->\n' \
                "$source_window" "$basename" "$_dkind" "$_dtext" "$asset_url" "$_dtag")
            _durl=$(jq -n --arg b "$_dbody" '{body: $b}' \
                    | api -X POST "/repos/$_drepo/issues/$_dnum/comments" --input - 2>/dev/null \
                    | jq -r '.html_url // empty') || _durl=""
            if [[ -z "$_durl" ]]; then
                disp_fail="${disp_fail:+$disp_fail }${_drepo}#${_dnum}"
                printf 'disposition %s#%s: NOT published (the comment POST returned no html_url)\n' "$_drepo" "$_dnum"
                continue
            fi
            _dcid="${_durl##*issuecomment-}"
            _dback=""
            if [[ "$_dcid" =~ ^[0-9]+$ ]]; then
                # `</dev/null`: this loop reads its bullets from a process
                # substitution, and a `gh` stub (or gh itself on some paths)
                # drains stdin — without the redirect the read-back ATE the
                # remaining bullets and the loop silently stopped after one.
                _dback=$(api "/repos/$_drepo/issues/comments/$_dcid" </dev/null 2>/dev/null | jq -r '.body // empty') || _dback=""
            fi
            if [[ "$_dback" == *"$_dtag"* ]]; then
                printf '%s#%s\t%s\t%s\n' "$_drepo" "$_dnum" "$_durl" "$_dkind" >> "$disp_ledger" 2>/dev/null || true
                disp_ok="${disp_ok:+$disp_ok }${_drepo}#${_dnum}"
                printf 'disposition %s#%s: published %s (read back OK: %s)\n' "$_drepo" "$_dnum" "$_durl" "$_dkind"
            else
                disp_fail="${disp_fail:+$disp_fail }${_drepo}#${_dnum}"
                printf 'disposition %s#%s: NOT published — the POST returned %s but the read-back did not find this report'"'"'s marker in it (a write with no read-back is not evidence; #1125)\n' "$_drepo" "$_dnum" "$_durl"
            fi
        done < <(_wrapup_dispositions "$report_path")
        printf 'dispositions: published {%s}; NOT published {%s}\n' "${disp_ok:-}" "${disp_fail:-}"
        [[ -z "$disp_fail" ]] || disp_st=failed
    fi

    # Step 3: rocket the trigger comment, if one was supplied. Posts to
    # $trigger_target (defaults to $target; --trigger-repo overrides).
    #
    # your-org/nexus-code#1114: NOT when the comment step refused to publish.
    # 🚀 is the "this mention is handled" marker — it is what evicts the
    # mention from the watcher's re-emit registry (see `_mark_processed
    # rocket` below). Rocketing a trigger whose answer was never published
    # would retire the reminder for work the thread never received, which is
    # the defect in its purest form: the marker of a delivery, without the
    # delivery. The refusal is not complete unless it also declines to say
    # "done".
    # `nothing-published` (#862) joins `degenerate-teaser` here
    # (your-org/nexus-code#1148): both mean the thread learned nothing, and
    # rocketing either marks the escalation handled with nothing delivered.
    # The DENY arm precedes the permissive one (#1121), and the retry case is
    # carved out by EVIDENCE — an earlier wrap-up that actually published for
    # this same trigger — not by state name.
    if [[ -n "$trigger_comment" && "$trigger_comment" != "0" ]] \
       && { [[ "$comment_st" == degenerate-teaser ]] \
            || { [[ "$comment_st" == nothing-published ]] \
                 && ! _wrapup_trigger_already_answered \
                        "$issue" "$basename" "$target" "$trigger_comment"; }; }; then
        rocket_st=skipped-nothing-published
    elif [[ -n "$trigger_comment" && "$trigger_comment" != "0" ]]; then
        : > "$err_buf"
        if api -X POST "/repos/$trigger_target/issues/comments/$trigger_comment/reactions" \
               -f content=rocket >/dev/null 2>"$err_buf"; then
            rocket_st=ok
            _mark_processed comment "$trigger_comment"
            # 🚀 = done → record the STOP marker so the re-emit registry
            # evicts this mention (your-org/nexus-code#360) rather than
            # demoting it to the 👀 slow-nudge tier.
            _mark_processed rocket "$trigger_comment"
        else
            rocket_st=failed
            failure_detail+="  rocket: POST /repos/$trigger_target/issues/comments/$trigger_comment/reactions failed: $(tr '\n' ' ' < "$err_buf")"$'\n'
        fi
    fi

    # ($source_window was resolved before the skeptic gate, above.)

    # Step 4: log the action. Always attempted — useful even on partial
    # success so the orchestrator can audit which wrap-up step blocked.
    local -a log_args=(
        monitor
        --event wrap-up
    )
    # `issue=` stays unconditional in the default form (the orchestrator's
    # window-cleanup + re-emit selectors key on it); a channel-only wrap-up
    # has no issue, so it carries `reply-to=` instead of an empty field.
    if [[ -n "$issue" ]]; then
        log_args+=( --extra "issue=$issue" )
    fi
    log_args+=( --extra "report=$basename" )
    [[ -n "$reply_to" ]]         && log_args+=( --extra "reply-to=$reply_to" )
    [[ "$channel_st" != skipped ]] && log_args+=( --extra "channel=$channel_st" )
    [[ -n "$asset_url" ]]        && log_args+=( --extra "asset-url=$asset_url" )
    [[ -n "$comment_url" ]]      && log_args+=( --extra "comment-url=$comment_url" )
    [[ -n "$trigger_comment" ]]  && log_args+=( --extra "trigger-comment=$trigger_comment" )
    [[ -n "$source_window" ]]    && log_args+=( --extra "window=$source_window" )
    [[ -n "$target" ]]           && log_args+=( --extra "repo=$target" )
    # Record trigger-repo only when it differs from repo — keeps
    # legacy entries compact (and parseable by jq selectors that
    # don't expect the field) while still surfacing cross-repo
    # wrap-ups for audit.
    [[ "$trigger_target" != "$target" ]] \
        && log_args+=( --extra "trigger-repo=$trigger_target" )
    log_args+=( --extra "upload=$upload_st" )
    log_args+=( --extra "comment=$comment_st" )
    log_args+=( --extra "rocket=$rocket_st" )
    # The spawn-skeptic filing outcome, recorded beside its three siblings
    # (your-org/nexus-code#975).
    #
    # This is the PUSH SIGNAL for a required skeptic — `filed <id>` |
    # `skipped (<why>)` | `FAILED (<why>)`. It was computed in Step 2b,
    # printed to the pane, and then dropped, while `upload`/`comment`/`rocket`
    # were kept. So the one field that says whether the obligation was ever
    # pushed lived only in a human's scrollback.
    #
    # The cost was measured, not hypothetical. #975 asked why three windows
    # retired owing a re-armed required verdict, and the two live candidates —
    # "never surfaced" vs "surfaced and dropped" — are distinguished by exactly
    # this value. They could not be separated, because `monitor/.state/requests/`
    # is GC'd by design (`test-requests-inbox.sh` asserts the collection of
    # `.done`/`.replied` past retention; `request-channel.sh` has no archive
    # path) and `request-channel.sh` makes no `cmd_log_action` call at all. So
    # nothing anywhere durably records that a request was filed. Two of the four
    # re-arms are permanently unattributable as a result.
    #
    # Recorded unconditionally when the skeptic step ran, INCLUDING the skip and
    # failure spellings: a skip is the answer in the case that matters, so
    # logging only `filed` would reproduce the defect — an absence that reads as
    # "no skeptic was required" rather than "the push was suppressed".
    [[ -n "$skreq_status" ]] && log_args+=( --extra "spawn-skeptic=$skreq_status" )
    if ( cmd_log_action "${log_args[@]}" ) 2>/dev/null; then
        log_st=ok
    else
        log_st=failed
        failure_detail+=$'  log-action: append to action-log.jsonl failed\n'
    fi

    # Step 5: auto-retain the source tmux window so the watcher's idle-worker
    # probe suppresses it into the retained-footer for retain_ttl_seconds
    # (default 24 h, config monitor.retain_ttl_seconds). Skipped when:
    #   - --no-retain was passed (close-immediately opt-out), OR
    #   - no source_window (verb ran outside the worker's tmux pane —
    #     orchestrator-side direct call, test harness, etc.).
    # Retention failure does NOT flip exit code: the wrap-up itself
    # already succeeded; failing to log a retain is auditability noise,
    # not a hand-off blocker. Stderr still names the step.
    local retain_st=skipped
    if (( no_retain == 0 )) && [[ -n "$source_window" ]]; then
        local effective_retain_reason="$retain_reason"
        if [[ -z "$effective_retain_reason" ]]; then
            effective_retain_reason="wrap-up-$(date -u +%Y-%m-%d)"
        fi
        local -a retain_args=(
            monitor
            --event window-retain
            --extra "window=$source_window"
            --extra "reason=$effective_retain_reason"
        )
        if [[ -n "$issue" ]]; then
            retain_args+=( --extra "issue=$issue" )
        else
            retain_args+=( --extra "reply-to=$reply_to" )
        fi
        if ( cmd_log_action "${retain_args[@]}" ) 2>/dev/null; then
            retain_st=ok
        else
            retain_st=failed
            failure_detail+=$'  retain: append window-retain to action-log.jsonl failed\n'
        fi
    fi

    # Summary line per step (stdout — machine-readable, predictable order).
    if [[ "$upload_st" == ok ]]; then
        printf 'uploaded: %s\n' "$asset_url"
    elif [[ "$upload_st" == skipped ]]; then
        printf 'uploaded: SKIPPED (channel-only wrap-up — no GitHub issue)\n'
    else
        printf 'uploaded: FAILED\n'
    fi
    if [[ "$channel_st" == ok ]]; then
        printf 'channel reply: %s -> %s\n' "$reply_to" "$channel_path"
    elif [[ "$channel_st" == failed ]]; then
        printf 'channel reply: FAILED (%s)\n' "$reply_to"
    fi
    if [[ "$comment_st" == ok ]]; then
        printf 'posted comment: %s\n' "$comment_url"
    elif [[ "$comment_st" == updated ]]; then
        # your-org/nexus-code#656: the headline word was `UPDATED`, which
        # reads as "your correction is published" for a run that published
        # nothing. Say what happened — the body is byte-identical and only
        # the asset link moved.
        printf 'posted comment: unchanged %s (post-once: link re-pointed to the new upload; comment body is identical — nothing to publish)\n' "$comment_url"
    elif [[ "$comment_st" == degenerate-teaser ]]; then
        # your-org/nexus-code#1114. Same headline as #862's arm — NOTHING
        # PUBLISHED — because it is the same fact from the reader's side: the
        # thread did not learn anything. The parenthetical is what differs,
        # and it quotes the exact bytes that were withheld.
        printf 'posted comment: NOTHING PUBLISHED (composed teaser carries no claim: %s — see stderr)\n' \
            "$(printf '%q' "$degenerate_teaser")"
    elif [[ "$comment_st" == nothing-published ]]; then
        # your-org/nexus-code#862. Distinct wording from `unchanged` on
        # purpose: that one means "you re-ran and nothing needed to move",
        # this one means "your report moved and the thread did not".
        printf 'posted comment: NOTHING PUBLISHED %s (report changed, composed body did not — see stderr)\n' "$comment_url"
    elif [[ "$comment_st" == edited ]]; then
        printf 'posted comment: EDITED %s (composed body changed — the comment was updated in place)\n' "$comment_url"
    elif [[ "$comment_st" == updated-and-posted ]]; then
        # #605: say plainly that BOTH things happened. The old line said
        # `UPDATED` for a run that had published none of the caller's
        # content, which is the exact claim a reporting path must never
        # make falsely.
        printf 'posted comment: NEW %s (--comment-body-file differed from the existing wrap-up comment; prior comment re-pointed to the new upload)\n' "$comment_url"
    elif [[ "$comment_st" == skipped ]]; then
        # your-org/nexus-code#815 (incidental) — this arm asserted a CAUSE it
        # had not established. `--no-comment` is the FIRST thing that sets
        # comment_st=skipped (see Step 2), so a `--no-comment` run whose
        # upload plainly succeeded still printed "SKIPPED (upload failed)" —
        # a false cause, one line under the asset URL that disproves it, and
        # exactly the kind of message that sends someone debugging a
        # nonexistent failure. The precedence here mirrors Step 2's own.
        if (( no_comment == 1 )); then
            printf 'posted comment: SKIPPED (--no-comment)\n'
        elif [[ -z "$issue" ]]; then
            printf 'posted comment: SKIPPED (channel-only wrap-up — no GitHub issue)\n'
        else
            printf 'posted comment: SKIPPED (upload failed)\n'
        fi
    else
        printf 'posted comment: FAILED\n'
    fi
    if [[ -n "$trigger_comment" && "$trigger_comment" != "0" ]]; then
        if [[ "$rocket_st" == ok ]]; then
            printf 'rocketed comment %s\n' "$trigger_comment"
        elif [[ "$rocket_st" == skipped-nothing-published ]]; then
            printf 'rocketed comment %s: SKIPPED (nothing was published — the trigger stays open)\n' \
                "$trigger_comment"
        else
            printf 'rocketed comment %s: FAILED\n' "$trigger_comment"
        fi
    fi
    if [[ "$log_st" == ok ]]; then
        if [[ -n "$issue" ]]; then
            printf 'logged action: wrap-up issue=%s report=%s\n' "$issue" "$basename"
        else
            printf 'logged action: wrap-up reply-to=%s report=%s\n' "$reply_to" "$basename"
        fi
    else
        printf 'logged action: FAILED\n'
    fi
    if [[ "$retain_st" == ok ]]; then
        printf 'retained window: %s (reason=%s; ttl=monitor.retain_ttl_seconds)\n' \
            "$source_window" "${retain_reason:-wrap-up-$(date -u +%Y-%m-%d)}"
    elif [[ "$retain_st" == failed ]]; then
        printf 'retained window: FAILED\n'
    fi
    # Spawn-skeptic request (Step 2b). Best-effort — a FAILED here does NOT
    # flip the exit (the pending marker + orphan backstop still cover it),
    # but it IS surfaced on stderr so the orchestrator can file it by hand.
    if [[ -n "$skreq_status" ]]; then
        case "$skreq_status" in
            filed*)   printf 'spawn-skeptic request: %s\n' "$skreq_status" ;;
            skipped*) printf 'spawn-skeptic request: %s\n' "$skreq_status" ;;
            *)        printf 'spawn-skeptic request: %s\n' "$skreq_status"
                      printf 'ng wrap-up: spawn-skeptic request not filed (%s) — the pending marker\n' "$skreq_status" >&2
                      printf '  and orphaned-skeptic-pending backstop still cover the skeptic; you may\n' >&2
                      printf '  file it by hand: ng request file --origin %s --kind spawn-skeptic ...\n' "$source_window" >&2 ;;
        esac
    fi

    # Aggregate: failures (not skips) on the hand-off steps flip exit.
    # Step 5 (retain) is auditability — its failure surfaces on stderr
    # but does not flip exit on its own. A failed retain leaves the
    # worker visible to the next idle-worker emit, which is the safe
    # degradation: the orchestrator will see and triage the row.
    # channel_st counts: in --reply-to mode the channel reply IS the
    # deliverable, so a failed delivery must not report success — the
    # requester would block forever on an answer that never landed.
    if [[ "$upload_st" == failed || "$comment_st" == failed \
          || "$rocket_st" == failed || "$log_st" == failed \
          || "$channel_st" == failed || "${disp_st:-skipped}" == failed ]]; then
        {
            printf 'ng wrap-up: partial failure — retry the failed steps:\n'
            printf '%s' "$failure_detail"
        } >&2
        return 1
    fi
    if [[ "$retain_st" == failed ]]; then
        {
            printf 'ng wrap-up: retain logging failed (wrap-up itself succeeded):\n'
            printf '%s' "$failure_detail"
        } >&2
    fi

    # EXIT 3 — NOTHING FAILED, AND NOTHING PUBLISHED.
    #
    # ONE contract, two causes (your-org/nexus-code#862, #1114). They are the
    # same composer failing at its two lossy steps, and treating them as two
    # unrelated bugs is how the seam between them survives:
    #
    #   the SECTION projection  report -> `## Summary` alone   (#862)
    #   the TEASER  projection  `## Summary` -> one sentence    (#1114)
    #
    # Each step can discard exactly what the author meant to publish, and
    # neither used to say so. The guarantee this block now carries is:
    #
    #     `ng wrap-up` publishes a composed link comment only when that
    #     comment carries a claim the author wrote. When the composition
    #     cannot carry one, it publishes NOTHING, exits 3, and names the
    #     cause and the ways out.
    #
    # What it does NOT guarantee, said here so nobody reads more into it: that
    # the teaser is a GOOD summary, or that `## Summary` describes the report.
    # Those are properties of the author's prose and no composer can check
    # them. It guarantees only that a fragment is never silently substituted
    # for a claim.
    #
    # WHY 3 AND NOT 1. Deliberately AFTER the failure aggregation above: a run
    # that also had a genuine step failure should report 1 (retry the failed
    # step). 3 is the case where every step did exactly what it was asked and
    # the caller's content still reached nobody — a retry reproduces it
    # exactly, so only the caller can clear it.
    #
    # WHY REFUSE RATHER THAN POST A DEGRADED STAND-IN (#1114). Falling back to
    # a title-only body was the obvious alternative and it is the wrong one: it
    # publishes a well-formed comment that reads as a completed hand-off, so
    # nobody looks again — the failure's only evidence would be an absence.
    # Silence plus a loud stop costs the author one minute and cannot be
    # mistaken for success. Note also that this repo ALREADY takes the refusal
    # side on the sibling surface: the `--reply-to` channel step above fails
    # outright rather than deliver an empty answer, "the requester would get
    # nothing". This is that same rule, finally applied to the GitHub surface.
    if [[ "$comment_st" == degenerate-teaser ]]; then
        {
            printf 'ng wrap-up: NOTHING PUBLISHED — the composed teaser carries no claim.\n'
            if [[ -z "$degenerate_teaser" ]]; then
                # your-org/nexus-code#1116 review, F2. Empty here means the
                # `**Key:** value` strip consumed the whole section — naming the
                # cause, because "composed to: ''" would send the author looking
                # at their first sentence when the problem is the SHAPE of every
                # line.
                printf '  Your `## Summary` is built entirely from `**Key:** value` lines, and\n'
                printf '  the composer strips those as metadata — so after flattening there was\n'
                printf '  nothing left to publish. Add at least one line of ordinary prose\n'
                printf '  stating the result, and it will be used.\n'
            else
                printf '  The link comment is composed from the first sentence of `## Summary`,\n'
                printf '  capped at 200 characters. Yours composed to:\n'
                printf '      %s\n' "$(printf '%q' "$degenerate_teaser")"
            fi
            printf '  That is a fragment, not an assertion, so it was NOT posted — a\n'
            printf '  well-formed comment carrying nothing reads as a finished hand-off and\n'
            printf '  nobody looks again. The trigger comment was NOT rocketed either, so the\n'
            printf '  mention stays open.\n'
            printf '  Two ways out:\n'
            printf '    1. rewrite the opening of `## Summary` so its first sentence states\n'
            printf '       the result on its own, then re-run wrap-up (the upload already\n'
            printf '       succeeded; the upload and comment steps are idempotent — the\n'
            printf '       SKEPTIC step is NOT. It ran as Step 0b BEFORE this refusal and\n'
            printf '       already armed a round keyed on the report sha, and the edit this\n'
            printf '       remedy asks for MOVES that sha, arming a second round\n'
            printf '       (your-org/nexus-code#1230));\n'
            printf '    2. pass --comment-body-file <path> to supply the comment prose\n'
            printf '       directly, bypassing the teaser composer entirely.\n'
            printf '  Exit 3, not 1: no step failed, so re-running this command unchanged\n'
            printf '  will reproduce this outcome exactly. STEPS THAT ALREADY SUCCEEDED RUN\n'
            printf '  AGAIN — the upload, and the skeptic step (Step 0b), which ARMS. "No\n'
            printf '  step failed" is not "no step had an effect"\n'
            printf '  (your-org/nexus-code#1230).\n'
            printf '  TO RE-READ THIS OUTPUT, DO NOT RE-RUN THE VERB: `ng wrap-up --last` replays\n'
            printf '  this record read-only, arming nothing (your-org/nexus-code#1370).\n'
        } >&2
        return 3
    fi
    if [[ "$comment_st" == nothing-published ]]; then
        {
            printf 'ng wrap-up: NOTHING PUBLISHED — the asset link moved, the thread did not.\n'
            printf '  The link comment is composed from `## Summary` alone, and yours is\n'
            printf '  byte-identical to the one already posted — so this run had nothing to\n'
            printf '  publish and published nothing. If you corrected the report anywhere\n'
            printf '  OUTSIDE `## Summary` (the append-only convention says to), that\n'
            printf '  correction is now in the uploaded report and NOWHERE ELSE.\n'
            printf '  FALSE ALARM MODE, so you are not sent hunting: the asset URL pins the\n'
            printf '  asset repo HEAD, not your report. A concurrent upload from another\n'
            printf '  window moves that head too. If you did NOT change this report, that is\n'
            printf '  what happened and there is nothing to do — the direction is deliberate,\n'
            printf '  since a false alarm costs a minute and a false silence is the defect.\n'
            printf '  This is the append-only convention working exactly as intended and\n'
            printf '  producing silence: a superseding verdict appended further down the\n'
            printf '  report cannot reach the thread through this path.\n'
            printf '  Three ways out, in order of preference:\n'
            printf '    1. edit the OPENING of `## Summary` — its FIRST SENTENCE, within the\n'
            printf '       first 200 characters — then re-run wrap-up (it will edit the\n'
            printf '       comment in place). Editing the Summary ANYWHERE ELSE is not\n'
            printf '       enough and lands you right back here: the composed body is that\n'
            printf '       opening and nothing more, so a correction further down the\n'
            printf '       section leaves it byte-identical. Measured on this very verb\n'
            printf '       while writing it (your-org/nexus-code#1116);\n'
            printf '    2. pass --comment-body-file <path> to post the correction as a new\n'
            printf '       comment (a second verdict is new information, not a fixed link);\n'
            printf '    3. say it yourself on the thread.\n'
            printf '  Exit 3, not 1: no step failed, so re-running this command unchanged\n'
            printf '  will reproduce this outcome exactly. STEPS THAT ALREADY SUCCEEDED RUN\n'
            printf '  AGAIN — the upload, and the skeptic step (Step 0b), which ARMS. "No\n'
            printf '  step failed" is not "no step had an effect"\n'
            printf '  (your-org/nexus-code#1230).\n'
            printf '  TO RE-READ THIS OUTPUT, DO NOT RE-RUN THE VERB: `ng wrap-up --last` replays\n'
            printf '  this record read-only, arming nothing (your-org/nexus-code#1370).\n'
        } >&2
        return 3
    fi

    # (The skeptic protocol step ran as Step 0b, BEFORE the GitHub
    # hand-off — see the rationale there. By here the hand-off has
    # already succeeded, so nothing skeptic-related remains.)

    # Step 7 (informational): interactive-wrap clarification (the #205
    # state-machine follow-up). When the source window carries a live
    # operator-engagement mark, this wrap-up does NOT release the
    # window — interactive sessions stay engaged by default, because
    # the operator may have follow-up inquiries. Tell the agent how to
    # signal the finished state explicitly. A machine-driven (non-
    # engaged) wrap-up prints nothing here and keeps today's behavior.
    if [[ -n "$source_window" ]] && _wrapup_window_engaged "$source_window"; then
        printf '%s\n' \
            '' \
            'NOTE: operator-engaged (interactive) session detected — clarify your finished state:' \
            '  - expecting follow-up user inquiries (the DEFAULT): do nothing further.' \
            '    The window stays engaged; idle cleanup and retire-eligibility remain' \
            '    suppressed while the operator is active (the mark self-expires on its' \
            '    own once the pane goes static past the change TTL).' \
            '  - FINISHED with this interactive session: run' \
            '        ng engaged-done' \
            '    to release the window for the typical wrapped-window cleanup.'
    fi
    return 0
}

# ── `disposition: no-further-pass` MUST NOT CONTRADICT A LIVE SKEPTIC GATE
#    (your-org/nexus-code#1363) ─────────────────────────────────────────────
#
# `retire-preflight.sh` reads the target's own report frontmatter as its FIRST
# gate, and `no-further-pass` is the PERMISSIVE value — so a report that says
# it while a skeptic is required or pending for that window removes a
# retirement gate that the marker on disk says is owed. The two records are
# written by different steps at different times (the author sets the field
# before wrap-up prompts the skeptic decision) and nothing compared them; the
# contradiction on `jcdeck` surfaced only because the spawn-skeptic request
# happens to print both values side by side, and the skeptic the orchestrator
# spawned anyway found a scientific error one presentation from being stated
# as fact. Failing CLOSED costs the author one edit; failing open costs a
# review nobody knows was skipped.
#
# _disposition_gate_conflict <report-path> <window> <decision-flag> <role-flag> <not-verdict-flag>
#   rc 0  no conflict (or nothing to compare against)
#   rc 1  conflict — the reasons are printed, one per line, on stdout
#
# WHAT COUNTS AS "a skeptic is required or pending for this window":
#   * a pending marker `$STATE_DIR/skeptic/pending/<window>` — armed by a
#     `require` wrap-up or by `spawn-worker.sh` when a reviewer was spawned
#     against this window;
#   * a spawn-stamped `skeptic_mode: require` in the window record;
#   * (wrap-up only) `--skeptic-decision require` on THIS invocation — an
#     `auto` worker's decision is not on disk until the wrap-up records it.
#
# THE ROLE PATH IS EXEMPT, deliberately. A reviewer's `no-further-pass` is its
# verdict about the CHAIN it reviewed, and its own pending marker (when it is
# itself the target of a deeper pass) is cleared by the very verdict path this
# check would otherwise block — refusing there would deadlock the reviewer
# behind the marker its wrap-up exists to discharge. An opted-out role window
# (`--not-a-skeptic-verdict`) is ordinary producer work and is NOT exempt.
_disposition_gate_conflict() {
    local report="${1:-}" window="${2:-}" decision="${3:-}" role_flag="${4:-0}" not_verdict="${5:-}"
    [[ -n "$report" && -n "$window" ]] || return 0
    local st src det
    read -r st src det <<<"$(_skeptic_stated_disposition "$report" 2>/dev/null)"
    [[ "$st" == "no-further-pass" && "$src" == "frontmatter" ]] || return 0
    local prov mode depth role target orig
    prov=$(_skeptic_provenance "$window")
    IFS=$'\t' read -r mode depth role target orig <<<"$prov"
    if (( role_flag == 1 )) || { [[ "$role" == "true" ]] && [[ -z "$not_verdict" ]]; }; then
        return 0
    fi
    local key marker conflict=0
    key=$(wk_encode "$window")
    marker="$STATE_DIR/skeptic/pending/$key"
    if [[ -e "$marker" ]]; then
        printf 'a skeptic-pending marker is LIVE for window %s (%s): a review is owed and not yet delivered\n' "$window" "$marker"
        conflict=1
    fi
    if [[ "$mode" == "require" ]]; then
        # RESOLUTION-AWARE, exactly as the marker arm above already is
        # (your-org/nexus-code#1495). This arm used to read the SPAWN RECORD
        # ALONE and treat it as a permanent present-tense obligation: once a
        # window was spawned `require`, it fired for the rest of that window's
        # life no matter what actually happened. That produced a DEADLOCK with
        # no true value available —
        #
        #   disposition: second-pass      refused by retire-preflight check 1c
        #                                 ("no further pass has been recorded")
        #   disposition: no-further-pass  refused HERE
        #
        # — reachable only after the required pass had HAPPENED and been
        # settled, which is to say after everything went right. Worse, the
        # refusal's own remedy ("settle the gate first") named a condition the
        # reader had ALREADY MET, sending them to redo the thing that had just
        # worked; and `ng wrap-up` reading the SAME fact printed "REQUIRE GATE
        # ALREADY RESOLVED — NOT RE-ARMING". One fact, two tools, contradictory
        # answers.
        #
        # A spawn-time property is evidence about what was DEMANDED, never
        # about what is OUTSTANDING. `_skeptic_resolution_state` is the
        # question about NOW, and it is the same predicate `_wrapup_skeptic_step`
        # consults, so the two can no longer disagree.
        #
        # POLARITY: only a positive `resolved` releases. `none`, `re-armed` and
        # `unknown` all still conflict — `unknown` means the probe could not
        # look, and a probe that could not look establishes nothing. An empty
        # read is forced to `unknown` rather than falling through as a release.
        local _dg_state _dg_detail _dg_path
        read -r _dg_state _dg_detail _dg_path \
            <<<"$(_skeptic_resolution_state "$STATE_DIR/skeptic/pending" "$key" "$window" 2>/dev/null)"
        [[ -n "$_dg_state" ]] || { _dg_state=unknown; _dg_detail=resolution-probe-returned-nothing; _dg_path=-; }
        if [[ "$_dg_state" != "resolved" ]]; then
            printf 'window %s was spawned with --skeptic require (window record skeptic_mode: require): a skeptic pass is mandatory, and the gate is NOT settled (%s: %s)\n' \
                "$window" "$_dg_state" "$_dg_detail"
            # NAME THE LEDGER AND PRINT THE CANDIDATE SHA.
            #
            # The settlement below discharges a specific sha — the worker's OWN
            # report AS IT STOOD AT ARMING TIME — and that sha exists in exactly
            # one place: `skeptic/pending/.<window>.ledger`. Meanwhile the
            # append-only convention says keep amending the report, so its
            # content sha moves constantly. A worker that has followed every
            # convention correctly could not derive the citation from anything
            # it held, and the refusal named the ledger ZERO times: the one
            # instance on record was solved by reading the ledger on a hunch.
            # A message is the cheapest possible place to fix that.
            local _dg_led _dg_open _dg_n
            _dg_led=$(_skeptic_ledger_file "$STATE_DIR/skeptic/pending" "$key")
            printf '  the pass HAPPENED? settle it on the record, do not restate the disposition:\n'
            # ASK FOR OUTSTANDING ARMS, not for "the last thing armed".
            # `_skeptic_current_arm_sha` returns the most recent `armed` row
            # WHETHER OR NOT it was discharged, so naming its output "the
            # outstanding arm" would be a claim the helper does not establish —
            # this file's own defect class, in a message written to fix a
            # discoverability problem. `_skeptic_open_arms` applies the
            # discharge and supersede rules, and the count decides what can
            # honestly be said.
            _dg_open=$(_skeptic_open_arms "$STATE_DIR/skeptic/pending" "$key" 2>/dev/null) || _dg_open=""
            _dg_n=$(printf '%s' "$_dg_open" | grep -c . ) || _dg_n=0
            [[ "$_dg_n" =~ ^[0-9]+$ ]] || _dg_n=0
            if (( _dg_n == 1 )); then
                printf '    ng wrap-up ... --skeptic-satisfied --skeptic-satisfied-by %s\n' "$_dg_open"
                printf '  (that sha is the ONE OUTSTANDING ARM on %s — the frozen bytes the\n' "$_dg_led"
                printf '   reviewer was handed, NOT the report as it stands now, which the\n'
                printf '   append-only convention keeps moving.)\n'
            elif (( _dg_n > 1 )); then
                printf '    ng wrap-up ... --skeptic-satisfied --skeptic-satisfied-by <one of these>\n'
                printf '%s\n' "$_dg_open" | sed 's/^/      /'
                printf '  (%d arms are OUTSTANDING on %s. A settlement closes them ALL, so it will\n' "$_dg_n" "$_dg_led"
                printf '   be refused while more than one is open — land the other rounds first, or\n'
                printf '   `ng skeptic resolve` and say so on the record.)\n'
            else
                printf '    ng wrap-up ... --skeptic-satisfied --skeptic-satisfied-by <sha-of-the-reviewed-bytes>\n'
                printf '  (the artefact list lives in %s; NO outstanding arm could be read from it\n' "$_dg_led"
                printf '   just now — which is itself worth looking at before citing anything, since\n'
                printf '   it means either nothing was ever armed here or the ledger is unreadable.)\n'
            fi
            conflict=1
        fi
    fi
    if [[ "$decision" == "require" ]]; then
        printf 'this wrap-up passes --skeptic-decision require: it is about to arm the very gate the report says is not needed\n'
        conflict=1
    fi
    (( conflict == 1 )) && return 1
    return 0
}

# ── UNSETTLED ASYNC WAITS BLOCK THE HAND-OFF (your-org/nexus-code#1181) ────
#
# `wrap-up` had a report-check pre-flight and no async-wait pre-flight, so an
# agent could complete its work, wrap up cleanly and leave waits dangling —
# three windows in one hour (`dolicomp`, `devmain2sk`, `olimit2sk`), and the
# first thing to notice was the watcher, one emit later, landing "RESUME is
# the default, a wait you have not confirmed dead must not be cleared" on an
# agent that had already declared itself done.
#
# SPLIT BY RESOLVABILITY, NOT BY EXISTENCE (the filer's own correction). A
# `syn-` id means the launcher retained NO handle — `_orphan_async.sh`
# resolves it `unresolvable` FOREVER by design, and the detector documents
# that the `sbatch` pattern admits PROSE (`async-launch-patterns.conf`), so a
# `syn-` row can be a phantom that no finishing of anything can clear. A
# refusal keyed on existence would deadlock on it and manufacture exactly the
# pressure to clear waits blindly that the rule exists to prevent. So:
#   * a row token with a PARSED handle (`asyncrun:ar-…`, `slurm:<jobid>`, …)
#     — REFUSE, naming it: it is answerable (`async-run.sh --status-line`,
#     `sacct -j`), and the agent still has the context to settle it;
#   * a `syn-` token — WARN only, naming it as possibly-phantom;
#   * a token this cannot parse at all (no `kind:id`, or the truncation
#     ellipsis the cap appends) — REFUSE: a list we cannot vouch for never
#     satisfies a terminating condition.
# NOTHING IS AUTO-CLEARED, in either arm. The settle verb is
# `monitor/declare-no-wait.sh <kind> <id>`, and only after the wait is
# CONFIRMED dead.
#
# _wrapup_async_preflight <window>   rc 0 = proceed (warnings on stderr), rc 1 = refuse
_wrapup_async_preflight() {
    local window="${1:-}"
    [[ -n "$window" ]] || return 0
    # TWO SOURCES, and the second is the one that matters (bundlersk on
    # your-org/nexus-code#1437): the watcher DROPS a window's
    # orphan-async-state.tsv row the moment the window stops reading idle
    # ("no longer reads idle-orphan-async (state=busy); dropping the row"),
    # and a worker running wrap-up is BUSY by definition — so a guard that
    # read only the TSV was aimed at a population that is empty at the
    # moment it runs. The heartbeat's `external_waits` is the record the
    # launch hook WRITES and `declare-no-wait` LIFTS; it is not dropped on
    # busy. Read both, union the tokens.
    local tsv="$STATE_DIR/orphan-async-state.tsv" row waits="" tok
    local hb="$STATE_DIR/heartbeat/$window.json" hb_waits="" sources=""
    if [[ -f "$tsv" ]]; then
        row=$(awk -F'\t' -v w="$window" '$1 == w { print; exit }' "$tsv" 2>/dev/null) || row=""
        if [[ -n "$row" ]]; then waits=$(printf '%s' "$row" | cut -f2); sources="$tsv"; fi
    fi
    if [[ -f "$hb" ]]; then
        if ! command -v jq >/dev/null 2>&1; then
            printf 'ng wrap-up: REFUSED — %s exists but jq is unavailable, so its external_waits cannot be read; a wait list this cannot vouch for never satisfies a terminating condition (your-org/nexus-code#1181).\n' "$hb" >&2
            return 1
        fi
        if ! hb_waits=$(jq -r '(.external_waits // []) | map("\(.kind):\(.id)") | join(",")' "$hb" 2>/dev/null); then
            printf 'ng wrap-up: REFUSED — %s exists but does not parse; nothing was cleared (your-org/nexus-code#1181, same fail-closed rule as declare-no-wait rc 5).\n' "$hb" >&2
            return 1
        fi
        if [[ -n "$hb_waits" ]]; then waits="${waits:+$waits,}$hb_waits"; sources="${sources:+$sources, }$hb"; fi
    fi
    [[ -n "$waits" ]] || return 0
    local -a refuse=() warn=() seen=()
    local IFS=,
    for tok in $waits; do
        [[ -n "$tok" ]] || continue
        case " ${seen[*]:-} " in *" $tok "*) continue;; esac; seen+=("$tok")
        if [[ "$tok" != *:* || "$tok" == *"…"* ]]; then refuse+=("$tok (unparseable/truncated — cannot vouch for it)")
        elif [[ "${tok#*:}" == syn-* ]]; then warn+=("$tok")
        else refuse+=("$tok")
        fi
    done
    unset IFS
    if (( ${#warn[@]} > 0 )); then
        {
            printf 'ng wrap-up: WARNING — %d synthetic (`syn-`) async wait(s) are on record for window %s:\n' "${#warn[@]}" "$window"
            for tok in "${warn[@]}"; do printf '    %s\n' "$tok"; done
            printf '  A `syn-` id means the launcher retained NO handle, so nothing can ever resolve it —\n'
            printf '  and it may be a PHANTOM (the detector admits `sbatch` in PROSE; see\n'
            printf '  monitor/async-launch-patterns.conf, the `syn-` discussion). Establish whether a\n'
            printf '  referent ever existed (`sacct -u $USER -S <session-start>`, `squeue -u $USER`) and\n'
            printf '  say so in the report. NOT a refusal on its own; NOT auto-cleared\n'
            printf '  (your-org/nexus-code#1181).\n'
        } >&2
    fi
    if (( ${#refuse[@]} > 0 )); then
        {
            printf 'ng wrap-up: REFUSED — %d unsettled async wait(s) with a real handle are on record for window %s:\n' "${#refuse[@]}" "$window"
            for tok in "${refuse[@]}"; do printf '    %s\n' "$tok"; done
            printf '  source: %s\n' "$sources"
            printf '  These are ANSWERABLE, and you still have the context to answer them. For each:\n'
            printf '    asyncrun:<id>  ->  monitor/async-run.sh --status-line <id>   (retained rc: terminal/died/running)\n'
            printf '    slurm:<jobid>  ->  sacct -j <jobid> --format=State,ExitCode\n'
            printf '  Then, ONLY once a wait is CONFIRMED not running, settle it deliberately:\n'
            printf '    monitor/declare-no-wait.sh <kind> <id>\n'
            printf '  and record what each answered in the report (a retained rc and a bare artefact are\n'
            printf '  DIFFERENT evidence — say which). RESUME is the default; an unconfirmed wait must not\n'
            printf '  be cleared, and this pre-flight clears nothing. Nothing was published, no marker was\n'
            printf '  touched (your-org/nexus-code#1181).\n'
        } >&2
        return 1
    fi
    return 0
}

# Does `window` carry a live operator-engagement mark? Lightweight
# ng-side mirror of the watcher's `_openg_marked` validity core (row
# seeded + pane-content change within the decay TTL + no newer
# `engaged-done`), reading the same state files the watcher writes:
#   - $STATE_DIR/operator-engaged.tsv   (row: since/last/…)
#   - $STATE_DIR/pane-change/<window>   (hash \t last_change_epoch)
#   - $STATE_DIR/action-log.jsonl       (engaged-done events)
# Used only to decide whether the interactive-wrap clarification
# prints — over-printing is harmless, so the spawn-lifecycle guard the
# watcher applies is deliberately omitted here.
_wrapup_window_engaged() {
    local window="$1"
    [[ -n "$window" ]] || return 1
    local row since last
    row=$(awk -F'\t' -v w="$window" '$1 == w { printf "%s\t%s", $2, $3; exit }' \
        "$STATE_DIR/operator-engaged.tsv" 2>/dev/null)
    [[ -n "$row" ]] || return 1
    IFS=$'\t' read -r since last <<<"$row"
    [[ "$since" =~ ^[0-9]+$ && "$last" =~ ^[0-9]+$ ]] || return 1
    (( since > 0 && last > 0 )) || return 1
    # Self-expiry mirror: mark holds only while the pane changed
    # within the decay TTL.
    local change_epoch ttl now
    change_epoch=$(awk -F'\t' 'NR == 1 { print $2; exit }' \
        "$STATE_DIR/pane-change/$window" 2>/dev/null)
    [[ "$change_epoch" =~ ^[0-9]+$ ]] || return 1
    ttl="${MONITOR_OPERATOR_ENGAGED_CHANGE_TTL_SECONDS:-}"
    if [[ ! "$ttl" =~ ^[0-9]+$ ]]; then
        ttl=$("$_cfg" monitor.operator_engaged_change_ttl_seconds 600 2>/dev/null) || ttl=600
        [[ "$ttl" =~ ^[0-9]+$ ]] || ttl=600
    fi
    now=$(date +%s)
    (( change_epoch > 0 && now - change_epoch <= ttl )) || return 1
    # Finished-signal mirror: a newer engaged-done already released it.
    local done_ts done_epoch
    done_ts=$(grep '"event":"engaged-done"' "$STATE_DIR/action-log.jsonl" 2>/dev/null \
        | tac \
        | jq -r --arg w "$window" 'select(.window == $w) | .ts' 2>/dev/null \
        | head -1)
    if [[ -n "$done_ts" ]]; then
        done_epoch=$(date -d "$done_ts" +%s 2>/dev/null) || done_epoch=""
        if [[ "$done_epoch" =~ ^[0-9]+$ ]] && (( done_epoch > since )); then
            return 1
        fi
    fi
    return 0
}

# `ng engaged-done [--window <name>]`
#
# The interactive session's explicit FINISHED-signal (the #205
# state-machine follow-up). A wrap-up from an operator-engaged window
# does NOT release the window — the engagement mark survives the
# hand-off so the operator's follow-up inquiries keep flowing without
# the watcher nagging or retiring the window. When the agent is
# genuinely done (no follow-up expected), this verb appends the
# `engaged-done` event the watcher's `_openg_marked` treats as an
# invalidation: the mark dies, and the window drops back to the
# typical wrapped-window cleanup path (retain footer → retire
# eligibility), exactly like a never-engaged worker that wrapped.
# A LATER operator prompt re-seeds a fresh engagement episode — the
# release is never a lock-out.
#
# Window resolution mirrors wrap-up's: the calling pane's tmux window
# via $TMUX_PANE; pass --window when invoking from outside the pane.
cmd_engaged_done() {
    _help_check "$@"
    local window_arg=""
    _argloop_prev_13=-1; while (( $# > 0 )); do (( $# != _argloop_prev_13 )) || _argloop_stuck "$1"; _argloop_prev_13=$#
        case "$1" in
            --window) _need_val --window "$#" "${2:-}"; window_arg="$2"; shift 2 ;;
            *) die "unknown flag: $(_arg_excerpt "$1")" ;;
        esac
    done
    local window="$window_arg"
    [[ -n "$window" ]] || window=$(_report_tmux_window)
    [[ -n "$window" ]] \
        || die "engaged-done: no tmux window resolvable — run inside the worker's pane or pass --window <name>"
    ( cmd_log_action monitor --event engaged-done --extra "window=$window" ) \
        || die "engaged-done: action-log append failed"
    printf 'engaged-done: %s released for normal cleanup (engagement mark invalidated; typical wrapped-window retire path applies; a new operator prompt re-engages)\n' \
        "$window"
}

# Fetch a github.com/user-attachments/{assets,files}/... URL via the
# user's PAT and write the bytes to disk. Bridges the bot's blind spot
# on user-pasted images: those URLs are scoped to user-OAuth credentials
# only; the App installation token returns 404 silently. See probe A in
# reports/nexus_2026-04-30_235529_hosted-survey.md.
#
# Two stages:
#   1. GET the user-attachments URL with `Authorization: Bearer <user-PAT>`
#      → expect 302 to a 5-min signed S3 URL (response body is empty).
#   2. GET the S3 URL → bytes (no auth; the signature is in the URL).
#
# Stage 1 deliberately uses `curl` with the user's `gh auth token`, NOT
# the bot's `api()` helper — the App credentials silently 404 here.
#
# Exit codes:
#   0  success
#   1  user input error (not a user-attachments URL, missing arg, unknown flag)
#   2  auth failure (gh auth token empty, or PAT rejected at stage 1)
#   3  fetch failure (stage 1 missing Location, stage 2 non-200, network)
#   4  --image-only set and content-type is not image/*
cmd_fetch_asset() {
    _help_check "$@"
    local url="" out="" image_only=0
    _argloop_prev_14=-1; while (( $# > 0 )); do (( $# != _argloop_prev_14 )) || _argloop_stuck "$1"; _argloop_prev_14=$#
        case "$1" in
            --out)        _need_val --out "$#" "${2:-}"; out="$2"; shift 2 ;;
            --image-only) image_only=1; shift   ;;
            -*)
                echo "ng fetch-asset: unknown flag: $(_arg_excerpt "$1")" >&2; exit 1 ;;
            *)
                if [[ -z "$url" ]]; then
                    url="$1"; shift
                else
                    echo "ng fetch-asset: unexpected positional: $(_arg_excerpt "$1")" >&2; exit 1
                fi
                ;;
        esac
    done
    [[ -n "$url" ]] || {
        echo "ng fetch-asset: usage: ng fetch-asset <user-attachments URL> [--out PATH] [--image-only]" >&2
        exit 1
    }
    [[ "$url" =~ ^https://github\.com/user-attachments/(assets|files)/ ]] || {
        echo "ng fetch-asset: not a github.com/user-attachments/{assets,files}/... URL: $url" >&2
        exit 1
    }

    local asset_id
    asset_id=$(awk -F/ '{ sub(/\?.*/,""); print $NF }' <<<"$url")
    [[ -n "$asset_id" ]] || { echo "ng fetch-asset: could not extract asset id from URL" >&2; exit 1; }

    # User PAT, NOT bot installation token. We deliberately read it
    # via `gh auth token` instead of forwarding $GH_TOKEN — bot tokens
    # 404 on this domain, and that's the entire reason this verb exists.
    #
    # locals-env.sh scopes GH_CONFIG_DIR to a credential-free dir (fail-closed
    # identity), so name the operator's config dir explicitly rather than
    # relying on gh-shim.sh being on PATH — this verb must keep working even
    # when the PATH-front wrapper is not reached.
    local user_pat opcfg=""
    if [[ -n "${NEXUS_OPERATOR_GH_CONFIG_DIR:-}" ]]; then
        opcfg="$NEXUS_OPERATOR_GH_CONFIG_DIR"
    elif [[ -n "${NEXUS_GH_CONFIG_SCOPED:-}" ]]; then
        opcfg="${XDG_CONFIG_HOME:-${HOME:-}/.config}/gh"
    fi
    if [[ -n "$opcfg" ]]; then
        user_pat=$(GH_CONFIG_DIR="$opcfg" gh auth token 2>/dev/null) || true
    else
        user_pat=$(gh auth token 2>/dev/null) || true
    fi
    [[ -n "$user_pat" ]] || {
        echo "ng fetch-asset: gh auth token returned empty; user PAT required (run: gh auth login)" >&2
        exit 2
    }

    local h1 h2
    h1=$(mktemp); h2=$(mktemp)
    trap "rm -f '$h1' '$h2'" RETURN

    local s1_status
    s1_status=$(curl -sS -o /dev/null -D "$h1" -w '%{http_code}' \
        -H "Authorization: Bearer $user_pat" \
        -H "Accept: application/octet-stream" \
        "$url") || { echo "ng fetch-asset: stage 1 curl failed (network?)" >&2; exit 3; }

    case "$s1_status" in
        302|303) ;;
        401|403)
            echo "ng fetch-asset: stage 1 returned $s1_status — user PAT rejected (token expired or insufficient scopes)" >&2
            exit 2 ;;
        404)
            cat >&2 <<'EOF'
ng fetch-asset: user-attachments URL not accessible to bot or user PAT (GitHub requires browser-session auth for this surface).

Workaround: ask the user to place the file locally under work/<project>/
and reference it by absolute path, or post the issue/comment number it's
attached to so the file can be downloaded via the issue's REST timeline
surface (e.g. gh api repos/<owner>/<repo>/issues/<N>/timeline for inline
images attached to issue or comment bodies). Stop attempting fetches
through this verb and route the gap to the user.
EOF
            exit 3 ;;
        *)
            echo "ng fetch-asset: stage 1 returned unexpected status $s1_status" >&2
            exit 3 ;;
    esac

    local location
    location=$(awk 'BEGIN{IGNORECASE=1} /^[Ll]ocation:/ { sub(/^[Ll]ocation: */,""); sub(/\r$/,""); print; exit }' "$h1")
    [[ -n "$location" ]] || { echo "ng fetch-asset: stage 1 redirect missing Location header" >&2; exit 3; }

    if [[ -z "$out" ]]; then
        # Default path: monitor/.state/assets/<asset-id><ext>. Extension
        # comes from the S3 URL basename (canonical) or the
        # response-content-type query param GitHub sets on the signed URL.
        local s3_basename ext=""
        s3_basename=$(awk -F/ '{ sub(/\?.*/,""); print $NF }' <<<"$location")
        if [[ "$s3_basename" == *.* ]]; then
            ext=".${s3_basename##*.}"
        elif [[ "$location" =~ response-content-type=([^&]+) ]]; then
            local ct="${BASH_REMATCH[1]}"
            ct="${ct//%2F//}"; ct="${ct//%2f//}"
            case "$ct" in
                image/png)            ext=".png"  ;;
                image/jpeg|image/jpg) ext=".jpg"  ;;
                image/gif)            ext=".gif"  ;;
                image/webp)           ext=".webp" ;;
                image/svg+xml)        ext=".svg"  ;;
                application/pdf)      ext=".pdf"  ;;
                *)                    ext=".bin"  ;;
            esac
        else
            ext=".bin"
        fi
        mkdir -p "$STATE_DIR/assets"
        out="$STATE_DIR/assets/${asset_id}${ext}"
    else
        local out_dir
        out_dir=$(dirname -- "$out")
        mkdir -p "$out_dir"
    fi

    # Stage 2: signed S3 URL, no auth. -f makes 4xx/5xx fail-fast so
    # we don't leave a 0-byte / error-body file on disk.
    local s2_status
    s2_status=$(curl -sS -f -o "$out" -D "$h2" -w '%{http_code}' "$location") || {
        echo "ng fetch-asset: stage 2 curl failed (S3 signed URL expired or denied; status=$s2_status)" >&2
        rm -f "$out"
        exit 3
    }
    [[ "$s2_status" == "200" ]] || {
        echo "ng fetch-asset: stage 2 returned $s2_status (expected 200)" >&2
        rm -f "$out"
        exit 3
    }

    local content_type byte_count
    content_type=$(awk 'BEGIN{IGNORECASE=1} /^[Cc]ontent-[Tt]ype:/ { sub(/^[Cc]ontent-[Tt]ype: */,""); sub(/\r$/,""); print; exit }' "$h2")
    [[ -n "$content_type" ]] || content_type="application/octet-stream"
    byte_count=$(stat -c %s "$out" 2>/dev/null || wc -c < "$out")

    if (( image_only == 1 )) && [[ ! "$content_type" =~ ^image/ ]]; then
        echo "ng fetch-asset: --image-only set but content-type is $content_type" >&2
        rm -f "$out"
        exit 4
    fi

    printf 'path=%s\ncontent_type=%s\nbytes=%s\n' "$out" "$content_type" "$byte_count"
}

cmd_issue() {
