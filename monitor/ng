# `ng respawn <window | session-id>` — the canonical "bring a
# wrapped/closed worker's session back" verb. Thin wrapper over
# `monitor/spawn-worker.sh --resume`: all the resolution (session-id
# from report frontmatter / window-close events / project-dir jsonl,
# workdir from pane / events / spawn-prompt cache) and all the spawn
# parity (NEXUS_ROOT + NEXUS_WORKER_WINDOW exports, worker-settings
# hooks, window options, lifecycle anchors) live there; this verb just
# routes so the operator surface matches the other window-lifecycle
# verbs (spawn-decision, wrap-up-check).
cmd_respawn() {
    _help_check "$@"
    # Positionals and flags interleave (your-org/nexus-code#906 C). This verb
    # already REFUSED a leading flag loudly — `"$target" != --*` — but it
    # refused with a usage dump rather than working, which is the wording fix
    # `#858 B` explicitly ranked below simply accepting either order. The
    # `args` array is now built AFTER the loop, because `--resume "$target"`
    # has to come first and the target may now arrive last.
    local target=""
    local -a args=()
    _argloop_prev_28=-1; while (( $# > 0 )); do (( $# != _argloop_prev_28 )) || _argloop_stuck "$1"; _argloop_prev_28=$#
        case "$1" in
            --window)   [[ -n "${2:-}" ]] || die "respawn: --window needs a value";  args+=( -n "$2" ); shift 2 ;;
            --workdir)  [[ -n "${2:-}" ]] || die "respawn: --workdir needs a value"; args+=( -c "$2" ); shift 2 ;;
            --replace)  args+=( --replace ); shift ;;
            --dry-run)  args+=( --dry-run ); shift ;;
            --nudge)    args+=( --nudge ); shift ;;
            --no-nudge) args+=( --no-nudge ); shift ;;
            --*) die "respawn: unknown flag: $(_arg_excerpt "$1")" ;;
            *)  if [[ -z "$target" ]]; then target="$1"
                else die "respawn: unexpected POSITIONAL argument $(_arg_excerpt "$1"). Flags must start with --; positionals are matched in order."; fi
                shift ;;
        esac
    done
    [[ -n "$target" ]] \
        || die "usage: ng respawn <window | session-id> [--window N] [--workdir P] [--replace] [--dry-run]"
    exec "$_script_dir/spawn-worker.sh" --resume "$target" "${args[@]}"
}

# `ng spawn-decision <window>` — advisory helper that classifies a
# retained worker window as continue-vs-spawn material per the policy
# in `skills/nexus.window-cleanup` (Continue-vs-spawn section).
# Issue #72 D5.
#
# Inputs:
#   <window>          — tmux window name to evaluate
#   --topic <slug>    — optional. The topic of the new task. When omitted,
#                        the helper assumes topic-match (caller already
#                        decided the routing applies to this window).
#
# Output (stdout, key=value, machine-parseable):
#   decision=<continue|spawn|ambiguous> reason=<short>
#   pane_state=<state> retain_age_s=<n|none> spawn_age_s=<n|none>
#
# Exit codes:
#   0  decision rendered (regardless of which class)
#   1  window unknown to tmux / classifier couldn't run
cmd_spawn_decision() {
    _help_check "$@"
    local window=""
    local topic=""
    _argloop_prev_29=-1; while (( $# > 0 )); do (( $# != _argloop_prev_29 )) || _argloop_stuck "$1"; _argloop_prev_29=$#
        case "$1" in
            --topic) _need_val --topic "$#" "${2:-}"; topic="$2"; shift 2 ;;
            --*) die "unknown flag: $(_arg_excerpt "$1")" ;;
            *)  if [[ -z "$window" ]]; then window="$1"
                else die "unexpected POSITIONAL argument $(_arg_excerpt "$1"). Flags must start with --; positionals are matched in order."; fi
                shift ;;
        esac
    done
    [[ -n "$window" ]] || die "usage: ng spawn-decision <window> [--topic <slug>]"
    command -v tmux >/dev/null 2>&1 \
        || { echo "decision=ambiguous reason=no-tmux"; return 1; }
    # your-org/nexus-code#802 — the enumeration's rc used to be DISCARDED, so
    # a FAILED `tmux list-windows` (wedged or down server; `tmux` still on
    # PATH, so the guard above passes) produced byte-identical output to a
    # genuinely-missing window: `decision=spawn reason=window-absent` at rc 0.
    # The failure arm was the one that AUTHORISED action — spawning a
    # duplicate into a session that may already hold that window, the
    # decapitation-duplicate shape skills/nexus.watcher has a recovery recipe
    # for. It is the #788 shape (silence used as a proxy for absence) in a
    # second producer, and it is this workspace's dominant defect class.
    #
    # Keep the rc and split the two facts. `ambiguous` is already in this
    # verb's output vocabulary and already means "do not act on this", so the
    # honest answer needs no new state — only that the failure stop being
    # routed to the confident one. rc 1 matches the documented contract
    # ("1 — window unknown to tmux / classifier couldn't run"), which this
    # arm satisfied all along while exiting 0.
    #
    # NOT changed here, deliberately: this call omits `-a`, so it enumerates
    # the CURRENT SESSION only while much of the nexus addresses windows by
    # name across the server. That is a real inconsistency (`ng`'s own
    # live-skeptic probe uses `-a`; `spawn-worker.sh`'s collision check does
    # NOT) but it is a behaviour change with its own spawn-collision
    # consequences, not the rc-blindness filed in #802. Fixing it silently
    # inside this diff is the scope creep the issue explicitly declined to
    # assume.
    local windows_csv
    if ! windows_csv=$(tmux list-windows -F '#{window_name}' 2>/dev/null); then
        echo "decision=ambiguous reason=enumeration-failed pane_state=unknown retain_age_s=none spawn_age_s=none"
        return 1
    fi
    if ! grep -qxF "$window" <<<"$windows_csv"; then
        echo "decision=spawn reason=window-absent pane_state=absent retain_age_s=none spawn_age_s=none"
        return 0
    fi
    # Pane state.
    local pane_state="unknown"
    if [[ -x "$_script_dir/pane-state.sh" ]]; then
        local line
        line=$("$_script_dir/pane-state.sh" --all 2>/dev/null \
                 | awk -v w="$window" -F'[ =]' '
                     {for(i=1;i<=NF;i+=2) kv[$i]=$(i+1)}
                     kv["name"]==w {print kv["state"]; exit}
                  ')
        [[ -n "$line" ]] && pane_state="$line"
    fi
    # Lifecycle anchors (issue #72): spawn ts + last retain ts.
    local log_file="$STATE_DIR/action-log.jsonl"
    local now spawn_age_s retain_age_s
    now=$(date +%s)
    spawn_age_s="none"
    retain_age_s="none"
    if [[ -f "$log_file" ]] && command -v jq >/dev/null 2>&1; then
        local spawn_ts retain_ts
        spawn_ts=$(grep '"event":"spawn"' "$log_file" 2>/dev/null \
                     | tac \
                     | jq -r --arg w "$window" 'select(.window==$w) | .ts' 2>/dev/null \
                     | head -1)
        retain_ts=$(grep '"event":"window-retain"' "$log_file" 2>/dev/null \
                     | tac \
                     | jq -r --arg w "$window" 'select(.window==$w) | .ts' 2>/dev/null \
                     | head -1)
        if [[ -n "$spawn_ts" ]]; then
            local spawn_epoch
            spawn_epoch=$(date -d "$spawn_ts" +%s 2>/dev/null || echo "")
            [[ "$spawn_epoch" =~ ^[0-9]+$ ]] && spawn_age_s=$(( now - spawn_epoch ))
        fi
        if [[ -n "$retain_ts" ]]; then
            local retain_epoch
            retain_epoch=$(date -d "$retain_ts" +%s 2>/dev/null || echo "")
            [[ "$retain_epoch" =~ ^[0-9]+$ ]] && retain_age_s=$(( now - retain_epoch ))
        fi
    fi
    # Decision policy mirrors skills/nexus.window-cleanup Continue-vs-spawn.
    local retain_ttl
    retain_ttl=$("$_script_dir/../config/load.sh" monitor.retain_ttl_seconds 86400 2>/dev/null || echo 86400)
    local decision="continue" reason="default-continue"
    case "$pane_state" in
        busy|user-typing)
            decision="ambiguous"
            reason="pane-mid-flight-queue-as-paste-buffer-followup" ;;
        blocked)
            decision="spawn"
            reason="pane-blocked-fresh-spawn-after-triage" ;;
        absent)
            decision="spawn"
            reason="pane-absent-fresh-spawn" ;;
        idle|autosuggest-only|empty)
            if [[ "$retain_age_s" == "none" ]]; then
                decision="spawn"
                reason="no-retain-on-record"
            elif (( retain_age_s > retain_ttl )); then
                decision="spawn"
                reason="retain-ttl-expired"
            else
                decision="continue"
                reason="retained-and-idle"
            fi ;;
        *)
            decision="ambiguous"
            reason="pane-state-unknown" ;;
    esac
    printf 'decision=%s reason=%s pane_state=%s retain_age_s=%s spawn_age_s=%s\n' \
        "$decision" "$reason" "$pane_state" "$retain_age_s" "$spawn_age_s"
    return 0
}

# `ng wrap-up-check <window>` — verify a worker has completed all
# wrap-up obligations before the orchestrator closes its window.
# Issue #72 D5. Independent of `ng wrap-up`'s pre-flight (which
# fires before the worker has uploaded anything); this verifies the
# post-conditions:
#
#   1. action-log carries a `wrap-up` event for the window (current
#      lifecycle — i.e. ts > most-recent spawn ts).
#   2. The cited report exists on disk and passes `ng report-check`.
#   3. A trigger-comment was rocketed, OR the worker explicitly
#      opted out via `--no-trigger` at wrap-up time (verifier passes
#      either way).
#
# Output (stdout):
#   status=<ok|incomplete> wrap_up=<present|missing>
#   report_check=<ok|fail|missing> rocket=<ok|skipped|missing>
#
# Exit codes:
#   0  status=ok — safe to close
#   1  status=incomplete — at least one obligation missing
cmd_wrap_up_check() {
    _help_check "$@"
    local window="${1:-}"
    [[ -n "$window" ]] || die "usage: ng wrap-up-check <window>"
    local log_file="$STATE_DIR/action-log.jsonl"
    local wrap_up_st="missing" report_check_st="missing" rocket_st="skipped"
    # your-org/nexus-code#1116 review, F1. Defaults to `ok` deliberately, and
    # the `*)` arm below maps an EMPTY `.comment` to `ok` for the same reason:
    # wrap-up events written before `.comment` existed carry no such field, and
    # treating "the field is absent" as "nothing was published" would mark every
    # historical window incomplete at once. Absence of the field is not evidence
    # of an unpublished comment; a NAMED unpublished state is. When no wrap-up
    # event is found at all, `wrap_up_st=missing` already blocks the status, so
    # this default never stands in for a missing hand-off.
    local comment_st_check="ok"
    local entry_report=""
    if [[ -f "$log_file" ]] && command -v jq >/dev/null 2>&1; then
        # Most-recent spawn ts (lifecycle anchor; pre-spawn entries
        # don't count).
        local spawn_ts spawn_epoch=0
        spawn_ts=$(grep '"event":"spawn"' "$log_file" 2>/dev/null \
                     | tac \
                     | jq -r --arg w "$window" 'select(.window==$w) | .ts' 2>/dev/null \
                     | head -1)
        if [[ -n "$spawn_ts" ]]; then
            spawn_epoch=$(date -d "$spawn_ts" +%s 2>/dev/null || echo 0)
        fi
        # Walk wrap-up events newest-first; take the first whose ts >
        # spawn ts (or any when spawn anchor is missing).
        local entry_ts entry_epoch entry_window entry_rocket entry_comment
        while IFS=$'\t' read -r entry_window entry_ts entry_report entry_rocket entry_comment; do
            [[ -n "$entry_report" ]] || continue
            if [[ "$entry_window" != "$window" ]]; then continue; fi
            if (( spawn_epoch > 0 )) && [[ -n "$entry_ts" && "$entry_ts" != "_NULL_" ]]; then
                entry_epoch=$(date -d "$entry_ts" +%s 2>/dev/null || echo 0)
                if [[ "$entry_epoch" =~ ^[0-9]+$ ]] \
                   && (( entry_epoch < spawn_epoch )); then
                    continue
                fi
            fi
            wrap_up_st="present"
            # Rocket status field was added by `ng wrap-up` step 3.
            #
            # your-org/nexus-code#1116 review, F1. This `case` used to end
            # `*) rocket_st="ok" ;;` — a hand-enumerated state list with a
            # PERMISSIVE default arm, which is the exact structure CLAUDE.md
            # says never to make a kill decision from, sitting on the path that
            # decides a WORKER is done. `#1114` then added the spelling
            # `skipped-nothing-published`, which no arm here enumerated, so a
            # wrap-up that deliberately withheld the rocket was read as `ok`.
            # Default-DENY: a status this gate has never heard of is not a
            # clearance, it is an unknown, and an unknown must not retire
            # anybody.
            case "$entry_rocket" in
                ok|skipped|"")            rocket_st="ok" ;;
                failed)                   rocket_st="missing" ;;
                skipped-nothing-published) rocket_st="withheld" ;;
                *)                        rocket_st="unknown" ;;
            esac
            # your-org/nexus-code#1116 review, F1 — THE OUTCOME, not merely the
            # event. This gate read `.window`, `.ts`, `.report` and `.rocket`
            # and never `.comment`, so a wrap-up that published NOTHING
            # (`#1114` degenerate-teaser, `#862` nothing-published) produced a
            # status BYTE-IDENTICAL to one that published: measured
            # `status=ok wrap_up=present report_check=ok rocket=ok`, rc 0, for
            # both. That is this PR's own argument — the marker of a delivery
            # without the delivery — left unapplied one layer up, where the
            # same marker retires the worker rather than the mention.
            case "$entry_comment" in
                degenerate-teaser|nothing-published) comment_st_check="unpublished" ;;
                failed)                              comment_st_check="failed" ;;
                *)                                   comment_st_check="ok" ;;
            esac
            break
        done < <(grep '"event":"wrap-up"' "$log_file" \
                    | tac \
                    | jq -r '[(.window // ""), (.ts // "_NULL_"), (.report // ""), (.rocket // ""), (.comment // "")] | @tsv' 2>/dev/null)
    fi
    # Report-check (only when we found a basename to check).
    if [[ -n "$entry_report" ]]; then
        local report_path=""
        if [[ -n "${NEXUS_ROOT:-}" && -f "$NEXUS_ROOT/reports/$entry_report" ]]; then
            report_path="$NEXUS_ROOT/reports/$entry_report"
        elif [[ -f "reports/$entry_report" ]]; then
            report_path="reports/$entry_report"
        fi
        if [[ -n "$report_path" ]]; then
            if cmd_report_check "$report_path" >/dev/null 2>&1; then
                report_check_st="ok"
            else
                report_check_st="fail"
            fi
        else
            report_check_st="missing"
        fi
    fi
    local status="incomplete"
    # your-org/nexus-code#1116 review, F1. `rocket_st` is now compared
    # POSITIVELY (`== ok`) rather than against a denylist of one value: the
    # old `!= missing` admitted `withheld` and `unknown` — every state nobody
    # had thought of — which is the same permissive-default shape as the
    # `case` above, one line further down.
    if [[ "$wrap_up_st" == "present" \
          && "$report_check_st" == "ok" \
          && "$rocket_st" == "ok" \
          && "$comment_st_check" == "ok" ]]; then
        status="ok"
    fi
    printf 'status=%s wrap_up=%s report_check=%s rocket=%s comment=%s\n' \
        "$status" "$wrap_up_st" "$report_check_st" "$rocket_st" "$comment_st_check"
    [[ "$status" == "ok" ]]
}

# `ng interactive-sessions [--limit N] [--days D] [--upsert-overview] [--dry-run]`
#
# Enumerate recently paused/closed interactive windows from their
# provenance records (monitor/.state/windows/<window>.json, written by
# spawn-worker.sh --kind interactive) and render a markdown section that
# the operator (or a fresh orchestrator) can use to identify and resume
# paused sessions.
#
# The section is bounded by HTML-comment delimiters and idempotently
# upserted into the overview issue body on --upsert-overview, so
# repeated runs replace the block in-place (no drift, no duplication).
# The bot identity (REST PATCH) is used for the GitHub write.
#
# --limit N     include at most N sessions (default 20)
# --days D      only include sessions active within the last D days (default 30)
# --upsert-overview  PATCH the block into the overview issue body
# --dry-run     print the rendered block; skip the GitHub PATCH
#
# Exit codes:
#   0  success (rendered; patched if --upsert-overview and not --dry-run)
#   1  error (write failed)
cmd_interactive_sessions() {
    _help_check "$@"
    local limit=20 days=30 upsert=0 dry_run=0 repo_arg=""
    _argloop_prev_30=-1; while (( $# > 0 )); do (( $# != _argloop_prev_30 )) || _argloop_stuck "$1"; _argloop_prev_30=$#
        case "$1" in
            --limit)           _need_val --limit "$#" "${2:-}"; limit="$2";    shift 2 ;;
            --days)            _need_val --days "$#" "${2:-}"; days="$2";     shift 2 ;;
            --upsert-overview) upsert=1;          shift   ;;
            --dry-run)         dry_run=1;         shift   ;;
            --repo)            _need_val --repo "$#" "${2:-}"; repo_arg="$2"; shift 2 ;;
            *) die "unknown flag: $(_arg_excerpt "$1")" ;;
        esac
    done
    [[ "$limit" =~ ^[0-9]+$ && "$limit" -gt 0 ]] || die "interactive-sessions: --limit must be a positive integer"
    [[ "$days"  =~ ^[0-9]+$ && "$days"  -gt 0 ]] || die "interactive-sessions: --days must be a positive integer"

    # Resolve the nexus root: env override, then script-relative.
    local nexus_root="${NEXUS_ROOT:-}"
    [[ -n "$nexus_root" ]] || nexus_root=$(cd "$_script_dir/.." && pwd)
    local windows_dir="$nexus_root/monitor/.state/windows"
    local action_log="$STATE_DIR/action-log.jsonl"

    local cutoff_epoch
    cutoff_epoch=$(date -d "-${days} days" +%s 2>/dev/null || date -v -"${days}"d +%s 2>/dev/null || echo 0)

    # Collect interactive-kind provenance records.
    # Each record: window, session_id, kind, workdir, topic, spawned_at.
    # We also consult window-close action-log events to identify closed windows.
    local -a sessions=()
    local -a elided_names=()
    local total_found=0

    if [[ -d "$windows_dir" ]] && command -v jq >/dev/null 2>&1; then
        # Build a set of closed windows from the action log (newest close first).
        declare -A closed_at
        if [[ -f "$action_log" ]]; then
            while IFS=$'\t' read -r cwin cts; do
                [[ -n "$cwin" && -n "$cts" ]] || continue
                closed_at["$cwin"]="$cts"
            done < <(grep '"event":"window-close"' "$action_log" 2>/dev/null \
                | tac \
                | jq -r '[(.window // ""), (.ts // "")] | @tsv' 2>/dev/null \
                | awk -F'\t' '!seen[$1]++')
        fi

        # Walk provenance files, newest-spawned first (sort by spawned_at field).
        local f win topic session_id workdir spawned_at spawned_epoch kind status resume_cmd
        while IFS= read -r f; do
            [[ -f "$f" ]] || continue
            kind=$(jq -r '.kind // "task"' "$f" 2>/dev/null)
            [[ "$kind" == "interactive" ]] || continue
            win=$(jq -r '.window // ""' "$f" 2>/dev/null)
            [[ -n "$win" ]] || continue
            topic=$(jq -r '.topic // ""' "$f" 2>/dev/null)
            [[ -n "$topic" ]] || topic="$win"
            session_id=$(jq -r '.session_id // ""' "$f" 2>/dev/null)
            workdir=$(jq -r '.workdir // ""' "$f" 2>/dev/null)
            spawned_at=$(jq -r '.spawned_at // ""' "$f" 2>/dev/null)
            spawned_epoch=0
            if [[ -n "$spawned_at" ]]; then
                spawned_epoch=$(date -d "$spawned_at" +%s 2>/dev/null || echo 0)
            fi

            # Status: open (window still in tmux), closed, or unknown.
            if [[ -n "${closed_at[$win]:-}" ]]; then
                status="closed (${closed_at[$win]%%T*})"
            elif command -v tmux >/dev/null 2>&1 \
                 && grep -Fxq -- "$win" <<<"$(tmux list-windows -F '#W' 2>/dev/null)"; then
                status="open"
            else
                status="paused"
            fi

            # Cutoff: skip sessions with no activity sign within --days.
            # Use heartbeat mtime or spawned_at as activity proxy.
            local hb_ref="$nexus_root/monitor/.state/heartbeat/$win.json"
            local activity_epoch="$spawned_epoch"
            if [[ -f "$hb_ref" ]]; then
                local hb_mtime
                hb_mtime=$(stat -c '%Y' "$hb_ref" 2>/dev/null || echo 0)
                [[ "$hb_mtime" =~ ^[0-9]+$ ]] && (( hb_mtime > activity_epoch )) && activity_epoch="$hb_mtime"
            fi
            (( activity_epoch >= cutoff_epoch )) || { elided_names+=("$win"); continue; }

            total_found=$(( total_found + 1 ))
            if (( total_found > limit )); then
                elided_names+=("$win")
                continue
            fi

            resume_cmd="monitor/spawn-worker.sh --resume $win"
            sessions+=("${win}|${topic}|${status}|${spawned_at%%T*}|${resume_cmd}")
        done < <(
            # Sort provenance files by spawned_at field descending (newest first).
            for f2 in "$windows_dir"/*.json; do
                [[ -f "$f2" ]] || continue
                local sa; sa=$(jq -r '.spawned_at // "0000"' "$f2" 2>/dev/null || echo "0000")
                printf '%s\t%s\n' "$sa" "$f2"
            done | sort -rk1,1 | awk -F'\t' '{print $2}'
        )
    fi

    # Render the markdown section.
    local elided_count=${#elided_names[@]}
    local elided_note=""
    if (( elided_count > 0 )); then
        elided_note="_Showing ${#sessions[@]} of $(( ${#sessions[@]} + elided_count )) interactive sessions (last ${days} days). ${elided_count} elided: $(printf '%s, ' "${elided_names[@]}" | sed 's/, $//')._"
    else
        elided_note="_Showing ${#sessions[@]} interactive sessions (last ${days} days)._"
    fi

    local block
    block=$(cat <<'MARKDOWN_EOF'
<!-- interactive-sessions:start -->
## Resumable Interactive Sessions

The orchestrator can resume any session below by running the listed command (or equivalently `monitor/ng respawn <window-name>`). Sessions are spawned with `--kind interactive` and are auto-retired after extended inactivity.

MARKDOWN_EOF
)
    if (( ${#sessions[@]} == 0 )); then
        block+=$'\n| Window | Topic | Status | Spawned | Resume Command |\n'
        block+=$'|--------|-------|--------|---------|----------------|\n'
        block+=$'| — | no interactive sessions recorded | — | — | — |\n'
    else
        block+=$'\n| Window | Topic | Status | Spawned | Resume Command |\n'
        block+=$'|--------|-------|--------|---------|----------------|\n'
        local entry
        for entry in "${sessions[@]}"; do
            IFS='|' read -r e_win e_topic e_status e_date e_cmd <<<"$entry"
            block+="| \`${e_win}\` | ${e_topic} | ${e_status} | ${e_date} | \`${e_cmd}\` |"$'\n'
        done
    fi
    block+=$'\n'"${elided_note}"$'\n'
    block+=$'<!-- interactive-sessions:end -->'

    printf '%s\n' "$block"

    # Upsert into overview issue body when --upsert-overview.
    if (( upsert == 1 )) && (( dry_run == 0 )); then
        local target; target=$(_resolve_repo write "$repo_arg") || exit $?
        local overview_number
        overview_number=$("$_cfg" github.overview_issue 1 2>/dev/null || echo 1)
        [[ "$overview_number" =~ ^[0-9]+$ ]] || overview_number=1

        # Fetch current body.
        local current_body
        current_body=$(api "/repos/$target/issues/$overview_number" 2>/dev/null \
            | jq -r '.body // ""') \
            || die "interactive-sessions: failed to fetch overview issue body"

        # Idempotent upsert: replace existing delimited block, or append.
        # your-org/nexus-code#959 THIRD population member — found by deriving
        # the population from the PROPERTY (`in_block=1; print block`) rather
        # than from `#959`'s marker name, which could not have seen it. Same
        # emit-on-every-match shape, same overview issue.
        _assert_single_marker_pair "interactive-sessions" "interactive-sessions" "$current_body"
        local new_body
        new_body=$(_upsert_marked_block "interactive-sessions" "$current_body" "$block")

        # your-org/nexus-code#1118 — third body-writing PATCH to an issue, and
        # it too discarded the response and announced "upserted" regardless.
        local _is_tmp _is_rc
        _is_tmp=$(mktemp)
        printf '%s' "$new_body" > "$_is_tmp"
        _patch_issue_body "$target" "$overview_number" "$_is_tmp" "interactive-sessions" >/dev/null
        _is_rc=$?
        rm -f "$_is_tmp"
        if (( _is_rc != 0 )); then
            printf 'ng: interactive-sessions: the block was NOT upserted.\n' >&2
            return "$_is_rc"
        fi
        printf 'upserted interactive-sessions block into %s #%s\n' "$target" "$overview_number" >&2
    elif (( dry_run == 1 )); then
        printf '(dry-run: block above NOT patched into overview issue)\n' >&2
    fi
}

# ---- service-incident generator (service-health-watch) ----
#
# Assemble a structured incident report for a registered service FROM
# THE RECORDED STATE — the per-service incident files the watcher's
# service_health task writes under monitor/.state/service-health/
# (<name>.state current-incident record + <name>.events append-only
# history) plus the service logfile. Machine facts (down→restored
# timestamps, the failing healthcheck, every restart attempt + outcome)
# are filled FROM the state so the human-written prose can't drift from
# what actually happened. The root-cause / how-to-undo sections are
# templated placeholders the dispatched fix-worker fills in.
#
# Emits markdown to stdout (the operator pipes it to `ng issue create
# --body-file -` or saves it). The required sections — Failure report /
# Immediate response / Root-cause fix (with how-to-undo) / References /
# Worker report — match skills/nexus.service-recovery and the operator's
# spec verbatim.
_sh_incident_field() {
    # awk key=value reader over a state file (mirrors _version_field).
    local file="$1" key="$2"
    [[ -f "$file" ]] || return 1
    awk -F= -v k="$key" '$1==k { sub(/^[^=]*=/, ""); print; exit }' "$file"
}

cmd_service_incident() {
    _help_check "$@"
    local svc=""
    local state_dir_arg=""
    _argloop_prev_31=-1; while (( $# > 0 )); do (( $# != _argloop_prev_31 )) || _argloop_stuck "$1"; _argloop_prev_31=$#
        case "$1" in
            --state-dir) _need_val --state-dir "$#" "${2:-}"; state_dir_arg="$2"; shift 2 ;;
            --*) die "unknown flag: $(_arg_excerpt "$1")" ;;
            *)  if [[ -z "$svc" ]]; then svc="$1"
                else die "unexpected POSITIONAL argument $(_arg_excerpt "$1"). Flags must start with --; positionals are matched in order."; fi
                shift ;;
        esac
    done
    [[ -n "$svc" ]] || die "usage: ng service-incident <svc> [--state-dir <path>]"

    local sh_dir="${state_dir_arg:-$STATE_DIR/service-health}"
    local sf="$sh_dir/${svc}.state"
    local ef="$sh_dir/${svc}.events"
    if [[ ! -f "$sf" && ! -f "$ef" ]]; then
        die "service-incident: no recorded state for '$svc' under $sh_dir (no ${svc}.state or ${svc}.events). Is the name a registry service that has had an incident?"
    fi

    local status policy first_iso recovered_iso recovered_via attempts health logfile workdir note last_check_iso grace_seconds
    status=$(_sh_incident_field "$sf" status 2>/dev/null || echo unknown)
    policy=$(_sh_incident_field "$sf" policy 2>/dev/null || echo "auto-restart")
    first_iso=$(_sh_incident_field "$sf" first_unhealthy_iso 2>/dev/null || echo unknown)
    recovered_iso=$(_sh_incident_field "$sf" recovered_at_iso 2>/dev/null || echo "—")
    recovered_via=$(_sh_incident_field "$sf" recovered_via 2>/dev/null || echo "")
    attempts=$(_sh_incident_field "$sf" restart_attempts 2>/dev/null || echo 0)
    health=$(_sh_incident_field "$sf" health_cmd 2>/dev/null || echo unknown)
    logfile=$(_sh_incident_field "$sf" logfile 2>/dev/null || echo "")
    workdir=$(_sh_incident_field "$sf" workdir 2>/dev/null || echo "")
    note=$(_sh_incident_field "$sf" note 2>/dev/null || echo "")
    last_check_iso=$(_sh_incident_field "$sf" last_check_iso 2>/dev/null || echo "")
    grace_seconds=$(_sh_incident_field "$sf" grace_seconds 2>/dev/null || echo "")

    # Human-readable current-state line + restart outcome derived from the
    # machine record — never invented.
    local restart_outcome
    case "$status" in
        recovered)
            if [[ "$recovered_via" == self-healed* ]]; then
                restart_outcome="RECOVERED — ${recovered_via}; restored ~${recovered_iso} (watcher did not restart)."
            else
                restart_outcome="RECOVERED — auto-restart held after ${attempts} attempt(s); restored ~${recovered_iso}."
            fi ;;
        flapping)  restart_outcome="NOT RECOVERED (flapping) — ${attempts} auto-restart attempt(s) did not hold; escalated to the orchestrator." ;;
        recovering) restart_outcome="IN PROGRESS — ${attempts} auto-restart attempt(s) issued; awaiting verification at last check ${last_check_iso}." ;;
        emit-only) restart_outcome="NOT RECOVERED (emit-only policy) — watcher did NOT auto-restart by policy; escalated to the orchestrator for a decision." ;;
        grace)     restart_outcome="IN GRACE — unhealthy, within the ${grace_seconds:-?}s self-heal grace window; watcher has NOT acted yet (deferring to the supervisor)." ;;
        down)      restart_outcome="DOWN — auto-restart underway (${attempts} attempt(s))." ;;
        *)         restart_outcome="status='${status}', ${attempts} restart attempt(s)." ;;
    esac

    local workdir_note=""
    [[ -n "$workdir" ]] && workdir_note=" (workdir \`$workdir\`)"

    # Plain-language status + the single clearest next action, keyed off the
    # same machine status. An operator who only knows biology + basic compute
    # reads THIS, not the restart-attempt internals above.
    local plain_status plain_action
    case "$status" in
        recovered)
            plain_status="already came back on its own"
            plain_action="**Nothing is required of you** — it recovered automatically. This issue is just a record; you can close it once you've read it." ;;
        recovering)
            plain_status="is restarting automatically right now"
            plain_action="**Give it a minute,** then check whether it's working again. If it does not come back, restart the workspace using the steps below." ;;
        grace)
            plain_status="had a brief hiccup and is being given a moment to recover on its own"
            plain_action="**Usually nothing** — wait a moment and it should recover. If it does not, restart the workspace using the steps below." ;;
        down)
            plain_status="went down and an automatic restart is already underway"
            plain_action="**Give it a minute.** If it does not come back, restart the workspace using the steps below." ;;
        flapping)
            plain_status="is **still down** — the automatic restarts did not hold"
            plain_action="**Restart the workspace** using the steps below." ;;
        emit-only)
            plain_status="is **down**, and it is deliberately set to NOT restart itself (a human decides)"
            plain_action="**Restart the workspace** using the steps below (the workspace's automated agent may also handle it for you)." ;;
        *)
            plain_status="changed state (\`$status\`)"
            plain_action="If \`$svc\` is not working, restart the workspace using the steps below." ;;
    esac

    # The recovery runbook needs the nexus root for the copy-paste restart
    # command (same derivation as cmd_nexus_identity / cmd_report_init).
    local nexus_root="${NEXUS_ROOT:-}"
    [[ -n "$nexus_root" ]] || nexus_root=$(cd "$_script_dir/.." && pwd)

    printf '# Service incident: `%s`\n\n' "$svc"

    # ---- Operator-friendly opening (issue: many operators are biologists
    # with only basic compute knowledge) -------------------------------------
    # Lead with a plain-language TL;DR + a copy-pasteable recovery runbook
    # BEFORE any machine facts. The detach / `watcher --continue` procedure
    # mirrors the EROFS-incident body in monitor/watcher/_lib.sh
    # (_nexus_incident_issue_body) verbatim, so the operator meets the SAME
    # recovery steps everywhere a workspace restart is the fix.
    printf '> **In plain terms (no compute expertise needed):** a background service in your workspace — **`%s`**%s — %s.\n' "$svc" "$workdir_note" "$plain_status"
    printf '>\n'
    printf '> **What this means for you:** _(see **User-facing impact** below — typically a website, app, or tool that was unreachable during the outage window.)_\n'
    printf '>\n'
    printf '> **What you should do:** %s\n\n' "$plain_action"

    printf '### If `%s` is still down: restart the workspace\n\n' "$svc"
    printf 'Most outages fix themselves (the monitor auto-restarts services) or are handled for you by the workspace agent. Do the following **only if `%s` is still not working.**\n\n' "$svc"
    printf '**If you are in the agent sandbox** (the simplest, surest fix — it cleanly restarts the whole workspace):\n\n'
    printf '1. **Find the workspace terminal.** Look at the bottom status bar. If it reads **`[sandbox]`**, you are in the right (inner) window.\n'
    printf '2. **Close that inner sandbox window:** press and hold **`Ctrl`**, tap **`a`**, let go — then tap **`d`**.\n'
    printf '   - That detaches and closes the inner (nested) sandbox tmux.\n'
    printf '   - ⚠️ Do **NOT** use **`Ctrl`+`b`** then **`d`** — that is the *outer/meta* terminal and will not fix anything.\n'
    printf '3. **Restart the workspace.** You are now back at the outer shell. Paste this one line and press **Enter**:\n'
    printf '   ```\n'
    printf '   cd %s && agent-sandbox tmux new-session ./watcher --continue\n' "$nexus_root"
    printf '   ```\n'
    printf '   (`--continue` resumes your previous session where it left off.)\n\n'
    printf 'That brings the whole workspace — including `%s` — back up on its own within about a minute.\n\n' "$svc"
    printf '**If you are NOT in the agent sandbox,** restart just this one service from the nexus root instead:\n\n'
    printf '```\nmonitor/svc.sh restart %s\n```\n\n' "$svc"

    printf -- '---\n\n'
    printf '_Auto-generated by `monitor/ng service-incident %s` from the watcher incident record (%s). The machine facts below are verbatim; fill the **Root-cause fix** + placeholders before filing._\n\n' "$svc" "$sf"

    printf '## Failure report\n\n'
    printf -- '- **Service:** `%s`%s\n' "$svc" "$workdir_note"
    printf -- '- **First unhealthy:** %s\n' "$first_iso"
    printf -- '- **Restored:** %s\n' "$recovered_iso"
    printf -- '- **Failing healthcheck:** `%s`\n' "$health"
    printf -- '- **Current status:** %s\n' "$status"
    printf -- '- **Restart policy:** `%s` %s\n' "$policy" \
        "$([[ "$policy" == "emit-only" ]] && echo '(watcher never auto-restarts this service — emit + orchestrator judgment)' || echo '(grace → minimal-downtime auto-restart → emit)')"
    printf -- '- **User-facing impact:** _(fill in: downtime window, endpoints affected — derive the window from First-unhealthy → Restored above)_\n'
    [[ -n "$note" ]] && printf -- '- **Watcher note:** %s\n' "$note"
    printf '\n'

    printf '## Immediate response\n\n'
    printf -- '- **Auto-restart (watcher):** %s\n' "$restart_outcome"
    if [[ "$policy" == "emit-only" ]]; then
        printf -- '- This service is `emit-only`: the watcher deliberately does NOT auto-restart it. After the self-heal grace window the watcher escalated to the orchestrator instead of restarting.\n'
    else
        printf -- '- The watcher first gives the service a self-heal grace window (its `*-supervised.sh` wrapper), then — only if still unhealthy — restarts via `monitor/svc.sh restart %s` (minimal downtime; stops a wedged supervisor process group, then relaunches via `recover_service`).\n' "$svc"
    fi
    printf -- '- **Manual restart (if any):** _(fill in: did the orchestrator run `monitor/svc.sh restart %s` itself? outcome?)_\n\n' "$svc"

    printf '## Root-cause fix\n\n'
    printf '_(fill in — the dispatched fix-worker completes this. Reversible + non-degrading; do NOT falsify the service to pass the healthcheck.)_\n\n'
    printf -- '- **What was changed:** _(file/commit)_\n'
    printf -- '- **Where:** _(path · commit SHA)_\n'
    printf -- '- **How to undo:** _(explicit revert — e.g. `git revert <sha>` — stated plainly so any operator can reverse it)_\n'
    printf -- '- **Why it will not reoccur:** _(fill in)_\n\n'

    printf '## References\n\n'
    printf -- '- **Incident state file:** `%s`\n' "$sf"
    printf -- '- **Incident event history:** `%s`\n' "$ef"
    [[ -n "$logfile" ]] && printf -- '- **Service logfile:** `%s`\n' "$logfile"
    printf -- '- **Related issues / PRs / commits:** _(fill in)_\n\n'

    # Embed the machine-recorded event timeline verbatim — the spine of
    # the report, immune to prose drift.
    if [[ -f "$ef" ]]; then
        printf '### Recorded event timeline (verbatim)\n\n```\n'
        awk -F'\t' '{ printf "%s  %-22s %s\n", $1, $2, $3 }' "$ef"
        printf '```\n\n'
    fi
    if [[ -n "$logfile" && -f "$logfile" ]]; then
        printf '### Logfile tail (last 40 lines)\n\n```\n'
        tail -n 40 "$logfile" 2>/dev/null
        printf '```\n\n'
    fi

    printf '## Worker report\n\n'
    printf '_(link the dispatched fix-worker'\''s `reports/` file here once it wraps up.)_\n'
}

# `ng nexus-identity [--upsert-overview] [--dry-run] [--repo OWNER/NAME]`
#
# Render a compact, stable **Nexus identity** block — the working
# directory front and centre — and idempotently upsert it into the
# overview issue body between HTML-comment delimiters (same pattern as
# `ng interactive-sessions`). The point is auto-generation: every field
# is DERIVED from the environment/config this nexus already has, so a
# second operator running the same code gets their own correct block
# with zero edits, and repeated runs replace the block in place (no
# drift, no duplication).
#
# Derived fields (nothing hardcodes `operator`):
#   - Working directory   $NEXUS_ROOT (env), else script-relative root.
#   - Host                `hostname` of the cockpit/watcher host.
#   - Asset + issue repo  github.repo ($REPO) + overview issue number.
#   - Implementation clone the nexus root's git origin remote + branch.
#   - Watcher pidfile/log <root>/monitor/.state/watcher.{pid,log}.
#
# --upsert-overview  PATCH the block into the overview issue body.
# --dry-run          print the rendered block; skip the GitHub PATCH.
# --repo OWNER/NAME  override the target repo for the upsert.
#
# Exit codes: 0 success; 1 error (write failed).
cmd_nexus_identity() {
    _help_check "$@"
    local upsert=0 dry_run=0 repo_arg=""
    _argloop_prev_32=-1; while (( $# > 0 )); do (( $# != _argloop_prev_32 )) || _argloop_stuck "$1"; _argloop_prev_32=$#
        case "$1" in
            --upsert-overview) upsert=1;          shift   ;;
            --dry-run)         dry_run=1;         shift   ;;
            --repo)            _need_val --repo "$#" "${2:-}"; repo_arg="$2"; shift 2 ;;
            *) die "unknown flag: $(_arg_excerpt "$1")" ;;
        esac
    done

    # Resolve the nexus root: env override, then script-relative.
    local nexus_root="${NEXUS_ROOT:-}"
    [[ -n "$nexus_root" ]] || nexus_root=$(cd "$_script_dir/.." && pwd)

    local host; host=$(hostname 2>/dev/null || echo "(unknown host)")

    # Implementation-clone provenance: the nexus root IS the canonical
    # nexus-code checkout. Read its origin remote + current branch; fall
    # back gracefully when the root isn't a git checkout (e.g. tests).
    local clone_remote clone_branch
    clone_remote=$(git -C "$nexus_root" remote get-url origin 2>/dev/null || echo "(no git origin)")
    clone_branch=$(git -C "$nexus_root" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "(detached)")

    local overview_num; overview_num=$(_overview_number_cheap)
    local watcher_pid="$nexus_root/monitor/.state/watcher.pid"
    local watcher_log="$nexus_root/monitor/.state/watcher.log"

    # Render the block. Working directory is the prominent headline; the
    # rest is a compact key/value table. Identity, not status.
    local block
    block="${IDENTITY_START}"$'\n'
    block+="${IDENTITY_HEADING}"$'\n\n'
    block+="**Working directory:** \`${nexus_root}\`"$'\n\n'
    block+=$'| Field | Value |\n'
    block+=$'|-------|-------|\n'
    block+="| Host | \`${host}\` |"$'\n'
    block+="| Asset + issue repo | \`${REPO}\` (overview: \`#${overview_num}\`) |"$'\n'
    block+="| Implementation clone | \`${clone_remote}\` · branch \`${clone_branch}\` |"$'\n'
    block+="| Watcher pidfile | \`${watcher_pid}\` |"$'\n'
    block+="| Watcher log | \`${watcher_log}\` |"$'\n'
    block+=$'\n'
    block+="_Orient / resume: cockpit \`monitor/svc.sh\` (in the \`services\` window) · live dashboard is the section below in this issue · reports under \`${nexus_root}/reports/\`. This block is auto-generated by \`ng nexus-identity\` — do not edit by hand._"$'\n'
    block+="${IDENTITY_END}"

    printf '%s\n' "$block"

    # Upsert into the overview issue body when --upsert-overview.
    if (( upsert == 1 )) && (( dry_run == 0 )); then
        local target; target=$(_resolve_repo write "$repo_arg") || exit $?
        local overview_number; overview_number=$(_overview_number) || exit $?   # #1136: a die in $( ) cannot abort us

        local current_body
        current_body=$(api "/repos/$target/issues/$overview_number" 2>/dev/null \
            | jq -r '.body // ""') \
            || die "nexus-identity: failed to fetch overview issue body"

        # Idempotent upsert: replace the existing delimited block, or append.
        # your-org/nexus-code#959 — emit at most once, and refuse a body that
        # is already nested (see `_upsert_marked_block`). Unlike `dashboard
        # put`, `block` here is generated from host state rather than supplied
        # by the caller, so this site cannot CREATE the nesting — but it
        # compounds one exactly as `put` did, which is the half that matters.
        _assert_single_marker_pair "nexus-identity" "nexus-identity" "$current_body"
        local new_body
        new_body=$(_upsert_marked_block "nexus-identity" "$current_body" "$block")

        # your-org/nexus-code#1118 — this verb writes to THE SAME capped issue
        # body the dashboard lives in, discarded the PATCH response entirely
        # (`>/dev/null`), and then printed "upserted" unconditionally. Over
        # the cap that line was simply false, on the very issue #1118 was
        # measured against. Same refuse-then-verify helper as `dashboard put`,
        # so "upserted" now means the forge was asked and agreed.
        local _ni_tmp _ni_rc
        _ni_tmp=$(mktemp)
        printf '%s' "$new_body" > "$_ni_tmp"
        _patch_issue_body "$target" "$overview_number" "$_ni_tmp" "nexus-identity" >/dev/null
        _ni_rc=$?
        rm -f "$_ni_tmp"
        if (( _ni_rc != 0 )); then
            printf 'ng: nexus-identity: the identity block was NOT upserted.\n' >&2
            return "$_ni_rc"
        fi
        printf 'upserted nexus-identity block into %s #%s\n' "$target" "$overview_number" >&2
    elif (( dry_run == 1 )); then
        printf '(dry-run: block above NOT patched into overview issue)\n' >&2
    fi
}

# ---- dispatch ----

# `ng skeptic <subcommand> ...` — thin delegator to
# monitor/skeptic-channel.sh (the worker↔skeptic comms channel + nudge).
# Gives the skeptic protocol a discoverable home on the `ng` surface:
#   ng skeptic ask          <task> <slug> ...  (skeptic writes a request)
#   ng skeptic await        <task>             (WORKER blocks for *.open.md,
#                                               acks → .ack.md, exits 0;
#                                               DONE → exit 10; timeout → 4)
#   ng skeptic answer       <task> <req> ...   (worker replies, → .answered.md)
#   ng skeptic await-answer <task> <req> ...   (skeptic blocks for the answer)
#   ng skeptic reconcile    <task> ...         (skeptic ensures all acked)
#   ng skeptic close        <task>             (skeptic drops DONE sentinel)
#   ng skeptic nudge        <window> ...       (wake an idle worker)
#   ng skeptic poll|status|list|init|dir <task>
# Run `ng skeptic --help` for the full surface + exit-code contract.
cmd_skeptic() {
    local chan="$_script_dir/skeptic-channel.sh"
    [[ -x "$chan" ]] || die "skeptic: $chan not found or not executable"
    "$chan" "$@"
}

# `ng request <subcommand> ...` — thin delegator to
# monitor/request-channel.sh (the watcher-mediated request inbox + the
# bidirectional request/reply protocol; agent-channel RFC Part B/D). The
# worker→orchestrator escalation channel, symmetric with `ng skeptic`:
#   PRODUCER/CLIENT:
#     ng request file  --origin <w> --kind <k> [--reply required] --slug <s> …
#                                              (writes .new.md; PRINTS the stable id)
#     ng request await <id> [--timeout S]      (block until .replied/.done; print reply)
#     ng request fetch <id> progress|results   (no-publish branch; path-confined pull)
#     ng request list [--state …] | show <id> | reqfile <id> | dir
#   ORCHESTRATOR:
#     ng request ack   <id>                    (.claimed → .done; bare ack —
#                                               refused on a reply:required id, use reply)
#     ng request reply <id> [--worker w] [--dir p] [--issue o/r#N] …  (.claimed → .replied)
#     ng request fail  <id> --reason "<why>"
# Run `ng request --help` for the full surface + exit-code contract.
cmd_request() {
    local chan="$_script_dir/request-channel.sh"
    [[ -x "$chan" ]] || die "request: $chan not found or not executable"
    "$chan" "$@"
}

# `ng remote <subcommand> …` — out-of-band secret provisioning for the
# confined remote SSH endpoint (agent-channel RFC Part A §4.9): host-key
# generation, one-time enrollment tokens, key enrollment, revoke, list, and
# the pre-write secret grep guard. NO subcommand here EVER touches GitHub;
# secrets travel out-of-band only (stdout / 0600 op-only file).
#     ng remote gen-host-key                       (print host fingerprint)
#     ng remote issue-token --principal P [--ttl S](mint a one-time token)
#     ng remote enroll --pubkey F --token T        (consume token → authorize a key)
#     ng remote enroll-invite --principal P [--ttl S]  (ROOTLESS self-enroll:
#                                                   mint token + per-window enroll
#                                                   key; client pipes <token>\n<pub>)
#     ng remote prune-enroll                       (drop expired/consumed enroll lines)
#     ng remote revoke --principal P               (remove a client's key)
#     ng remote list                               (enrolled principals)
#     ng remote carrier-authline --pubkey F|- [--port P]  (off-host forward-only carrier line)
#     ng remote guard [FILE]                       (pre-write secret scan; exit 3 if matched)
#     ng remote client-helper [--base64|--verify D](emit the CURRENT client helper
#                                                   set + digests computed NOW)
# Run `ng remote --help` for the full surface.
cmd_remote() {
    # `client-helper` is NOT an enrollment verb and touches no secret: it emits
    # tracked, world-readable source files. It routes to its own script rather
    # than through remote-enroll.sh so that "hand the client its tooling" never
    # shares a code path with "mint a credential".
    if [[ "${1:-}" == client-helper ]]; then
        shift
        local helper="$_script_dir/remote-client-helper.sh"
        [[ -x "$helper" ]] || die "remote: $helper not found or not executable"
        "$helper" "$@"
        return $?
    fi
    local chan="$_script_dir/remote-enroll.sh"
    [[ -x "$chan" ]] || die "remote: $chan not found or not executable"
    "$chan" "$@"
}

# ---- pure pass-through facades ----
#
# Each verb below is a thin discoverability front door over a standalone
# monitor/*.sh script — the exact `ng skeptic` shape. `_facade` `exec`s the
# script so stdout, stderr, and the exit code pass through UNCHANGED; the
# gate/logic and its dedicated test-*.sh unit stay single-source in the
# script (facade-over-scripts, not migrate — see docs/ng-interface-proposal.md).
#
# Deliberately NO `_help_check` here: `ng <verb> --help` must forward to the
# underlying script's own usage, not ng's. Adding logic to these is a smell —
# fix the script instead.
_facade() {
    local script="$1"; shift
    local path="$_script_dir/$script"
    [[ -x "$path" ]] || die "${script%.sh}: $path not found or not executable"
    exec "$path" "$@"
}
# orchestrator: synchronous go/no-go gate before tmux kill-window
cmd_retire_preflight() { _facade retire-preflight.sh "$@"; }

# the obligation ledger: who OWES whom (your-org/nexus-code#845)
#     ng obligation open   --debtor W --creditor W [--kind K] [--round N] [--detail T]
#     ng obligation settle <id> --reason "…"   |   settle --debtor W --reason "…"
#     ng obligation list [--live] [--debtor W] [--creditor W]
#     ng obligation state <id> | show <id> | gate <window> | pairs
# `pairs` is the "who is waiting on whom" view; `gate <window>` is the
# predicate retire-preflight check 1d consumes.
cmd_obligation() { _facade obligations.sh "$@"; }

# ng retire-window <window> [--reason <text>] [--dry-run] [--keep-window] [--assume-absent]
#
# The WHOLE teardown of a retired worker, as one verb (your-org/nexus-code
# #602). Gate → kill → prune every state surface → VERIFY the prune.
#
# Why a verb and not a longer checklist. The teardown used to be a
# hand-copied list of state directories, re-transcribed at every
# retirement. `idle-state.tsv` was never on it, so every retirement of a
# wrapped worker left a row that kept the dead window in the
# `--- idle workers ---` emit permanently — costing an investigation each
# time it resurfaced, and eroding trust in the one surface the
# orchestrator uses to see what is happening. A list that must be
# transcribed correctly every time will drift again; this one is data
# (BK_RETIRE_SURFACES) read by both the teardown and its test.
#
# The final step is the one that makes the rest trustworthy: after
# pruning, RE-READ the surfaces and fail if any still names the window.
# Exit 0 asserts the property (no surface references it), not the proxy
# (the rm commands returned 0).
cmd_retire_window() {
    _help_check "$@"
    local window="" reason="" dry=0 keep=0 assume_absent=0 strict=0
    _argloop_prev_33=-1; while (( $# > 0 )); do (( $# != _argloop_prev_33 )) || _argloop_stuck "$1"; _argloop_prev_33=$#
        case "$1" in
            --reason)        _need_val --reason "$#" "${2:-}"; reason="$2"; shift 2 ;;
            --dry-run)       dry=1;  shift ;;
            --keep-window)   keep=1; shift ;;
            --assume-absent) assume_absent=1; shift ;;
            --strict)        strict=1; shift ;;
            -*) die "unknown flag: $(_arg_excerpt "$1")" ;;
            *)  [[ -z "$window" ]] || die "unexpected POSITIONAL argument $(_arg_excerpt "$1"). Flags must start with --; positionals are matched in order."
                window="$1"; shift ;;
        esac
    done
    [[ -n "$window" ]] || die "usage: ng retire-window <window> [--reason <text>] [--dry-run] [--keep-window] [--assume-absent] [--strict]"

    if (( dry == 1 )); then
        printf 'retire-window: DRY RUN for %s — surfaces that would be pruned:\n' "$window"
        local refs; refs=$(bk_state_refs_window "$STATE_DIR" "$window")
        if [[ -z "$refs" ]]; then
            printf '  (none — no state surface references this window)\n'
        else
            printf '%s\n' "$refs" | sed 's/^/  /'
        fi
        return 0
    fi

    # Is the window still in tmux? This — not a flag — decides whether
    # the gate applies. A window that no longer exists cannot be
    # protected by a live-pane check, and `retire-preflight` exits 3 on
    # one, so gating on presence is the only shape that both protects a
    # live window and lets a genuinely-dead one be cleaned up.
    # Load the tmux-targeting helper HERE, in the only verb that consumes it —
    # NOT at ng startup (your-org/nexus-code#646).
    #
    # The first version of this fix sourced it at the top of `ng`, next to
    # `_bookkeeping.sh`. That broke EVERY OTHER VERB: `ng`'s test fixtures build
    # a fake tree containing `ng` and `_bookkeeping.sh` and nothing else, so a
    # new startup dependency made `ng` refuse to start in all of them — 20 of 30
    # ng suites went red, and all five CI unit cells failed. `_bookkeeping.sh`
    # can be a startup dependency because every verb needs it; this helper is
    # needed by one. Scoping a precondition wider than its consumer turns an
    # absent optional file into a total outage, which is a worse failure than
    # the one being fixed.
    #
    # Both guards are kept, they have simply moved to where the laundering
    # actually happened. `die` exits 1 with a diagnostic, so the verb REFUSES
    # rather than proceeding with an empty `wid` that means "no such window".
    [[ -r "$_script_dir/_tmux-window.sh" ]] \
        || die "retire-window: $_script_dir/_tmux-window.sh missing or unreadable — refusing (cannot resolve the window id, and an unresolvable id is NOT 'window not found')"
    # shellcheck source=monitor/_tmux-window.sh
    source "$_script_dir/_tmux-window.sh" \
        || die "retire-window: $_script_dir/_tmux-window.sh failed to source (syntax error?) — refusing"
    # A helper that sources CLEANLY but no longer defines the function would
    # leave the call below as an unknown command — rc 127, swallowed by the same
    # `|| wid=""`. Same defect, different exit code; the file check alone misses
    # it, which is what makes this line the class closer rather than belt-and-braces.
    declare -F resolve_window_id >/dev/null \
        || die "retire-window: _tmux-window.sh did not define resolve_window_id — refusing (a resolver that cannot run must not be laundered into 'window not found'; that is your-org/nexus-code#646, where this verb then skipped its own gate)"

    # Sourced function, not a subprocess (your-org/nexus-code#646 — see the
    # source block near the top), so it cannot fail as rc 126/127 here.
    #
    # `resolve_window_id` is THREE-STATE (your-org/nexus-code#699): rc 0
    # present, rc 1 looked-and-absent, rc >= 2 could-not-determine. Only rc 1
    # is a "no". Everything else means this verb never observed the window,
    # and pruning the state of an unobserved window is the #646 failure — it
    # is what let this verb skip its own preflight and prune a live window.
    #
    # The `if command -v tmux` that used to wrap this call was itself a
    # laundering site: with tmux missing, `wid` stayed empty and the code fell
    # straight through to the prune. The resolver reports that as rc 3 now, so
    # the guard is not merely redundant — removing it is the fix.
    local wid="" wid_rc=0
    wid=$(resolve_window_id "$window") || wid_rc=$?
    if (( wid_rc >= 2 )); then
        # `--assume-absent` is the deliberate override, and it exists because
        # refusing outright would strand a REAL case: the tmux server died and
        # left state behind, so the one moment you most need to prune is the
        # one where nothing can be observed. The flag makes that an operator
        # ASSERTION rather than a silent inference — which is the whole
        # difference from the behaviour being fixed. It is deliberately NOT
        # implied by --keep-window or --dry-run.
        if (( assume_absent == 0 )); then
            die "retire-window: could not determine whether window '$window' exists (resolver rc $wid_rc; see the diagnostic above) — refusing. An unobserved window is NOT an absent window (your-org/nexus-code#699): nothing killed, nothing pruned. Fix tmux access, or pass --assume-absent if you KNOW the server is gone and want the state pruned anyway."
        fi
        printf 'retire-window: WARNING — could not observe tmux (resolver rc %d); --assume-absent given, so proceeding as if %s were gone. Nothing will be killed; state WILL be pruned.\n' \
            "$wid_rc" "$window" >&2
        wid=""
    fi

    # Step 1 — the gate. The synchronous re-check that stands between a
    # ~60s-stale idle snapshot and an irreversible kill. It runs whenever
    # the window is STILL PRESENT, including under `--keep-window`: that
    # flag suppresses the kill, never the safety check, so it cannot be
    # used to prune the state of a window that is still working.
    #
    # THE GATE RUNS EVEN WHEN THE PANE IS GONE (your-org/nexus-code#977).
    #
    # This used to read `if [[ -n "$wid" ]] … else "preflight skipped
    # (nothing live to protect)"`. That rationale is SOUND for a LIVE-PANE
    # check — checks 1/2/3 ask "is the operator typing", "did a prompt just
    # land", "is work in flight", and for a window that is not in tmux the
    # answer to all three is no. It then silently generalised to checks 1b
    # and 1c, which are not about liveness at all: 1b refuses on an
    # unresolved required-skeptic marker, and A MARKER ON DISK IS EXACTLY AS
    # BINDING WHETHER OR NOT A PANE STILL EXISTS.
    #
    # So retiring an absent window through the canonical verb ran no gate,
    # then Step 3 pruned `skeptic/pending/{s}` AND `dir:skeptic/{s}` — the
    # obligation and the entire worker<->skeptic channel — with no refusal,
    # no error and no surviving artefact. Measured on this tree before the
    # fix: marker present + channel dir present -> rc 0, both absent, and the
    # only log line was a `window-close` that says nothing about either.
    #
    # Why that is worse than an ordinary silent failure: AN OBLIGATION
    # DESTROYED AT TEARDOWN LEAVES THE SAME TRACE AS AN OBLIGATION THAT NEVER
    # EXISTED. #975 found three windows still holding orphaned require
    # markers — those are the SURVIVORS, not the population, and they survive
    # precisely because the canonical verb was not used on them. The
    # prevalence is invisible by construction, which is why the recording
    # half below lands regardless of the refusing half.
    #
    # The fix is not to add a second copy of the obligation check here. It is
    # to stop lying to the gate about what could not be observed: inject
    # `--pane-state absent`, the token whose meaning is precisely "this
    # window is not in tmux" and which `bk_pane_kill_authorized` already
    # allows. Checks 1/2/3 then reach the same conclusion they always did,
    # and 1b/1c run.
    #
    # This CAN now refuse where it previously always proceeded. That is the
    # point, and the refusal is releasable: check 1b's own message names
    # `ng skeptic resolve <window> --reason "…"`, which is orchestrator-only,
    # audited, and works on a window that is gone from tmux (it is pure
    # filesystem). A gate with no release is a brick and a brick trains the
    # `rm` bypass — which would destroy the obligation OUTSIDE any gate, i.e.
    # this defect made worse. The release existing is what makes refusing the
    # right direction rather than a trade.
    # The gate is now on BOTH paths, so its absence must be named rather than
    # arriving as a bare `rc 127` out of a command substitution. `ng`'s own
    # idiom for a required sibling script (`_facade`, `cmd_skeptic`,
    # `cmd_request`) is exactly this: refuse, and say what is missing.
    #
    # Fail-CLOSED is not in question — an unrunnable gate is doubt and this is
    # an irreversible act, the same reasoning the `resolve_window_id` guard
    # above states for #646/#699. What was in question is whether the operator
    # can ACT on the refusal, and `monitor/ng: line NNNN: …: No such file or
    # directory` is not actionable. This surfaced from a fixture that omits
    # the script: before #977 an absent window skipped the gate entirely, so a
    # missing `retire-preflight.sh` was INVISIBLE on that path and the verb
    # cheerfully pruned. That is the defect restating itself — a dependency
    # nobody could notice was missing, because it was never consulted.
    # Placed AFTER the `--dry-run` return above, deliberately: a dry run
    # prunes nothing, so a missing gate cannot harm it and requiring one
    # would break the read-only inspection path for no safety gained.
    [[ -x "$_script_dir/retire-preflight.sh" ]] \
        || die "retire-window: $_script_dir/retire-preflight.sh not found or not executable — refusing. This verb is gate-then-prune and the gate is what stands between a stale snapshot and an irreversible kill; without it there is no safe prune to perform (your-org/nexus-code#977)."
    local pf_out pf_rc=0
    if [[ -n "$wid" ]]; then
        pf_out=$("$_script_dir/retire-preflight.sh" "$window" 2>&1) || pf_rc=$?
    else
        printf 'retire-window: window %s is not present in tmux — running the preflight with\n' "$window"
        printf '  --pane-state absent. The LIVENESS checks have nothing to protect; the\n'
        printf '  OBLIGATION checks (1b skeptic-pending, 1c disposition) are not about\n'
        printf '  liveness and still apply (your-org/nexus-code#977).\n'
        pf_out=$("$_script_dir/retire-preflight.sh" "$window" --pane-state absent 2>&1) || pf_rc=$?
    fi
    printf '%s\n' "$pf_out"
    if (( pf_rc != 0 )); then
        echo "ng retire-window: preflight refused (rc $pf_rc) — NOT killing, NOT pruning" >&2
        return "$pf_rc"
    fi
    # Step 2 — the kill. Targets the @id resolved above, never the NAME:
    # `kill-window -t <name>` dot-parses a dotted window name
    # (`cc-update-2.1.183`) as window.pane, fails to find the pane, and
    # SILENTLY NO-OPS — the window leaks while the caller reads success
    # (#323).
    if (( keep == 0 )) && [[ -n "$wid" ]]; then
        tmux kill-window -t "$wid" 2>/dev/null \
            || die "retire-window: kill-window failed for $window ($wid) — NOT pruning state for a window that may still be alive"
    fi

    # Step 2b — RECORD ANY SKEPTIC OBLIGATION THIS TEARDOWN IS ABOUT TO
    # DESTROY (your-org/nexus-code#977).
    #
    # The gate above can now refuse on a LIVE obligation, but it deliberately
    # does not refuse on every one: check 1b lets an ORPHANED marker through
    # (fresh, but no live skeptic past the grace window), because blocking on
    # those strands the window forever — and orphaned markers are exactly the
    # population #961 measured, 6 of 10 belonging to windows that no longer
    # exist. Those prunes are legitimate and they still destroy an obligation
    # record and a channel directory.
    #
    # So the destruction is recorded whenever it happens. This is the half of
    # #977's suggested shape that is "valuable even if the refusing half is
    # judged too strict", and it is what converts the blast radius from
    # UNKNOWABLE to countable: before this, the audit trail could not measure
    # a failure mode whose signature is the absence of an audit trail.
    #
    # It RECORDS, it never DECIDES — the same posture (and the same
    # justification) as retire-preflight's `skeptic-disposition-gate` event.
    # Fail-open and bounded: a log that cannot be written must not stall a
    # teardown, and whether the write landed changes nothing about the prune.
    #
    # Emitted ONLY when there was something to destroy. An event on every
    # retirement would bury the ~1 in N that matters in the N that do not,
    # and "this retirement destroyed nothing" is already the default reading
    # of a `window-close` with no companion event.
    local _rw_key _rw_marker _rw_chan _rw_subj="" _rw_depth="-"
    _rw_key=$(wk_encode "$window")
    _rw_marker="$STATE_DIR/skeptic/pending/${_rw_key}"
    _rw_chan="$STATE_DIR/skeptic/${_rw_key}"
    if [[ -e "$_rw_marker" || -d "$_rw_chan" ]]; then
        _rw_subj=$(_skeptic_current_arm_sha "$STATE_DIR/skeptic/pending" "$_rw_key") || _rw_subj=""
        # `-` means "no depth to read" and stays `-` for an EMPTY marker too.
        # Computed here rather than inline in the --extra, where an empty `tr`
        # result and an unreadable file would both have produced an empty
        # value — the `findings=0` conflation (#601/#605) in a new field.
        if [[ -r "$_rw_marker" ]]; then
            _rw_depth=$(tr -d '\n' < "$_rw_marker" 2>/dev/null) || _rw_depth=""
            [[ -n "$_rw_depth" ]] || _rw_depth="-"
        fi
        ( cmd_log_action monitor --event skeptic-obligation-destroyed \
            --extra "window=$window" \
            --extra "key=$_rw_key" \
            --extra "marker=$( [[ -e "$_rw_marker" ]] && printf present || printf absent )" \
            --extra "marker-depth=$_rw_depth" \
            --extra "channel-dir=$( [[ -d "$_rw_chan" ]] && printf present || printf absent )" \
            --extra "subject-armed-sha=${_rw_subj:--}" \
            --extra "by=retire-window" \
            --extra "reason=${reason:-retire-window}" ) 2>/dev/null || true
        printf 'retire-window: NOTE — this teardown destroys skeptic obligation state for %s\n' "$window" >&2
        printf '  marker      : %s\n' "$( [[ -e "$_rw_marker" ]] && printf %s "$_rw_marker" || printf 'absent' )" >&2
        printf '  channel dir : %s\n' "$( [[ -d "$_rw_chan" ]] && printf %s "$_rw_chan" || printf 'absent' )" >&2
        printf '  recorded as `skeptic-obligation-destroyed` in the action log.\n' >&2
        printf '  The obligation ledger (.%s.ledger) is NOT pruned — it is the durable\n' "$_rw_key" >&2
        printf '  account of what this window owed and what was validated.\n' >&2
    fi

    # Step 2c — PRESERVE THE RELEASES THIS PRUNE WOULD OTHERWISE REVOKE
    # (your-org/nexus-code#1270 residual A).
    #
    # Step 2b above records what this teardown destroys of the RETIRED window's
    # own state. It is silent about the collateral: `void-pairing-closed` is
    # DERIVED on every read from this creditor's DONE sentinel, and step 3 is
    # about to `rm -rf` the channel that holds it. The moment it goes,
    # `_obl_done_identity` answers `none`, `none` matches the baseline captured
    # at open, and every edge this creditor had RELEASED silently reverts to
    # `live` — stranding a DEBTOR that is a different window and did nothing.
    # Measured at 0b82ffb2: close -> void-pairing-closed, gate rc 0; prune ->
    # live, gate rc 1.
    #
    # GUARDED ON THE SENTINEL, not on the channel dir. A channel with no DONE
    # is releasing nothing, so there is nothing to preserve and this stays
    # silent — the common case.
    #
    # BEST-EFFORT AND NEVER FATAL. If this cannot run, the edges keep deriving
    # exactly as they do today, which BLOCKS a retirement — the conservative
    # direction. A teardown must not fail because the ledger was busy.
    if [[ -e "$_rw_chan/DONE" && -x "$_script_dir/obligations.sh" ]]; then
        local _rw_preserved=""
        _rw_preserved=$( "$_script_dir/obligations.sh" preserve-closures \
            --creditor "$window" --by "retire-window" 2>/dev/null ) || _rw_preserved=""
        if [[ -n "$_rw_preserved" ]]; then
            printf 'retire-window: NOTE — %s'"'"'s DONE sentinel was releasing obligation edges\n' "$window" >&2
            printf '  owed BY OTHER WINDOWS, and this teardown destroys it. Those releases have\n' >&2
            printf '  been settled into the ledger so they survive the prune:\n' >&2
            printf '%s\n' "$_rw_preserved" | sed 's/^/    /' >&2
        fi
    fi

    # Step 3 — prune every surface in the manifest.
    bk_prune_window_state "$STATE_DIR" "$window" \
        || die "retire-window: state dir not usable: $STATE_DIR"

    # Step 4 — VERIFY. The point of the verb.
    local leftover; leftover=$(bk_state_refs_window "$STATE_DIR" "$window")
    ( cmd_log_action monitor --event window-close \
        --extra "window=$window" \
        --extra "reason=${reason:-retire-window}" ) 2>/dev/null || true
    if [[ -n "$leftover" ]]; then
        echo "ng retire-window: PRUNE INCOMPLETE — these surfaces still reference '$window':" >&2
        printf '%s\n' "$leftover" | sed 's/^/  /' >&2
        echo "  Each will keep resurfacing the dead window in watcher emits. Fix before" >&2
        echo "  treating this window as retired." >&2
        return 1
    fi
    # Step 5 — THE MANIFEST-INDEPENDENT SCAN (your-org/nexus-code#1101, skeptic
    # F3). Step 4 above iterates BK_RETIRE_SURFACES, exactly as the pruner does,
    # so it is BLIND TO WHAT THE MANIFEST OMITS: two answers computed from one
    # hand-maintained enumeration confirm each other and neither describes the
    # state dir. This verb used to close by printing `no state surface
    # references it (N surfaces checked)` on the strength of that — which is
    # verbatim what the `#941` comment inside `_bookkeeping.sh` warns against,
    # "announces a complete teardown over state it did not touch".
    #
    # Measured: an independent scan over the live state dir found SIX families
    # the 18-entry manifest does not name, across five real windows. So the
    # summary line was a claim about the array, not about the disk.
    #
    # It REPORTS and never deletes, and the asymmetry is deliberate: pruning
    # must stay an explicit list because deletion is irreversible, while
    # verification must be independent because a false positive costs a line of
    # output and a false negative costs the entire guarantee.
    #
    # It does NOT fail the verb. An unmanifested reference is not a failed
    # prune — it is a surface nobody classified, and turning that into rc 1
    # would break every retirement on the board for a condition the operator
    # cannot fix in the moment. `--strict` is there for a caller that wants it.
    local unmanifested=""
    if declare -F bk_state_refs_unmanifested >/dev/null 2>&1; then
        unmanifested=$(bk_state_refs_unmanifested "$STATE_DIR" "$window")
    fi
    if [[ -n "$unmanifested" ]]; then
        # THE COUNT GOES ON STDOUT (skeptic G4). The two branches used to differ
        # on stdout only by a TRAILING CLAUSE — an ABSENT clause as the signal,
        # which is the weakest shape available and the one this board keeps
        # getting caught by. A caller grepping the success line could not tell
        # the branches apart, and a suite re-keyed to the shared prefix passes
        # in both (which is exactly what happened to test-window-key.sh, G2).
        # Now the discriminator is a PRESENT VALUE: `unmanifested=N`, always
        # emitted, `0` on the clean branch.
        local _unman_n; _unman_n=$(printf '%s\n' "$unmanifested" | grep -c .)
        printf 'retire-window: %s retired; %d manifested surface(s) pruned and verified clear; unmanifested=%d (NOT pruned, NOT verified — see stderr).\n' \
            "$window" "${#BK_RETIRE_SURFACES[@]}" "$_unman_n"
        printf 'retire-window: NOT COVERED BY THIS VERB — %d state reference(s) name '"'"'%s'"'"' and are NOT in\n' \
            "$_unman_n" "$window" >&2
        printf '  BK_RETIRE_SURFACES, so they were neither pruned nor verified:\n' >&2
        printf '%s\n' "$unmanifested" | sed 's/^unmanifested\t/  /' >&2
        printf '  Each is EITHER a surface that belongs in the manifest, OR one deliberately\n' >&2
        printf '  retained (async-run/ holds retained exit statuses; paste-verdicts/ the delivery\n' >&2
        printf '  record; prompts/ the spawn brief). This verb does not decide which — it refuses\n' >&2
        printf '  to claim a completeness it did not check (your-org/nexus-code#1101).\n' >&2
        if (( strict == 1 )); then
            printf 'retire-window: --strict given: treating unmanifested references as a failure.\n' >&2
            return 1
        fi
        return 0
    fi
    # THE CLEAN-BRANCH SENTENCE SAYS WHAT WAS SEARCHED (skeptic G1). It read
    # "a manifest-INDEPENDENT scan of <dir> found no other reference", which is a
    # claim about STATE — and the scan behind it keyed on two shapes, so the
    # sentence outran its evidence. It now names the predicate, so a reader
    # inherits the boundary instead of the reassurance.
    printf 'retire-window: %s retired; %d manifested surface(s) pruned and verified clear; unmanifested=0 — a manifest-INDEPENDENT scan of %s found no other path or top-level TSV row naming this window as a `.`/`_`-delimited token.\n' \
        "$window" "${#BK_RETIRE_SURFACES[@]}" "$STATE_DIR"
    return 0
}

# ng decision-ack <window> <fingerprint> [--reason <text>]
# ng decision-ack <path-to-decision-json> [--reason <text>]
# ng decision-ack <window> --all [--reason <text>]
#
# Answer a `--- pending decisions ---` row DURABLY (your-org/nexus-code#790).
#
# WHY A VERB. The ack this channel documented was "remove the cited
# file", and for `idle_prompt` that is a no-op. The fingerprint is
# sha1(window | kind | message); `idle_prompt`'s message is the constant
# "Claude is waiting for your input", so it is a pure function of the
# window. Removing the file and staying idle for another minute gets you
# a byte-identical filename back — observed three times in one session on
# `guardgap.672915acaad8`, and once on `civerdict.bb0f332f628a` (removed
# 15:41, back at 16:09:32, same fingerprint). An operator who follows the
# documentation exactly cannot tell their ack from a re-fire.
#
# The durable channel already existed — `<w>.<fp>.handled.json`, honoured
# by the hook's write path AND the watcher's reader — and nothing pointed
# at it, so nobody used it. This verb is that rename, done for you, and
# the emit row now names this verb rather than the file. That ordering
# matters: the fix for "the documented gesture does not work" is a
# gesture that does, not a louder document.
#
# SCOPE OF THE SUPPRESSION, stated plainly because it is broad. A
# tombstone is terminal for that fingerprint until the window is retired
# (`ng retire-window` prunes `decisions/<w>.*`) or reaped (the watcher
# drops decisions for windows absent from tmux past
# MONITOR_PENDING_REAP_MIN_AGE_SECONDS). For `idle_prompt` that means
# "this window's idle pings stop being decision rows" — which is correct:
# `--- idle workers ---` is the surface that tracks idle workers, it
# cannot be tombstoned, and having two channels nag about the same fact
# is what made this one skimmable. A `permission_prompt` embeds the tool
# and its arguments in the message, so a DIFFERENT prompt is a different
# fingerprint and surfaces normally; only the identical prompt is muted.
cmd_decision_ack() {
    _help_check "$@"
    local window="" fp="" reason="" all=0 path=""
    _argloop_prev_34=-1; while (( $# > 0 )); do (( $# != _argloop_prev_34 )) || _argloop_stuck "$1"; _argloop_prev_34=$#
        case "$1" in
            --reason) _need_val --reason "$#" "${2:-}"; reason="$2"; shift 2 ;;
            --all)    all=1; shift ;;
            -*) die "unknown flag: $(_arg_excerpt "$1")" ;;
            *)  if [[ -z "$window" ]]; then window="$1"
                elif [[ -z "$fp" ]]; then fp="$1"
                else die "unexpected POSITIONAL argument $(_arg_excerpt "$1"). Flags must start with --; positionals are matched in order."; fi
                shift ;;
        esac
    done
    [[ -n "$window" ]] || die "usage: ng decision-ack <window> <fingerprint> | <path-to-decision-json> | <window> --all"

    local dir="$STATE_DIR/decisions"
    [[ -d "$dir" ]] || die "decision-ack: no decisions directory at $dir"

    # Path form: the emit row cites an absolute `file=`, so accept it
    # verbatim rather than making the operator re-split it into two
    # tokens. Splitting by hand is how a fingerprint gets mistyped, and a
    # mistyped fingerprint tombstones nothing while reporting success.
    if [[ "$window" == */* || "$window" == *.json ]]; then
        [[ -z "$fp" ]] || die "decision-ack: pass EITHER a path OR <window> <fingerprint>, not both"
        path="$window"
        [[ -f "$path" ]] || die "decision-ack: no such decision file: $path"
        case "$path" in
            *.handled.json) printf 'decision-ack: already acked (tombstone): %s\n' "$path"; return 0 ;;
        esac
        local bn; bn=$(basename "$path" .json)
        [[ "$bn" =~ ^(.+)\.([0-9a-f]{12})$ ]] \
            || die "decision-ack: filename is not <window>.<12hex>.json: $(basename "$path")"
        window="${BASH_REMATCH[1]}"
        fp="${BASH_REMATCH[2]}"
    fi

    local -a targets=()
    if (( all == 1 )); then
        [[ -z "$fp" ]] || die "decision-ack: --all takes no fingerprint"
        # Save/restore, NOT an unconditional `shopt -u`: `ng` is SOURCED
        # (the unit suites source it to drive internal helpers), so an
        # unconditional unset hands a caller that HAD nullglob a shell
        # without it. `test-ambient-shell-option-scope.sh` P2 enforces
        # exactly this and caught the first draft of this block.
        local _da_restore_nullglob f
        _da_restore_nullglob=$(shopt -p nullglob)
        shopt -s nullglob
        for f in "$dir/$window".*.json; do
            [[ -e "$f" ]] || continue
            case "$f" in *.handled.json) continue ;; esac
            targets+=( "$f" )
        done
        eval "$_da_restore_nullglob"
        # Exit 0, not `die`. `--all` is the form a retire flow calls
        # unconditionally as one of its steps (skills/nexus.window-cleanup
        # step 5), and "this window had nothing pending" is the ordinary
        # case there — failing it would abort a teardown over good news.
        # The single-fingerprint form still dies on a miss, because there
        # the caller named something specific and not finding it means
        # they mistyped.
        if (( ${#targets[@]} == 0 )); then
            printf 'decision-ack: no un-acked decisions for window %s — nothing to do\n' "$window"
            return 0
        fi
    else
        [[ -n "$fp" ]] || die "usage: ng decision-ack <window> <fingerprint> | <path> | <window> --all"
        [[ "$fp" =~ ^[0-9a-f]{12}$ ]] \
            || die "decision-ack: '$fp' is not a 12-hex fingerprint — copy it from the row's fp= field"
        if [[ -f "$dir/$window.$fp.handled.json" && ! -f "$dir/$window.$fp.json" ]]; then
            printf 'decision-ack: already acked (tombstone present): %s.%s\n' "$window" "$fp"
            return 0
        fi
        [[ -f "$dir/$window.$fp.json" ]] \
            || die "decision-ack: no decision $window.$fp.json in $dir"
        targets=( "$dir/$window.$fp.json" )
    fi

    # Rename, then VERIFY the property (tombstone present AND live file
    # gone) rather than trusting mv's exit status — same discipline as
    # retire-window's step 4. A half-completed ack that reports success is
    # how this channel earned its distrust in the first place.
    local t tomb acked=0
    for t in "${targets[@]}"; do
        tomb="${t%.json}.handled.json"
        mv -f "$t" "$tomb" 2>/dev/null || true
        if [[ -f "$tomb" && ! -f "$t" ]]; then
            acked=$(( acked + 1 ))
            printf 'decision-ack: %s → %s\n' "$(basename "$t")" "$(basename "$tomb")"
        else
            echo "decision-ack: FAILED to tombstone $t — the decision will keep re-surfacing" >&2
        fi
    done
    (( acked == ${#targets[@]} )) || return 1

    ( cmd_log_action monitor --event decision-ack \
        --extra "window=$window" \
        --extra "count=$acked" \
        --extra "reason=${reason:-acked}" ) 2>/dev/null || true
    printf 'decision-ack: %d decision(s) acked for %s; re-fires of the same fingerprint are now suppressed at the hook\n' \
        "$acked" "$window"
    return 0
}
# orchestrator: classify a worker pane (idle|busy|user-typing|…)
cmd_pane_state()       { _facade pane-state.sh       "$@"; }
# worker: "wake me when this long job ends, fails, or does anything I asked
# about" (your-org/nexus-code#1535). ONE host-armed plugin monitor per session
# polls a per-session spool; `add` drops a watch in, and the dispatcher
# prints one line per terminal transition — delivered as a task notification.
cmd_longjob()          { _facade longjob-watch.sh    "$@"; }
# "is this head green, and was it green the FIRST time?" (#749). `gh run list`
# and the check-runs API show only the LATEST attempt, so a band that failed and
# was re-run green is indistinguishable from one that passed first time. Exits
# 6 when a green replaced a red at the same sha.
cmd_ci_attempts()      { _facade ci-head-attempts.sh "$@"; }
# worker, PRE-PUSH: "which guards scan what I just changed?" (#803). A PR's
# green covers the suites its diff TOUCHES, not the suites its change AFFECTS;
# this asks the construct-keyed guards themselves, via their `--population`
# protocol, and reports what it did NOT consider as well as what it did.
cmd_guards_for_diff()  { _facade guards-for-diff.sh   "$@"; }
# orchestrator: resolve a window's session-id from RECORDED state, never
# from a workdir-derived project slug (your-org/nexus-code#647)
