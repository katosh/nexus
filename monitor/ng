cmd_reply() {
    _help_check "$@"
    local issue="${1:-}"; shift || true
    [[ -n "$issue" ]] || die "usage: ng reply <issue> [--repo <owner/name>] [--body-file <path>]"
    # ---- your-org/nexus-code#858 B/C: name the RIGHT token ------------
    #
    # Binding is order-sensitive — the issue number comes first — and
    # when a caller got the order wrong the diagnostic pointed at the
    # wrong thing. `ng comment --repo your-org/nexus-code 846 …` bound
    # `--repo` into the issue slot and then reported the REPO as an
    # unknown *flag*, which reads as "that repo is not recognised"
    # rather than "that argument is in the wrong position".
    if [[ "$issue" == -* ]]; then
        die "$(printf 'reply/comment takes the ISSUE NUMBER first, then flags.\nGot the flag %s in the issue slot. Try: ng reply <issue> %s <value> ...' \
                "$(_arg_excerpt "$issue")" "$issue")"
    fi
    [[ "$issue" =~ ^[0-9]+$ ]] || die "$(printf 'reply/comment takes an issue/PR NUMBER first, got %s.\nUsage: ng reply <issue> [--repo <owner/name>] [--body-file <path>]' \
                "$(_arg_excerpt "$issue")")"
    local body_file="" repo_arg=""
    _argloop_prev_5=-1; while (( $# > 0 )); do (( $# != _argloop_prev_5 )) || _argloop_stuck "$1"; _argloop_prev_5=$#
        case "$1" in
            --body-file) _need_val --body-file "$#" "${2:-}"; body_file="$2"; shift 2 ;;
            --repo)      _need_val --repo "$#" "${2:-}"; repo_arg="$2";  shift 2 ;;
            -*) die "unknown flag: $(_arg_excerpt "$1")" ;;
            # A positional BODY is a natural guess — and the body is read
            # from stdin. Say which, rather than calling the body an
            # unknown flag and echoing it back verbatim.
            *) die "$(printf 'unexpected argument %s\nreply/comment takes its body on STDIN or via --body-file; a positional body is not accepted.\nFlags must follow the issue number.' \
                       "$(_arg_excerpt "$1")")" ;;
        esac
    done
    local target
    target=$(_resolve_repo write "$repo_arg") || exit $?
    local _body; _body=$(_read_body "$body_file") || exit $?   # #1136: a die in $( ) cannot abort us
    _body_receipt "$_body" "$body_file"
    _post_body "/repos/$target/issues/$issue/comments" "$_body"
}

# `ng comment <issue>` — alias for `ng reply`. Posts a comment to an
# issue or PR thread via the bot (PR conversation comments go through
# the issues endpoint). `comment` is the verb operators reach for first
# (#236 B4); `reply` predates it and stays for back-compat. Identical
# surface to both `ng reply` and `ng issue comment`.
cmd_comment() {
    _help_check "$@"
