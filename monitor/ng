# Open a PR. Body is required (from --body-file or stdin). Branch must
# already be pushed to origin; this is pure API, it doesn't push for you.
#
# Reviewer behavior: bot-opened PRs default to --reviewer
# $github.user_login, so each PR auto-requests review from the human
# operator. GitHub mutes notifications for actions taken by the
# recipient's account, so without this the dashboard surface goes
# cold for any repo missing CODEOWNERS. Belt-and-suspenders with
# `.github/CODEOWNERS` for repos that have it; the only gap is repos
# where the requested login isn't a collaborator (then the
# requested_reviewers POST 422s — we warn, not fatal).
# Opt-out with --no-reviewer; override with --reviewer <login>.
cmd_pr_create() {
    _help_check "$@"
    local head="" base="main" title="" body_file="" repo_arg=""
    # Sentinel distinguishes "not passed" from "passed empty" — empty
    # means --no-reviewer (caller intends to skip), unset means default.
    local reviewer="__DEFAULT__"
    _argloop_prev_18=-1; while (( $# > 0 )); do (( $# != _argloop_prev_18 )) || _argloop_stuck "$1"; _argloop_prev_18=$#
        case "$1" in
            --head)        _need_val --head "$#" "${2:-}"; head="$2";      shift 2 ;;
            --base)        _need_val --base "$#" "${2:-}"; base="$2";      shift 2 ;;
            --title)       _need_val --title "$#" "${2:-}"; title="$2";     shift 2 ;;
            --body-file)   _need_val --body-file "$#" "${2:-}"; body_file="$2"; shift 2 ;;
            --repo)        _need_val --repo "$#" "${2:-}"; repo_arg="$2";  shift 2 ;;
            --reviewer)    _need_val --reviewer "$#" "${2:-}"; reviewer="$2";  shift 2 ;;
            --no-reviewer) reviewer="";        shift ;;
            *) die "unknown flag: $(_arg_excerpt "$1")" ;;
        esac
    done
    [[ -n "$head"  ]] || die "ng pr create: --head is required"
    [[ -n "$title" ]] || die "ng pr create: --title is required"
    local body target
    body=$(_read_body "$body_file") || exit $?   # #1136: a die in $( ) cannot abort us
    [[ -n "$body" ]] || die "ng pr create: empty body"
    target=$(_resolve_repo write "$repo_arg") || exit $?
    # When PRing into a non-nexus repo, run the bot-install preflight
    # so a missing install fails with a clear remediation instead of
    # GitHub's "Resource not accessible by integration" GraphQL error.
    if [[ "$target" != "$REPO" ]]; then
        _preflight_repo "$target" || die "preflight failed for $target — install the bot before retrying"
    fi
    [[ "$reviewer" == "__DEFAULT__" ]] && reviewer="$USER_LOGIN"
    local response url number
    response=$(jq -n --arg t "$title" --arg b "$body" --arg h "$head" --arg base "$base" \
            '{title:$t, body:$b, head:$h, base:$base}' \
          | api -X POST "/repos/$target/pulls" --input -)
    url=$(jq -r '.html_url // empty'  <<<"$response")
    number=$(jq -r '.number // empty' <<<"$response")
    [[ -n "$url" ]] || die "pr create failed"
    # Auto-request review via separate endpoint (the pulls POST doesn't
    # accept `reviewers`). Bot identity != reviewer, so self-review
    # rejection isn't a concern. Failure here is warned, not fatal: a
    # missing collaborator (e.g. CODEOWNERS-only flow) shouldn't kill
    # an otherwise-successful PR open.
    if [[ -n "$reviewer" && -n "$number" ]]; then
        if ! jq -n --arg u "$reviewer" '{reviewers:[$u]}' \
             | api -X POST "/repos/$target/pulls/$number/requested_reviewers" --input - >/dev/null; then
            echo "ng: warning: failed to request review from @$reviewer on $target#$number" >&2
        fi
    fi
    printf '%s\n' "$url"
}

# Patch title and/or body on an existing PR. Either flag alone is fine.
cmd_pr_edit() {
    _help_check "$@"
    local n=""
    local title="" body_file="" have_body=0 repo_arg=""
    _argloop_prev_19=-1; while (( $# > 0 )); do (( $# != _argloop_prev_19 )) || _argloop_stuck "$1"; _argloop_prev_19=$#
        case "$1" in
            --title)     _need_val --title "$#" "${2:-}"; title="$2";     shift 2 ;;
            --body-file) _need_val --body-file "$#" "${2:-}"; body_file="$2"; have_body=1; shift 2 ;;
            --repo)      _need_val --repo "$#" "${2:-}"; repo_arg="$2";  shift 2 ;;
            --*) die "unknown flag: $(_arg_excerpt "$1")" ;;
            *)  if [[ -z "$n" ]]; then n="$1"
                else die "unexpected POSITIONAL argument $(_arg_excerpt "$1"). Flags must start with --; positionals are matched in order."; fi
                shift ;;
        esac
    done
    [[ -n "$n" ]] || die "usage: ng pr edit <n> [--repo <owner/name>] [--title <t>] [--body-file <path>]"
    [[ -n "$title" || "$have_body" == 1 ]] || die "ng pr edit: pass --title and/or --body-file"
    local payload='{}' target
    target=$(_resolve_repo write "$repo_arg") || exit $?
    [[ -n "$title" ]]    && payload=$(jq -c --arg t "$title" '. + {title:$t}' <<<"$payload")
    if (( have_body == 1 )); then
        local body
        body=$(_read_body "$body_file") || exit $?   # #1136: a die in $( ) cannot abort us
        [[ -n "$body" ]] || die "ng pr edit: empty body"
        payload=$(jq -c --arg b "$body" '. + {body:$b}' <<<"$payload")
    fi
    local url
    url=$(printf '%s' "$payload" \
          | api -X PATCH "/repos/$target/pulls/$n" --input - \
          | jq -r '.html_url // empty')
    [[ -n "$url" ]] || die "pr edit failed"
    printf '%s\n' "$url"
}

# Merge a PR via the REST API. Prints the merge commit SHA. Optional
# --delete-branch removes the head ref after a successful merge.
#
# HEAD-SHA PIN (your-org/nexus-code#628). The merge PUT always carries a `sha`,
# so GitHub REJECTS it (HTTP 409) if the PR head moved — an unpinned PUT
# silently merges whatever the head is NOW, which on #627 merged 97d7a02a two
# minutes after 93da6612 was the verified-green head. `--sha <verified-head>`
# pins the head the CALLER verified, end to end; absent it, the freshly-fetched
# head is pinned, which still closes the fetch→PUT window but does not vouch for
# a head verified earlier — so a hint recommends --sha.
#
# BASE-SHA PIN (your-org/nexus-code#880), and it is the OTHER HALF of the same
# idea. `--sha` pins the head the caller verified; `--base-sha` pins the BASE
# that head's green was computed against. `ng ci-attempts` prints that sha in
# full on its `Merge-ref base: VERIFIED` line for exactly this purpose, so the
# clearance can be CARRIED to the merge instead of remembered.
#
# WHY IT IS NEEDED SEPARATELY FROM GitHub's OWN 409. GitHub rejects a stale HEAD
# pin, and it rejects a merge whose base changed IN A CONFLICTING WAY. It does
# NOT reject a base that advanced and still merges cleanly — and that is the
# whole hazard: `#823` was clean, green everywhere, and a tree nobody tested.
# Measured on this repo: `#870` merged onto `4ed5aa1e` five minutes after `dev`
# left `a74805b5`, which is the base its suite actually ran against. No conflict,
# no 409, no warning.
#
# WHY IT IS OPT-IN. A base check that fired on every merge would block the board
# every time `dev` moved during a review, and a gate that always fires is a gate
# somebody disables — which is strictly worse than not having it. So the default
# is unchanged and the caller asks for the guarantee when the caller wants it.
# ---- a flag whose value is missing is a caller error (your-org/nexus-code S5) --
#
# `shift 2` with ONE positional left FAILS and does NOT shift, so the parse loop
# spins on the same token forever. Reproduced in isolation: `set -- --repo` with
# the PRE-FIX arm (spelled with a space so no rewrite can eat it again:
# `--repo )  x="$ {2:-}";  shift 2 ;;`) runs 2000+ iterations with `$1` still
# `--repo`. `$ {2:-}` then hides the other half — an empty value that looks like
# a supplied one, which is how `ng pr merge 42 --sha` merged UNPINNED while
# reading as pinned.
#
# THIS COMMENT WAS ITSELF CORRUPTED BY THE FIX. The mechanical rewrite that
# guarded the arms matched the example INSIDE this comment too, turning it into
# the GUARDED form — so the paragraph explaining the bug ended up asserting that
# the fixed spelling spins, which is false. Caught while reconciling two counts
# that disagreed by three. A rewrite broad enough to fix a class is broad enough
# to rewrite its own documentation; the spaces above are what stop it recurring.
#
# CALLED AS A STATEMENT, NEVER IN `$( )`. `die` inside a command substitution
# exits the SUBSHELL and the caller sails on with an empty value — the same
# class of silent failure this is fixing.
# TWO PREDICATES, AND THE FIRST CUT COLLAPSED THEM INTO ONE. `[[ -n "$2" ]]`
# answered "is the value non-empty" and was read as answering "does a value
# exist". Those coincide on the reported instances and diverge on a SUPPLIED
# EMPTY one: `ng log-action --note ""` is a documented, tested caller — it takes
# the `if $note != ""` branch and omits the key — and the class sweep turned it
# into a hard error, red at `test-ng-log-action.sh` (28/0 on `dev`, 26/2 with the
# collapsed predicate). Guarding a class on a PROXY for its property is the
# defect one layer out from the one this branch is about, so both questions are
# now asked separately:
#
#   ARITY     ($2 = the CALLER's `$#`, read at the case arm before any shift)
#             — a value exists iff two positionals remain. This is exactly the
#             condition under which `shift 2` succeeds, i.e. the mechanism the
#             comment above describes, asked directly instead of by proxy.
#   NON-EMPTY ($3 = the candidate value) — a SEMANTIC requirement of most flags,
#             and the reason `ng pr merge 42 --sha ""` must still refuse rather
#             than merge unpinned. Default ON; a flag whose contract genuinely
#             admits an empty string opts out with `--allow-empty`, which is a
#             visible per-flag decision rather than a silent class-wide loosening.
#
# Usage:  _need_val <flag> "$#" "${2:-}" [--allow-empty]
# EX_USAGE (sysexits.h). One user-visible condition must not have two exit
# codes (your-org/nexus-code#990). A flag given no value is a USAGE error, and
# every other script in this repo already says so with 64 — measured at
# 7c4ddbb, `_argloop_stuck` is defined in SIXTEEN scripts and all sixteen exit
# 64:
#
#   for f in $(git grep -l "^_argloop_stuck()" -- ':(glob)**/*.sh' monitor/ng); do
#       awk "/^_argloop_stuck\(\)/{i=1} i&&/exit [0-9]+/{print \$2; exit}" "$f"; done
#   # -> 64, sixteen times
#
# `ng` was the single outlier at rc 1, so #990's option 1 is not a coin-flip
# between two conventions — it aligns ONE helper with sixteen scripts. #990
# itself frames this as "guards-for-diff/ci-head-attempts vs ng", which
# understates it: those two are a sample of the sixteen, not the population.
_die_usage() { printf '%s\n' "$*" | sed 's/^/ng: /' >&2; exit 64; }

_need_val() {
    # A call site left in an older spelling would pass a VALUE where an argc is
    # expected. Refuse anything that is not an argc rather than arithmetic-
    # evaluating a string into a plausible answer.
    #
    # THIS BRANCH KEEPS `die` (rc 1) ON PURPOSE. It is not a usage error: the
    # user did nothing wrong, `ng` called its own helper incorrectly. EX_USAGE
    # would tell a caller "fix your command line" about a bug it cannot fix.
    # The two branches below are the user-facing condition #990 is about.
    [[ "${2:-}" =~ ^[0-9]+$ ]] \
        || die "internal: _need_val $1 expects the caller's \$# as its 2nd argument (got '${2:-}')"
    (( $2 >= 2 )) || _die_usage "$1 requires a value (nothing followed it on the command line)"
    [[ "${4:-}" == "--allow-empty" ]] && return 0
    # An EMPTY value is the same user-visible condition as a missing one — the
    # flag did not receive a usable value — so it takes the same code. Keeping
    # it at 1 would replace the two-script split #990 reports with a two-BRANCH
    # split inside one helper, which is harder to see and no more correct.
    [[ -n "${3:-}" ]] || _die_usage "$1 requires a non-empty value"
}

cmd_pr_merge() {
    _help_check "$@"
    local n=""
    local method="squash" delete_branch=0 repo_arg="" pin_sha="" pin_base="" verify_base=0
    _argloop_prev_20=-1; while (( $# > 0 )); do (( $# != _argloop_prev_20 )) || _argloop_stuck "$1"; _argloop_prev_20=$#
        case "$1" in
            --squash) method="squash"; shift ;;
            --merge)  method="merge";  shift ;;
            --rebase) method="rebase"; shift ;;
            # `${2:-}` + `shift 2` on a FINAL flag silently yields an EMPTY
            # pin and shifts past the end — so `ng pr merge 42 --sha` merged
            # UNPINNED while looking like it had pinned something. A flag whose
            # value is missing is a caller error, not a default (S5).
            --sha)    _need_val --sha "$#" "${2:-}"; pin_sha="$2"; shift 2 ;;
            --base-sha) _need_val --base-sha "$#" "${2:-}"; pin_base="$2"; shift 2 ;;
            --verify-base) verify_base=1; shift ;;
            --delete-branch) delete_branch=1; shift ;;
            --repo)   _need_val --repo "$#" "${2:-}"; repo_arg="$2"; shift 2 ;;
            --*) die "unknown flag: $(_arg_excerpt "$1")" ;;
            *)  if [[ -z "$n" ]]; then n="$1"
                else die "unexpected POSITIONAL argument $(_arg_excerpt "$1"). Flags must start with --; positionals are matched in order."; fi
                shift ;;
        esac
    done
    [[ -n "$n" ]] || die "usage: ng pr merge <n> [--repo <owner/name>] [--squash|--merge|--rebase] [--sha <verified-head>] [--base-sha <verified-base>|--verify-base] [--delete-branch]"
    local head_ref head_sha sha target pr_json verify_sha body resp err_txt err_tmp
    target=$(_resolve_repo write "$repo_arg") || exit $?
    pr_json=$(api "/repos/$target/pulls/$n" 2>/dev/null)
    head_ref=$(jq -r '.head.ref // empty' <<<"$pr_json")
    head_sha=$(jq -r '.head.sha // empty' <<<"$pr_json")
    # `--verify-base` — the sha-free form, and the one to reach for
    # (your-org/nexus-code#880). `--base-sha` makes the CALLER carry a sha from
    # whenever `ci-attempts` last ran; measured, the window between that verdict
    # and the merge has been as short as NINETEEN SECONDS (`#890`, 2026-08-14),
    # which is a window a human-paced agent can follow the instructions for and
    # still lose. This form re-derives the answer HERE, milliseconds before the
    # PUT, so there is no sha to carry and no interval to lose.
    if (( verify_base == 1 )); then
        local _vb_here _vb_disp
        _vb_here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
        if [[ -r "$_vb_here/_merge_ref_base.sh" ]]; then
            # shellcheck source=/dev/null
            . "$_vb_here/_merge_ref_base.sh"
            REPO="$target" PR_NUM="$n" SHA="${pin_sha:-$head_sha}" _merge_ref_base
            _vb_disp=$(_mrb_clearance_disposition "$_MRB_STATE")
            if [[ "$_vb_disp" == withhold ]]; then
                die "pr merge REFUSED by --verify-base: the merge-ref base check says \`$_MRB_STATE\`. $_MRB_DETAIL. The green you are merging on does not describe the tree that would land (#823, #878, #880). Merge the base in (or push) so a run exists against the current base, then retry."
            fi
            # `permit` is NOT `verified`. It includes `unread` (logs expired)
            # and `n/a` (no PR context) — states where nothing was checked and
            # blocking would be wrong. Saying "OK" about those is the exact
            # conflation this branch exists to remove, one level out: a base
            # nobody looked at must not read as a base looked at and found
            # current.
            if [[ "$_MRB_STATE" == current ]]; then
                echo "ng: --verify-base VERIFIED — $_MRB_DETAIL" >&2
            else
                echo "ng: --verify-base NOT CHECKED (\`$_MRB_STATE\`) — proceeding, because this state cannot be blocked on without breaking every older head, but the base was NOT verified: $_MRB_DETAIL" >&2
            fi
        else
            die "pr merge REFUSED: --verify-base was requested but $_vb_here/_merge_ref_base.sh is missing, so the base could not be checked. Refusing rather than merging an unchecked base — absence of the checker is not evidence the base is fine."
        fi
    fi
    if [[ -n "$pin_base" ]]; then
        # THE LIVE TIP OF THE REF, never `.base.sha`. The PR object's `.base.sha`
        # is a frozen snapshot GitHub does not advance as the branch moves, so
        # comparing against it is a check that cannot fail — the identical
        # mistake `_merge_ref_base.sh` documents at length and refuses.
        local base_ref live_base
        base_ref=$(jq -r '.base.ref // empty' <<<"$pr_json")
        [[ -n "$base_ref" ]] || die "pr merge REFUSED: --base-sha was given but the PR's base BRANCH could not be read, so there is nothing to compare the pin against. Fail-closed: re-verify and retry."
        live_base=$(api "/repos/$target/git/ref/heads/$base_ref" 2>/dev/null | jq -r '.object.sha // empty')
        [[ -n "$live_base" ]] || die "pr merge REFUSED: --base-sha was given but the LIVE tip of $base_ref could not be read. Refusing to fall back to the PR's frozen .base.sha, which cannot detect base movement (#880)."
        if [[ "$live_base" != "$pin_base" ]]; then
            die "pr merge REJECTED: the BASE moved. You verified against ${pin_base:0:12}; $base_ref is now ${live_base:0:12}. The green you are merging on describes a tree that would not land — and this advance merges CLEANLY, so GitHub would not have told you (#823, #880). Re-run \`ng ci-attempts $n\` against the new base, then retry with the base-sha it prints."
        fi
        echo "ng: base pin OK — $base_ref is still ${live_base:0:12}" >&2
    fi
    verify_sha="${pin_sha:-$head_sha}"
    if [[ -n "$verify_sha" ]]; then
        body=$(jq -n --arg m "$method" --arg s "$verify_sha" '{merge_method:$m, sha:$s}')
        [[ -n "$pin_sha" ]] || echo "ng: pinning merge to fetched head $verify_sha; pass --sha <verified-head> to pin the head you actually verified" >&2
    else
        # No head sha available (some mocks, or an API hiccup). Fall back to the
        # unpinned form rather than blocking the merge — loud, not silent.
        echo "ng: WARNING could not resolve head sha; merging UNPINNED (no head-moved protection)" >&2
        body=$(jq -n --arg m "$method" '{merge_method:$m}')
    fi
    # Keep stdout (JSON) clean for jq; stderr (gh's "HTTP 409 …" line, or a
    # deprecation warning) goes to a temp so a warning cannot corrupt the parse.
    err_tmp=$(mktemp)
    resp=$(printf '%s' "$body" | api -X PUT "/repos/$target/pulls/$n/merge" --input - 2>"$err_tmp")
    err_txt=$(<"$err_tmp"); rm -f "$err_tmp"
    sha=$(jq -r '.sha // empty' <<<"$resp" 2>/dev/null)
    if [[ -z "$sha" ]]; then
        if grep -qiE 'HTTP 409|Head branch was modified|Base branch was modified|SHA .* could not be resolved' <<<"$resp$err_txt"; then
            die "pr merge REJECTED: the PR head moved since ${verify_sha:-<unpinned>} (GitHub 409). Re-verify the NEW head and retry — do not merge a head you did not check. Response: $resp $err_txt"
        fi
        die "pr merge failed: $resp $err_txt"
    fi
    printf '%s\n' "$sha"
    if (( delete_branch == 1 )); then
        [[ -n "$head_ref" ]] || { echo "ng: could not resolve head ref; skipping delete" >&2; return 0; }
        api -X DELETE "/repos/$target/git/refs/heads/$head_ref" >/dev/null \
            || echo "ng: failed to delete branch $head_ref (already gone?)" >&2
    fi
}

# Read-only summary: #N state=OPEN author=login title=..., plus head->base.
# `--json [field,...]` switches to scriptable JSON (#236 B4): bare
# `--json` prints the full REST pull object; `--json number,state,title`
# selects those fields. Field names are GitHub REST pull-object keys
# (number, state, title, draft, merged, mergeable, …); dotted paths like
# `head.ref` resolve too.
cmd_pr_view() {
    _help_check "$@"
    local n=""
    local repo_arg="" want_json=0 json_fields=""
    _argloop_prev_21=-1; while (( $# > 0 )); do (( $# != _argloop_prev_21 )) || _argloop_stuck "$1"; _argloop_prev_21=$#
        case "$1" in
            --repo) _need_val --repo "$#" "${2:-}"; repo_arg="$2"; shift 2 ;;
            --json)
                want_json=1
                # An optional following token that isn't another flag is
                # the comma-separated field selector.
                if [[ -n "${2:-}" && "$2" != --* ]]; then
                    json_fields="$2"; shift 2
                else
                    shift
                fi
                ;;
            --*) die "unknown flag: $(_arg_excerpt "$1")" ;;
            *)  if [[ -z "$n" ]]; then n="$1"
                else die "unexpected POSITIONAL argument $(_arg_excerpt "$1"). Flags must start with --; positionals are matched in order."; fi
                shift ;;
        esac
    done
    [[ -n "$n" ]] || die "usage: ng pr view <n> [--repo <owner/name>] [--json [field,...]]"
    local target raw
    target=$(_resolve_repo read "$repo_arg") || exit $?
    raw=$(api "/repos/$target/pulls/$n" 2>/dev/null)
    [[ -n "$raw" ]] && jq -e '.number' <<<"$raw" >/dev/null 2>&1 \
        || die "pr $n: fetch failed"
    if (( want_json )); then
        if [[ -n "$json_fields" ]]; then
            local filter='{}' f
            local IFS=','
            for f in $json_fields; do
                f="${f// /}"
                [[ -n "$f" ]] || continue
                [[ "$f" =~ ^[A-Za-z0-9_.]+$ ]] \
                    || die "pr view --json: invalid field name: $f"
                filter="$filter + {\"$f\": (.$f? // null)}"
            done
            jq -S "$filter" <<<"$raw"
        else
            jq -S '.' <<<"$raw"
        fi
        return 0
    fi
    jq -r 'select(.number) | "#\(.number) state=\(.state | ascii_upcase) author=\(.user.login) \(.head.ref)->\(.base.ref) title=\(.title)"' <<<"$raw"
}

# ---- read-only repo / comment helpers ----

# `ng preflight <owner/repo>` — is the bot's installation able to write
# to this repo? Cross-repo PR/issue verbs would otherwise surface a
# confusing "Resource not accessible by integration" GraphQL error;
# this turns that into one explicit yes/no line front-loaded.
#
# Beyond the yes/no, preflight surfaces the installation's
# `repository_selection` (all|selected) and — when the repo is missing —
# a concrete management URL plus the bot name, so the operator lands on
# the page that adds the repo instead of hunting through GitHub's
# settings UI (U5, your-org/your-nexus#236). One /installation/
# repositories call drives all of it.
#
# Exit 0: yes. Exit 1: no (with remediation hint).
cmd_preflight() {
    _help_check "$@"
    local target="${1:-}"
    [[ -n "$target" ]] || die "usage: ng preflight <owner/repo>"
    [[ "$target" == */* ]] || die "preflight: target must be OWNER/NAME (got: $target)"

    # One paginated fetch surfaces BOTH the membership test and
    # repository_selection — same slurp shape as _preflight_repo, so the
    # two stay in sync. errexit is off (set -uo pipefail, no -e); the
    # `|| x=...` guards convert jq's -e "result was false/null" exit and
    # any empty-payload jq error into a safe default rather than aborting.
    local payload installed selection
    payload=$(api --paginate "/installation/repositories?per_page=100" 2>/dev/null)
    installed=$(printf '%s' "$payload" | jq -es --arg t "$target" \
        '[.[].repositories[]?.full_name] | any(. == $t)' 2>/dev/null) || installed=false
    selection=$(printf '%s' "$payload" | jq -rs \
        '[.[].repository_selection] | map(select(. != null)) | first // "unknown"' \
        2>/dev/null) || selection=unknown

    if [[ "$installed" == "true" ]]; then
        printf 'bot installed: yes (%s) — repository_selection=%s\n' "$target" "$selection"
        return 0
    fi

    local bot_name owner install_id url owner_match
    bot_name=$("$_cfg" github.bot_git_name "the nexus bot")
    bot_name="${bot_name%\[bot\]}"
    owner="${target%%/*}"
    install_id=$("$_cfg" github.bot_installation_id 2>/dev/null) || install_id=""

    # Pin the installation id in the URL only when we can confirm the
    # bot's installation actually lives under $owner (it can see at least
    # one repo owned by $owner). A stale id under the wrong org 404s, so
    # otherwise fall back to the org-level installations list page.
    owner_match=$(printf '%s' "$payload" | jq -es --arg o "$owner" \
        'any(.[].repositories[]?; .owner.login == $o)' 2>/dev/null) || owner_match=false
    if [[ -n "$install_id" && "$owner_match" == "true" ]]; then
        url="https://github.com/organizations/$owner/settings/installations/$install_id"
    else
        url="https://github.com/organizations/$owner/settings/installations"
    fi

    printf 'bot installed: NO (%s) — repository_selection=%s\n' "$target" "$selection"
    printf '  ask org admin for %s to add %s to %s'\''s installation:\n' \
        "$owner" "$target" "$bot_name"
    printf '    %s\n' "$url"
    return 1
}

# `ng show <comment-id>` — read-only fetch of a comment by ID. Bypasses
# the `ng process` eligibility filter (which only surfaces
# user-authored comments) so agents can quote prior bot deliverables in
# replies. The security boundary is in the *processing* path, not the
# read path.
#
# `--meta` additionally emits the CAS snapshot header for
# `ng comment-edit --expect-updated-at` (the safe read half of the
# read-modify-write loop, #524 defect 1):
#   id=<cid>
#   updated_at=<ts>
#   body<<EOF
#   <body>
#   EOF
cmd_show() {
    _help_check "$@"
    local cid=""
    local repo_arg="" with_meta=0
    _argloop_prev_22=-1; while (( $# > 0 )); do (( $# != _argloop_prev_22 )) || _argloop_stuck "$1"; _argloop_prev_22=$#
        case "$1" in
            --repo) _need_val --repo "$#" "${2:-}"; repo_arg="$2"; shift 2 ;;
            --meta) with_meta=1;       shift   ;;
            --*) die "unknown flag: $(_arg_excerpt "$1")" ;;
            *)  if [[ -z "$cid" ]]; then cid="$1"
                else die "unexpected POSITIONAL argument $(_arg_excerpt "$1"). Flags must start with --; positionals are matched in order."; fi
                shift ;;
        esac
    done
    [[ -n "$cid" ]] || die "usage: ng show <comment-id> [--repo <owner/name>] [--meta]"
    local target meta body
    target=$(_resolve_repo read "$repo_arg") || exit $?
    meta=$(api "/repos/$target/issues/comments/$cid" 2>/dev/null) \
        || die "comment $cid: fetch failed"
    body=$(jq -r '.body // empty' <<<"$meta")
    [[ -n "$body" ]] || die "comment $cid: fetch failed (or empty body)"
    if (( with_meta == 1 )); then
        local updated
        updated=$(jq -r '.updated_at // empty' <<<"$meta")
        [[ -n "$updated" ]] || die "comment $cid: malformed metadata (no updated_at)"
        printf 'id=%s\nupdated_at=%s\nbody<<EOF\n%s\nEOF\n' "$cid" "$updated" "$body"
    else
        printf '%s\n' "$body"
    fi
}

# ---- dashboard ----

# Resolve the overview issue number. Three layers of robustness, in
# priority order, against the labelled-issue index's eventual
# consistency (~60% empty-result rate observed in
# `reports/nexus_2026-04-27_113127_ng-overview-flakiness.md`):
#
#   1. `github.overview_issue_number` in config/nexus.yml — if set,
#      skip the lookup entirely. Cheapest, most reliable.
#   2. Per-process cache at $STATE_DIR/overview-number — populated on
#      first successful lookup; valid for the life of this state dir.
#   3. Live API call with up to 3 attempts (1s + 2s backoff) when the
#      label index returns `[]` transiently.
#
# Cache busts on first lookup mismatch (e.g. relabelled issue) — a
# stale cache that resolves to a non-overview issue dies on the
# eventual PATCH, not silently.
_overview_number() {
    local cache="$STATE_DIR/overview-number"
    local pinned
    pinned=$("$_cfg" github.overview_issue_number "" 2>/dev/null || true)
    if [[ -n "$pinned" && "$pinned" =~ ^[0-9]+$ ]]; then
        printf '%s' "$pinned"
        return 0
    fi
    if [[ -f "$cache" ]]; then
        local cached
        cached=$(cat "$cache" 2>/dev/null)
        if [[ "$cached" =~ ^[0-9]+$ ]]; then
            printf '%s' "$cached"
            return 0
        fi
    fi
    local n="" attempt=1 backoff=1
    while (( attempt <= 3 )); do
        n=$(api "/repos/$REPO/issues?labels=nexus:overview&state=open&per_page=5" 2>/dev/null \
            | jq -r '.[0].number // empty')
        [[ -n "$n" ]] && break
        sleep "$backoff"
        backoff=$(( backoff * 2 ))
        (( attempt++ ))
    done
    [[ -n "$n" ]] || die "no open issue with label nexus:overview (3 attempts; pin via github.overview_issue_number to skip lookup)"
    mkdir -p "$STATE_DIR"
    printf '%s' "$n" > "$cache"
    printf '%s' "$n"
}

# Extract the dashboard middle (everything between markers, exclusive).
_extract_middle() {
    awk -v s="$DASH_START" -v e="$DASH_END" '
        $0 ~ s { in_block = 1; next }
        $0 ~ e { in_block = 0 }
        in_block { print }
    '
}

# Splice: print prefix + START line + new middle (from $1 file) + END line + suffix.
#
# your-org/nexus-code#959 — EMIT AT MOST ONCE. This used to call `emit_new()`
# on EVERY line matching START, so a body that had already been corrupted into
# a nested marker pair duplicated the middle on each subsequent put — and on
# CORRECT puts too, so the corruption compounded rather than washing out.
# Measured against a synthetic fixture with a single-pair control in the same
# run (HEAD 7c4ddbb, before this change):
#
#   HEAD/START/CONTENT/END/FOOT                      -> CONTENT x1   (control)
#   HEAD/START/OLD/START/OLD2/END/MORE/END/FOOT      -> CONTENT x2   (nested)
#
# `cmd_dashboard_put` now REFUSES a live body with more than one pair, so this
# path should be unreachable from that caller. The flag stays anyway: it is
# what makes a pre-existing nesting DEGRADE instead of compound, and a guard
# that depends on its only caller having checked first is a guard in name.
_splice_body() {
    awk -v s="$DASH_START" -v e="$DASH_END" -v nf="$1" '
        function emit_new(    line) { while ((getline line < nf) > 0) print line; close(nf) }
        $0 ~ s { print; if (!emitted) { emit_new(); emitted = 1 } ; in_block = 1; next }
        $0 ~ e { in_block = 0; print; next }
        !in_block { print }
    '
}

# your-org/nexus-code#959, generalised past the verb it was filed against.
#
# `#959` is about `cmd_dashboard_put`, and explicitly did not enumerate the
# other marker-splice sites. Deriving the population by the PROPERTY rather
# than by marker name — every `in_block=1; print block` in this file — finds
# TWO more, both upserting into the SAME overview issue body: the
# `nexus-identity` block and the `interactive-sessions` block. Both carried
# the identical unguarded shape. These two helpers exist so the guard lives
# once and a fourth marker family inherits it instead of re-earning the bug.
#
# They are deliberately SEPARATE functions. The check must run OUTSIDE a
# command substitution, because `die` inside `$( )` exits only the subshell
# and the caller sails on with an empty body — which is this batch's whole
# defect class, and would be a fine way to reintroduce it inside its own fix.

# Refuse a body already carrying more than one of either marker. Call this
# DIRECTLY, never inside `$( )`.
_assert_single_marker_pair() {
    local label="$1" name="$2" current="$3"
    local n_start n_end
    n_start=$(grep -cE "<!--[[:space:]]*${name}:start[[:space:]]*-->" <<<"$current")
    n_end=$(grep -cE "<!--[[:space:]]*${name}:end[[:space:]]*-->" <<<"$current")
    if (( n_start > 1 || n_end > 1 )); then
        die "$label: the LIVE overview body carries $n_start '${name}:start' marker(s)
     and $n_end '${name}:end' marker(s) — it should carry at most one of each.
     Writing into a nested pair duplicates the block on this run AND on every
     later one, including correct ones (your-org/nexus-code#959). There is no
     automatic repair path; un-nesting is manual. Nothing was sent.
     Repair the body by hand, then re-run."
    fi
}

# Replace the delimited block, or append it when absent. Emits AT MOST ONCE.
_upsert_marked_block() {
    local name="$1" current="$2" block="$3"
    local sre="<!--[[:space:]]*${name}:start[[:space:]]*-->"
    local ere="<!--[[:space:]]*${name}:end[[:space:]]*-->"
    if grep -qE "$sre" <<<"$current"; then
        printf '%s' "$current" | awk -v block="$block" -v sre="$sre" -v ere="$ere" '
            BEGIN { in_block=0; emitted=0 }
            $0 ~ sre { in_block=1; if (!emitted) { print block; emitted=1 } ; next }
            in_block && $0 ~ ere { in_block=0; next }
            in_block { next }
            { print }'
    else
        printf '%s\n\n%s' "$current" "$block"
    fi
}

# Canonicalise a body for COMPARISON ONLY (your-org/nexus-code#1118): strip a
# trailing CR from every line and re-emit each line through awk so the
# final-newline question cannot decide the answer.
#
# THE ORIGINAL JUSTIFICATION FOR THIS WAS WRONG and is corrected here rather
# than quietly dropped. It claimed "GitHub stores issue bodies CRLF", citing
# four disagreeing size readings of one body. Measured by the skeptic pass on
# #1123: the live overview body contains **zero** CR characters, and a body
# deliberately engineered to invite normalisation — NFD vs NFC, zero-width
# space, NBSP, HTML entities, autolink candidates, explicit CRLF, a lone CR,
# emoji, HTML tags — came back BYTE-IDENTICAL, with its 3 CRs preserved as 3.
# So no CRLF rewriting is observable on this path, and the size disagreements
# have some other explanation (characters vs bytes across `gh` surfaces).
#
# The normaliser is KEPT because it is symmetric — it is applied to both sides
# of every comparison, so it cannot manufacture a match — and because it makes
# the final-newline question moot. But it is defence against a hazard that has
# not been observed, not a fix for a measured one, and saying otherwise was the
# same error as the read-back's: a claim wider than its evidence.
#
# NOTHING WRITTEN TO GITHUB PASSES THROUGH HERE. This normaliser exists on the
# verification path only; the bytes we PATCH are the bytes the caller supplied.
_body_norm() { sed 's/\r$//' | awk '{ print }'; }

# PATCH an issue body and PROVE IT LANDED (your-org/nexus-code#1118).
#
# The property is not "how many bytes did I send" — that is a proxy. The
# property is DID THE BODY I SENT ACTUALLY LAND.
#
# THE PATCH RESPONSE CANNOT ANSWER THAT, and this comment used to claim it
# could. Measured live against real GitHub on scratch issue
# your-org/nexus-code#1128 (PATCH, then an INDEPENDENT GET), by the skeptic
# pass on #1123: an over-cap PATCH returns 200 whose `.body` is THE BODY YOU
# SENT, while the store keeps the old one. `response_echoed_sent = YES` in
# every case measured, INCLUDING every swallow:
#
#     sent 262,144 B -> stored 262,144  LANDED     (the boundary lands)
#     sent 262,145 B -> stored 262,143  SWALLOWED  (one byte over)
#     sent 300,029 B -> stored     164  SWALLOWED
#
# The limit is 262,144 BYTES, not characters (a 280,018-byte / 140,018-char
# multibyte body swallowed). So a comparison against the PATCH RESPONSE
# compares the request with itself: for a server-side swallow its
# true-positive set is EMPTY. An earlier version of this helper did exactly
# that and described it as the thing that catches swallows.
#
# So there are three guards here and they cover DIFFERENT causes. Naming which
# is which is the whole point, because the previous version's error was a
# check credited with work it could not do:
#
#   1. REFUSE before sending, on size. This is what actually protects against
#      the cap — and it is exact: refusal at `> 262144`, swallow begins at
#      `> 262144`, same threshold, same unit.
#   2. CLIENT-SIDE integrity, from the PATCH response. Because the response
#      echoes the REQUEST, this catches corruption on OUR side of the wire —
#      a payload `jq` mangled (it silently substitutes invalid UTF-8 at rc 0),
#      a truncated encode — and nothing on the server's side.
#   3. SERVER-SIDE truth, from an INDEPENDENT GET. This is the only thing here
#      that observes the STORE rather than the request, so it is the only
#      thing that can catch a swallow — from the cap or from any cause nobody
#      has enumerated. It costs one extra API call, which is what the earlier
#      version was wrong to think it could save.
#
# (3) is #1010's `cmp` run in the opposite direction: #1010 compares intent
# against the CURRENT state to refuse a no-op that would buy false freshness;
# this compares intent against the RESULTING state to refuse a claim of
# success. Same primitive, both ends of the same write.
#
# NOT covered, and the read-back would not catch these either since they need
# not change the body at all: secondary rate limits, abuse/spam filtering, a
# locked or transferred issue, GraphQL-path writes. Unmeasured, by me and by
# the skeptic.
#
# Usage:  _patch_issue_body <repo> <issue-number> <body-file> <verb-label>
# stdout: the issue html_url, and ONLY when the write is verified applied.
# exit:   0 verified applied
#         1 refused before sending, or PATCH failed, or VERIFIED NOT APPLIED
#         4 the PATCH may have applied but could NOT be verified — a refusal
#           to claim, deliberately distinct from a claim of failure.
#
# FAIL-CLOSED ON MISMATCH, and that is a considered trade. A concurrent edit
# landing between the caller's fetch and this PATCH would read here as a
# mismatch and exit 1 on a write that did apply. That window is milliseconds
# (`cmd_dashboard_put` re-fetches immediately before splicing), the failure is
# LOUD and re-running fixes it — whereas the opposite policy is #1118 itself.
# A false alarm costs one command; a false success cost a day of silence.
_patch_issue_body() {
    local repo="$1" num="$2" src="$3" label="$4"
    local bytes; bytes=$(wc -c < "$src")

    if (( bytes > GH_ISSUE_BODY_MAX_BYTES )); then
        {
            printf '%s: REFUSING to PATCH — the body is %s bytes and GitHub\n' "$label" "$bytes"
            printf '  caps an issue body at %s. Over the cap GitHub answers HTTP 200\n' "$GH_ISSUE_BODY_MAX_BYTES"
            printf '  whose body is THE ONE YOU SENT, while the store keeps the old one —\n'
            printf '  so sending this would look like a successful write, and would look\n'
            printf '  like one to a read-back of the response too (#1118, measured on\n'
            printf '  scratch issue your-org/nexus-code#1128).\n'
            printf '  Over by %s bytes. Nothing was sent; the issue is untouched.\n' \
                   "$(( bytes - GH_ISSUE_BODY_MAX_BYTES ))"
        } >&2
        return 1
    fi
    if (( bytes > GH_ISSUE_BODY_WARN_BYTES )); then
        printf '%s: WARNING — body is %s bytes, %s under GitHub'"'"'s %s cap.\n' \
               "$label" "$bytes" "$(( GH_ISSUE_BODY_MAX_BYTES - bytes ))" \
               "$GH_ISSUE_BODY_MAX_BYTES" >&2
        printf '  Past the cap a PATCH silently no-ops (#1118). Trim while there is room.\n' >&2
    fi

    # TEST THE PRODUCER'S RC — the payload is built to a FILE, not piped.
    #
    # `jq … | api … --input -` is a pipeline, and a pipeline's exit status is
    # its LAST command's. When the producer dies the consumer still runs, on
    # EMPTY STDIN: measured on this host, producer rc 1, payload 0 bytes,
    # PIPELINE RC 0. A PATCH carrying no `body` field is not an error to
    # GitHub — it returns 200 and the issue UNCHANGED. That is rc 0, a printed
    # URL, empty stderr and an unaltered body: the reported signature of
    # #1118, reachable AT ANY SIZE and with no cap involved.
    #
    # Note `set -o pipefail` at the top of this file does NOT save the old
    # form: the rc lands on an assignment nobody tested. Building to a file
    # and testing the rc removes the pipeline instead of arguing with it.
    local payload; payload=$(mktemp)
    if ! jq -Rs '{body: .}' < "$src" > "$payload"; then
        rm -f "$payload"
        printf '%s: could not encode the body as JSON — nothing was sent.\n' "$label" >&2
        return 1
    fi
    if [[ ! -s "$payload" ]]; then
        rm -f "$payload"
        printf '%s: the encoded payload is EMPTY — refusing to PATCH. A body-less\n' "$label" >&2
        printf '  PATCH returns 200 and changes nothing, which is indistinguishable\n' >&2
        printf '  from a successful write (your-org/nexus-code#1118).\n' >&2
        return 1
    fi
    local resp; resp=$(api -X PATCH "/repos/$repo/issues/$num" --input "$payload")
    rm -f "$payload"
    local url; url=$(printf '%s' "$resp" | jq -r '.html_url // empty')
    if [[ -z "$url" ]]; then
        printf '%s: PATCH failed — the response carried no html_url.\n' "$label" >&2
        return 1
    fi

    # `has("body")` rather than `.body // empty`: an ABSENT body and an EMPTY
    # one are different facts, and only the first means "cannot verify".
    if [[ "$(printf '%s' "$resp" | jq -r 'has("body")')" != "true" ]]; then
        {
            printf '%s: UNVERIFIED — the PATCH returned %s but no body, so this\n' "$label" "$url"
            printf '  command CANNOT tell you whether your content landed. It may have.\n'
            printf '  Read it back yourself before believing it (your-org/nexus-code#1118).\n'
        } >&2
        return 4
    fi

    local tmp_back tmp_sent tmp_store
    tmp_back=$(mktemp); tmp_sent=$(mktemp); tmp_store=$(mktemp)

    # `jq -j`, NEVER `jq -r`. `-r` APPENDS A NEWLINE to its output, so the
    # read-back side gained one trailing byte the sent side never had and the
    # comparison failed on every correct write. Measured while building this:
    # sent 129 bytes ending `\n\n`, `jq -r '.body'` 130 ending `\n\n\n`.
    # The check compared jq's OUTPUT (a proxy with its own formatting
    # convention) instead of the body's BYTES (the property). `-j` adds nothing.
    _body_norm < "$src" > "$tmp_sent"

    # GUARD 2 — CLIENT-SIDE INTEGRITY, from the PATCH response.
    #
    # The response echoes the REQUEST (measured — see the header), so this
    # compares what GitHub received against what this command built. That is a
    # real question with a non-empty answer set: `jq -Rs` silently substitutes
    # invalid UTF-8 at rc 0, and a truncated encode would show here. But it is
    # a question about OUR side of the wire only. It CANNOT detect a
    # server-side swallow and must never be described as though it can.
    printf '%s' "$resp" | jq -j '.body' | _body_norm > "$tmp_back"
    if ! cmp -s "$tmp_back" "$tmp_sent"; then
        {
            printf '%s: THE REQUEST WAS CORRUPTED BEFORE IT LEFT.\n' "$label"
            printf '  GitHub echoed back a body that is not the one this command built,\n'
            printf '  so the payload was mangled on OUR side (encoding, truncation).\n'
            printf '    built (normalised):  %s bytes\n' "$(wc -c < "$tmp_sent")"
            printf '    echoed (normalised): %s bytes\n' "$(wc -c < "$tmp_back")"
            printf '  Nothing downstream was updated — no cache write, no freshness stamp.\n'
        } >&2
        rm -f "$tmp_back" "$tmp_sent" "$tmp_store"
        return 1
    fi

    # GUARD 3 — SERVER-SIDE TRUTH, from an INDEPENDENT GET.
    #
    # THE ONLY GUARD HERE THAT OBSERVES THE STORE. Everything above observes
    # the request. This costs one extra API call — the call the previous
    # version of this helper wrongly believed it could save, on the grounds
    # that the PATCH response "already carries the issue object". It does, and
    # that is useless: the object it carries is the one you just handed it.
    local get_resp
    get_resp=$(api "/repos/$repo/issues/$num" 2>/dev/null)
    if [[ "$(printf '%s' "$get_resp" | jq -r 'has("body")' 2>/dev/null)" != "true" ]]; then
        {
            printf '%s: UNVERIFIED — the PATCH returned %s and the payload left here\n' "$label" "$url"
            printf '  intact, but the follow-up GET could not be read, so this command\n'
            printf '  CANNOT tell you what the store now holds. It may well have landed.\n'
            printf '  Read it back yourself before believing it (#1118).\n'
        } >&2
        rm -f "$tmp_back" "$tmp_sent" "$tmp_store"
        return 4
    fi
    printf '%s' "$get_resp" | jq -j '.body' | _body_norm > "$tmp_store"
    if ! cmp -s "$tmp_store" "$tmp_sent"; then
        {
            printf '%s: THE WRITE DID NOT LAND. The PATCH returned %s at HTTP 200 and\n' "$label" "$url"
            printf '  echoed the body back — but an INDEPENDENT GET shows the store still\n'
            printf '  holds something else. A 200 is not evidence of a write, and neither\n'
            printf '  is the echoed response body (your-org/nexus-code#1118).\n'
            printf '    sent (normalised):   %s bytes\n' "$(wc -c < "$tmp_sent")"
            printf '    stored (normalised): %s bytes\n' "$(wc -c < "$tmp_store")"
            printf '  Nothing downstream was updated — no cache write, no freshness stamp.\n'
            printf '  If someone edited the issue concurrently, re-run; otherwise check size.\n'
        } >&2
        rm -f "$tmp_back" "$tmp_sent" "$tmp_store"
        return 1
    fi
    rm -f "$tmp_back" "$tmp_sent" "$tmp_store"
    printf '%s\n' "$url"
}

# Resolve the overview issue number WITHOUT an API round-trip — for
# rendering (identity block, scaffold pointer) where the live number
# isn't load-bearing. Config pin first, else the conventional `1`.
# (`_overview_number` remains the authoritative, API-backed resolver
# used on the write path.)
_overview_number_cheap() {
    local pinned
    pinned=$("$_cfg" github.overview_issue_number "" 2>/dev/null || true)
    if [[ -n "$pinned" && "$pinned" =~ ^[0-9]+$ ]]; then
        printf '%s' "$pinned"
    else
        printf '1'
    fi
}

# ---- dashboard schema (scaffold + validate) ----

# Render the canonical dashboard skeleton to stdout. Every section in
# DASH_REQUIRED_SECTIONS appears with a one-line hint describing what it
# holds and whether it is operator-narrated or auto-populated. The
# operator pipes this into `ng dashboard put` (or fills it in first).
# Identity is intentionally a POINTER, not a copy — the canonical record
# lives in the `ng nexus-identity` block elsewhere in the same issue body.
_dashboard_template() {
    # `@IDENTITY_NAME@` is substituted from IDENTITY_HEADING so the
    # pointer prose names the block by the heading the generator actually
    # emits (your-org/nexus-code#886). Quoted heredoc + parameter
    # expansion, so the template's own backticks need no escaping.
    local _tpl _ident="${IDENTITY_HEADING#\#\# }"
    _tpl=$(cat <<'TEMPLATE_EOF'
## Identity
_See the auto-generated **@IDENTITY_NAME@** block above (run `ng nexus-identity`). Working directory, host, repos, watcher paths live there — not here._

## Infra
_Operator-narrated. Watcher / orchestrator / CC-pin health at a glance. e.g. `watcher ✅ live (pid 1234) · orchestrator ✅ · CC pin 1.x.y`._

## Services
_Auto-populatable from `monitor/services.registry` (name + healthcheck). One row per supervised service with its health. Narrate exceptions._

## In-flight
_Active worker windows: `window` · topic · state · branch/PR. Mirrors `tmux list-windows` + per-window heartbeats. Avoids spawn-name collisions._

## Awaiting operator
_Threads/decisions blocked on the operator: issue link · one-line ask. Empty is good news — keep it short._

## Recent landings
_Last few merged PRs / completed tasks: `#PR` · one-line summary · date. Trim to the most recent handful._
TEMPLATE_EOF
)
    printf '%s\n' "${_tpl//@IDENTITY_NAME@/$_ident}"
}

# Report which required sections are MISSING from the body in file $1.
# Prints one missing heading per line to stdout; empty output == all
# present. Pure text check (grep -Fx on each canonical heading) — no
# network, so both `dashboard validate` and the put-time warn reuse it.
#
# $2 is the OPTIONAL OUTER CONTEXT — the whole issue body, when the caller
# has it. A section counts as present if it appears in EITHER file, and that
# is a contract decision, not a leniency:
#
#   The six sections are required OF THE ISSUE BODY, not of the dashboard
#   region. The region is where the operator NARRATES them.
#
# `## Identity` is the case that forces the question. The scaffold's own
# `## Identity` text is a POINTER — "see the auto-generated Nexus Identity
# block above" — and `DASH_SECTION_ALIASES` exists (your-org/nexus-code#886)
# so that a body carrying the generated block satisfies the requirement. But
# the generated block legitimately sits ABOVE the START marker, and this
# check ran on the MIDDLE alone, so the alias could only ever be satisfied by
# a block INSIDE the region — contradicting the pointer design it was written
# to support. The result was a `put` that warned "missing required
# section(s): ## Identity … pushing anyway" on every single run, forever,
# about a section three lines above the marker.
#
# That is worse than a wrong warning. It is a warning that is STRUCTURALLY
# INCAPABLE of being right, in the reassuring direction, on a surface whose
# whole job is to be believed — so the operator learns to ignore it, and the
# next true warning is ignored with it.
#
# Callers WITHOUT the outer body (`validate --body-file <a middle>`) pass one
# argument and must say what they could not see, rather than assert absence.
#
# FENCE-AWARE, via `_dashboard_headings`. This used `grep -qFx` and was
# fence-BLIND while `_dashboard_headings` in the same verb was fence-aware —
# the codebase already had the right primitive and this did not use it. The
# skeptic pass on #1123 measured the consequence, with a negative control:
#
#   region with none of the six, no outer arg          -> all six missing
#   same region + outer whose six headings appear ONLY
#     inside a ``` fence                               -> NONE reported missing
#   outer with no headings at all (negative control)   -> six missing
#
# So a quoted scaffold example, or a pasted prompt excerpt, satisfied the
# schema. That is bad anywhere and worse HERE, because the whole-body
# loosening above points this predicate at exactly the prose where quoted
# examples live. A stricter-checking PR must not ship a looser predicate.
_dashboard_missing_sections() {
    local file="$1" outer="${2:-}" section alias
    local hdr_file hdr_outer
    hdr_file=$(mktemp); hdr_outer=$(mktemp)
    _dashboard_headings "$file" | cut -f2- > "$hdr_file"
    if [[ -n "$outer" && -f "$outer" ]]; then
        _dashboard_headings "$outer" | cut -f2- > "$hdr_outer"
    fi
    for section in "${DASH_REQUIRED_SECTIONS[@]}"; do
        grep -qFx "$section" "$hdr_file" && continue
        grep -qFx "$section" "$hdr_outer" && continue
        alias="${DASH_SECTION_ALIASES[$section]:-}"
        if [[ -n "$alias" ]]; then
            grep -qFx "$alias" "$hdr_file" && continue
            grep -qFx "$alias" "$hdr_outer" && continue
        fi
        printf '%s\n' "$section"
    done
    rm -f "$hdr_file" "$hdr_outer"
    # Explicit: the loop's last command is now a `grep … && continue`
    # chain, so the function's rc would otherwise be "did the last
    # section match". Callers read the STDOUT, never the rc.
    return 0
}

# your-org/nexus-code#1058 — PRESENCE IS NOT UNIQUENESS.
#
# `_dashboard_missing_sections` above answers "does each required heading
# appear", and `grep -qFx` returns on the FIRST match, so a body carrying two
# contradictory copies of a required section validated OK. Reproduced at
# 7c4ddbb on a fixture with `## Infra` twice, one copy saying the watcher is
# live and the other saying it is dead: `dashboard validate: OK (all 6
# required sections present)`, rc 0.
#
# These three helpers answer the questions presence cannot.

# Enumerate top-level headings OUTSIDE fenced code blocks, as
# "<lineno>\t<heading>". The fence skip is not fussiness: a dashboard quotes
# command output, and a `## Infra` inside a ``` block is a quotation, not a
# section. Counting it would make the checker fire on correct dashboards,
# which is how a linter gets switched off.
_dashboard_headings() {
    awk '
        /^[ \t]*(```|~~~)/ { fence = !fence; next }
        !fence && /^## / { printf "%d\t%s\n", NR, $0 }
    ' "$1"
}

# Normalise a heading to its IDENTITY (your-org/nexus-code#1058 point 2).
#
# `## 🛑 Board — QUIESCED` and `## Board — 3 workers active` are the same
# section by intent and different strings by regex, so an exact anchor
# simultaneously OVER-counts the name (two matches where one is stale) and
# UNDER-counts it (a real section the checker cannot see). This strips the
# `## `, any leading non-alphanumerics (emoji, `🛑`), and everything from the
# first em/en dash, colon or ` - ` separator, then casefolds.
#
# Multibyte separators are found with `index()` on BYTES rather than named in
# a regex — gawk and mawk disagree about multibyte character classes, and this
# file runs under whichever awk the host has. Verified against gawk 4.1.4.
_dashboard_heading_key() {
    awk '
        function key(h,   t, p) {
            t = h
            sub(/^##[ \t]*/, "", t)
            sub(/^[^A-Za-z0-9]+/, "", t)
            p = index(t, "\xe2\x80\x94"); if (p > 0) t = substr(t, 1, p-1)   # em dash
            p = index(t, "\xe2\x80\x93"); if (p > 0) t = substr(t, 1, p-1)   # en dash
            p = index(t, ":");            if (p > 0) t = substr(t, 1, p-1)
            p = index(t, " - ");          if (p > 0) t = substr(t, 1, p-1)
            gsub(/^[ \t]+|[ \t]+$/, "", t)
            return tolower(t)
        }
        { print key($0) }
    '
}

# Report duplicated headings in the body in file $1. One record per group:
#
#     EXACT<TAB><count><TAB><line,line,...><TAB><heading>
#     NEAR<TAB><count><TAB><line,line,...><TAB><normalised key>
#
# EXACT = the identical heading text on more than one line. That is always
# accretion, never style: the dashboard is a ROUTING SURFACE, and two sections
# with the same name give an operator two answers to one question.
# NEAR = distinct headings sharing a normalised key — reported, never failed,
# because two sections legitimately may differ after their separator.
_dashboard_duplicate_headings() {
    _dashboard_headings "$1" | awk -F'\t' '
        function key(h,   t, p) {
            t = h
            sub(/^##[ \t]*/, "", t)
            sub(/^[^A-Za-z0-9]+/, "", t)
            p = index(t, "\xe2\x80\x94"); if (p > 0) t = substr(t, 1, p-1)
            p = index(t, "\xe2\x80\x93"); if (p > 0) t = substr(t, 1, p-1)
            p = index(t, ":");            if (p > 0) t = substr(t, 1, p-1)
            p = index(t, " - ");          if (p > 0) t = substr(t, 1, p-1)
            gsub(/^[ \t]+|[ \t]+$/, "", t)
            return tolower(t)
        }
        {
            h = $2; k = key(h)
            if (!(h in ecount)) { eorder[++en] = h }
            ecount[h]++;  elines[h] = (elines[h] == "" ? $1 : elines[h] "," $1)
            if (!(k in kcount)) { korder[++kn] = k }
            kcount[k]++;  klines[k] = (klines[k] == "" ? $1 : klines[k] "," $1)
            if (index("\x01" kdistinct[k], "\x01" h "\x01") == 0) {
                kdistinct[k] = kdistinct[k] h "\x01"; kdn[k]++
            }
        }
        END {
            for (i = 1; i <= en; i++) { h = eorder[i]
                if (ecount[h] > 1) printf "EXACT\t%d\t%s\t%s\n", ecount[h], elines[h], h }
            for (i = 1; i <= kn; i++) { k = korder[i]
                if (kcount[k] > 1 && kdn[k] > 1) printf "NEAR\t%d\t%s\t%s\n", kcount[k], klines[k], k }
        }
    '
}

# `ng dashboard scaffold` — print the canonical skeleton.
cmd_dashboard_scaffold() {
    _help_check "$@"
    (( $# == 0 )) || die "usage: ng dashboard scaffold (no args)"
    _dashboard_template
}

# `ng dashboard validate [--body-file <path>]` — check a candidate
# dashboard body (file or stdin) against DASH_REQUIRED_SECTIONS.
# Exit 0 = all required headings present; exit 1 = one or more missing
# (listed on stderr). This is the STRICT gate for CI / pre-commit use;
# the `dashboard put` path runs the same check in WARN-only mode so the
# operator is never blocked from pushing in a hurry.
cmd_dashboard_validate() {
    _help_check "$@"
    local body_file="" have_body_file=0
    _argloop_prev_23=-1; while (( $# > 0 )); do (( $# != _argloop_prev_23 )) || _argloop_stuck "$1"; _argloop_prev_23=$#
        case "$1" in --body-file) _need_val --body-file "$#" "${2:-}"; body_file="$2"; have_body_file=1; shift 2 ;; *) die "unknown flag: $(_arg_excerpt "$1")" ;; esac
    done
    local tmp; tmp=$(mktemp)
    trap "rm -f '$tmp'" RETURN

    # your-org/nexus-code#958 — NO `--body-file` NOW MEANS THE LIVE DASHBOARD.
    #
    # It used to mean stdin, which is empty in every non-interactive shell,
    # and the resulting `ng: empty dashboard body` was a verdict on THE
    # DASHBOARD rather than on this command's input. Measured against a live
    # 15,139-byte dashboard: the same body passed via `--body-file` and failed
    # via the default, same ref, same command. The obvious consequent action —
    # "the dashboard is empty, regenerate and put" — overwrites a healthy
    # dashboard on the strength of a message about stdin.
    #
    # `validate` is a READ-ONLY predicate about a thing this tool already
    # knows how to fetch (`ng dashboard get`), so the verb name has an obvious
    # intended meaning and this is now it. `--body-file <path>` still checks a
    # candidate before pushing, and `--body-file -` now explicitly asks for
    # stdin — a thing you could not previously request, only receive.
    local tmp_outer=""
    if (( have_body_file == 0 )); then
        tmp_outer=$(mktemp)
        # `_dashboard_fetch_middle` applies `_dashboard_marker_verdict` to the
        # full body, so the live path gets the uniqueness check for free — and
        # gets it BEFORE reporting anything about sections, which is the right
        # order: a body with two ENDs has no well-defined region to judge.
        _dashboard_fetch_middle "$tmp" "$tmp_outer"
    else
        _read_body "$body_file" > "$tmp"
        # A supplied body may be a REGION or a WHOLE issue body — `validate`
        # cannot tell, and must not guess. If it carries markers at all, it is
        # a whole body and the uniqueness predicate applies to it directly.
        if grep -qF -- "$DASH_START" "$tmp" || grep -qF -- "$DASH_END" "$tmp"; then
            _dashboard_marker_verdict "$tmp" "dashboard validate: --body-file $body_file" \
                || return 1
            tmp_outer="$tmp"
        fi
    fi
    if [[ ! -s "$tmp" ]]; then
        if (( have_body_file == 0 )); then
            die "dashboard validate: the LIVE dashboard region on overview #$(_overview_number_cheap)
     is empty. This one IS a verdict about the dashboard — the body was
     fetched successfully and the region between the markers has no content."
        fi
        _die_empty_body "dashboard validate" "$body_file" \
            "To validate the LIVE dashboard instead, run 'ng dashboard validate' with no flags."
    fi

    local rc=0
    local missing; missing=$(_dashboard_missing_sections "$tmp" "$tmp_outer")
    local dupes;   dupes=$(_dashboard_duplicate_headings "$tmp")
    local exact_dupes near_dupes
    exact_dupes=$(printf '%s\n' "$dupes" | awk -F'\t' '$1=="EXACT"')
    near_dupes=$(printf '%s\n' "$dupes"  | awk -F'\t' '$1=="NEAR"')

    if [[ -n "$missing" ]]; then
        rc=1
        {
            printf 'ng dashboard validate: missing required section(s):\n'
            while IFS= read -r _s; do
                printf '  - %s\n' "$_s"
                # your-org/nexus-code#1058 point 2 — ANCHOR TOLERANTLY, THEN
                # SAY WHAT YOU MATCHED. A heading like `## 🛑 Infra — …` is
                # that section by intent and invisible to `grep -Fx`, so a
                # bare "missing" verdict sends the operator to add a section
                # that is already there. Name the near miss instead.
                local _k _near
                _k=$(printf '%s\n' "$_s" | _dashboard_heading_key)
                _near=$(_dashboard_headings "$tmp" | awk -F'\t' -v k="$_k" \
                            'function key(h,   t,p){t=h;sub(/^##[ \t]*/,"",t);sub(/^[^A-Za-z0-9]+/,"",t);
                             p=index(t,"\xe2\x80\x94"); if(p>0)t=substr(t,1,p-1);
                             p=index(t,"\xe2\x80\x93"); if(p>0)t=substr(t,1,p-1);
                             p=index(t,":");           if(p>0)t=substr(t,1,p-1);
                             p=index(t," - ");         if(p>0)t=substr(t,1,p-1);
                             gsub(/^[ \t]+|[ \t]+$/,"",t); return tolower(t)}
                             key($2)==k { printf "      line %s: %s\n", $1, $2 }')
                [[ -n "$_near" ]] && {
                    printf '    NEAR MISS — this body already carries that section under\n'
                    printf '    another spelling. It is missing only to the exact anchor:\n'
                    printf '%s\n' "$_near"
                }
            done <<<"$missing"
            # SAY WHAT YOU COULD NOT SEE. A required section may legitimately
            # live OUTSIDE the dashboard region (`## Identity` is the designed
            # case — the scaffold's entry is a POINTER to a generated block
            # that sits above the START marker). Given only a region, this
            # command cannot distinguish "absent" from "elsewhere in the issue
            # body", and asserting the first would be a verdict wider than the
            # evidence — the defect this whole batch is about.
            if [[ -z "$tmp_outer" ]]; then
                printf 'NOTE: only the dashboard REGION was checked. A section that lives\n'
                printf '  outside the markers (e.g. the generated identity block) cannot be\n'
                printf '  seen from here. Run `ng dashboard validate` with no flags to check\n'
                printf '  the whole live issue body.\n'
            fi
            printf 'scaffold the full skeleton with: ng dashboard scaffold\n'
        } >&2
    fi

    if [[ -n "$exact_dupes" ]]; then
        rc=1
        {
            printf 'ng dashboard validate: DUPLICATED section heading(s) — the same\n'
            printf '  heading on more than one line. A routing surface that answers one\n'
            printf '  question twice answers it wrongly at least once (#1058):\n'
            while IFS=$'\t' read -r _kind _n _lines _h; do
                [[ -n "$_kind" ]] || continue
                printf '  - %s  (%sx, lines %s)\n' "$_h" "$_n" "$_lines"
            done <<<"$exact_dupes"
        } >&2
    fi

    if [[ -n "$near_dupes" ]]; then
        {
            printf 'ng dashboard validate: NOTE — heading(s) that differ in text but name\n'
            printf '  the same section. Not failed (a section may legitimately vary after\n'
            printf '  its separator), but worth a look:\n'
            while IFS=$'\t' read -r _kind _n _lines _k; do
                [[ -n "$_kind" ]] || continue
                printf '  - "%s"  (%sx, lines %s)\n' "$_k" "$_n" "$_lines"
            done <<<"$near_dupes"
        } >&2
    fi

    # your-org/nexus-code#1058 point 3 — PUT A NUMBER BESIDE THE VERDICT.
    # `OK` on a 222 KB, 40-section body should read as the anomaly it is, and
    # a verdict that never mentions size cannot prompt anyone to look. This is
    # deliberately advisory: the right ceiling is an operator's business, but
    # the GitHub one is not negotiable, so the headroom is named too.
    # Both numbers are COUNTS OF LINES in the body being validated, defined
    # exactly so they are checkable: `_h2` is every `## ` heading outside a
    # fenced block; `_nonschema` is those whose exact text is neither a
    # required heading nor a declared alias. A duplicated required heading
    # therefore contributes 2 to `_h2` and 0 to `_nonschema`, which is what
    # makes the pair readable next to the duplicate report above.
    local _bytes _h2 _nonschema _schema_re=""
    _bytes=$(wc -c < "$tmp")
    _h2=$(_dashboard_headings "$tmp" | wc -l)
    { local _s2; for _s2 in "${DASH_REQUIRED_SECTIONS[@]}" "${DASH_SECTION_ALIASES[@]}"; do
        [[ -n "$_s2" ]] && _schema_re="${_schema_re}${_s2}"$'\n'
      done; }
    _nonschema=$(_dashboard_headings "$tmp" | cut -f2- \
                 | grep -cvxF -- "$_schema_re" 2>/dev/null || true)
    [[ "$_nonschema" =~ ^[0-9]+$ ]] || _nonschema=0

    if (( rc == 0 )); then
        # A checker that found something must not print an unqualified pass.
        #
        # your-org/nexus-code#1058's own reported instance is a NEAR group, not
        # an EXACT one: `## Board — QUIESCED …` against `## Board — 3 workers
        # active` differ after the separator, so failing them would also fail a
        # legitimate `## Notes: infra` / `## Notes: services` pair, which is a
        # false positive and how a linter gets switched off. rc stays 0 — the
        # documented contract is "exit 1 iff a required section is missing",
        # and CI callers depend on it. But the WORD "OK" is the thing an
        # operator reads, and bare OK over a finding is this batch's class in
        # miniature: a verdict wider than what was checked.
        local _near_n=0
        [[ -n "$near_dupes" ]] && _near_n=$(printf '%s\n' "$near_dupes" | grep -c '^NEAR')
        if (( _near_n > 0 )); then
            printf 'dashboard validate: required sections OK (all %d, each exactly once) — but see the %d duplicate-name NOTE(s) above; this is NOT an unqualified pass\n' \
                   "${#DASH_REQUIRED_SECTIONS[@]}" "$_near_n"
        else
            printf 'dashboard validate: OK (all %d required sections present, each exactly once)\n' \
                   "${#DASH_REQUIRED_SECTIONS[@]}"
        fi
    fi
    printf 'dashboard validate: %s bytes, %s top-level sections (%s outside the schema).\n' \
           "$_bytes" "$_h2" "$_nonschema" >&2
    if (( _bytes > GH_ISSUE_BODY_WARN_BYTES )); then
        printf '  NOTE: GitHub caps a whole issue body at %s bytes, and the dashboard\n' \
               "$GH_ISSUE_BODY_MAX_BYTES" >&2
        printf '  region is only part of that body. Past the cap a PATCH silently\n' >&2
        printf '  no-ops at HTTP 200 (your-org/nexus-code#1118). Trim while there is room.\n' >&2
    fi
    return "$rc"
}

# PRESENCE IS NOT UNIQUENESS — the one predicate, at every entry point.
#
# This is the unifying defect behind your-org/nexus-code#1058 AND #1118, and
# the two turn out to be one sentence on two surfaces. `cmd_dashboard_put`'s
# precondition was:
#
#     grep -qF -- "$DASH_START" "$tmp_full" && grep -qF -- "$DASH_END" "$tmp_full" \
#         || die "dashboard markers missing"
#
# which asserts the markers are PRESENT and never that they are UNIQUE —
# verbatim what #1058 says about `validate` and a duplicated section heading.
# A body carrying two ENDs sails through it. Measured by the operator on the
# live overview at a FULL BODY OF 198,236 BYTES, 64 KB UNDER the cap: two
# consecutive puts, both rc 0, both printing the URL, stderr empty, body
# byte-identical, planted marker never present. Removing the duplicate END
# made the very next put land.
#
# THE CAP IS THE MECHANISM, ALWAYS — and this comment said the opposite until
# the skeptic pass on #1123 measured it. Driving the real `cmd_dashboard_put`
# against a stateful fake forge:
#
#   1 START + 2 END, 198,268 B -> merged 198,301 B -> the write LANDS
#   2 START + 2 END, 198,246 B -> merged 396,127 B -> rc 0, store UNCHANGED
#   1 START + 1 END, 240,117 B -> merged 263,350 B -> rc 0, stderr EMPTY,
#                                                     stamp WRITTEN, unchanged
#
# A duplicated END alone is HARMLESS. A duplicated START doubles the region
# through `_splice_body`'s unguarded `emit_new()` and pushes a comfortably
# sized body over the cap — so the marker defect is a cause of the SIZE, not an
# independent failure mode. The third row is the one to remember: every symptom
# of the reported failure, on a perfectly healthy single marker pair.
#
# The false step in the original reasoning was "198,236 bytes, 64 KB under the
# cap, therefore not the cap". The cap applies to the MERGED body, which was
# never measured. So uniqueness still matters — it is how a healthy body gets
# doubled — but it is the SIZE that swallows the write.
#
# Returns 0 when the body carries exactly one of each marker; prints a
# structured diagnostic and returns 1 otherwise. Call it DIRECTLY — a `die`
# inside `$( )` exits only the subshell.
_dashboard_marker_verdict() {
    local file="$1" label="$2" n_start n_end
    n_start=$(grep -cF -- "$DASH_START" "$file")
    n_end=$(grep -cF -- "$DASH_END" "$file")
    if (( n_start == 1 && n_end == 1 )); then return 0; fi
    {
        if (( n_start == 0 || n_end == 0 )); then
            printf '%s: dashboard markers missing (%s START, %s END; need exactly one of each).\n' \
                   "$label" "$n_start" "$n_end"
        else
            printf '%s: the body carries %s START marker(s) and %s END marker(s).\n' \
                   "$label" "$n_start" "$n_end"
            printf '  It must carry EXACTLY ONE of each. Duplicated markers are\n'
            printf '  not cosmetic: `get` and the splice then disagree about which marker\n'
            printf '  delimits the region, and a put can report success having published\n'
            printf '  nothing (your-org/nexus-code#1118), while a `get` -> edit -> `put`\n'
            printf '  round-trip can add another layer each cycle (#959).\n'
            printf '  Marker lines:\n'
            grep -nF -- "$DASH_START" "$file" | sed 's/^/    START @ line /' | cut -c1-100
            grep -nF -- "$DASH_END" "$file" | sed 's/^/    END   @ line /' | cut -c1-100
            printf '  There is no automatic repair path. Delete the extra marker(s) and the\n'
            printf '  duplicated region by hand, then re-run.\n'
        fi
    } >&2
    return 1
}

# Fetch the live dashboard middle into file $1.
#
# Factored out of `cmd_dashboard_get` so `dashboard validate` can read the
# live dashboard (your-org/nexus-code#958) WITHOUT `get`'s cache write — a
# read-only predicate should not move state. Takes an output FILE rather than
# printing, deliberately: as a pipeline stage its `die`s would fire in a
# subshell and the caller would sail on with an empty body, which is the
# defect class this batch is closing, not a style preference.
# $2, if given, also receives the FULL body — callers that need to check the
# six sections against the whole issue (see `_dashboard_missing_sections`) or
# to apply the uniqueness predicate need it, and re-fetching for that would
# be a second answer to a question already asked.
_dashboard_fetch_middle() {
    local out="$1" full_out="${2:-}" num body
    # A `die` INSIDE `$( )` CANNOT ABORT THE CALLER (your-org/nexus-code#1136).
    # `_overview_number`'s fatal exits the SUBSHELL; `num` is then empty and
    # this function carries on, asks for `/repos/R/issues/` and re-reports the
    # FETCH's failure as a verdict about the DASHBOARD. Consult the rc.
    num=$(_overview_number) || exit $?
    # `2>/dev/null` here swallowed gh's own diagnostic AND `token`'s `die`, and
    # the pipeline rc was discarded, so a DNS failure and a genuinely empty
    # body printed the BYTE-IDENTICAL line. Measured: nothing in the output
    # distinguished them. That is #958's shape one layer out — the failure to
    # look and the finding rendered the same.
    local _err _fetch_rc=0
    _err=$(mktemp)
    body=$(api "/repos/$REPO/issues/$num" 2>"$_err" | jq -r '.body // empty') || _fetch_rc=$?
    if (( _fetch_rc != 0 )); then
        printf 'ng: FETCH FAILED for overview #%s (rc %s). This is NOT a verdict about\n' "$num" "$_fetch_rc" >&2
        printf '    the dashboard — the body was never read. Relaying the client:\n' >&2
        sed 's/^/    | /' "$_err" >&2
        rm -f "$_err"; exit 1
    fi
    rm -f "$_err"
    [[ -n "$body" ]] || die "overview #$num has empty body. The fetch SUCCEEDED, so this one IS a verdict about the dashboard"
    local tmp_full; tmp_full=$(mktemp)
    printf '%s' "$body" > "$tmp_full"
    if ! _dashboard_marker_verdict "$tmp_full" "overview #$num"; then
        rm -f "$tmp_full"; exit 1
    fi
    _extract_middle < "$tmp_full" > "$out"
    [[ -n "$full_out" ]] && cp "$tmp_full" "$full_out"
    rm -f "$tmp_full"
}

cmd_dashboard_get() {
    _help_check "$@"
    local tmp; tmp=$(mktemp)
    trap "rm -f '$tmp'" RETURN
    _dashboard_fetch_middle "$tmp"

    # your-org/nexus-code#959 — `get` IS THE THING THAT HANDS YOU THE LOADED
    # GUN, so it is the right place to refuse.
    #
    # The compounding in #959 is not a slow leak; it is one round-trip away.
    # `get` produces the inner region and `put` consumes it, so if `get` ever
    # returns a "middle" that itself carries a marker, the operator's very
    # next `get` -> edit -> `put` re-nests the region — and it can add a
    # marker every cycle. Refusing here stops the cycle at its source rather
    # than only at `put`'s door.
    #
    # `_dashboard_marker_verdict` above has already established the FULL body
    # has exactly one pair, so reaching this is a statement about
    # `_extract_middle` rather than about the operator's body. Ten marker
    # orderings were swept against the real function and none produced a
    # marker-bearing middle — so this guard is not expected to fire, and that
    # is exactly why it is cheap to keep: it costs one grep and it converts an
    # unenumerated case from silent corruption into a refusal.
    if grep -qF -- "$DASH_START" "$tmp" || grep -qF -- "$DASH_END" "$tmp"; then
        die "dashboard get: the extracted region ITSELF contains a dashboard marker.
     Handing this back would arm a get -> edit -> put round-trip to re-nest the
     region (your-org/nexus-code#959). Nothing was cached. Inspect the raw body
     with 'gh issue view --json body --jq .body' and repair it by hand."
    fi
    mkdir -p "$STATE_DIR"
    cp "$tmp" "$DASH_CACHE"
    cat "$tmp"
}

cmd_dashboard_put() {
    _help_check "$@"
    local body_file=""
    _argloop_prev_24=-1; while (( $# > 0 )); do (( $# != _argloop_prev_24 )) || _argloop_stuck "$1"; _argloop_prev_24=$#
        case "$1" in --body-file) _need_val --body-file "$#" "${2:-}"; body_file="$2"; shift 2 ;; *) die "unknown flag: $(_arg_excerpt "$1")" ;; esac
    done
    local tmp_new tmp_full tmp_merged tmp_live
    tmp_new=$(mktemp); tmp_full=$(mktemp); tmp_merged=$(mktemp); tmp_live=$(mktemp)
    # Double-quoted trap expands paths at trap-set time, so cleanup
    # still works after the local vars go out of scope on RETURN
    # (set -u otherwise complains about unbound variables).
    trap "rm -f '$tmp_new' '$tmp_full' '$tmp_merged' '$tmp_live'" RETURN
    _read_body "$body_file" > "$tmp_new"
    # your-org/nexus-code#958 — same message, but it must name its INPUT.
    # `put` keeps stdin as a defensible default (piping a generated dashboard
    # is the documented idiom), so unlike `validate` the DEFAULT does not
    # change here — only the diagnostic, which used to blame the dashboard for
    # the caller's empty pipe.
    [[ -s "$tmp_new" ]] || _die_empty_body "dashboard put" "$body_file" \
        "'put' takes the INNER dashboard region on stdin or via --body-file."

    # your-org/nexus-code#959 — REFUSE A FULL ISSUE BODY.
    #
    # `put` consumes the INNER region; `gh issue edit --body-file` consumes
    # the WHOLE body; `ng dashboard get` PRODUCES the inner region. Two
    # conventions, three commands, nothing at the call site saying which, and
    # the wrong one was accepted silently — it nests the markers, the page
    # still renders, and then EVERY later put (including correct ones)
    # duplicates the content. The symptom is delayed and misattributed:
    # whoever notices is looking at a put made after the one that caused it.
    #
    # An operator who has just used `gh issue edit` on this issue — the
    # documented path for edits `ng` does not cover — has the full body in
    # hand. This is the natural mistake, not a careless one.
    if grep -qF -- "$DASH_START" "$tmp_new" || grep -qF -- "$DASH_END" "$tmp_new"; then
        die "dashboard put: the body you supplied CONTAINS a dashboard marker.
     'put' takes the INNER region only — the text BETWEEN the markers — not a
     full issue body. Splicing this in would NEST the markers, and every later
     put would then duplicate the content (your-org/nexus-code#959).
     Nothing was sent; the issue is untouched. Did you mean:
       ng dashboard get > d.md              # fetch the inner region to edit
       gh issue edit --body-file <whole>    # replace the WHOLE issue body"
    fi

    # Schema check in WARN-only mode: surface drift from the canonical
    # section set, but never block the push — the operator still needs to
    # update the dashboard in a hurry. `ng dashboard validate` is the
    # strict gate for anyone who wants a hard failure.
    # (The required-section check needs the WHOLE issue body to be correct
    # about `## Identity`, so it runs after the live fetch below — not here.)

    # your-org/nexus-code#1058, warn-only half. `validate` FAILS on a
    # duplicated heading; `put` says so and pushes, because the operator still
    # needs to update the dashboard in a hurry and a second `## Infra` in the
    # body they are replacing is exactly what they may be here to fix.
    local _dupes; _dupes=$(_dashboard_duplicate_headings "$tmp_new")
    if [[ -n "$_dupes" ]]; then
        {
            printf 'ng dashboard put: WARNING — duplicated section heading(s) in the body:\n'
            while IFS=$'\t' read -r _kind _n _lines _h; do
                [[ -n "$_kind" ]] || continue
                printf '  - [%s] %s  (%sx, lines %s)\n' "$_kind" "$_h" "$_n" "$_lines"
            done <<<"$_dupes"
            printf '  (pushing anyway; `ng dashboard validate` is the strict gate)\n'
        } >&2
    fi

    local num
    # Same shape as `_dashboard_fetch_middle` (your-org/nexus-code#1136): a
    # `die` in `$( )` cannot abort the caller, and the swallowed stderr made a
    # network fault indistinguishable from an empty body.
    num=$(_overview_number) || exit $?
    local _err _fetch_rc=0
    _err=$(mktemp)
    api "/repos/$REPO/issues/$num" 2>"$_err" | jq -r '.body // empty' > "$tmp_full" || _fetch_rc=$?
    if (( _fetch_rc != 0 )); then
        printf 'ng: FETCH FAILED for overview #%s (rc %s). NOTHING WAS SENT and the\n' "$num" "$_fetch_rc" >&2
        printf '    issue is untouched. This is NOT a verdict about the dashboard.\n' >&2
        sed 's/^/    | /' "$_err" >&2
        rm -f "$_err"; exit 1
    fi
    rm -f "$_err"
    [[ -s "$tmp_full" ]] || die "overview #$num: empty body. The fetch SUCCEEDED"
    # your-org/nexus-code#1118 + #1058 — ONE PREDICATE, and it is uniqueness.
    # This line used to assert PRESENCE only, which is precisely what #1058
    # says about `validate`. A body with two ENDs passed it and then no-oped.
    _dashboard_marker_verdict "$tmp_full" "overview #$num" || exit 1

    # your-org/nexus-code#886 + the operator's 2026-08-28 repair — RUN THE
    # SECTION CHECK AGAINST THE WHOLE BODY, NOW THAT WE HAVE IT.
    #
    # It used to run against the region alone, so a `## Identity` pointer
    # whose generated block legitimately sits ABOVE the START marker was
    # reported missing on EVERY put, forever: "missing required section(s):
    # ## Identity … pushing anyway". A warning that cannot be right, in the
    # reassuring direction, on the surface whose job is to be believed.
    local _missing
    _missing=$(_dashboard_missing_sections "$tmp_new" "$tmp_full")
    if [[ -n "$_missing" ]]; then
        {
            printf 'ng dashboard put: WARNING — required section(s) absent from BOTH the
'
            printf '  dashboard region and the rest of the issue body:
'
            while IFS= read -r _s; do printf '  - %s
' "$_s"; done <<<"$_missing"
            printf '  (pushing anyway; scaffold with `ng dashboard scaffold`)
'
        } >&2
    fi

    # your-org/nexus-code#1010 — A NO-OP PUT IS NOT A REFRESH, AND MUST NOT
    # BUY ONE. Measured on 2026-08-25: `ng dashboard get > d.md` followed by
    # `ng dashboard put --body-file d.md` — byte-for-byte what was already on
    # the forge — advanced the stamp 09:35:52 -> 11:42:57 and cleared the
    # watcher's staleness warning. A put that changed nothing purchased two
    # hours of asserted freshness.
    #
    # That is not a cosmetic defect, because the warning's own remedy string
    # is `refresh via monitor/ng dashboard put` — so the natural response to
    # the false-STALE half of #1010 is EXACTLY the operation that manufactures
    # the false-FRESH half. The failure mode and its advertised remedy were
    # the same command.
    #
    # So: compare the middle we are about to write against the middle already
    # on the forge, and when they are identical do NOTHING — no PATCH (which
    # would move the issue's own `updated_at` and manufacture the same lie one
    # layer down), no stamp. Say so, and exit 0: the operator asked for the
    # dashboard to say this, and it already does. Nothing failed; nothing was
    # done either, and those are different facts.
    _extract_middle < "$tmp_full" > "$tmp_live"
    if cmp -s "$tmp_live" "$tmp_new"; then
        # your-org/nexus-code#1116 review, F3. The changed path below has a
        # `mkdir -p "$STATE_DIR"` before its cache write; this arm did not, so
        # with STATE_DIR absent the `cp` printed `No such file or directory`
        # and the verb still exited 0. The suite's own #1010 test does
        # `rm -rf "$WORK/state"` immediately before this call and did not
        # notice, because nothing asserted the cache.
        mkdir -p "$STATE_DIR"
        cp "$tmp_new" "$DASH_CACHE"
        {
            printf 'ng dashboard put: UNCHANGED — the body you supplied is byte-identical to\n'
            printf '  the dashboard already on overview #%s. Nothing was pushed, and the\n' "$num"
            printf '  freshness stamp was NOT advanced (your-org/nexus-code#1010: a put that\n'
            printf '  changes nothing is not a refresh, and must not be able to buy one).\n'
            printf '  If you meant to refresh the CONTENT, edit the body and re-run.\n'
        } >&2
        # your-org/nexus-code#1116 review, F4. The changed path ends
        # `[[ -n "$url" ]] || die "dashboard PATCH failed"`. This arm used to
        # `printf` the substitution directly, so a failed or unexpected GET
        # printed an EMPTY LINE at rc 0 — the emptiness-at-rc-0 shape, on the
        # one path whose entire purpose is to stop reporting an achievement it
        # did not make. Say so instead of printing nothing convincingly.
        local unchanged_url
        unchanged_url=$(api "/repos/$REPO/issues/$num" 2>/dev/null | jq -r '.html_url // empty')
        if [[ -n "$unchanged_url" ]]; then
            printf '%s\n' "$unchanged_url"
        else
            printf 'ng dashboard put: the dashboard is UNCHANGED (above), but the URL for\n' >&2
            printf '  overview #%s could not be read back — GET failed or returned no\n' "$num" >&2
            printf '  html_url. Nothing was pushed and nothing is wrong with the dashboard;\n' >&2
            printf '  this verb simply cannot show you where it lives.\n' >&2
        fi
        return 0
    fi

    _splice_body "$tmp_new" < "$tmp_full" > "$tmp_merged"

    # your-org/nexus-code#1118 — THE POST-CONDITION IS A READ-BACK.
    #
    # The cap applies to the WHOLE issue body, not to the dashboard region, so
    # the size that matters is the MERGED body — and a dashboard that fits
    # perfectly well can still be unpublishable because the prose outside the
    # markers has grown. `_patch_issue_body` refuses over the cap, warns near
    # it, and verifies the write from the PATCH's own response.
    #
    # Its rc is what gates everything below. This ordering is the fix: the
    # cache write and the freshness stamp used to follow a bare `html_url`
    # check, so a swallowed PATCH still refreshed both. That is how three
    # independent surfaces — rc 0, a printed URL, and the watcher's
    # `dashboard last updated:` emit — all reported a write that never
    # happened. A stamp is a claim about the FORGE, and it may only be written
    # once the forge has been asked and has agreed.
    local url rc
    url=$(_patch_issue_body "$REPO" "$num" "$tmp_merged" "dashboard put"); rc=$?
    if (( rc != 0 )); then
        # Say what was NOT done, in the same breath. An operator who reads
        # only the last line must not be left thinking a retry is all that is
        # missing when the cache and stamp are also untouched.
        printf 'ng: dashboard put: no cache write and NO freshness stamp — the\n' >&2
        printf 'ng:   dashboard is unchanged as far as this command can establish.\n' >&2
        if (( rc == 4 )); then
            printf 'ng:   (rc 4 = UNVERIFIED, not failed. Read it back before believing\n' >&2
            printf 'ng:   either answer: ng dashboard get)\n' >&2
        fi
        return "$rc"
    fi

    # The size diagnostic that makes the refusal actionable, on the SUCCESS
    # path too. Region vs remainder is the number that decides what to do:
    # if the prose outside the markers alone approaches the cap, trimming the
    # dashboard cannot help and the operator needs to know that BEFORE they
    # spend an hour on the wrong half.
    local _mb _rb
    _mb=$(wc -c < "$tmp_merged"); _rb=$(wc -c < "$tmp_new")
    if (( _mb > GH_ISSUE_BODY_WARN_BYTES )); then
        printf 'ng: dashboard put: body %s bytes = %s dashboard region + %s outside\n' \
               "$_mb" "$_rb" "$(( _mb - _rb ))" >&2
    fi

    mkdir -p "$STATE_DIR"
    cp "$tmp_new" "$DASH_CACHE"
    # Touch the freshness timestamp the watcher reads in its emit footer.
    # Single source of truth for "when did we last write the dashboard".
    date -Is > "$STATE_DIR/dashboard-updated.ts"
    printf '%s\n' "$url"
}

cmd_dashboard() {
    _help_check_first "$@"
    local sub="${1:-}"; shift || true
    case "$sub" in
        get)      cmd_dashboard_get      "$@" ;;
        put)      cmd_dashboard_put      "$@" ;;
        scaffold) cmd_dashboard_scaffold "$@" ;;
        validate) cmd_dashboard_validate "$@" ;;
        *)   die "usage: ng dashboard get|put|scaffold|validate [--body-file <path>]" ;;
    esac
}

