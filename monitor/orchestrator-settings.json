{
  "skipDangerousModePermissionPrompt": true,
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          { "type": "command",
            "command": "$NEXUS_ROOT/monitor/hooks/block-askuserquestion.sh" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command",
            "command": "$NEXUS_ROOT/monitor/hooks/orchestrator-session-pin.sh" },
          { "type": "command",
            "command": "(mkdir -p \"$NEXUS_ROOT/monitor/.state\" && touch \"$NEXUS_ROOT/monitor/.state/orchestrator-paste-received\" &) >/dev/null 2>&1" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command",
            "command": "(mkdir -p \"$NEXUS_ROOT/monitor/.state\" && touch \"$NEXUS_ROOT/monitor/.state/orchestrator-heartbeat\" &) >/dev/null 2>&1" }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command",
            "command": "$NEXUS_ROOT/monitor/hooks/notification-record.sh" },
          { "type": "command",
            "command": "$NEXUS_ROOT/monitor/hooks/notify-permission.sh" }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command",
            "command": "$NEXUS_ROOT/monitor/hooks/dangerous-rm-decide.sh --mode orchestrator",
            "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command",
            "command": "(mkdir -p \"$NEXUS_ROOT/monitor/.state\" && touch \"$NEXUS_ROOT/monitor/.state/orchestrator-heartbeat\" &) >/dev/null 2>&1" },
          { "type": "command",
            "command": "$NEXUS_ROOT/monitor/hooks/stamp-clear.sh over-limit" },
          { "type": "command",
            "command": "$NEXUS_ROOT/monitor/hooks/stamp-clear.sh turn-failure" }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          { "type": "command",
            "command": "$NEXUS_ROOT/monitor/hooks/over-limit-emit.sh" },
          { "type": "command",
            "command": "$NEXUS_ROOT/monitor/hooks/turn-failure-emit.sh" }
        ]
      }
    ]
  }
}
