.bipartite/
bin/
.config/
# .claude/ is mostly local state, but the skills symlink that
# exposes the in-repo skills/ tree to Claude Code's discovery path
# (.claude/skills) must be tracked.
.claude/*
!.claude/skills
_ignore/
.epic-config.json
ISSUE-*.md
.epic-status.json
.epic-worklog.md
logs/
.mcp.json
config.yml
.jupyter/
nexus/

# Assets live in the asset repo (typically <your-org>/<your-nexus>
# `main`), cloned at /assets/ and pushed by monitor/upload-asset.sh.
# Legacy: status-assets/ from the original embedded-binary scheme,
# .wiki-checkout/ from the wiki-asset scheme that preceded the
# asset-repo cutover (still gitignored for orchestrators on older
# clones).
/assets/
/assets.lock
/assets.staging/
/monitor/status-assets/
/.wiki-checkout/

# Parallel-agent worktrees.
/.worktrees/

# npm-installed Claude Code. package.json + package-lock.json are
# tracked (reproducible install); node_modules/ is regenerated by
# `monitor/install-claude-local.sh` / `npm ci`.
/node_modules/

# Project-local npm cache. install-claude-local.sh points npm's cache here
# (default $HOME/.npm is read-only on sandboxed/HPC hosts → EROFS); the dir
# is overridable via npm_config_cache / NPM_CONFIG_CACHE.
/.npm-cache/

# NFS silly-rename artefacts.
**/.nfs*

# Nexus-wide, self-contained toolchain built by monitor/bootstrap-venv.sh
# and described by monitor/locals-env.sh: the standalone uv binary
# (locals/bin), shared managed Python interpreters + uv cache/tool store
# (locals/uv/*), and per-project venvs (locals/venvs/<name>). Keeps every
# byte out of $HOME and out of git; rebuilt on demand. ANCHORED on purpose:
# the toolchain lives ONLY at the nexus root, never inside a work/<project>
# repo (nexus infra does not extend into work-dir repos), so /locals/ is
# correct — an un-anchored locals/ would only matter for per-project locals,
# which this design deliberately avoids.
/locals/
# Belt-and-suspenders: an explicit in-tree venv (bootstrap-venv --dir .venv)
# at the nexus root. The default venv lives under locals/venvs/ instead.
/.venv/

# agent-sandbox runtime state, at the nexus root. Generated, never tracked, and
# it accumulates over a nexus's lifetime — 3,394 untracked files on the operator
# nexus at the time of your-org/nexus-code#1197. Anchored, matching the
# convention above: this is nexus-root state, not something a work/<project>
# repo should inherit a rule about.
#
# THIS IS THE FILE-COUNT HALF AND IT IS NOT WHAT RESTORED THE GATE, which is
# worth writing down because #1197 proposed it as "the one-line fix". Measured
# untracked bytes on that nexus: artifacts/ 41,741 MB, backups/ 462 MB, data/
# 361 MB, .sandbox-state/ 89 MB. So this line removes 78% of the untracked FILES
# and 0.2% of the untracked BYTES, and the probe timeout is driven by bytes —
# ten .h5ad files alone are 41.5 GB. The cost fix is `grep -I` in
# monitor/_guard_population.sh:gp_untracked_matching; this line is worth having
# on its own terms, for the spawn and stat cost and because tracking runtime
# state is never right, not as the remedy.
#
# artifacts/ and backups/ are deliberately NOT ignored here. They may be
# intentional, and that is each operator's call to make in their own clone
# rather than this repo's to make for everyone.
/.sandbox-state/

# Python bytecode caches (e.g. from harness py_compile checks).
__pycache__/
*.pyc

# mkdocs build output.
/site/


# zsh completion dump written by interactive-zsh probes/snapshots under
# monitor/shellenv as ZDOTDIR (assert-gh-wrapped.sh redirects it, but Claude
# Code snapshot generation can still land one here). Never a source artifact.
monitor/shellenv/.zcompdump*

# run-tests.sh per-job sidecars. When its `$out_file` base resolves empty the
# sidecars land at the REPO ROOT as `.assertions` / `.caseskipped` / `.err` /
# `.failed` / `.nocount` / `.out` / `.zerocount` instead of under the run dir.
# They are pure scratch, and a `git add -A` in a tree where the suite has run
# will commit them (your-org/nexus-code#835 — it did, into this repo's PR).
.assertions
.caseskipped
.err
.failed
.nocount
.out
.zerocount
.timedout
.accounted
